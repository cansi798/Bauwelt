---
// Grundgerüst aller Seiten: <head>, Header/Footer folgen in späteren Tasks.
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import { SITE, u } from "../consts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u("favicon.ico")} sizes="any" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Progressive Enhancement: Animationen/Reveal NUR wenn JS läuft.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <IconSprite />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <script>
      // Scroll-Reveal: nur Zusatz-Schicht. Ohne JS fehlt html.js → alles sichtbar (CSS-Gate).
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
