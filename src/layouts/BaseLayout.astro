---
// Grundgerüst aller Seiten: SEO-Head (Meta, OG, JSON-LD), Header, Footer, Reveal.
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import { SITE, u } from "../consts";
import { REGION_CENTER, REGION_CITIES, SERVICE_TYPES } from "../data/region";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

const ogImage = new URL(u("assets/og-image.png"), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Strukturierte Daten für lokale Suche (Schema.org)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: SITE.legal,
  image: ogImage.href,
  url: new URL(u(""), Astro.site).href,
  telephone: SITE.phoneTel,
  email: SITE.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.street,
    postalCode: SITE.zip,
    addressLocality: SITE.city,
    addressCountry: "DE",
  },
  // Einzugsgebiet: 100-km-Radius um Norderstedt + konkrete Orte (lokale Suche)
  areaServed: [
    {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: REGION_CENTER.lat,
        longitude: REGION_CENTER.lng,
      },
      geoRadius: REGION_CENTER.radiusMeter,
    },
    ...REGION_CITIES.map((c) => ({ "@type": "City", name: c })),
  ],
  serviceType: SERVICE_TYPES,
  priceRange: "€€",
  openingHours: "Mo-Fr 08:00-18:00",
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={u("sitemap.xml")} />
    <link rel="icon" href={u("favicon.ico")} sizes="48x48" />
    <link rel="icon" href={u("assets/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="icon" href={u("assets/favicon-512.png")} sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href={u("assets/favicon-180.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#2D2C2E" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Progressive Enhancement: Animationen/Reveal NUR wenn JS läuft.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <IconSprite />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />

    <!-- Nach-oben-Button: erscheint nach einer Bildschirmhöhe Scrolltiefe -->
    <button class="hoch" id="hochBtn" type="button" aria-label="Zurück zum Seitenanfang" hidden>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script>
      // Scroll-Reveal: nur Zusatz-Schicht. Ohne JS fehlt html.js → alles sichtbar (CSS-Gate).
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Scroll-Fortschritt + Nach-oben-Button (passiv, ein Listener für beides)
      const fill = document.getElementById("scrollFill");
      const hoch = document.getElementById("hochBtn");
      if (fill && hoch) {
        const tick = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          fill.style.width = max > 0 ? `${(scrollY / max) * 100}%` : "0%";
          hoch.hidden = scrollY < innerHeight;
        };
        addEventListener("scroll", tick, { passive: true });
        tick();
        hoch.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));
      }

      // Erklärvideo-Kacheln: Klick startet das generierte Video MIT Ton
      // (Nutzer-Geste). Es spielt immer nur ein Video; Ende/Pause zeigt wieder
      // den Play-Knopf. Tipp aufs laufende Video pausiert.
      let laufendesVideo: HTMLVideoElement | null = null;
      document.querySelectorAll<HTMLElement>("[data-vkachel]").forEach((kachel) => {
        const video = kachel.querySelector("video")!;
        const play = kachel.querySelector(".vkachel__play")!;
        function zeigeKnopf() { kachel.classList.remove("spielt"); }
        play.addEventListener("click", () => {
          if (laufendesVideo && laufendesVideo !== video) laufendesVideo.pause();
          laufendesVideo = video;
          kachel.classList.add("spielt");
          video.play().catch(zeigeKnopf);
        });
        video.addEventListener("click", () => video.pause());
        video.addEventListener("pause", zeigeKnopf);
        video.addEventListener("ended", () => { video.currentTime = 0; zeigeKnopf(); });
      });
    </script>

    <style>
      .hoch[hidden] { display: none; }
      .hoch {
        position: fixed;
        right: 16px;
        bottom: calc(var(--stickybar-h, 0px) + env(safe-area-inset-bottom) + 16px);
        z-index: 95;
        width: 46px; height: 46px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--linie);
        border-radius: 50%;
        background: var(--weiss);
        color: var(--gold-700);
        box-shadow: var(--shadow-lg);
        transition: transform var(--transition), background var(--transition);
      }
      .hoch:hover { background: var(--gold-100); transform: translateY(-2px); }
      @media (min-width: 1024px) { .hoch { bottom: 24px; } }
    </style>
  </body>
</html>
