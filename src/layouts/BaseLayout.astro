---
// Grundgerüst aller Seiten: SEO-Head (Meta, OG, JSON-LD), Header, Footer, Reveal.
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import { SITE, u } from "../consts";
import { REGION_CENTER, REGION_CITIES, SERVICE_TYPES } from "../data/region";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

const ogImage = new URL(u("assets/og-image.png"), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Strukturierte Daten für lokale Suche (Schema.org)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: SITE.legal,
  image: ogImage.href,
  url: new URL(u(""), Astro.site).href,
  telephone: SITE.phoneTel,
  email: SITE.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.street,
    postalCode: SITE.zip,
    addressLocality: SITE.city,
    addressCountry: "DE",
  },
  // Einzugsgebiet: 100-km-Radius um Norderstedt + konkrete Orte (lokale Suche)
  areaServed: [
    {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: REGION_CENTER.lat,
        longitude: REGION_CENTER.lng,
      },
      geoRadius: REGION_CENTER.radiusMeter,
    },
    ...REGION_CITIES.map((c) => ({ "@type": "City", name: c })),
  ],
  serviceType: SERVICE_TYPES,
  priceRange: "€€",
  openingHours: "Mo-Fr 08:00-18:00",
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={u("sitemap.xml")} />
    <link rel="icon" href={u("favicon.ico")} sizes="48x48" />
    <link rel="icon" href={u("assets/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="icon" href={u("assets/favicon-512.png")} sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href={u("assets/favicon-180.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#2D2C2E" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Progressive Enhancement: Animationen/Reveal NUR wenn JS läuft.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <IconSprite />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyBar />

    <!-- Nach-oben-Button: erscheint nach einer Bildschirmhöhe Scrolltiefe -->
    <button class="hoch" id="hochBtn" type="button" aria-label="Zurück zum Seitenanfang" hidden>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script>
      // Scroll-Reveal: nur Zusatz-Schicht. Ohne JS fehlt html.js → alles sichtbar (CSS-Gate).
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Scroll-Fortschritt + Nach-oben-Button (passiv, ein Listener für beides)
      const fill = document.getElementById("scrollFill");
      const hoch = document.getElementById("hochBtn");
      if (fill && hoch) {
        const tick = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          fill.style.width = max > 0 ? `${(scrollY / max) * 100}%` : "0%";
          hoch.hidden = scrollY < innerHeight;
        };
        addEventListener("scroll", tick, { passive: true });
        tick();
        hoch.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));
      }

      // „Gezeichnetes Video" (AIDA, ohne Play-Button): Sobald ein markierter
      // Karten-Slider ins Bild scrollt, läuft er mobil automatisch STUMM in
      // Schleife durch – die aktive Karte wird golden nachgezeichnet (Browser
      // verbieten Ton-Autostart; der 🔊-Chip schaltet die Musik dazu).
      // Wischen übernimmt die Kontrolle und stoppt den Auto-Lauf.

      // Hintergrundmusik: weiches Pad + Pentatonik-Arpeggio, sehr leise
      let audio: { ctx: AudioContext; master: GainNode; arp: number } | null = null;
      function musikStart() {
        try {
          const ctx = new AudioContext();
          const master = ctx.createGain();
          master.gain.setValueAtTime(0, ctx.currentTime);
          master.gain.linearRampToValueAtTime(0.11, ctx.currentTime + 1.0);
          master.connect(ctx.destination);
          const filter = ctx.createBiquadFilter();
          filter.type = "lowpass";
          filter.frequency.value = 850;
          filter.connect(master);
          for (const f of [110, 165, 221.5]) {
            const o = ctx.createOscillator();
            o.type = "triangle";
            o.frequency.value = f;
            const g = ctx.createGain();
            g.gain.value = 0.06;
            o.connect(g);
            g.connect(filter);
            o.start();
          }
          const toene = [440, 494, 554, 659, 740, 659, 554, 494];
          let n = 0;
          const arp = window.setInterval(() => {
            const o = ctx.createOscillator();
            o.type = "sine";
            o.frequency.value = toene[n++ % toene.length];
            const g = ctx.createGain();
            g.gain.setValueAtTime(0, ctx.currentTime);
            g.gain.linearRampToValueAtTime(0.09, ctx.currentTime + 0.05);
            g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.55);
            o.connect(g);
            g.connect(master);
            o.start();
            o.stop(ctx.currentTime + 0.6);
          }, 640);
          audio = { ctx, master, arp };
        } catch {
          audio = null;
        }
      }
      function musikStopp() {
        if (!audio) return;
        const { ctx, master, arp } = audio;
        clearInterval(arp);
        try {
          master.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.5);
        } catch {}
        setTimeout(() => ctx.close().catch(() => {}), 700);
        audio = null;
      }
      // 🔊-Chips: Musik an/aus (ein Gesture genügt den Browser-Regeln)
      document.querySelectorAll<HTMLButtonElement>("[data-vton]").forEach((chip) => {
        chip.addEventListener("click", () => {
          if (audio) {
            musikStopp();
            document.querySelectorAll("[data-vton]").forEach((c) => (c.textContent = "🔊 Ton einschalten"));
          } else {
            musikStart();
            chip.textContent = "🔇 Ton aus";
          }
        });
      });

      // Goldener Nachzeichnen-Rahmen für die aktive Karte
      function zeichneRahmen(karte: HTMLElement) {
        karte.classList.add("vzeichnet");
        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.setAttribute("class", "vzeichnet-rahmen");
        svg.setAttribute("viewBox", "0 0 100 100");
        svg.setAttribute("preserveAspectRatio", "none");
        const pf = document.createElementNS("http://www.w3.org/2000/svg", "path");
        pf.setAttribute("d", "M4 7 C 30 3, 70 9, 96 5 C 99 30, 95 68, 97 93 C 70 98, 28 94, 4 96 C 1 70, 5 32, 4 7 Z");
        pf.setAttribute("pathLength", "1");
        pf.setAttribute("vector-effect", "non-scaling-stroke");
        svg.append(pf);
        karte.append(svg);
      }

      const mobil = matchMedia("(max-width: 767px)");
      const ruhig = matchMedia("(prefers-reduced-motion: reduce)");
      if (mobil.matches && !ruhig.matches && "IntersectionObserver" in window) {
        document.querySelectorAll<HTMLElement>("[data-vauto]").forEach((slider) => {
          let timer: number | undefined;
          let idx = 0;
          let vonHand = false; // Nutzer hat gewischt → Auto-Lauf aus
          const karten = () => Array.from(slider.children) as HTMLElement[];

          function aufraeumen() {
            slider.querySelectorAll(".vzeichnet-rahmen").forEach((s) => s.remove());
            slider.querySelectorAll(".vzeichnet").forEach((k) => k.classList.remove("vzeichnet"));
          }

          function pause() {
            clearTimeout(timer);
            timer = undefined;
            aufraeumen();
          }

          function schritt() {
            const alle = karten();
            aufraeumen();
            const k = alle[idx % alle.length];
            k.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
            zeichneRahmen(k);
            idx++;
            timer = window.setTimeout(schritt, 2400);
          }

          const io = new IntersectionObserver(
            (eintraege) => {
              for (const e of eintraege) {
                if (e.isIntersecting && !vonHand && timer === undefined) {
                  idx = 0;
                  schritt();
                } else if (!e.isIntersecting) {
                  pause();
                }
              }
            },
            { threshold: 0.55 }
          );
          io.observe(slider);

          // Wischen = Nutzer übernimmt; Auto-Lauf für diese Sektion beenden
          slider.addEventListener("pointerdown", () => {
            vonHand = true;
            pause();
          }, { passive: true });
        });
      }
    </script>

    <style>
      .hoch[hidden] { display: none; }
      .hoch {
        position: fixed;
        right: 16px;
        bottom: calc(var(--stickybar-h, 0px) + env(safe-area-inset-bottom) + 16px);
        z-index: 95;
        width: 46px; height: 46px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--linie);
        border-radius: 50%;
        background: var(--weiss);
        color: var(--gold-700);
        box-shadow: var(--shadow-lg);
        transition: transform var(--transition), background var(--transition);
      }
      .hoch:hover { background: var(--gold-100); transform: translateY(-2px); }
      @media (min-width: 1024px) { .hoch { bottom: 24px; } }
    </style>
  </body>
</html>
