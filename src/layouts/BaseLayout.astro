---
// Grundgerüst aller Seiten: <head>, Header/Footer folgen in späteren Tasks.
import "../styles/global.css";
import { SITE, u } from "../consts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u("favicon.ico")} sizes="any" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Progressive Enhancement: Animationen/Reveal NUR wenn JS läuft.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
