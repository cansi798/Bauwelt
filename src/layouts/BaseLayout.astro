---
// Grundgerüst aller Seiten: SEO-Head (Meta, OG, JSON-LD), Header, Footer, Reveal.
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBar from "../components/StickyBar.astro";
import type { StickyKnopf } from "../consts";
import BookingDialog from "../components/BookingDialog.astro";
import { LEISTUNGEN, SITE, u } from "../consts";
import { REGION_CENTER, REGION_CITIES } from "../data/region";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Footer nur mit Navigation (ohne Kontakt-Kopf) – Karriere & Partner, Kundenwunsch 11.10.2026 (10). */
  footerNurNav?: boolean;
  /** Eigene Buttons für die feste Leiste unten (Audit 1.7) – ohne Angabe: Rechner + Vor-Ort-Termin. */
  sticky?: StickyKnopf[];
  /** Zusätzliche Schema.org-Knoten dieser Seite (Service, FAQPage, BreadcrumbList – Audit S3). */
  schema?: Record<string, unknown>[];
}
const { title, description, noindex = false, footerNurNav = false, sticky, schema = [] } = Astro.props;

const ogImage = new URL(u("assets/og-image.png"), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Strukturierte Daten (Schema.org) – SEO-/KI-Audit S3 (19.10.2026): EIN Graph mit
// Firma (HomeAndConstructionBusiness + GeneralContractor), Website und seitenbezogenen Daten
// (Service, FAQPage, BreadcrumbList über das Prop `schema`). Nur echte Leistungen (LEISTUNGEN),
// keine Bewertungen (gibt es noch nicht).
const start = new URL(u(""), Astro.site).href;
const FIRMA_ID = `${start}#firma`;
const firma = {
  "@type": ["HomeAndConstructionBusiness", "GeneralContractor"],
  "@id": FIRMA_ID,
  name: SITE.name,
  legalName: SITE.legal,
  url: start,
  logo: new URL(u("assets/logo.png"), Astro.site).href,
  image: ogImage.href,
  telephone: SITE.phoneTel,
  email: SITE.email,
  vatID: SITE.vat,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.street,
    postalCode: SITE.zip,
    addressLocality: SITE.city,
    addressRegion: "Schleswig-Holstein",
    addressCountry: "DE",
  },
  memberOf: { "@type": "Organization", name: "Handwerkskammer Lübeck" },
  // Einzugsgebiet laut Karte (ca. 40 km um Norderstedt, Jamils 2. Karte) + konkrete Orte
  areaServed: [
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: REGION_CENTER.lat, longitude: REGION_CENTER.lng },
      geoRadius: REGION_CENTER.radiusMeter,
    },
    ...REGION_CITIES.map((c) => ({ "@type": "City", name: c })),
  ],
  knowsAbout: LEISTUNGEN.map((l) => l.unterschrift),
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Leistungen",
    itemListElement: LEISTUNGEN.map((l) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: l.unterschrift, url: new URL(u(`leistungen/${l.slug}/`), Astro.site).href },
    })),
  },
  priceRange: "€€",
  openingHoursSpecification: [{
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "08:00",
    closes: "18:00",
  }],
  contactPoint: [{ "@type": "ContactPoint", telephone: SITE.phoneTel, email: SITE.email, contactType: "customer service", availableLanguage: "de" }],
};
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    firma,
    { "@type": "WebSite", "@id": `${start}#website`, url: start, name: SITE.name, inLanguage: "de-DE", publisher: { "@id": FIRMA_ID } },
    ...schema.map((n) => ({ ...n, ...(n["@type"] === "Service" ? { provider: { "@id": FIRMA_ID } } : {}) })),
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={u("sitemap.xml")} />
    <link rel="icon" href={u("favicon.ico")} sizes="48x48" />
    <link rel="icon" href={u("assets/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="icon" href={u("assets/favicon-512.png")} sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href={u("assets/favicon-180.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#2D2C2E" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Progressive Enhancement: Animationen/Reveal NUR wenn JS läuft.
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <IconSprite />
    <Header />
    <main id="main">
      <slot />
    </main>
    {/* Jamil 27.10.2026 (Talk 3461): Abschnitte wechseln überall Weiß → Creme → Weiß … (zentral, damit neue Abschnitte automatisch
        richtig wechseln). Dunkle Abschnitte/Leiste bleiben; nie zwei gleichfarbige Abschnitte nebeneinander.
        Prüfung 27.10.2026: Die Seiten setzen section--sand schon im HTML genau so (sonst springen die Farben beim
        langsamen Laden sichtbar um, und ohne JS stimmt es nicht). Das Skript ist nur noch Sicherheitsnetz und meldet
        in der Konsole, wenn es etwas korrigieren musste → dann die Klasse auf der Seite anpassen. */}
    <script is:inline>
      (function () {
        var m = document.getElementById("main");
        if (!m) return;
        function run(parent) {
          var prev = "dunkel";
          for (var c = parent.firstElementChild; c; c = c.nextElementSibling) {
            if (c.hidden) continue;
            if (c.matches("section.section:not(.section--dark)")) {
              var farbe = prev === "weiss" ? "creme" : "weiss";
              if (c.classList.contains("section--sand") !== (farbe === "creme")) falsch++;
              c.classList.toggle("section--sand", farbe === "creme");
              prev = farbe;
            } else if (c.matches("div") && c.querySelector(":scope > section.section")) {
              run(c);
              prev = "dunkel";
            } else {
              prev = c.classList.contains("phero") ? "weiss" : "dunkel";
            }
          }
        }
        var falsch = 0;
        run(m);
        if (falsch) console.warn("Weiß/Creme-Wechsel: " + falsch + " Abschnitt(e) im HTML anders gefärbt – Klasse section--sand auf der Seite anpassen");
      })();
    </script>
    <Footer nurNav={footerNurNav} />
    <StickyBar knoepfe={sticky} />
    <BookingDialog />

    <!-- Nach-oben-Button: erscheint nach einer Bildschirmhöhe Scrolltiefe -->
    <button class="hoch" id="hochBtn" type="button" aria-label="Zurück zum Seitenanfang" hidden>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>
    <script>
      // Scroll-Reveal + alle Animationen: genau einmal beim ersten Sichtbarwerden
      // (Kundenwunsch 17.10.2026 (81)). Ohne JS fehlt html.js → alles sichtbar (CSS-Gate).
      import "../scripts/einmal-animieren";

      // Scroll-Fortschritt + Nach-oben-Button (passiv, ein Listener für beides)
      const fill = document.getElementById("scrollFill");
      const hoch = document.getElementById("hochBtn");
      if (fill && hoch) {
        // Ruckel-Prüfung 29.10.2026: vorher bei JEDEM Scroll-Ereignis style.width (= Layout) und hidden neu
        // gesetzt (211 bzw. 54 Schreibvorgänge pro Testlauf). Jetzt: höchstens einmal pro Bild (rAF), Balken
        // per transform (kein Layout), Seitenhöhe nur bei Größenänderung messen, hidden nur bei echtem Wechsel.
        let max = 1, geplant = false, zuletzt = -1, versteckt = hoch.hidden;
        const messen = () => { max = Math.max(1, document.documentElement.scrollHeight - innerHeight); };
        const zeichnen = () => {
          geplant = false;
          const anteil = Math.min(1, Math.max(0, scrollY / max));
          if (Math.abs(anteil - zuletzt) > 0.0005) { fill.style.transform = `scaleX(${anteil.toFixed(4)})`; zuletzt = anteil; }
          const v = scrollY < innerHeight;
          if (v !== versteckt) { hoch.hidden = v; versteckt = v; }
        };
        const tick = () => { if (!geplant) { geplant = true; requestAnimationFrame(zeichnen); } };
        messen();
        new ResizeObserver(() => { messen(); tick(); }).observe(document.body);
        addEventListener("resize", () => { messen(); tick(); }, { passive: true });
        addEventListener("scroll", tick, { passive: true });
        tick();
        hoch.addEventListener("click", () => scrollTo({ top: 0, behavior: "smooth" }));
      }

    </script>

    <style>
      .hoch[hidden] { display: none; }
      .hoch {
        position: fixed;
        right: 16px;
        bottom: calc(var(--stickybar-h, 0px) + env(safe-area-inset-bottom) + 16px);
        z-index: 95;
        width: 46px; height: 46px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--linie);
        border-radius: 50%;
        background: var(--weiss);
        color: var(--gold-700);
        box-shadow: var(--shadow-lg);
        transition: transform var(--transition), background var(--transition);
      }
      .hoch:hover { background: var(--gold-100); transform: translateY(-2px); }
      @media (min-width: 1024px) { .hoch { bottom: 24px; } }
      /* Audit 1.10 (19.10.2026): am Handy/Tablet kein „Nach oben“-Button – Leiste unten + Logo reichen */
      @media (max-width: 1023px) { .hoch { display: none !important; } }
    </style>
  </body>
</html>
