---
// USP-Sektion (Enpal: 3 Säulen mit Bild): warum Bauwelt.
import { USP } from "../data/home";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import RoughSzene from "./RoughSzene.astro";

// Kundenwunsch 14.10.2026 (37): Überschrift wörtlich mit Punkt; Hintergrund wählbar
// (auf Über uns weiß, damit sich Sand/Weiß/Dunkel abwechseln).
interface Props { weiss?: boolean; }
const { weiss = false } = Astro.props;
---

<section class:list={["section", { "section--sand": !weiss }]}>
  <div class="container">
    <SectionHead center eyebrow="Warum Bauwelt Handwerk" pre="Handwerk ohne " accent="Überraschungen." />
    <div class="grid cols-3">
      {USP.map((usp) => (
        <article class="card usp reveal">
          {/* Kundenwunsch 15.10.2026 (61): gezeichnete Animation statt Foto */}
          <div class="usp__bild"><RoughSzene szene={usp.szene} label={`Zeichnung: ${usp.title}`} /></div>
          <div class="usp__head">
            <span class="usp__icon"><Icon name={usp.icon} size={24} class="icon" /></span>
            <h3>{usp.title}</h3>
          </div>
          <p>{usp.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .usp__bild { background: var(--sand, #f3f0ea); border-radius: var(--radius-lg); padding: 18px 12px 6px; }
  .usp__bild :global(.rszene) { margin: 0 auto; }
  .usp__bild :global(.rszene__bild) { max-width: 300px; }
  .usp { display: grid; gap: 16px; align-content: start; padding: 16px 16px 28px; }
  .usp__head { display: flex; align-items: center; gap: 12px; padding-inline: 8px; }
  .usp__head h3 { margin: 0; }
  .usp__icon {
    flex: none;
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--gold-100);
    color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .usp p { padding-inline: 8px; margin: 0; }
</style>
