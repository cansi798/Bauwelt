---
// FAQ-Akkordeon: <details>/<summary> – funktioniert ohne JavaScript.
// Der letzte Eintrag endet im Termin-CTA (Enpal-Muster "Noch Fragen?").
import Icon from "./Icon.astro";

interface Props {
  items: { q: string; a: string }[];
  /** Termin-CTA unter der letzten Antwort anzeigen. */
  withCta?: boolean;
}
const { items, withCta = false } = Astro.props;
---

<div class="faq">
  {items.map((f, i) => (
    <details class="faq__item reveal">
      <summary>
        {f.q}
        <Icon name="chevron" size={20} class="icon faq__chev" />
      </summary>
      <div class="faq__body">
        <p>{f.a}</p>
        {withCta && i === items.length - 1 && (
          <a class="btn btn--sm" href="#termin">Kostenloses Gespräch vereinbaren</a>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 12px; max-width: 820px; margin-inline: auto; }
  .faq__item {
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 22px;
    font-family: var(--font-heading); font-weight: 700; font-size: 16px;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__chev { flex: none; transition: transform var(--transition); color: var(--gold-700); }
  .faq__item[open] .faq__chev { transform: rotate(180deg); }
  .faq__body { padding: 0 22px 20px; display: grid; gap: 12px; justify-items: start; }
  .faq__body p { margin: 0; }
</style>
