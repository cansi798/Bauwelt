---
// Referenz-Galerie nach Leistungen (Kundenfeedback 07.10.2026): Sprungleiste
// oben, darunter je Leistung eine Bildgruppe mit Link zur Leistungsseite.
// Reines HTML/CSS – kein JS nötig. Klick auf ein Bild öffnet es in voller Größe.
// 14.10.2026 (36): Kategorie-Einleitung (Slogan + Text) und Projektkarten mit Projektname;
// Ort/Fläche/Art erscheinen automatisch, sobald sie in galerie.ts eingetragen sind.
import { u } from "../consts";
import { GALERIE } from "../data/galerie";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import Img from "./Img.astro";

// Slogan „Mehr Komfort. Mehr Design. Mehr Wohnqualität.“ → letzter Satz gold
const kopf = (t: string) => {
  const m = t.match(/^(.*[.!?]\s)([^.!?]+[.!?]?)$/) ?? t.match(/^(.*\s)(\S+)$/);
  return m ? { pre: m[1], accent: m[2] } : { pre: "", accent: t };
};
---

<nav class="gal__nav" aria-label="Referenzen nach Leistung">
  {GALERIE.map((g) => (
    <a class="gal__chip" href={`#${g.id}`}>{g.title} <span>{g.bilder.length}</span></a>
  ))}
</nav>

{GALERIE.map((g) => (
  <section class="gal__gruppe" id={g.id}>
    {/* Kategorie-Einleitung statt direkt Bilder (Kundenwunsch 14.10.2026 (36)) */}
    <SectionHead center eyebrow={g.title} {...kopf(g.slogan ?? g.title)} text={g.intro} />
    <div class="gal__grid">
      {g.bilder.map((b) => (
        <figure class="gal__karte reveal">
          <a class="gal__bild" href={u(`assets/img/${b.file}`)} target="_blank" rel="noopener" aria-label={`${b.alt} – Bild vergrößern`}>
            <Img src={b.file} alt={b.alt} w={4} h={5} />
          </a>
          {(b.titel || b.ort || b.flaeche || b.art) && (
            <figcaption class="gal__daten">
              {b.titel && <strong>{b.titel}</strong>}
              {(b.ort || b.flaeche || b.art) && (
                <ul>
                  {b.ort && <li><Icon name="pin" size={15} class="icon" />{b.ort}</li>}
                  {b.flaeche && <li><Icon name="tiles" size={15} class="icon" />{b.flaeche}</li>}
                  {b.art && <li><Icon name="hand" size={15} class="icon" />{b.art}</li>}
                </ul>
              )}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
    <p class="gal__mehr">
      <a class="btn btn--ghost" href={g.href}>Mehr zur Leistung {g.title} <Icon name="arrow" size={16} class="icon" /></a>
    </p>
  </section>
))}

<style>
  .gal__nav {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;
    margin-bottom: 48px;
  }
  .gal__chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--linie);
    background: var(--weiss);
    font-family: var(--font-heading); font-weight: 600; font-size: 14px;
    color: var(--anthrazit-800);
    transition: border-color var(--transition), background var(--transition);
  }
  .gal__chip:hover { border-color: var(--gold-500); background: var(--gold-100); text-decoration: none; }
  .gal__chip span {
    min-width: 24px; padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--gold-100); color: var(--gold-700);
    font-size: 12px; text-align: center;
  }

  .gal__gruppe + .gal__gruppe { margin-top: 64px; }
  .gal__gruppe :global(.section-head) { margin-bottom: 28px; }
  /* Mobil 2 Spalten, Tablet 3, Desktop 4 – einheitliches Hochformat 4:5 */
  /* größer (Kundenwunsch 14.10.2026 (33)): mobil 1, Tablet 2, Desktop 3 Spalten */
  .gal__grid { display: grid; gap: 14px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .gal__grid { grid-template-columns: repeat(2, 1fr); gap: 18px; } }
  @media (min-width: 1024px) { .gal__grid { grid-template-columns: repeat(3, 1fr); gap: 22px; } }
  .gal__karte { margin: 0; display: grid; gap: 12px; align-content: start; }
  .gal__bild { display: block; border-radius: var(--radius-lg); overflow: hidden; }
  .gal__daten { display: grid; gap: 6px; padding: 0 2px; }
  .gal__daten strong { font-family: var(--font-heading); font-size: 16px; line-height: 1.3; color: var(--anthrazit-900); }
  .gal__daten ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 14px; color: var(--anthrazit-700); }
  .gal__daten li { display: inline-flex; align-items: center; gap: 6px; }
  .gal__daten :global(.icon) { width: 15px; height: 15px; color: var(--gold-700); }
  .gal__bild :global(img) { transition: transform 400ms ease; }
  .gal__bild:hover :global(img) { transform: scale(1.04); }

  /* Kundenwunsch 11.10.2026 (8): linksbündig, bündig mit der linken Kante des ersten Bildes */
  .gal__mehr { margin: 16px 0 0; text-align: left; }
  .gal__mehr a {
    display: inline-flex; align-items: center; gap: 6px;
    font-weight: 700; color: var(--gold-700);
  }
</style>
