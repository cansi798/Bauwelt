---
// Zahlen-Band (statt Enpals "Bekannt aus"): NUR belegbare Werte aus data/home.ts.
// Zähl-Animation nur mit JS; ohne JS stehen die Endwerte im Markup.
import { STATS } from "../data/home";
---

<section class="trust section--sand" aria-label="Bauwelt in Zahlen">
  <div class="container trust__grid">
    {STATS.map((s) => (
      <div class="trust__item">
        <span class="trust__value" data-count={s.value}>
          {s.prefix}<span class="trust__num">{s.value}</span>{s.suffix}
        </span>
        <span class="trust__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .trust { padding-block: 28px; border-block: 1px solid var(--linie); }
  .trust__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (min-width: 768px) { .trust__grid { grid-template-columns: repeat(4, 1fr); } }
  .trust__item { display: grid; justify-items: center; text-align: center; gap: 2px; }
  .trust__value {
    font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(28px, 4vw, 40px);
    color: var(--anthrazit-800);
  }
  .trust__label { font-size: 14px; color: var(--anthrazit-600); }
</style>

<script>
  // Hochzählen beim ersten Sichtbarwerden.
  const items = document.querySelectorAll<HTMLElement>(".trust__value");
  if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const num = el.querySelector<HTMLElement>(".trust__num")!;
        const target = Number(el.dataset.count || "0");
        const t0 = performance.now();
        const dur = 1200;
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          num.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.4 });
    items.forEach((el) => io.observe(el));
  }
</script>
