---
// Sektions-Überschrift: eyebrow + H2 mit goldenem Akzentwort + goldene Kurzlinie.
// Jamil 21.10.2026 (Msg 2891): Akzent = das Wort mit der meisten Bedeutung, nicht automatisch das
// letzte. Entweder `titel` mit *Sternchen* („Was Sie *nach dem Termin* erhalten“) oder pre/accent/post.
import { akzent } from "../lib/akzent";
interface Props {
  eyebrow?: string;
  pre?: string;      // Text vor dem Akzentwort
  accent?: string;   // goldenes Wort
  post?: string;     // Text nach dem Akzentwort
  /** Ganze Überschrift mit *Akzent* in Sternchen (ohne Sternchen: letztes Wort gold). */
  titel?: string;
  text?: string;     // optionaler Beschreibungstext unter der Headline
  center?: boolean;
  /** Nur mobil (< 768 px) mittig, ab Tablet linksbündig. */
  centerMobile?: boolean;
  as?: "h1" | "h2" | "h3";
  /** Zwischenüberschrift innerhalb eines Abschnitts: kleiner als die Abschnitts-Überschrift
   *  (Jamil 27.10.2026, Talk 3488/3489 – unter „So arbeiten wir heute“). */
  klein?: boolean;
}
const { eyebrow, text, center = false, centerMobile = false, as: Tag = "h2", klein = false } = Astro.props;
const { pre = "", accent = "", post = "" } = Astro.props.titel ? akzent(Astro.props.titel) : Astro.props;
---

<div class:list={["section-head", { center, "center-mobile": centerMobile, "section-head--klein": klein }]}>
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  <Tag class="rule">{pre}{accent && <span class="accent">{accent}</span>}{post}</Tag>
  {text && <p class="lead">{text}</p>}
</div>
