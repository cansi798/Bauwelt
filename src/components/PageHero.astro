---
import { u } from "../consts";
import Placeholder from "./Placeholder.astro";
interface Crumb { label: string; href?: string; }
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  img?: string;      // Dateiname in assets/img/
  prompt?: string;   // KI-Bildbeschreibung
}
const { eyebrow, title, lead, crumbs = [], img, prompt } = Astro.props;
---
<section class="hero hero--page">
  <div class="hero__media">
    <Placeholder prompt={prompt} img={img} imgClass="hero__img" showKi={false} alt={title} />
  </div>
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label="Brotkrumen">
        {crumbs.map((c, i) => (
          <>
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            {i < crumbs.length - 1 && <span class="sep">/</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <p class="eyebrow" style="color:var(--gold-300)">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
  </div>
</section>
