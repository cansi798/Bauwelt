---
// Einzugsgebiet (Kundenwunsch 19.10.2026, Audit 3.3 – ersetzt das Orts-Laufband):
// eigene gezeichnete Karte nach Jamils markiertem Gebiet (Szene „gebiet“, src/data/szenen.ts)
// + feste, lesbare Ortsliste. Keine Kartenkacheln, keine fremden Dienste (Datenschutz).
import { REGION_CITIES, REGION_KARTE, REGION_TEXT } from "../data/region";
import { SITE } from "../consts";
import SectionHead from "./SectionHead.astro";
import RoughSzene from "./RoughSzene.astro";

interface Props {
  /** Ohne eigene Sektion/Überschrift (z. B. Kontaktseite, Kundenwunsch 17.10.2026 (78)). */
  eingebettet?: boolean;
  /** Creme-Hintergrund (Weiß/Creme-Wechsel, Jamil 27.10.2026 – Startseite) */
  sand?: boolean;
}
const { eingebettet = false, sand = false } = Astro.props;
const BESCHREIBUNG = REGION_KARTE;
---

{!eingebettet && (
  <section class:list={["section", "area", { "section--sand": sand }]} id="einzugsgebiet-karte">
    <div class="container">
      <SectionHead
        center
        eyebrow="Einzugsgebiet"
        pre="In Ihrer Nähe für Sie "
        accent="unterwegs"
        text={`Von ${SITE.city} aus betreuen wir Projekte in ${REGION_TEXT}.`}
      />
      <div class="area__grid">
        <RoughSzene szene="gebiet" label={BESCHREIBUNG} />
        <div class="area__liste">
          <p class="area__titel">Hier sind wir für Sie da:</p>
          <ul>{REGION_CITIES.map((c) => <li>{c}</li>)}</ul>
          <p class="small area__note">Ihr Ort ist nicht dabei? Fragen Sie einfach an – oft lohnt sich die Anfahrt trotzdem. Mögliche Anfahrtskosten besprechen wir vorab.</p>
        </div>
      </div>
    </div>
  </section>
)}
{eingebettet && (
  <div class="area area--eingebettet">
    <div class="area__grid">
      <RoughSzene szene="gebiet" label={BESCHREIBUNG} />
      <div class="area__liste">
        <p class="area__titel">Hier sind wir für Sie da:</p>
        <ul>{REGION_CITIES.map((c) => <li>{c}</li>)}</ul>
        <p class="small area__note">Ihr Ort ist nicht dabei? Fragen Sie einfach an – oft lohnt sich die Anfahrt trotzdem. Mögliche Anfahrtskosten besprechen wir vorab.</p>
      </div>
    </div>
  </div>
)}

<style>
  .area__grid { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 900px) { .area__grid { grid-template-columns: 1.15fr 0.85fr; gap: 48px; } }
  .area__grid :global(.rszene) { margin: 0; }
  .area__grid :global(.rszene__bild) { max-width: 620px; }
  .area__titel { margin: 0 0 12px; font-family: var(--font-heading); font-weight: 700; font-size: 18px; color: var(--anthrazit-900); }
  .area__liste ul {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .area__liste li {
    padding: 6px 12px; border-radius: 999px;
    background: var(--weiss); border: 1px solid var(--linie);
    font-family: var(--font-heading); font-weight: 600; font-size: 14px; color: var(--anthrazit-700);
  }
  .area__liste li:first-child { border-color: var(--gold-500); color: var(--gold-700); }
  .area__note { margin: 16px 0 0; }
  .area--eingebettet { margin-bottom: 28px; }
</style>
