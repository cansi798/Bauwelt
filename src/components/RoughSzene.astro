---
// Handgezeichnete Erklär-Szene (ersetzt die Erklärvideos, 29.09.2026).
// Die Formen berechnet rough.js beim BUILD (src/data/szenen.ts) – im Browser
// liegt nur fertiges SVG. Zwei Fassungen: hochkant (Handy) und quer (ab Tablet).
// Ablauf (Kundenwunsch 17.10.2026 (81), ersetzt die Endlosschleife vom 30.09.2026):
// Sobald die Szene zum ersten Mal im Bild ist (data-einmal → „is-sichtbar“, siehe
// src/scripts/einmal-animieren.ts), zeichnet sie sich EINMAL Strich für Strich
// (CSS, pathLength=1 + stroke-dashoffset) und bleibt dann fertig stehen – kein
// Neustart beim Zurückscrollen, erst wieder nach Neuladen der Seite.
// Ohne JS oder bei „Bewegung reduzieren" steht sofort das fertige Bild.
// Kundenwunsch 19.10.2026 (Audit 3.1): gleicher Look, aber schnell – alle Zeiten einer Szene
// werden so gestaucht, dass sie in ca. 2 s fertig gezeichnet ist (19.10.: 2 s statt 1,5 s) (Reihenfolge/Versatz bleiben),
// und alle Texte stehen sofort da (keine Einblendung mehr).
// Gesamt-Audit 20.10.2026 P1 (Jamil, Talk 2787): Die Szenen stehen NICHT mehr im HTML, sondern als
// eigene Dateien (/szenen/<name>-<ansicht>.svg, src/pages/szenen/[datei].svg.ts). Im HTML steht nur
// ein Platzhalter mit der richtigen Höhe (kein Springen); ein kleines Skript lädt die Zeichnung
// ca. 300 px bevor sie ins Bild kommt und setzt sie ein – danach zeichnet sie sich wie bisher.
// Ohne JS zeigt <noscript> die fertige Zeichnung als Bild. `sofort` bettet direkt ein (z. B. im Hero).
import type { SzenenName } from "../data/szenen";
import { fassungen, szeneMasse, szeneSvg } from "../lib/szene-svg";
import { u } from "../consts";

interface Props {
  szene: SzenenName;
  /** Beschreibt die Szene für Screenreader (role="img"). */
  label: string;
  /** Sofort einbetten statt nachladen (Zeichnung im ersten Bildschirm, z. B. Karriere-Hero). */
  sofort?: boolean;
}
const { szene, label, sofort = false } = Astro.props;
const platzhalter = fassungen(szene).map((a) => ({
  klasse: a === "beide" ? "rszene__svg" : `rszene__svg rszene__svg--${a}`,
  ...szeneMasse(szene, a),
  src: u(`szenen/${a === "beide" ? szene : `${szene}-${a}`}.svg`),
}));
---

<div class={`rszene rszene--${szene}`} data-rszene data-einmal data-geladen={sofort ? "" : undefined}>
  <div class="rszene__bild" role="img" aria-label={label}>
    {sofort
      ? <Fragment set:html={fassungen(szene).map((a) => szeneSvg(szene, a)).join("")} />
      : platzhalter.map((p) => (
          <div class={`${p.klasse} rszene__platz`} style={`aspect-ratio: ${p.breite} / ${p.hoehe}`} data-rszene-datei={p.src}>
            <noscript><img class="rszene__img" src={p.src} alt="" width={p.breite} height={p.hoehe} loading="lazy" /></noscript>
          </div>
        ))}
  </div>
</div>

<script>
  // Szenen kurz vor dem Sichtbarwerden nachladen (P1) – nur die Fassung, die gerade zu sehen ist
  // (Handy ODER Desktop); die andere erst, wenn sich die Bildschirmbreite ändert (Drehen, Fenster).
  // Fehlt fetch/IntersectionObserver oder schlägt das Laden fehl, steht die Zeichnung als fertiges
  // Bild da (ohne Animation).
  const einsetzen = async (p: HTMLElement) => {
    const src = p.dataset.rszeneDatei!;
    delete p.dataset.rszeneDatei; // nicht doppelt laden
    try {
      const r = await fetch(src);
      if (!r.ok) throw new Error(String(r.status));
      // Farbblock der Datei entfernen – im Dokument gelten die Farben der Seite
      p.insertAdjacentHTML("afterend", (await r.text()).replace(/<style data-datei>[\s\S]*?<\/style>/, ""));
      p.remove();
    } catch {
      p.innerHTML = `<img class="rszene__img" src="${src}" alt="">`;
    }
  };
  const laden = async (el: HTMLElement) => {
    el.classList.add("rszene--angefordert");
    const offen = [...el.querySelectorAll<HTMLElement>("[data-rszene-datei]")].filter((p) => getComputedStyle(p).display !== "none");
    await Promise.all(offen.map(einsetzen));
    if (el.hasAttribute("data-geladen")) return;
    el.setAttribute("data-geladen", "");
    el.dispatchEvent(new CustomEvent("rszene:geladen"));
  };
  matchMedia("(min-width: 768px)").addEventListener("change", () =>
    document.querySelectorAll<HTMLElement>(".rszene--angefordert").forEach(laden)
  );
  const offen = document.querySelectorAll<HTMLElement>("[data-rszene]:not([data-geladen])");
  if (!("IntersectionObserver" in window)) offen.forEach(laden);
  else {
    const io = new IntersectionObserver(
      (eintraege) => {
        for (const e of eintraege) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          laden(e.target as HTMLElement);
        }
      },
      { rootMargin: "300px 0px" }
    );
    offen.forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  .rszene {
    position: relative;
    margin: 0 auto 32px;
    text-align: center;
  }
  .rszene__bild { max-width: 420px; margin-inline: auto; }
  /* SEO-/KI-Audit S6 (19.10.2026): Zeichnungen außerhalb des Bildschirms erst bei Bedarf
     aufbauen lassen – entlastet das Handy beim Laden (Aussehen unverändert).
     Platzhalter nur für die HÖHE: „contain-intrinsic-size: auto 480px“ galt auch für die
     Breite – im Raster (Einzugsgebiet) wurde die Spalte dadurch 480 px breit und die
     Seite war am Handy breiter als der Bildschirm (seitliches Wackeln). */
  .rszene { content-visibility: auto; contain-intrinsic-block-size: auto 480px; }
  .rszene__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .rszene__img { display: block; width: 100%; height: auto; }
  .rszene__svg text { font-family: var(--font-heading); stroke: none; }
  .rszene__svg--desktop { display: none; }
  @media (min-width: 768px) {
    .rszene__bild { max-width: 1000px; }
    .rszene__svg--mobil { display: none; }
    .rszene__svg--desktop { display: block; }
    .rszene { margin-bottom: 44px; }
  }

  .rs-s { stroke-dasharray: 1 1; }
  .rs-fl { stroke-dasharray: 0.06 0.035; }
  .rs-g--stempel { transform-box: fill-box; transform-origin: center; }

  /* Animation nur mit JS und ohne „Bewegung reduzieren" – sonst steht das fertige Bild */
  @media (prefers-reduced-motion: no-preference) {
    /* Texte erscheinen mit ihrer Station (Bug-Meldungen Jamil 19.10.2026 „Der Text steht immer
       noch da“): Beschriftungen (.rs-xb, Titel/Unterzeilen) blenden ein, sobald ihre Station
       gezeichnet wird; Texte in der Zeichnung („12h“, Schritt-Nummern, Ortsnamen) kurz nach ihrer
       Form. Gesamtdauer bleibt ca. 2 s (Audit 3.1). */
    html.js .rszene .rs-s,
    html.js .rszene .rs-f,
    html.js .rszene .rs-x { opacity: 0; }
    html.js .rszene.is-sichtbar .rs-x { animation: rs-ein 0.3s ease-out var(--t) both; }
    html.js .rszene.is-sichtbar .rs-x:not(.rs-xb) { animation-delay: calc(var(--t) + 0.15s); } /* kurz nach der eigenen Form */

    html.js .rszene.is-sichtbar .rs-s { animation: rs-zeichnen var(--d) ease-out var(--t) both; }
    html.js .rszene.is-sichtbar .rs-f { animation: rs-ein 0.25s ease-out var(--t) both; }
    html.js .rszene.is-sichtbar .rs-g--stempel { animation: rs-stempel 0.3s ease-out var(--t) both; }
    html.js .rszene.is-sichtbar .rs-g--puls { animation: rs-puls 2.4s ease-in-out calc(var(--ende) + 0.4s) 1 forwards; }
    /* Fertig gezeichnet: ruhiges Endbild ohne Animation (springt z. B. beim Drehen nicht neu an) */
    html.js .rszene.is-sichtbar.is-fertig :is(.rs-s, .rs-f, .rs-x, .rs-g) { animation: none; opacity: 1; }

    /* Dauerbewegung nach dem Zeichnen (Kundenwunsch 19.10.2026, Sprachnachricht Jamil):
       goldene Innenringe der Siegel drehen sich langsam, goldene Verbindungslinien im Ablauf
       „fließen“. Start, wenn die Szene fertig gezeichnet ist (--ende). Bei „Bewegung
       reduzieren“ greift diese Regel nicht (äußere Media-Query) → alles steht still. */
    html.js .rszene.is-sichtbar .rs-g--dreh,
    html.js .rszene.is-sichtbar.is-fertig .rs-g--dreh {
      transform-box: fill-box; transform-origin: center;
      animation: rs-dreh 14s linear var(--ende, 2s) infinite;
    }
    /* Verbindungslinien: gestrichelt von Anfang an, fließen schon während des Zeichnens */
    html.js .rszene.is-sichtbar .rs-fl,
    html.js .rszene.is-sichtbar.is-fertig .rs-fl { animation: rs-fluss 1.6s linear infinite; }
  }

  @keyframes rs-zeichnen {
    0% { stroke-dashoffset: 1; opacity: 0; }
    1% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes rs-ein { from { opacity: 0; } to { opacity: 1; } }
  @keyframes rs-stempel {
    0% { transform: scale(0.6); }
    60% { transform: scale(1.08); }
    100% { transform: scale(1); }
  }
  @keyframes rs-dreh { to { transform: rotate(360deg); } }
  /* Fließen: Linie bleibt sichtbar, ein gestrichelter Abschnitt wandert entlang (pathLength = 1) */
  @keyframes rs-fluss {
    0% { stroke-dasharray: 0.06 0.035; stroke-dashoffset: 0; }
    100% { stroke-dasharray: 0.06 0.035; stroke-dashoffset: -0.095; }
  }
  @keyframes rs-puls { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
</style>
