---
// Dunkles CTA-Band (Enpal-Muster): Wiederhol-CTA mit Trust-Punkten
// und Zweit-CTA zur Terminbuchung (Kundenfeedback 12.09.2026, Abschnitt 6).
import { CTA, u } from "../consts";
import { CTA_BAND } from "../data/home";
import Icon from "./Icon.astro";

interface Props {
  /** Überschreibt die Standard-Headline, z. B. auf Leistungsseiten. */
  pre?: string;
  accent?: string;
  ctaHref?: string;
  ctaLabel?: string;
  /** Ziel des Zweit-CTAs – Startseite nutzt den eigenen Anker #termin. */
  cta2Href?: string;
}
const {
  pre = CTA_BAND.pre,
  accent = CTA_BAND.accent,
  ctaHref = CTA.href,
  ctaLabel = CTA.label,
  cta2Href = u("kontakt/#termin"),
} = Astro.props;
---

<section class="section section--dark ctaband">
  <div class="container ctaband__inner">
    <h2>{pre}<span class="accent">{accent}</span></h2>
    <p class="ctaband__sub">{CTA_BAND.sub}</p>
    <p>{CTA_BAND.text}</p>
    <div class="ctaband__actions">
      <a class="btn btn--lg" href={ctaHref}>{ctaLabel}</a>
      <a class="btn btn--lg ctaband__ghost" href={cta2Href}>{CTA_BAND.cta2Label}</a>
    </div>
    <ul class="check-row ctaband__checks">
      {CTA_BAND.checks.map((c) => (
        <li><Icon name="check" size={18} class="icon" /> {c}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ctaband__inner { display: grid; justify-items: center; text-align: center; gap: 16px; }
  .ctaband__inner h2, .ctaband__inner p { margin: 0; }
  .ctaband__sub {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: var(--gold-300);
  }
  .ctaband__actions { display: flex; flex-wrap: wrap; gap: 12px 16px; justify-content: center; }
  .ctaband__ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--weiss);
    box-shadow: none;
  }
  .ctaband__ghost:hover { background: rgba(255, 255, 255, 0.12); border-color: var(--weiss); }
  .ctaband__checks { justify-content: center; margin-top: 8px; }
</style>
