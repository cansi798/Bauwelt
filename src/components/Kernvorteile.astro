---
// Kundenwunsch 19.10.2026 (Audit 5.1): gemeinsame Leiste mit den 4 Kernvorteilen –
// überall gleiche Namen (aus VERSPRECHEN, src/data/versprechen.ts). Steht direkt unter
// dem Hero der Leistungsseiten; die Seiten selbst zeigen nur noch max. 3 eigene Vorteile.
import Icon from "./Icon.astro";
import { KERNVORTEILE } from "../data/versprechen";

const ICONS: Record<string, string> = { festpreis: "euro", termin: "calendar", ansprechpartner: "user", antwort: "chat" };
---

<section class="kern" aria-label="Unsere Kernvorteile">
  <ul class="container kern__liste">
    {KERNVORTEILE.map((k) => (
      <li class="kern__item">
        <span class="kern__icon"><Icon name={ICONS[k.id] ?? k.icon} size={22} class="icon" /></span>
        <span class="kern__text">
          <strong>{k.title.replace("Deutschsprachiger", "Deutsch\u00ADsprachiger")}</strong>
          <small>{k.short}</small>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .kern {
    background: var(--weiss);
    border-bottom: 1px solid var(--anthrazit-100);
  }
  .kern__liste {
    list-style: none;
    margin: 0 auto;
    padding-block: 28px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .kern__item { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
  .kern__icon {
    flex: none;
    width: 44px; height: 44px;
    border-radius: 12px;
    background: var(--gold-100);
    color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .kern__text { display: grid; gap: 2px; min-width: 0; }
  .kern__text strong {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    color: var(--anthrazit-900);
  }
  .kern__text small { font-size: 14px; line-height: 1.45; color: var(--anthrazit-600); }

  @media (max-width: 1023px) {
    .kern__liste { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; padding-block: 24px; }
  }
  /* Handy: kompakt 2 × 2, nur die Namen (Erklärsätze ab Tablet) */
  @media (max-width: 479px) {
    .kern__liste { gap: 16px 12px; padding-block: 20px; }
    .kern__item { align-items: center; gap: 10px; }
    .kern__icon { width: 38px; height: 38px; border-radius: 10px; }
    .kern__text strong { font-size: 14px; hyphens: auto; }
    .kern__text small { display: none; }
  }
</style>
