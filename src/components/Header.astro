---
import { SITE, NAV, u } from "../consts";
import Icon from "./Icon.astro";
const { active } = Astro.props;
---
<header class="header" id="top">
  <div class="container header__inner">
    <a class="header__logo" href={u("")} aria-label="Bauwelt Handwerk – Startseite">
      <img src={u("assets/logo.png")} alt="Bauwelt Handwerk" width="220" height="56" />
    </a>
    <nav class="nav" aria-label="Hauptnavigation">
      {NAV.map((item) => (
        <a href={item.href} class={active === item.label ? "active" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header__actions">
      <a class="btn btn--primary btn--phone" href={`tel:${SITE.phoneTel}`}>
        <Icon name="phone" size={18} />{SITE.phoneDisplay}
      </a>
      <button class="burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
