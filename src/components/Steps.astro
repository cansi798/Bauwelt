---
interface Step { title: string; text: string; }
interface Props { steps: Step[]; }
const { steps } = Astro.props;
---
<div class="steps steps--line">
  {steps.map((s, i) => (
    <div class="step reveal">
      <div class="step__num">{i + 1}</div>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </div>
  ))}
</div>
