---
// Nummerierter Ablauf – Karten-Raster. Desktop: 4 Spalten, bei durch 3
// teilbarer Schrittzahl (z. B. 6 Schritte der Startseite) 3 Spalten.
// Hat ein Schritt eine Kurzzeile (`kurz`), wird sie sichtbar gezeigt und der
// volle Text liegt in einem nativen <details> („Mehr dazu") – bleibt damit im
// DOM und für Suchmaschinen indexierbar (gleiche Mechanik wie das FAQ).
import { STEPS } from "../data/home";

interface Props {
  /** Alternative Schritte, z. B. gewerkspezifisch auf Leistungsseiten. */
  steps?: { title: string; text: string; kurz?: string }[];
}
const { steps = STEPS } = Astro.props;
const cols = steps.length % 3 === 0 ? 3 : 4;
---

<ol class="steps" style={`--steps-cols: ${cols}`} data-cols={cols}>
  {steps.map((s, i) => (
    <li class="steps__item reveal">
      <span class="steps__num">{i + 1}</span>
      <h3>{s.title}</h3>
      {s.kurz ? (
        <>
          <p>{s.kurz}</p>
          <details class="steps__mehr">
            <summary>Mehr dazu</summary>
            <p>{s.text}</p>
          </details>
        </>
      ) : (
        <p>{s.text}</p>
      )}
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 20px;
    counter-reset: step;
  }
  /* Mobil: horizontaler Swipe (Scroll-Snap) statt langem Untereinander –
     die nächste Karte lugt rechts herein und lädt zum Wischen ein. */
  @media (max-width: 767px) {
    .steps {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 4px 4px 14px;
      margin-inline: -4px;
      scrollbar-width: none;
    }
    .steps::-webkit-scrollbar { display: none; }
    .steps__item {
      flex: 0 0 min(78vw, 320px);
      scroll-snap-align: center;
    }
  }
  @media (min-width: 768px)  { .steps { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(var(--steps-cols, 4), 1fr); } }

  .steps__item {
    position: relative;
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    padding: 28px 24px 24px;
    display: grid; gap: 8px; align-content: start;
  }
  .steps__item h3 { margin: 0; font-size: 17px; }
  .steps__item p { margin: 0; font-size: 15px; color: var(--anthrazit-700); }
  .steps__num {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--gold-500);
    color: var(--anthrazit-900);
    font-family: var(--font-heading); font-weight: 800; font-size: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 8px;
  }

  /* Verbindungslinie zwischen den Nummern (Desktop, nicht am Zeilenende) */
  @media (min-width: 1024px) {
    .steps__item::before {
      content: "";
      position: absolute;
      top: 50px; /* Mitte der Nummern-Kreise */
      left: calc(24px + 44px + 8px);
      right: -20px; /* über den Grid-Gap zur nächsten Karte */
      height: 2px;
      background: var(--gold-300);
    }
    .steps__item:last-child::before { display: none; }
    .steps[data-cols="3"] .steps__item:nth-child(3n)::before { display: none; }
    .steps[data-cols="4"] .steps__item:nth-child(4n)::before { display: none; }
  }

  /* „Mehr dazu"-Aufklapper (FAQ-Mechanik) */
  .steps__mehr summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex; align-items: center; gap: 6px;
    font-weight: 700; font-size: 14px;
    color: var(--gold-700);
  }
  .steps__mehr summary::-webkit-details-marker { display: none; }
  .steps__mehr summary::after {
    content: "";
    width: 8px; height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 200ms ease;
  }
  .steps__mehr[open] summary::after { transform: rotate(225deg) translateY(-2px); }
  .steps__mehr > p { margin-top: 8px; }
</style>
