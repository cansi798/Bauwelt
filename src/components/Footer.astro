---
// Mehrspaltiger Footer (Enpal-Muster): 4 Spalten + Copyright.
// CTA-Zeile „Ihr Projekt, ein Ansprechpartner, ein Festpreis." entfernt (Kundenfeedback 30.09.2026).
// Oben der dunkle Kontakt-Kopf „So sollte Handwerk sein." (Kundenwunsch 10.10.2026).
// Kundenwunsch 10.10.2026 (Screenshot): Footer kompakter – Kontaktwege unten raus
// (stehen im Kopf darüber), Logo kleiner nach oben rechts, weniger Abstände.
import { LEISTUNGEN, SITE, u } from "../consts";
import FooterKontakt from "./FooterKontakt.astro";

interface Props {
  /** Nur Navigation: ohne Kontakt-Kopf („So sollte Handwerk sein“, Buttons, Öffnungszeiten).
   *  Karriere & Partner (Kundenwunsch 11.10.2026 (10)). */
  nurNav?: boolean;
}
const { nurNav = false } = Astro.props;

// Kundenwunsch 16.10.2026 (73): im Footer die Unterschrift (= Leistungsname) – kompakter als die Überschrift
const leistungen = LEISTUNGEN.map((l) => ({ label: l.unterschrift, href: u(`leistungen/${l.slug}/`) }));
const jahr = new Date().getFullYear();
---

<footer class:list={["ftr", { "ftr--nurnav": nurNav }]}>
  {!nurNav && <FooterKontakt />}
  <div class="container ftr__cols">
    <div>
      <h3 class="ftr__head">Leistungen</h3>
      <ul>
        {leistungen.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="ftr__head">Unternehmen</h3>
      <ul>
        <li><a href={u("ueber-uns/")}>Über uns</a></li>
        <li><a href={u("referenzen/")}>Referenzen</a></li>
        <li><a href={u("karriere/")}>Karriere</a></li>
        <li><a href={u("partner/")}>Partner</a></li>
      </ul>
    </div>
    <div>
      <h3 class="ftr__head">Kontakt</h3>
      <ul class="ftr__contact">
        <li>{SITE.legal}<br />{SITE.street}<br />{SITE.zip} {SITE.city}</li>
      </ul>
    </div>
    <div class="ftr__legal">
      <div>
        <h3 class="ftr__head">Rechtliches</h3>
        <ul>
          <li><a href={u("impressum/")}>Impressum</a></li>
          <li><a href={u("datenschutz/")}>Datenschutz</a></li>
        </ul>
      </div>
      <img class="ftr__logo" src={u("assets/logo-inverse.webp")} alt="" width="120" height="78" loading="lazy" />
    </div>
  </div>

  <div class="container ftr__bottom">
    <span>© {jahr} {SITE.legal}, {SITE.city}</span>
  </div>
</footer>

<style>
  .ftr { background: var(--anthrazit-800); color: var(--anthrazit-200); margin-top: 0; }
  /* :not(.btn) – sonst überschreibt die Linkfarbe den dunklen Button-Text (hell auf Gold) */
  .ftr a:not(.btn) { color: var(--anthrazit-200); }
  .ftr a:not(.btn):hover { color: var(--weiss); }
  /* Mobil: Links auf mindestens ~40px Tipphöhe bringen (Touchziel-Audit) */
  @media (max-width: 767px) {
    .ftr a { display: inline-block; padding-block: 8px; } /* Audit 1.9: ca. 44 px Tipphöhe */
    .ftr__contact a { display: inline-flex; }
    /* Kundenwunsch 10.10.2026: Stapel am Handy enger */
    .ftr__cols { gap: 20px; }
    .ftr__cols ul { gap: 0; }
  }

  .ftr__cols {
    display: grid; gap: 24px;
    padding-block: 32px 28px;
    /* Kundenwunsch 11.10.2026: Kopf und Spalten gleich anthrazit – feine Trennlinie wie unten */
    border-top: 1px solid var(--anthrazit-700);
  }
  .ftr--nurnav .ftr__cols { border-top: 0; padding-top: 40px; }
  @media (min-width: 768px)  { .ftr__cols { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .ftr__cols { grid-template-columns: repeat(4, 1fr); } }

  .ftr__head {
    font-size: 15px; letter-spacing: 0.08em;
    color: var(--gold-500);
    margin-bottom: 12px;
  }
  .ftr__cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 15px; }
  /* Logo oben rechts neben „Rechtliches", auf Höhe der Überschriften */
  .ftr__legal { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .ftr__logo { flex: none; height: auto; opacity: 0.9; }

  .ftr__bottom {
    padding-block: 14px;
    border-top: 1px solid var(--anthrazit-700);
    font-size: 13px; color: var(--anthrazit-400);
  }
</style>
