---
// Vollbild-Menü (<1024px): aufklappbare Gruppen via <details>, scrollbar,
// iOS-Safe-Area (Lektion: Inhalt war auf kleinen Handys nicht erreichbar).
// Kundenwunsch 12.10.2026 (14): unten keine Buttons (Projekt berechnen, Telefon,
// WhatsApp) – Telefon/WhatsApp bleiben als Symbole im Header.
// (15): Zeile mit Öffnungszeiten/Reaktionszeit bleibt aber erhalten.
// Kundenwunsch 19.10.2026 (Audit 1.6, ersetzt (14)): „Leistungen“ ist gleich aufgeklappt,
// darunter „Projekt berechnen“, „Vor-Ort-Termin buchen“ und die Telefonnummer.
import { CTA, NAV2, SITE, TERMIN } from "../consts";
import Icon from "./Icon.astro";
---

<div class="mm" id="mobileMenu">
  <nav aria-label="Mobile Navigation">
    <ul class="mm__list">
      {NAV2.map((item) =>
        item.children ? (
          <li>
            <details class="mm__group" open={item.label === "Leistungen"}>
              <summary>
                {item.label}
                <Icon name="chevron" size={18} class="icon mm__chev" />
              </summary>
              <ul class="mm__sub">
                {item.children.map((c, i) => (
                  <li class:list={{ "mm__trenner": c.hervorheben && !item.children![i - 1]?.hervorheben }}>
                    {/* Kundenwunsch 16.10.2026 (73): wie am Desktop – fett Überschrift, grau Unterschrift,
                        hervorgehobene Einträge gold unter Trennlinie */}
                    <a class:list={{ "mm__hervor": c.hervorheben }} href={c.href}>
                      {c.icon && <Icon name={c.icon} size={20} class="icon mm__icon" />}
                      <span class="mm__text">
                        <strong>{c.label}</strong>
                        {c.desc && <small>{c.desc}</small>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        ) : (
          <li><a class="mm__top" href={item.href}>{item.label}</a></li>
        )
      )}
    </ul>
  </nav>

  <div class="mm__ctas">
    <a class="btn btn--lg" href={CTA.href}>{CTA.label}</a>
    <a class="btn btn--lg btn--ghost" href={TERMIN.href} target="_blank" rel="noopener" data-termin>
      <Icon name="calendar" size={20} class="icon" /> {TERMIN.kurz}
    </a>
    <a class="btn btn--lg btn--ghost mm__tel" href={`tel:${SITE.phoneTel}`}><Icon name="phone" size={18} class="icon" /> {SITE.phoneDisplay}</a>
  </div>

  <div class="mm__footer">
    <p class="small">{SITE.hours} · Antwort innerhalb von 12 Stunden (werktags)</p>
  </div>
</div>

<style>
  .mm {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 99;
    background: var(--weiss);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 24px 20px calc(32px + env(safe-area-inset-bottom));
    display: none;
    flex-direction: column;
    gap: 24px;
  }
  .mm.open { display: flex; }
  @media (min-width: 1024px) { .mm.open { display: none; } }

  .mm__ctas { display: grid; gap: 10px; }
  .mm__ctas .btn { width: 100%; justify-content: center; min-height: 52px; }
  .mm__tel :global(.icon) { color: var(--gold-700); }
  .mm__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .mm__top, .mm__group summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 8px;
    font-family: var(--font-heading); font-weight: 700; font-size: 18px;
    color: var(--anthrazit-800);
    text-decoration: none;
    border-bottom: 1px solid var(--linie);
    cursor: pointer;
    list-style: none;
  }
  .mm__group summary::-webkit-details-marker { display: none; }
  .mm__group summary :global(.mm__chev) { transition: transform var(--transition); }
  .mm__group[open] summary :global(.mm__chev) { transform: rotate(180deg); }
  .mm__sub { list-style: none; margin: 0; padding: 8px 0 8px 8px; display: grid; gap: 2px; }
  .mm__sub a {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 8px;
    color: var(--anthrazit-700);
    text-decoration: none;
    border-radius: var(--radius-md);
  }
  .mm__sub a:active { background: var(--gold-100); }
  .mm__sub a :global(.mm__icon) { color: var(--gold-700); flex: none; }
  .mm__text { display: grid; gap: 2px; line-height: 1.3; }
  .mm__text strong { font-weight: 600; color: var(--anthrazit-800); }
  .mm__text small { font-size: 13.5px; color: var(--anthrazit-600); }
  .mm__hervor .mm__text strong { color: var(--gold-700); }
  .mm__trenner { border-top: 1px solid var(--linie); margin-top: 6px; padding-top: 6px; }


  .mm__footer { margin-top: auto; }
  .mm__footer .small { text-align: center; margin: 0; }
</style>
