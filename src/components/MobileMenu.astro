---
import { SITE, NAV, u, waLink } from "../consts";
import Icon from "./Icon.astro";
---
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <div class="mobile-menu__top">
    <img src={u("assets/logo-inverse.png")} alt="Bauwelt Handwerk" />
    <button class="mobile-menu__close" aria-label="Menü schließen">&times;</button>
  </div>
  <nav aria-label="Mobile Navigation">
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={u("#kalkulator")}>Badpreis berechnen</a>
  </nav>
  <div class="mobile-menu__actions">
    <a class="btn btn--primary" href={`tel:${SITE.phoneTel}`}>
      <Icon name="phone" size={18} /> Anrufen
    </a>
    <a class="btn btn--on-dark" href={waLink()} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={18} /> WhatsApp
    </a>
  </div>
</div>
