---
// Kennzeichnung KI-generierter Bilder (Kundenwunsch 16.10.2026): kleine, dezente
// Plakette in einer Bildecke. Wird über istKiBild() in consts.ts automatisch gesetzt.
interface Props {
  /** Ecke: unten links (Standard, gerahmte Bilder) oder oben rechts (Vollbild-Heros). */
  pos?: "unten-links" | "oben-rechts";
}
const { pos = "unten-links" } = Astro.props;
---

<span class:list={["ki-hinweis", `ki-hinweis--${pos}`]}>KI-generiertes Bild</span>

<style>
  /* Kundenwunsch 16.10.2026 (73): Markierung deutlich dezenter („fällt noch zu sehr auf“) –
     kleiner, leichter, fast transparenter Hintergrund; Textschatten hält sie auf hellen
     und dunklen Bildern lesbar. Bleibt sichtbar (Transparenzpflicht Art. 50 KI-VO). */
  .ki-hinweis {
    position: absolute;
    z-index: 3;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.28);
    color: rgba(255, 255, 255, 0.92);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
    pointer-events: none;
    white-space: nowrap;
  }
  .ki-hinweis--unten-links { left: 8px; bottom: 8px; }
  .ki-hinweis--oben-rechts { right: 10px; top: 10px; }
</style>
