---
// Kennzeichnung KI-generierter Bilder (Kundenwunsch 16.10.2026): kleine, gut lesbare
// Plakette in einer Bildecke. Wird über istKiBild() in consts.ts automatisch gesetzt.
interface Props {
  /** Ecke: unten links (Standard, gerahmte Bilder) oder oben rechts (Vollbild-Heros). */
  pos?: "unten-links" | "oben-rechts";
}
const { pos = "unten-links" } = Astro.props;
---

<span class:list={["ki-hinweis", `ki-hinweis--${pos}`]}>KI-generiertes Bild</span>

<style>
  .ki-hinweis {
    position: absolute;
    z-index: 3;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(26, 26, 26, 0.68);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
    pointer-events: none;
    white-space: nowrap;
  }
  .ki-hinweis--unten-links { left: 10px; bottom: 10px; }
  .ki-hinweis--oben-rechts { right: 12px; top: 12px; }
</style>
