---
// "Unsere Versprechen" – sieben eigene Siegel als handgezeichnete Szene
// (Kundenfeedback 30.09.2026: Siegel-Karten + Erklär-Dialoge entfallen).
// Rechtlich: eigene Zusagen, klar als solche gekennzeichnet – keine fremden Prüfzeichen.
// Jamil 19.10.2026 (Talk 2538/2539/2541): Startseite UND Über uns zeigen genau dieselben
// 7 Versprechen (src/data/versprechen.ts) – keine Fakten-Siegel (15+ Jahre, regional) mehr dazwischen.
import SectionHead from "./SectionHead.astro";
import RoughSzene from "./RoughSzene.astro";
import { VERSPRECHEN } from "../data/versprechen";

interface Props {
  // Kundenwunsch 14.10.2026 (37): Über uns mit eigener Überschrift
  eyebrow?: string;
  pre?: string;
  accent?: string;
  /** Weißer statt Sand-Hintergrund (Über uns: Wechsel Sand/Weiß, Kundenwunsch 15.10.2026 (66)). */
  weiss?: boolean;
}
const {
  eyebrow = "Unsere Versprechen",
  pre = "Worauf Sie sich verlassen ",
  accent = "können",
  weiss = false,
} = Astro.props;
const label =
  `${VERSPRECHEN.length === 7 ? "Sieben" : VERSPRECHEN.length} gezeichnete Siegel werden nacheinander aufgestempelt: ` +
  VERSPRECHEN.map((v) => v.title).join(", ") + ".";
---

<section class:list={["section", { "section--sand": !weiss }]} id="versprechen" data-versprechen={VERSPRECHEN.map((v) => v.id).join(" ")}>
  <div class="container">
    <SectionHead
      center
      eyebrow={eyebrow}
      pre={pre}
      accent={accent}
      text="Sieben Grundsätze, nach denen wir mit Ihnen arbeiten möchten."
    />
    <RoughSzene szene="siegel" label={label} />
  </div>
</section>
