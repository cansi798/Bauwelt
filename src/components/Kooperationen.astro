---
// Kooperationen / Auftraggeber als Namens-Kacheln (Über uns + Partner).
// Kundenwunsch 14.10.2026 (37/39): Logos nur mit rechtlicher Freigabe der Unternehmen –
// bis dahin bewusst nur die Namen als Text.
import SectionHead from "./SectionHead.astro";

interface Props {
  eyebrow: string;
  pre: string;
  accent: string;
  text: string;
  /** Hintergrund Sand statt Weiß. */
  sand?: boolean;
}
const { eyebrow, pre, accent, text, sand = false } = Astro.props;

/** Derzeitige Kooperationen (Kundenfeedback 07.10.2026).
 *  Kundenwunsch 19.10.2026 (Audit 6.7): konkrete Angaben laut Jamil (Stand Oktober 2026) –
 *  OBI seit 2024 über 20 Aufträge, seniovo seit 2026 über 5 Aufträge, Hornbach seit 2026
 *  (erst 1 Auftrag → bewusst ohne Zahl). Logos weiterhin nur nach Freigabe. */
const KOOPERATIONEN = [
  { name: "OBI", info: "seit 2024 · über 20 Aufträge" },
  { name: "seniovo", info: "seit 2026 · über 5 Aufträge" },
  { name: "Hornbach", info: "seit 2026" },
];
---

<section class:list={["section", { "section--sand": sand }]}>
  <div class="container">
    <SectionHead center eyebrow={eyebrow} pre={pre} accent={accent} text={text} />
    <ul class="koop__liste">
      {KOOPERATIONEN.map((k) => (
        <li class="koop__name reveal">
          <span class="koop__label">Kooperationspartner</span>
          <span class="koop__wort">{k.name}</span>
          <span class="koop__strich" aria-hidden="true"></span>
          <span class="koop__info">{k.info}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Kundenwunsch 15.10.2026 (69): hochwertigere Partner-Kacheln – dunkel mit Gold statt schlichtem Weiß */
  .koop__liste {
    list-style: none; margin: 0 auto; padding: 0;
    display: grid; gap: 14px; max-width: 960px;
  }
  @media (min-width: 640px) { .koop__liste { grid-template-columns: repeat(3, 1fr); gap: 22px; } }
  .koop__name {
    position: relative; overflow: hidden;
    display: grid; justify-items: center; align-content: center; gap: 10px;
    min-height: 132px; padding: 22px 18px;
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, var(--anthrazit-800) 0%, var(--anthrazit-900, #1f1e20) 100%);
    border: 1px solid rgba(201, 169, 110, 0.35);
    box-shadow: 0 18px 40px -22px rgba(31, 30, 32, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }
  .koop__name::before {
    content: ""; position: absolute; inset: -40% -10% auto auto; width: 70%; height: 120%;
    background: radial-gradient(closest-side, rgba(201, 169, 110, 0.18), transparent);
    pointer-events: none;
  }
  .koop__name:hover { transform: translateY(-3px); border-color: var(--gold-500); box-shadow: 0 24px 48px -22px rgba(31, 30, 32, 0.7); }
  .koop__label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-300);
  }
  .koop__wort {
    font-family: var(--font-heading); font-weight: 800; font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: 0.04em; color: var(--weiss); /* Markennamen so, wie die Marken sie schreiben (z. B. „seniovo“, Jamil 19.10.2026) */
  }
  .koop__info { font-size: 14px; font-weight: 600; color: var(--anthrazit-200); }
  .koop__strich { width: 36px; height: 2px; border-radius: 2px; background: var(--gold-500); }
</style>
