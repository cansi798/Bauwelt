---
// Feste Leiste unten (mobil + Tablet), dauerhaft sichtbar – auch auf der
// Rechner-Seite (Kundenfeedback 07.10.2026). Zwei kompakte Buttons: Rechner +
// Besichtigungstermin (öffnet per `data-termin` das Buchungsfenster).
// Die doppelten Buttons im Seiteninhalt sind mobil ausgeblendet (`.nur-desktop`).
import { CTA, TERMIN } from "../consts";
---

<div class="sticky-bar">
  <a class="btn btn--sm sticky-bar__btn" href={CTA.href}>{CTA.label}</a>
  <a class="btn btn--sm btn--ghost sticky-bar__btn" href={TERMIN.href} target="_blank" rel="noopener" data-termin aria-label={TERMIN.label}>
    {TERMIN.kurz}
  </a>
</div>

<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 90;
    background: var(--weiss);
    border-top: 1px solid var(--linie);
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
    display: flex; gap: 8px; align-items: center;
    height: calc(var(--stickybar-h) + env(safe-area-inset-bottom));
  }
  .sticky-bar__btn {
    flex: 1 1 0; min-width: 0;
    padding: 9px 10px;
    font-size: 13px; line-height: 1.15;
    text-align: center; white-space: normal;
  }
  .sticky-bar__btn.btn--ghost { background: var(--weiss); }
  @media (min-width: 1024px) { .sticky-bar { display: none; } }
</style>
