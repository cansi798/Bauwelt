---
// Feste Leiste unten (mobil + Tablet), dauerhaft sichtbar – auch auf der
// Rechner-Seite (Kundenfeedback 07.10.2026). Zwei kompakte Buttons: Rechner +
// Vor-Ort-Termin (öffnet per `data-termin` das Buchungsfenster).
// Die doppelten Buttons im Seiteninhalt sind mobil ausgeblendet (`.nur-desktop`).
// Kundenwunsch 19.10.2026 (Audit 1.7): Buttons passend zur Seite (BaseLayout-Prop `sticky`),
// z. B. Karriere „Jetzt bewerben“ + WhatsApp, Partner „Zusammenarbeit anfragen“, Checks „… buchen“ + Anrufen.
import { CTA, TERMIN, type StickyKnopf } from "../consts";
interface Props {
  knoepfe?: StickyKnopf[];
}
const STANDARD: StickyKnopf[] = [
  { label: CTA.label, href: CTA.href },
  { label: TERMIN.kurz, href: TERMIN.href, extern: true, termin: true, ariaLabel: TERMIN.label },
];
const { knoepfe = STANDARD } = Astro.props;
---

<div class="sticky-bar">
  {knoepfe.map((k, i) => (
    <a
      class:list={["btn", "btn--sm", "sticky-bar__btn", { "btn--ghost": i > 0 }]}
      href={k.href}
      {...(k.extern ? { target: "_blank", rel: "noopener" } : {})}
      {...(k.termin ? { "data-termin": "" } : {})}
      aria-label={k.ariaLabel}
    >
      {k.label}
    </a>
  ))}
</div>

<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 90;
    background: var(--weiss);
    border-top: 1px solid var(--linie);
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
    display: flex; gap: 8px; align-items: center;
    height: calc(var(--stickybar-h) + env(safe-area-inset-bottom));
  }
  .sticky-bar__btn {
    flex: 1 1 0; min-width: 0;
    min-height: 48px; /* Audit 1.9: Tap-Ziel mind. 48 px */
    padding: 9px 10px;
    font-size: var(--btn-s-fs); line-height: 1.15; /* Größe S, Höhe 48 px (Audit 1.9/2.7) */
    text-align: center; white-space: normal;
  }
  .sticky-bar__btn.btn--ghost { background: var(--weiss); }
  @media (min-width: 1024px) { .sticky-bar { display: none; } }
</style>
