---
import { SITE, u } from "../consts";
import Icon from "./Icon.astro";
---
{/* Einbettung: hier den Kalender-Code des Buchungsanbieters (Calendly / Cal.com) einfügen.
    Beispiel: <iframe src="https://calendly.com/bauwelt-handwerk/beratung" width="100%" height="700" frameborder="0"></iframe> */}
<div class="booking-embed" id="bookingEmbed">
  <div class="booking-embed__inner">
    <Icon name="calendar" size={48} />
    <h3>Online-Terminbuchung folgt</h3>
    <p>Hier wird der Buchungskalender eingebettet. Bis dahin erreichen Sie uns telefonisch – wir finden gemeinsam einen Termin.</p>
    <div class="hero__actions" style="justify-content:center;margin-top:24px">
      <a class="btn btn--primary" href={`tel:${SITE.phoneTel}`}><Icon name="phone" size={18} /> {SITE.phoneDisplay}</a>
      <a class="btn btn--secondary" href={u("kontakt/")}>Rückruf anfragen</a>
    </div>
  </div>
</div>
