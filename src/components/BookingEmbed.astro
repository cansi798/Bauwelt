---
// Termin-Karte (Kontakt- und Rechnerseite). Seit 30.09.2026 ohne eigenen
// iframe: Der Button öffnet das globale Buchungsfenster (BookingDialog).
import { SITE, TERMIN, waLink } from "../consts";
import Icon from "./Icon.astro";
---

<div class="booking" id="bookingEmbed">
  <div class="booking__intro">
    <Icon name="calendar" size={48} class="icon booking__icon" />
    <h3>Termin online buchen</h3>
    <p>Wählen Sie direkt einen passenden Termin für Ihre kostenlose Besichtigung.</p>
    <ul class="check-row booking__chips">
      <li><Icon name="check" size={16} class="icon" /> Kostenlos</li>
      <li><Icon name="check" size={16} class="icon" /> Unverbindlich</li>
      <li><Icon name="clock" size={16} class="icon" /> Antwort in 12 h</li>
    </ul>
    <a class="btn" href={TERMIN.href} target="_blank" rel="noopener" data-termin>
      <Icon name="calendar" size={18} class="icon" /> Termin buchen
    </a>
    <p class="small">
      Lieber direkt? <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a> ·
      <a href={waLink()} target="_blank" rel="noopener">WhatsApp</a>
    </p>
  </div>
</div>

<style>
  .booking {
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 20px;
  }
  .booking__intro { display: grid; justify-items: center; text-align: center; gap: 12px; padding: 28px 12px; }
  .booking__intro h3, .booking__intro p { margin: 0; }
  .booking__intro :global(.booking__icon) { color: var(--gold-700); width: 48px; height: 48px; }
  .booking__chips { justify-content: center; }
</style>
