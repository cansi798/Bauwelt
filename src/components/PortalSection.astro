---
// Kundenportal-Sektion (Kundenfeedback 30.09.2026): Überschrift + Unterzeile
// und die handgezeichnete Portal-Szene in Endlosschleife – Kacheln und
// Portal-Demo-Ansicht entfallen auf allen Geräten.
import { PORTAL } from "../data/home";
import SectionHead from "./SectionHead.astro";
import RoughSzene from "./RoughSzene.astro";
---

<section class="section section--sand" id="kundenportal">
  <div class="container">
    <SectionHead
      center
      eyebrow="Kundenportal"
      pre="So behalten Sie Ihr Projekt jederzeit im "
      accent="Blick"
      text={PORTAL.sub}
    />
    <RoughSzene
      szene="portal"
      label="Gezeichnetes Handy mit dem Kundenportal: Projektfortschritt und Freigabe-Knopf, dazu vier Vorteile – alle Dokumente an einem Ort, alle Termine im Blick, Kommunikation per WhatsApp oder E-Mail und der aktuelle Projektstatus: immer wissen, was als Nächstes passiert."
    />
  </div>
</section>
