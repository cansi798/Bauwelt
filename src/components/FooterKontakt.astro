---
// Dunkler Footer-Kopf auf jeder Seite (Kundenwunsch 10.10.2026): Leitsatz
// „So sollte Handwerk sein." + Direktkontakt. Ersetzt das frühere CTA-Band und
// die Kontakt-Buttons in „Sprechen Sie mit uns".
import { SITE, EMAILS, TERMIN, waLink } from "../consts";
import { FOOTER_KONTAKT as F } from "../data/home";
import Icon from "./Icon.astro";
---

<section class="fkontakt" aria-labelledby="fkontakt-titel">
  <div class="container fkontakt__inner">
    <h2 id="fkontakt-titel">{F.pre}<span class="accent">{F.accent}</span></h2>
    <p class="fkontakt__sub">{F.sub}</p>
    <p class="fkontakt__text">{F.text}</p>

    <h3 class="fkontakt__head">{F.kontaktHead}</h3>
    <p class="fkontakt__text">{F.kontaktText}</p>
    <!-- Kundenwunsch 10.10.2026 (Sprachnachricht): Buttons etwas kleiner – normale
         Button-Größe statt btn--lg, kompakteres Polster, Icons 18 px, Reihe schmaler -->
    <div class="fkontakt__actions">
      <a class="btn" href={`tel:${SITE.phoneTel}`}>
        <Icon name="phone" size={18} class="icon" /> {SITE.phoneDisplay} anrufen
      </a>
      <a class="btn fkontakt__ghost" href={waLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} class="icon" /> Per WhatsApp schreiben
      </a>
      <!-- mobil steckt der Termin-Button in der festen Leiste unten -->
      <a class="btn fkontakt__ghost nur-desktop" href={TERMIN.href} target="_blank" rel="noopener" data-termin>
        <Icon name="calendar" size={18} class="icon" /> {TERMIN.label}
      </a>
      <!-- Kundenwunsch 10.10.2026: statt „E-Mail schreiben" die Adresse selbst anzeigen -->
      <a class="btn fkontakt__ghost fkontakt__mail" href={`mailto:${EMAILS.service}`}>
        <Icon name="mail" size={18} class="icon" /> {EMAILS.service}
      </a>
    </div>
    <p class="fkontakt__zeiten">{F.zeiten}</p>
  </div>
</section>

<style>
  .fkontakt {
    background: var(--anthrazit-900);
    color: var(--weiss);
    padding-block: 64px 56px;
  }
  .fkontakt__inner { display: grid; justify-items: center; text-align: center; gap: 14px; }
  .fkontakt__inner h2, .fkontakt__inner h3, .fkontakt__inner p { margin: 0; }
  .fkontakt h2 { color: var(--weiss); }
  .fkontakt__sub {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: var(--gold-300);
  }
  .fkontakt__text { color: var(--anthrazit-200); max-width: 46rem; }
  .fkontakt__head {
    margin-top: 28px !important;
    color: var(--weiss);
    font-size: 22px;
  }
  .fkontakt__actions {
    display: grid; gap: 12px;
    width: 100%; max-width: 20rem;
    margin-top: 8px;
  }
  @media (min-width: 1024px) {
    .fkontakt__actions { grid-template-columns: auto auto; justify-content: center; max-width: 46rem; }
    .fkontakt__actions .btn { white-space: nowrap; }
  }
  .fkontakt__actions .btn {
    justify-content: center;
    /* Kundenwunsch 10.10.2026: etwas kleiner, am Handy trotzdem ≥ 44 px hoch */
    padding: 11px 22px;
    font-size: 15px;
    gap: 8px;
  }
  /* Adresse darf nicht mitten im Wort umbrechen – am Handy minimal kleiner */
  .fkontakt__mail { white-space: nowrap; font-size: 14px; letter-spacing: -0.01em; }
  @media (min-width: 1024px) { .fkontakt__mail { font-size: 15px; } }
  .fkontakt__ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--weiss);
    box-shadow: none;
  }
  .fkontakt__ghost:hover { background: rgba(255, 255, 255, 0.12); border-color: var(--weiss); }
  .fkontakt__zeiten { color: var(--anthrazit-200); font-size: 15px; margin-top: 6px !important; }
</style>
