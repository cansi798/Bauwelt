---
// Leistungsseiten-Hero (Kundenwunsch 14.10.2026 (29)): Leistungsseite als eigenständige
// „Landingpage“, die man Kunden direkt schicken kann – Vollbild-Foto wie auf der
// Startseite, aber niedriger.
// Aufbau: H1 → Slogan → Claim (emotional) → Lead → CTAs → Vertrauens-Chips.
// Jamil 19.10.2026 (Talk 2529): Pfad „Leistungen › …“ entfernt – die allgemeine
// Leistungsübersicht gibt es nicht mehr, der Link führte ins Leere.
// CTAs nur ab Desktop (mobil übernimmt die feste Leiste unten, wie auf der Startseite).
// Jamil 20.10.2026 (Talk 2784): am PC füllt der Hero den ganzen ersten Bildschirm (wie die
// Startseite: 100svh minus Kopfzeile, mit Unter-/Obergrenze), Hintergrund = KI-Bild passend zur
// Leistung (ki-hero-<slug>-<breite>.avif/.webp, gekennzeichnet). Tablet/Handy: normale Höhe.
// Jamil 20./21.10.2026 (Talk 2878/2882): Leistungsname im Hero ganz WEISS (kein Gold-Wort mehr).
import { KI_HERO_BREITEN, TERMIN, istKiBild, kiHeroStamm, u } from "../consts";
import Icon from "./Icon.astro";
import KiHinweis from "./KiHinweis.astro";

interface Props {
  eyebrow: string;
  pre: string;
  accent?: string;
  /** Slogan der Leistung, klein unter dem Leistungsnamen (Kundenwunsch 19.10.2026, Audit 1.3) */
  slogan?: string;
  claim?: string;
  lead?: string;
  bild: string;           // Datei in assets/img/
  ctaHref: string;
  ctaLabel: string;
  /** Termin-Button zusätzlich anzeigen (bei Pauschal-Leistungen ist der Haupt-CTA schon die Buchung). */
  mitTermin?: boolean;
  /** Haupt-CTA auch mobil zeigen (Sicher wohnen: großer Button direkt im Hero). */
  ctaMobil?: boolean;
  chips: string[];
  /** Ruhiger Hinweis-Banner unter dem Text (Jamil 28.10.2026, Talk 3570), z. B. Pflegegrad bei der Badsanierung. */
  hinweis?: { text: string; link?: string; linkText?: string };
}
const { eyebrow, pre, accent = "", slogan, claim, lead, bild, ctaHref, ctaLabel, mitTermin = true, ctaMobil = false, chips, hinweis } = Astro.props;
// KI-Hero mit Varianten (828–2560 px, AVIF + WebP) → responsive srcset; sonst einzelnes Bild wie bisher
const stamm = kiHeroStamm(bild);
const set = (fmt: string) => stamm ? KI_HERO_BREITEN.map((w) => `${u(`assets/img/${stamm}-${w}.${fmt}`)} ${w}w`).join(", ") : undefined;
const imgSrc = stamm ? u(`assets/img/${stamm}-1920.webp`) : u(`assets/img/${bild}`);
---

<section class="lhero" data-einmal>
  <div class="lhero__bg" aria-hidden="true">
    <picture>
      {stamm && <source type="image/avif" srcset={set("avif")} sizes="100vw" />}
      <img
        src={imgSrc}
        srcset={set("webp")}
        sizes={stamm ? "100vw" : undefined}
        alt=""
        width={stamm ? 2560 : 1600}
        height={stamm ? 1440 : 900}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        onerror="this.remove()"
      />
    </picture>
    <div class="lhero__shade"></div>
  </div>
  {istKiBild(bild) && <KiHinweis pos="oben-rechts" />}

  <div class="container lhero__content">
    {/* Kundenwunsch 14.10.2026 (49): kleine Zeile über der H1 entfällt auf allen Leistungsseiten */}
    <h1 class="lhero__in" style="--d: 0ms">{pre}{accent}</h1>
    {slogan && <p class="lhero__slogan lhero__in" style="--d: 170ms">{slogan}</p>}

    {(claim || lead) && (
      <div class="lhero__text lhero__in" style="--d: 220ms">
        {claim && <p class="lhero__claim">{claim}</p>}
        {lead && <p class="lhero__lead">{lead}</p>}
      </div>
    )}

    {hinweis && (
      <p class="lhero__hinweis lhero__in" style="--d: 280ms">
        <Icon name="heim" size={20} class="icon" />
        <span>{hinweis.text}{hinweis.link && <> <a href={hinweis.link}>{hinweis.linkText ?? "Mehr erfahren"}</a></>}</span>
      </p>
    )}

    <div class:list={["lhero__actions", "lhero__in", { "nur-desktop": !ctaMobil }]} style="--d: 320ms">
      <a class="btn btn--lg" href={ctaHref}>{ctaLabel}</a>
      {mitTermin && (
        <a class="btn btn--lg lhero__ghost" href={TERMIN.href} target="_blank" rel="noopener" data-termin>{TERMIN.label}</a>
      )}
    </div>

    {chips.length > 0 && (
    <ul class="lhero__chips lhero__in" style="--d: 420ms">
        {chips.map((c) => (
          <li><Icon name="check" size={16} class="icon" /> {c}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .lhero {
    position: relative;
    min-height: min(70svh, 640px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--anthrazit-900); /* Fallback, falls das Bild fehlt */
  }
  /* Desktop (Jamil 20.10.2026, Talk 2784): ganzer erster Bildschirm wie die Startseite */
  @media (min-width: 1024px) {
    .lhero { min-height: clamp(600px, calc(100svh - var(--header-h)), 1080px); }
  }
  .lhero__bg { position: absolute; inset: 0; }
  .lhero__bg picture { display: block; width: 100%; height: 100%; }
  .lhero__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    /* Audit 3.6 (19.10.2026): kein Zoom mehr – er verstärkt die Unschärfe hochskalierter Fotos.
       Wieder einschalten, sobald scharfe Querformat-Fotos da sind:
       animation: lkenburns 24s ease-in-out 1 forwards; */
  }
  @keyframes lkenburns {
    from { transform: scale(1); }
    to   { transform: scale(1.07) translateX(-1.5%); }
  }
  .lhero__shade {
    position: absolute; inset: 0;
    background:
      /* Audit 7.4 (19.10.2026): dunkel nur links hinter dem Text, rechts fast frei.
         21.10.2026: die KI-Bilder sind sehr hell → links kräftiger, damit weiße Schrift ≥ 4,5:1 bleibt */
      linear-gradient(90deg, rgba(31, 30, 32, 0.86) 0%, rgba(31, 30, 32, 0.72) 48%, rgba(31, 30, 32, 0.12) 90%),
      linear-gradient(180deg, rgba(31, 30, 32, 0.2) 0%, rgba(31, 30, 32, 0) 35%, rgba(31, 30, 32, 0.35) 100%);
  }

  .lhero__content {
    position: relative;
    width: 100%; /* sonst schrumpft der Container im Flex-Hero und steht nicht bündig mit dem Inhalt darunter */
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    justify-items: start;
    padding-block: 64px 72px;
  }
  .lhero__content > * { max-width: 100%; min-width: 0; }
  .lhero__content h1 { color: var(--weiss); margin: 0; max-width: 19ch; hyphens: manual; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.25); }
  /* Prüfung 27.10.2026: KEIN „hyphens: none“ ab Tablet mehr – sonst brach am PC „BODENLEGERARBEITE|N“ mitten im
     Wort ohne Bindestrich. Weiche Trennstellen setzt [slug].astro nur in langen Wörtern (Boden­leger­arbeiten …);
     sie greifen nur, wenn das Wort nicht in die Zeile passt. */
  .lhero__content .eyebrow { color: var(--gold-300); margin: 0; }


  /* Slogan unter dem Leistungsnamen (Audit 1.3): klein, gold, nicht in Versalien */
  .lhero__slogan {
    margin: -4px 0 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.3;
    color: var(--gold-300);
  }
  .lhero__text { display: grid; gap: 10px; max-width: 620px; }
  .lhero__claim {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 2.3vw, 27px);
    line-height: 1.28;
    color: var(--weiss);
  }
  .lhero__lead { margin: 0; font-size: 16px; line-height: 1.6; color: var(--anthrazit-100); }

  /* Hinweis-Banner (Talk 3570): ruhig, Markenfarben, kein Störer */
  .lhero__hinweis {
    display: flex; align-items: flex-start; gap: 10px; max-width: 620px; margin: 4px 0 0;
    padding: 12px 16px; border-radius: 14px;
    background: rgba(31, 30, 32, 0.72); border: 1px solid var(--gold-500);
    font-size: 15px; line-height: 1.5; color: var(--weiss);
  }
  .lhero__hinweis :global(.icon) { flex: none; color: var(--gold-300); margin-top: 1px; }
  .lhero__hinweis a { color: var(--gold-300); font-weight: 700; text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }
  .lhero__content .lhero__hinweis { max-width: 680px; }
  @media (max-width: 767px) { .lhero__hinweis { font-size: 14px; padding: 10px 12px; } }
  .lhero__actions { display: flex; flex-wrap: wrap; gap: 14px 16px; margin-top: 12px; }
  .lhero__ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--weiss);
    box-shadow: none;
  }
  .lhero__ghost:hover { background: rgba(255, 255, 255, 0.12); border-color: var(--weiss); }

  .lhero__chips {
    list-style: none; margin: 8px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  .lhero__chips li {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px 7px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(6px);
    color: var(--weiss);
    font-size: 14px; font-weight: 600;
    white-space: nowrap;
  }
  .lhero__chips :global(.icon) { width: 16px; height: 16px; color: var(--gold-300); flex: none; }

  .lhero__in {
    animation: lrise var(--dur-reveal) var(--ease) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes lrise {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 767px) {
    .lhero { min-height: auto; }
    /* Handy: Text steht über die ganze Breite → gleichmäßig abdunkeln */
    .lhero__shade { background: linear-gradient(180deg, rgba(31, 30, 32, 0.72) 0%, rgba(31, 30, 32, 0.78) 100%); }
    .lhero__content { padding-block: 44px 40px; gap: 12px; }
    .lhero__lead { font-size: 15px; }
    .lhero__actions .btn { text-align: center; justify-content: center; } /* mehrzeilige Buttons mittig (Audit 4.1) */
    .lhero__chips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; width: 100%; }
    .lhero__chips li { font-size: 13px; padding: 7px 10px; white-space: normal; line-height: 1.25; border-radius: 12px; }
  }
</style>
