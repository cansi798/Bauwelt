---
// Erklärvideo-Kachel (nur mobil): generiertes WebM mit Musik. Klick auf die
// Kachel startet das Video MIT Ton (Nutzer-Geste). Dateien: assets/video/.
import { u } from "../consts";

interface Props {
  /** Dateiname ohne Endung, z. B. "weg" → weg.<ext> + weg-poster.jpg */
  name: string;
  titel: string;
  /** Dateiendung – generierte Videos sind webm, gelieferte z. B. mp4. */
  ext?: string;
  /** Sichtbare Überschrift über dem Video (mobil), damit das Thema klar ist. */
  ueberschrift?: string;
}
const { name, titel, ext = "webm", ueberschrift } = Astro.props;
---

<div class="vwrap">
  {ueberschrift && <h2 class="vkachel__titel">{ueberschrift}</h2>}
  <div class="vkachel" data-vkachel>
  <video
    preload="none"
    playsinline
    poster={u(`assets/video/${name}-poster.jpg`)}
    src={u(`assets/video/${name}.${ext}`)}
    aria-label={titel}
  ></video>
  <button class="vkachel__play" type="button" aria-label={`Video abspielen: ${titel}`}>
    <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.52.86l10.2-6.5a1 1 0 0 0 0-1.7L9.52 4.64A1 1 0 0 0 8 5.5Z"/></svg>
  </button>
  </div>
</div>

<style>
  .vwrap { display: none; }
  @media (max-width: 767px) {
    html.js .vwrap { display: block; }
  }
  .vkachel__titel {
    text-align: center;
    font-size: 22px;
    margin: 0 0 14px;
  }
  .vkachel__titel::after {
    content: "";
    display: block;
    width: 56px; height: 3px;
    background: var(--gold-500);
    margin: 12px auto 0;
  }
  @media (max-width: 767px) {
    html.js .vkachel {
      display: block;
      position: relative;
      margin: 0 auto 22px;
      max-width: 420px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      background: var(--anthrazit-900);
    }
  }
  .vkachel video { display: block; width: 100%; height: auto; }
  .vkachel__play {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    border: 0;
    background: rgba(31, 30, 32, 0.25);
    color: var(--anthrazit-900);
  }
  .vkachel__play svg {
    box-sizing: content-box;
    padding: 22px;
    background: var(--gold-500);
    border-radius: 50%;
    box-shadow: var(--shadow-lg);
  }
  .vkachel.spielt .vkachel__play { display: none; }
</style>
