---
import { u } from "../consts";
import Icon from "./Icon.astro";
// Markenkonformer Bild-Platzhalter. Liegt eine echte Datei unter assets/img/<img>,
// wird sie automatisch angezeigt (onerror entfernt sonst das <img>).
interface Props {
  prompt?: string;   // KI-Bildbeschreibung (wird als Label gezeigt)
  img?: string;      // Dateiname in assets/img/, z. B. "hero.jpg"
  alt?: string;
  imgClass?: string; // Klasse fürs <img> (z. B. "hero__img" / "tile__img")
  showKi?: boolean;  // KI-Badge + Prompt anzeigen (Galerie) statt nur Icon
}
const { prompt, img, alt = "", imgClass = "", showKi = true } = Astro.props;
---
<div class="ph" role="img" data-prompt={prompt} aria-label={alt || prompt}>
  <span class="ph__label">
    {showKi ? (
      <>
        <span class="ph__ki"><Icon name="image" size={14} /> KI-Bild</span>
        {prompt && <span class="ph__prompt">{prompt}</span>}
      </>
    ) : (
      <Icon name="image" size={40} />
    )}
  </span>
</div>
{img && (
  <img class={imgClass} src={u(`assets/img/${img}`)} alt={alt} loading="lazy" onerror="this.remove()" />
)}
