---
// Vollbild-Hero (Enpal-Muster), bewusst textarm: Eyebrow, Headline mit
// ROTIERENDEM Begriff (CSS-Wortwalze: „Ihr [neues Bad|Zuhause|…] zum Festpreis"),
// eine Kurzzeile, drei Häkchen, ein CTA. Bild füllt Mobil + Desktop den Viewport,
// Ken-Burns-Zoom + gestaffelte Entrance. Alles reines CSS: läuft ohne JS,
// prefers-reduced-motion zeigt den ersten Begriff statisch (global.css stoppt Rest).
import { CTA, u } from "../consts";
import { HERO } from "../data/home";
import { VERSPRECHEN } from "../data/versprechen";
import Icon from "./Icon.astro";

const badge = VERSPRECHEN[0]; // Festpreis-Garantie an Enpals Testsiegel-Position
const WORTE = HERO.begriffe;
// Für die nahtlose Schleife wird das erste Wort am Ende wiederholt.
const WALZE = [...WORTE, WORTE[0]];
---

<section class="fhero">
  <div class="fhero__bg" aria-hidden="true">
    <img
      src={u(`assets/img/${HERO.bild}`)}
      alt=""
      width="1600"
      height="900"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      onerror="this.remove()"
    />
    <div class="fhero__shade"></div>
  </div>

  <div class="container fhero__content">
    <div class="eyebrow fhero__in" style="--d: 0ms">{HERO.eyebrow}</div>

    <h1 class="fhero__in" style="--d: 120ms">
      <span class="visually-hidden">{HERO.vor} {WORTE[0]} {HERO.nach}</span>
      <span aria-hidden="true">
        {HERO.vor}
        <span class="fhero__walze">
          <span class="fhero__band" style={`--n: ${WORTE.length}`}>
            {WALZE.map((w) => <span class="fhero__wort accent">{w}</span>)}
          </span>
        </span>
        {HERO.nach}
      </span>
    </h1>

    <p class="lead fhero__in" style="--d: 240ms">{HERO.sub}</p>
    <ul class="check-row fhero__checks fhero__in" style="--d: 360ms">
      {HERO.checks.map((c) => (
        <li><Icon name="check" size={18} class="icon" /> {c}</li>
      ))}
    </ul>
    <div class="fhero__actions fhero__in" style="--d: 480ms">
      <a class="btn btn--lg" href={CTA.href}>{CTA.label}</a>
      <span class="fhero__note">Unverbindlich · Ergebnis in 1 Minute</span>
    </div>
  </div>

  <div class="fhero__badge fhero__in" style="--d: 640ms" title={badge.short}>
    <Icon name={badge.icon} size={26} class="icon" />
    <span>{badge.title}</span>
  </div>

  <a class="fhero__scroll" href="#trust" aria-label="Nach unten scrollen">
    <Icon name="chevron" size={26} class="icon" />
  </a>
</section>

<style>
  .fhero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--anthrazit-900); /* Fallback, falls das Bild fehlt */
  }

  .fhero__bg { position: absolute; inset: 0; }
  .fhero__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    animation: kenburns 22s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1) translateX(0); }
    to   { transform: scale(1.08) translateX(-1.5%); }
  }
  .fhero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(31, 30, 32, 0.82) 0%, rgba(31, 30, 32, 0.55) 45%, rgba(31, 30, 32, 0.18) 100%),
      linear-gradient(180deg, rgba(31, 30, 32, 0.25) 0%, rgba(31, 30, 32, 0) 30%, rgba(31, 30, 32, 0.45) 100%);
  }

  .fhero__content {
    position: relative;
    display: grid;
    gap: 20px;
    justify-items: start;
    padding-block: 96px 120px;
  }
  .fhero__content h1 { color: var(--weiss); margin: 0; }
  .fhero__content .lead { color: var(--anthrazit-100); margin: 0; }
  .fhero__content .eyebrow { color: var(--gold-300); margin: 0; }
  .fhero__checks li { color: var(--weiss); }
  .fhero__checks .icon { color: var(--gold-500); }
  .fhero__actions { display: grid; gap: 10px; justify-items: start; }
  .fhero__note { font-size: 14px; color: var(--anthrazit-200); }

  /* --- Wortwalze: Begriffe rollen vertikal durch die Headline --- */
  .fhero__walze {
    display: block;
    height: 1.15em;
    overflow: hidden;
  }
  .fhero__band {
    display: flex;
    flex-direction: column;
    /* n Begriffe à 3s: 2.4s halten, 0.6s rollen – letzter Frame = erster (nahtlos) */
    animation: walze calc(var(--n) * 3s) cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite;
  }
  .fhero__wort {
    display: block;
    height: 1.15em;
    line-height: 1.15;
    white-space: nowrap;
  }
  /* 5 Begriffe: Schritte bei 20/40/60/80%, jeweils 4% Roll-Zeit */
  @keyframes walze {
    0%, 16%   { transform: translateY(0); }
    20%, 36%  { transform: translateY(-1.15em); }
    40%, 56%  { transform: translateY(-2.3em); }
    60%, 76%  { transform: translateY(-3.45em); }
    80%, 96%  { transform: translateY(-4.6em); }
    100%      { transform: translateY(-5.75em); }
  }
  /* Reduced motion (global.css stoppt Animationen): erster Begriff steht still */
  @media (prefers-reduced-motion: reduce) {
    .fhero__band { transform: none; }
  }

  .fhero__badge {
    position: absolute; right: 24px; bottom: 88px;
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--weiss);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-lg);
    padding: 12px 20px;
    font-family: var(--font-heading); font-weight: 700; font-size: 14px;
    color: var(--anthrazit-800);
  }
  .fhero__badge .icon { color: var(--gold-700); animation: floaty 5s ease-in-out infinite; }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .fhero__scroll {
    position: absolute; left: 50%; bottom: 20px;
    width: 48px; height: 48px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--weiss);
    border-radius: 50%;
    animation: nudge 2.2s ease-in-out infinite;
  }
  @keyframes nudge {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.9; }
    50% { transform: translateX(-50%) translateY(8px); opacity: 0.5; }
  }

  .fhero__in {
    animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 767px) {
    .fhero { min-height: calc(100svh - var(--header-h-scrolled)); }
    .fhero__content { padding-block: 64px 96px; }
    .fhero__badge { right: 16px; top: 16px; bottom: auto; padding: 10px 16px; }
  }
</style>
