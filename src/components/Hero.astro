---
// Vollbild-Hero (Enpal-Muster): Eyebrow (Positionierung), Headline mit
// ROTIERENDEM Begriff (CSS-Wortwalze: „Bereit für Ihr neues [Badezimmer?|…]"),
// Kurzzeile, fünf Zusagen, zwei CTAs (Rechner + Besichtigungstermin).
// Bild füllt Mobil + Desktop den Viewport, Ken-Burns-Zoom + gestaffelte Entrance.
// Alles reines CSS: läuft ohne JS, prefers-reduced-motion zeigt den ersten
// Begriff statisch (global.css stoppt Rest).
import { CTA, u } from "../consts";
import { HERO } from "../data/home";
import { VERSPRECHEN } from "../data/versprechen";
import Icon from "./Icon.astro";

const badge = VERSPRECHEN[0]; // Festpreis-Garantie an Enpals Testsiegel-Position
const WORTE = HERO.begriffe;
// Für die nahtlose Schleife wird das erste Wort am Ende wiederholt.
const WALZE = [...WORTE, WORTE[0]];
---

<section class="fhero">
  <div class="fhero__bg" aria-hidden="true">
    <img
      src={u(`assets/img/${HERO.bild}`)}
      alt=""
      width="1600"
      height="900"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      onerror="this.remove()"
    />
    <div class="fhero__shade"></div>
  </div>

  <div class="container fhero__content">
    <div class="eyebrow fhero__in" style="--d: 0ms">
      <span class="fhero__eb-lang">{HERO.eyebrow}</span>
      <span class="fhero__eb-kurz">{HERO.eyebrowKurz}</span>
    </div>

    <h1 class="fhero__in" style="--d: 120ms">
      <span class="visually-hidden">{HERO.vor} {WORTE[0]} {HERO.nach}</span>
      <span aria-hidden="true">
        {HERO.vor}
        <span class="fhero__walze">
          <span class="fhero__band" style={`--n: ${WORTE.length}`}>
            {WALZE.map((w) => <span class="fhero__wort accent">{w}</span>)}
          </span>
        </span>
        {HERO.nach}
      </span>
    </h1>

    <p class="fhero__statement fhero__in" style="--d: 220ms">{HERO.statement}</p>
    <p class="lead fhero__in" style="--d: 280ms">{HERO.sub}</p>
    <!-- Zusagen als rotierende Zeile (nicht alles auf einmal); volle Liste bleibt
         unsichtbar im DOM – für Screenreader und Suchmaschinen. -->
    <div class="fhero__zusagen fhero__in" style="--d: 360ms">
      <ul class="visually-hidden">
        {HERO.checks.map((c) => <li>{c}</li>)}
      </ul>
      <div class="fhero__zwalze" aria-hidden="true">
        <div class="fhero__zband">
          {/* 2 Gruppen à 3 Zusagen + Klon der ersten für die nahtlose Schleife */}
          {[HERO.checksKurz.slice(0, 3), HERO.checksKurz.slice(3, 6), HERO.checksKurz.slice(0, 3)].map((gruppe) => (
            <div class="fhero__zgruppe">
              {gruppe.map((c) => (
                <span class="fhero__zitem"><Icon name="check" size={18} class="icon" /> {c}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="fhero__actions fhero__in" style="--d: 480ms">
      <div class="fhero__cta">
        <a class="btn btn--lg" href={CTA.href}>{CTA.label}</a>
        <span class="fhero__note">{HERO.note}</span>
      </div>
      <a class="btn btn--lg fhero__ghost" href={HERO.cta2.href}>{HERO.cta2.label}</a>
    </div>
  </div>

  <div class="fhero__badge fhero__in" style="--d: 640ms" title={badge.short}>
    <Icon name={badge.icon} size={26} class="icon" />
    <span>{badge.title}</span>
  </div>

  <a class="fhero__scroll" href="#weiter" aria-label="Nach unten scrollen">
    <Icon name="chevron" size={26} class="icon" />
  </a>
</section>

<style>
  .fhero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--anthrazit-900); /* Fallback, falls das Bild fehlt */
  }

  .fhero__bg { position: absolute; inset: 0; }
  .fhero__bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    animation: kenburns 22s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1) translateX(0); }
    to   { transform: scale(1.08) translateX(-1.5%); }
  }
  .fhero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(31, 30, 32, 0.82) 0%, rgba(31, 30, 32, 0.55) 45%, rgba(31, 30, 32, 0.18) 100%),
      linear-gradient(180deg, rgba(31, 30, 32, 0.25) 0%, rgba(31, 30, 32, 0) 30%, rgba(31, 30, 32, 0.45) 100%);
  }

  .fhero__content {
    position: relative;
    display: grid;
    /* minmax(0,1fr): Kinder mit intrinsischer Breite (Zusagen-Band) dürfen die
       Spalte NICHT über die Containerbreite aufspannen (Mobil-Beschnitt-Bug) */
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    justify-items: start;
    padding-block: 96px 120px;
  }
  .fhero__content > * { max-width: 100%; min-width: 0; }
  .fhero__zusagen { width: 100%; max-width: 340px; }
  .fhero__content h1 { color: var(--weiss); margin: 0; }
  .fhero__content .lead { color: var(--anthrazit-100); margin: 0; max-width: 62ch; }
  .fhero__content .eyebrow { color: var(--gold-300); margin: 0; }
  .fhero__statement {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: var(--weiss);
  }
  .fhero__statement + .lead { margin-top: -12px; }

  /* Zusagen: immer DREI sichtbar, die Dreiergruppe slidet von rechts nach links */
  .fhero__zwalze { width: 100%; overflow: hidden; }
  .fhero__zband {
    display: flex;
    animation: zslide 9s cubic-bezier(0.65, 0, 0.35, 1) 2s infinite;
  }
  .fhero__zgruppe {
    flex: none; width: 100%;
    display: grid; gap: 6px;
  }
  .fhero__zitem {
    display: inline-flex; align-items: center; gap: 10px;
    line-height: 1.5; white-space: nowrap;
    color: var(--weiss); font-weight: 600; font-size: 15px;
  }
  .fhero__zitem :global(.icon) { color: var(--gold-500); flex: none; }
  /* 2 Gruppen + Klon: halten, nach links rausschieben, halten, weiter (nahtlos) */
  @keyframes zslide {
    0%, 44%   { transform: translateX(0); }
    50%, 94%  { transform: translateX(-100%); }
    100%      { transform: translateX(-200%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fhero__zband { transform: none; }
  }

  .fhero__actions {
    display: flex; flex-wrap: wrap; gap: 14px 16px; align-items: flex-start;
  }
  .fhero__cta { display: grid; gap: 8px; justify-items: center; }
  .fhero__note { font-size: 14px; color: var(--anthrazit-200); }
  .fhero__ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.55);
    color: var(--weiss);
    box-shadow: none;
  }
  .fhero__ghost:hover { background: rgba(255, 255, 255, 0.12); border-color: var(--weiss); }

  /* --- Wortwalze: Begriffe rollen vertikal durch die Headline --- */
  .fhero__walze {
    display: block;
    height: 1.15em;
    overflow: hidden;
  }
  .fhero__band {
    display: flex;
    flex-direction: column;
    /* n Begriffe à 3s: 2.4s halten, 0.6s rollen – letzter Frame = erster (nahtlos) */
    animation: walze calc(var(--n) * 3s) cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite;
  }
  .fhero__wort {
    display: block;
    height: 1.15em;
    line-height: 1.15;
    white-space: nowrap;
  }
  /* 3 Begriffe: Schritte bei 33/67%, jeweils 4% Roll-Zeit (letzter Frame = erster) */
  @keyframes walze {
    0%, 29.33%     { transform: translateY(0); }
    33.33%, 62.67% { transform: translateY(-1.15em); }
    66.67%, 96%    { transform: translateY(-2.3em); }
    100%           { transform: translateY(-3.45em); }
  }
  /* Reduced motion (global.css stoppt Animationen): erster Begriff steht still */
  @media (prefers-reduced-motion: reduce) {
    .fhero__band { transform: none; }
  }

  .fhero__badge {
    position: absolute; right: 24px; bottom: 88px;
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--weiss);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-lg);
    padding: 12px 20px;
    font-family: var(--font-heading); font-weight: 700; font-size: 14px;
    color: var(--anthrazit-800);
  }
  .fhero__badge :global(.icon) { color: var(--gold-700); animation: floaty 5s ease-in-out infinite; }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .fhero__scroll {
    position: absolute; left: 50%; bottom: calc(20px + var(--stickybar-h, 0px));
    width: 48px; height: 48px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--weiss);
    border-radius: 50%;
    animation: nudge 2.2s ease-in-out infinite;
  }
  @keyframes nudge {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.9; }
    50% { transform: translateX(-50%) translateY(8px); opacity: 0.5; }
  }

  .fhero__in {
    animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: none; }
  }

  /* Eyebrow: Desktop voller Kundensatz, mobil Kurzfassung */
  .fhero__eb-kurz { display: none; }

  @media (max-width: 767px) {
    .fhero { min-height: calc(100svh - var(--header-h-scrolled)); }
    .fhero__content { padding-block: 40px 88px; gap: 14px; }
    /* Mobil entschlackt: kurze Positionierung, keine Unterzeile,
       Buttons direkt nach dem Statement, Zusagen darunter */
    .fhero__eb-lang { display: none; }
    .fhero__eb-kurz { display: inline; }
    .fhero__content .lead { display: none; }
    /* früher umbrechen, damit die Zeile nicht bis an die Kante läuft */
    .fhero__statement { max-width: 21ch; }
    .fhero__zitem { font-size: 13.5px; }
    .fhero__actions { display: grid; justify-items: stretch; width: 100%; }
    .fhero__actions .btn {
      width: 100%;
      white-space: normal;
      line-height: 1.3;
      padding: 14px 18px;
      text-align: center;
    }
    .fhero__cta { width: 100%; }
    /* Festpreis-Badge: lugt mobil periodisch sanft von rechts herein */
    .fhero__badge {
      right: 0; top: 16px; bottom: auto; padding: 10px 16px;
      border-radius: var(--radius-pill) 0 0 var(--radius-pill);
      animation: badge-peek 11s ease-in-out 2.5s infinite;
      transform: translateX(105%);
    }
  }
  @keyframes badge-peek {
    0%, 4%    { transform: translateX(105%); }
    10%, 55%  { transform: translateX(0); }
    62%, 100% { transform: translateX(105%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .fhero__badge { transform: none; }
  }
  @media (max-width: 767px) {
  }
</style>
