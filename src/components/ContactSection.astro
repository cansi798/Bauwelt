---
// Kontakt-Sektion: Ansprechpartner-Karten + Erreichbarkeit.
// Die Direktkontakt-Buttons stehen seit 10.10.2026 im Footer-Kopf auf jeder Seite (Kundenwunsch).
// Bewusst KEIN Formular (Kundenentscheidung).
import { SITE, u } from "../consts";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

// Fehlt ein Porträt (z. B. burim.webp) noch, gar nicht erst anfragen –
// sonst 404 in der Konsole. Das Personen-Symbol bleibt als Platzhalter.
const hatFoto = (datei: string) => existsSync(join(process.cwd(), "public/assets/img", datei));
---

<section class="section" id="kontakt">
  <div class="container contact__grid">
    <div>
      <SectionHead
        eyebrow="Kontakt"
        pre="Sprechen Sie mit "
        accent="uns"
        text="Kurze Frage, konkretes Projekt oder erst einmal unverbindlich beraten lassen – Sie erreichen uns direkt, ohne Warteschleife."
      />
      <div class="contact__persons">
        {SITE.contacts.map((c) => (
          <div class="contact__person">
            <span class="contact__photo">
              {hatFoto(c.photo) && (
                <img
                  src={u(`assets/img/${c.photo}`)}
                  alt={`Porträt ${c.name}`}
                  width="72" height="72"
                  loading="lazy"
                  onerror="this.remove()"
                />
              )}
              <Icon name="user" size={28} class="icon" />
            </span>
            <span>
              <strong>{c.name}</strong>
              <small>{c.role}</small>
            </span>
          </div>
        ))}
      </div>
      <p class="small">{SITE.hours} · Antwort innerhalb von 12 Stunden</p>
    </div>
  </div>
</section>

<style>
  .contact__grid { display: grid; gap: 40px; align-items: start; }

  .contact__persons { display: grid; gap: 16px; margin-bottom: 20px; }
  @media (min-width: 768px) { .contact__persons { grid-template-columns: repeat(2, max-content); gap: 16px 56px; } }
  .contact__person { display: flex; align-items: center; gap: 16px; }
  .contact__person span:last-child { display: grid; line-height: 1.4; }
  .contact__person small { color: var(--anthrazit-600); }
  .contact__photo {
    position: relative; flex: none;
    width: 72px; height: 72px;
    border-radius: 50%;
    background: var(--gold-100);
    color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
    overflow: hidden;
    border: 2px solid var(--gold-300);
  }
  .contact__photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }

</style>
