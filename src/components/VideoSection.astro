---
// Story-Sektion: Solange kein echtes Video existiert (VIDEO.url leer), läuft eine
// eigene animierte Zeichnungs-Szene (SVG + CSS): ein Haus zeichnet sich selbst,
// die Fenster leuchten warm auf, ein Herz steigt aus dem Schornstein – darunter
// die Einladung „Kommen Sie zu uns" mit Termin-CTA. Reines CSS: läuft ohne JS,
// prefers-reduced-motion stoppt alle Bewegungen.
// Sobald VIDEO.url gesetzt ist, ersetzt der klick-ladende Player die Szene (DSGVO:
// kein Third-Party-Request ohne Nutzeraktion).
import { VIDEO } from "../data/home";
import { CTA } from "../consts";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import Img from "./Img.astro";

const hasVideo = VIDEO.url.length > 0;
---

<section class="section story" id="so-arbeiten-wir">
  <div class="container">
    <SectionHead center eyebrow={VIDEO.eyebrow} pre={VIDEO.pre} accent={VIDEO.accent} text={VIDEO.text} />

    {hasVideo ? (
      <div class="story__frame reveal" data-video-url={VIDEO.url}>
        <Img src={VIDEO.poster} alt="Einblick in die Arbeit der Bauwelt Handwerk GmbH" w={1120} h={630} />
        <button class="story__play" type="button" aria-label="Video abspielen">
          <Icon name="play" size={32} class="icon" />
        </button>
      </div>
    ) : (
      <div class="story__frame story__scene reveal" role="img" aria-label="Animierte Zeichnung: Ein Haus entsteht, die Fenster leuchten auf – aus Baustelle wird Zuhause.">
        <svg viewBox="0 0 800 420" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <g class="sc-sun">
            <circle cx="672" cy="88" r="34" fill="var(--gold-300)" stroke="none" />
            <g stroke="var(--gold-500)" stroke-width="4">
              <path d="M672 34v-14M672 156v-14M726 88h14M604 88h14M712 48l10-10M622 138l10-10M712 128l10 10M622 38l10 10" />
            </g>
          </g>

          <path class="sc-draw" style="--len: 600; --dd: 0s" d="M100 356h600" stroke="var(--anthrazit-400)" stroke-width="4" />

          <g stroke="var(--anthrazit-800)" stroke-width="5">
            <path class="sc-draw" style="--len: 480; --dd: 0.3s" d="M240 356V216h320v140" />
            <path class="sc-draw" style="--len: 420; --dd: 1.0s" d="M216 226 400 96l184 130" />
            <path class="sc-draw" style="--len: 120; --dd: 1.6s" d="M488 150v-56h36v82" />
            <path class="sc-draw" style="--len: 180; --dd: 1.9s" d="M368 356v-84h64v84" />
          </g>

          <g stroke="var(--anthrazit-800)" stroke-width="4">
            <rect class="sc-glow" style="--gd: 2.6s" x="272" y="248" width="56" height="52" rx="4" fill="var(--gold-300)" />
            <rect class="sc-glow" style="--gd: 2.9s" x="472" y="248" width="56" height="52" rx="4" fill="var(--gold-300)" />
          </g>

          <g class="sc-roller">
            <rect x="0" y="0" width="46" height="26" rx="8" fill="var(--gold-500)" stroke="var(--anthrazit-800)" stroke-width="4" />
            <path d="M46 13h18v34" stroke="var(--anthrazit-800)" stroke-width="4" />
          </g>
          <path class="sc-paint" d="M260 328h280" stroke="var(--gold-300)" stroke-width="18" />

          <g fill="var(--anthrazit-200)" stroke="none">
            <circle class="sc-puff" style="--pd: 0s" cx="506" cy="80" r="8" />
            <circle class="sc-puff" style="--pd: 1.4s" cx="512" cy="80" r="6" />
            <circle class="sc-puff" style="--pd: 2.8s" cx="500" cy="80" r="5" />
          </g>
          <path
            class="sc-heart"
            d="M506 66c-5-9-18-8-20 2-2 8 8 15 20 24 12-9 22-16 20-24-2-10-15-11-20-2Z"
            fill="var(--fehler)"
            stroke="none"
          />
        </svg>
        <p class="story__caption">
          <span class="story__cap1">Wo andere eine Baustelle sehen …</span>
          <span class="story__cap2">… sehen wir Ihr neues Zuhause.</span>
        </p>
      </div>
    )}

    <div class="story__cta">
      <p class="story__invite">Kommen Sie zu uns – wir nehmen uns Zeit für Ihr Projekt.</p>
      <div class="story__buttons">
        <a class="btn btn--lg" href="#termin"><Icon name="calendar" size={20} class="icon" /> Jetzt Termin buchen</a>
        <a class="btn btn--ghost btn--lg" href={CTA.href}>{CTA.label}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .story__frame {
    position: relative;
    max-width: 960px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .story__scene {
    background: linear-gradient(180deg, var(--gold-100) 0%, var(--weiss) 100%);
    padding: 24px 16px 12px;
  }
  .story__scene svg { width: 100%; height: auto; display: block; }

  /* Selbstzeichnende Linien */
  .sc-draw {
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    animation: sc-draw 1.1s ease-out forwards;
    animation-delay: var(--dd, 0s);
  }
  @keyframes sc-draw { to { stroke-dashoffset: 0; } }

  /* Fenster leuchten auf und glimmen weiter */
  .sc-glow {
    opacity: 0;
    animation: sc-on 0.8s ease-out forwards, sc-glow 3.5s ease-in-out infinite;
    animation-delay: var(--gd, 2.5s), calc(var(--gd, 2.5s) + 0.8s);
  }
  @keyframes sc-on { to { opacity: 1; } }
  @keyframes sc-glow { 0%, 100% { fill: var(--gold-300); } 50% { fill: var(--gold-500); } }

  /* Farbrolle + Farbspur */
  .sc-roller { animation: sc-roll 3s ease-in-out 2.2s forwards; opacity: 0; transform: translate(240px, 315px); }
  @keyframes sc-roll {
    0% { opacity: 0; transform: translate(240px, 315px); }
    10% { opacity: 1; }
    90% { opacity: 1; transform: translate(510px, 315px); }
    100% { opacity: 0; transform: translate(510px, 315px); }
  }
  .sc-paint {
    stroke-dasharray: 280;
    stroke-dashoffset: 280;
    animation: sc-draw 2.4s ease-in-out 2.5s forwards;
  }

  /* Rauch-Puffs steigen dauerhaft */
  .sc-puff { opacity: 0; animation: sc-puff 4.2s ease-out infinite; animation-delay: calc(2.2s + var(--pd, 0s)); }
  @keyframes sc-puff {
    0% { opacity: 0; transform: translateY(0) scale(0.6); }
    15% { opacity: 0.9; }
    70% { opacity: 0.25; }
    100% { opacity: 0; transform: translateY(-46px) scale(1.5); }
  }

  /* Herz: erscheint und schwebt */
  .sc-heart {
    opacity: 0;
    transform-origin: 506px 80px;
    animation: sc-heart 5s ease-in-out 3.4s infinite;
  }
  @keyframes sc-heart {
    0% { opacity: 0; transform: translateY(6px) scale(0.5); }
    12% { opacity: 1; transform: translateY(-6px) scale(1); }
    60% { opacity: 1; transform: translateY(-26px) scale(1.05); }
    100% { opacity: 0; transform: translateY(-44px) scale(0.9); }
  }

  /* Bildunterschrift in zwei Schritten */
  .story__caption {
    display: grid; gap: 2px;
    text-align: center;
    margin: 4px 0 8px;
    font-family: var(--font-heading); font-weight: 600;
    color: var(--anthrazit-700);
  }
  .story__cap1, .story__cap2 { opacity: 0; animation: sc-on 0.9s ease-out forwards; }
  .story__cap1 { animation-delay: 1.2s; }
  .story__cap2 { animation-delay: 3.2s; color: var(--gold-700); }

  /* Reduced motion: Endzustand sofort, Bewegtes aus */
  @media (prefers-reduced-motion: reduce) {
    .sc-draw, .sc-paint { stroke-dashoffset: 0; }
    .sc-glow, .story__cap1, .story__cap2 { opacity: 1; }
    .sc-roller, .sc-puff, .sc-heart { display: none; }
  }

  .story__play {
    position: absolute; inset: 0; margin: auto;
    width: 84px; height: 84px;
    border-radius: 50%;
    border: 0;
    background: var(--gold-500);
    color: var(--anthrazit-900);
    display: flex; align-items: center; justify-content: center;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition), background var(--transition);
  }
  .story__play:hover { transform: scale(1.06); background: var(--gold-600); }
  .story__play :global(.icon) { margin-left: 4px; }
  .story__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .story__cta { display: grid; justify-items: center; gap: 14px; margin-top: 28px; text-align: center; }
  .story__invite { margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 18px; }
  .story__buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>

<script>
  // Nur relevant, sobald ein echtes Video eingetragen ist (VIDEO.url).
  const frame = document.querySelector<HTMLElement>(".story__frame[data-video-url]");
  const play = frame?.querySelector<HTMLButtonElement>(".story__play");
  play?.addEventListener("click", () => {
    const iframe = document.createElement("iframe");
    iframe.src = frame!.dataset.videoUrl!;
    iframe.allow = "autoplay; fullscreen; picture-in-picture";
    iframe.title = "Bauwelt Handwerk – Unternehmensvideo";
    frame!.append(iframe);
    play!.remove();
  });
</script>
