---
interface Stat { value: number; unit?: string; prefix?: string; label: string; }
interface Props { stats: Stat[]; }
const { stats } = Astro.props;
---
<div class="stats">
  {stats.map((s) => (
    <div class="stat">
      {/* Präfix (z. B. „+") steht als Geschwister VOR dem gezählten Wert, damit
          die Hochzähl-Animation es nicht bei jedem Frame überschreibt. */}
      <div class="stat__num">
        {s.prefix && <span class="stat__prefix">{s.prefix}</span>}
        <span data-count={s.value}>0{s.unit && <span class="unit">{s.unit}</span>}</span>
      </div>
      <div class="stat__label">{s.label}</div>
    </div>
  ))}
</div>
