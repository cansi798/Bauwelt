---
// Referenz-Slider: echte Bauwelt-Fotos (Auswahl aus der Leistungs-Galerie,
// Kundenfeedback 07.10.2026). Jede Karte führt zur passenden Gruppe auf /referenzen/.
// Kopf (Text + Strich) steht auf allen Geräten mittig, Pfeile darunter.
import { u } from "../consts";
import { GALERIE_HIGHLIGHTS } from "../data/galerie";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import Img from "./Img.astro";

interface Props {
  /** Überschreibt die Standard-Überschrift (Startseite: „Aus Ideen werden Ergebnisse"). */
  eyebrow?: string;
  pre?: string;
  accent?: string;
  text?: string;
}
const {
  eyebrow = "Referenzen",
  pre = "Ergebnisse, die man ",
  accent = "sieht",
  text,
} = Astro.props;
---

<section class="section" id="referenzen">
  <div class="container">
    <div class="refs__head">
      <SectionHead center eyebrow={eyebrow} pre={pre} accent={accent} text={text} />
      <div class="slider__nav">
        <button class="slider__btn" type="button" data-dir="-1" aria-label="Zurück">
          <Icon name="arrow-left" size={20} class="icon" />
        </button>
        <button class="slider__btn" type="button" data-dir="1" aria-label="Weiter">
          <Icon name="arrow" size={20} class="icon" />
        </button>
      </div>
    </div>

    <div class="slider">
      <div class="slider__track" data-slider>
        {GALERIE_HIGHLIGHTS.map((b) => (
          <a class="card refcard reveal" href={b.anker}>
            {/* Kundenwunsch 13.10.2026 (20): kein Gewerk/keine Beschreibung unter den Fotos */}
            <Img src={b.file} alt={b.alt} w={4} h={5} />
          </a>
        ))}
      </div>
    </div>

    <div class="text-center">
      <a class="btn btn--ghost" href={u("referenzen/")}>Alle Referenzen ansehen</a>
    </div>
  </div>
</section>

<style>
  .refs__head {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px; margin-bottom: 24px;
  }
  .refs__head :global(.section-head) { margin-bottom: 0; }
  .refcard {
    width: min(84vw, 420px); /* größer: Kundenwunsch 14.10.2026 (33) */
    padding: 12px;
    display: grid; gap: 0;
  }
</style>

<script>
  // Pfeil-Navigation: scrollt um eine Kartenbreite; Buttons deaktivieren an den Enden.
  for (const slider of document.querySelectorAll<HTMLElement>(".slider")) {
    const track = slider.querySelector<HTMLElement>("[data-slider]");
    const nav = slider.closest("section")?.querySelectorAll<HTMLButtonElement>(".slider__btn");
    if (!track || !nav?.length) continue;
    const step = () => (track.firstElementChild as HTMLElement)?.offsetWidth + 20 || 300;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 4;
      nav.forEach((b) => {
        const dir = Number(b.dataset.dir);
        b.disabled = dir < 0 ? track.scrollLeft <= 4 : track.scrollLeft >= max;
      });
    };
    nav.forEach((b) =>
      b.addEventListener("click", () =>
        track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: "smooth" })
      )
    );
    track.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
