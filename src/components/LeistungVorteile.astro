---
// Versprechen-Abschnitt der Leistungsseiten (dunkel).
// Jamil 21.10.2026 (Talk 2867): Der Kasten „Das Besondere bei …“ und das Projektfoto entfallen
// auf ALLEN Leistungsseiten (Desktop und Handy). Stattdessen stehen die 7 Versprechen allein und
// groß im Mittelpunkt – voll und hochwertig (die Variante vom 20.10., Commit 78bb3f8, war Jamil
// „zu leer, nicht flüssig“).
// Aufbau: Kopf „Unsere 7 Versprechen“ + eine Zeile, darunter ein Raster aus 7 Karten:
//   Desktop (≥ 1024 px) 4 Spalten – die Festpreis-Zusage als breite Hauptkarte (2 Spalten, mit dem
//   ausführlichen Text), dann 2 + 4 Karten → zwei volle Reihen ohne Lücken.
//   Tablet (640–1023 px) 2 Spalten, Festpreis über die volle Breite → vier volle Reihen.
//   Handy: kompakte Liste (Plakette links, Text rechts, feine Goldlinien), Festpreis mit Kurztext.
// Texte kommen nur aus src/data/versprechen.ts (keine neuen Aussagen). Plaketten mit Ziffern
// „1–7“ ohne führende Null im Skizzen-Stil (SkizzenKreis, Jamil 20.10., Talk 2692/2694), dazu je
// Karte eine handgezeichnete Goldlinie (rough.js nur beim Build). Alles zeichnet sich EINMAL,
// gestaffelt, sobald der Abschnitt sichtbar wird; „Bewegung reduzieren“/ohne JS = fertiges Bild.
// Karten sind nicht klickbar → kein Anheben beim Drüberfahren (Audit 3.5).
// Ausnahme Pauschal-Checks (Jamil 21.10.2026, Talk 2872): Sanierungscheck und Sicher wohnen behalten
// den Kasten „Das bringt Ihnen …“ mit ihren eigenen Vorteilen (Props `eigeneTitel` + `vorteile`) –
// über den Versprechen-Karten, Desktop drei Spalten, sonst untereinander. Kein Foto. Vorteile mit
// demselben Titel wie ein Versprechen fallen weg (jeder Vorteil nur einmal pro Seite).
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import SkizzenKreis from "./SkizzenKreis.astro";
import { VERSPRECHEN } from "../data/versprechen";
import { Zeichner } from "../lib/rough-szene";
import { ohneAkzent } from "../lib/akzent";

type Vorteil = { icon: string; title: string; text: string };

interface Props {
  eyebrow?: string;
  /** Nur Pauschal-Checks (Talk 2872): Überschrift des Kastens, z. B. „Das bringt Ihnen der Check“ */
  eigeneTitel?: string;
  /** Nur Pauschal-Checks (Talk 2872): eigene Vorteile des Checks im Kasten */
  vorteile?: Vorteil[];
  /** Eine Zeile unter der Überschrift. */
  lead?: string;
  /** Bestehender Button der Seite („Preis berechnen“ / „… buchen“), mittig unter den Karten.
   *  Bei Pauschal-Checks weglassen (Audit 5.7). */
  cta?: { href: string; label: string; extern?: boolean };
  /** Jamil 21.10.2026 (Talk 2893): Die 7 Versprechen stehen nicht mehr auf den Leistungsseiten.
   *  `false` = nur der Kasten der Pauschal-Checks, ohne Versprechen-Karten. */
  mitVersprechen?: boolean;
}
const {
  eyebrow = "Ihre Vorteile",
  lead = "Darauf können Sie sich verlassen – vom ersten Gespräch bis zur Übergabe.",
  eigeneTitel,
  vorteile = [],
  cta,
  mitVersprechen = true,
} = Astro.props;
const versprechenTitel = new Set(VERSPRECHEN.map((v) => v.title.toLowerCase()));
const eigene = eigeneTitel ? vorteile.filter((v) => !versprechenTitel.has(v.title.toLowerCase())) : [];

// Handgezeichnete Goldlinie je Karte (feste Seeds → jeder Build gleich, kleines SVG)
const n = (x: number) => Math.round(x * 100) / 100;
const goldlinie = (seed: number) => {
  const z = new Zeichner();
  z.linie(2, 5, 118, 4, { seed, strokeWidth: 1.6, roughness: 1.4, bowing: 2, stroke: "x" }, 0.5);
  return z.elemente
    .map((e) => (e.art === "strich" ? `<path class="skreis__s" pathLength="1" d="${e.d}" style="--t:${n(e.t)}s;--d:${n(e.dauer)}s"/>` : ""))
    .join("");
};
---

<section class="section section--dark lvort" aria-label={mitVersprechen ? "Unsere Versprechen" : ohneAkzent(eigeneTitel ?? "Ihre Vorteile")}>
  <div class="container">
    {mitVersprechen
      ? <SectionHead center eyebrow={eyebrow} pre={`Unsere ${VERSPRECHEN.length} `} accent="Versprechen" text={lead} />
      : <SectionHead center eyebrow="Ihre Vorteile" titel={eigeneTitel ?? "Ihre Vorteile"} /* *Akzent* möglich (Msg 2891) */ />}
    {eigene.length > 0 && (
      <div class="lvort__eigen reveal">
        {mitVersprechen && <p class="lvort__kicker">{ohneAkzent(eigeneTitel ?? "")}</p>}
        <ul class="lvort__eigenliste">
          {eigene.map((v) => (
            <li class="lvort__eigenpunkt">
              <span class="lvort__eigenicon"><Icon name={v.icon} size={24} class="icon" /></span>
              <div>
                <h3>{v.title}</h3>
                <p>{v.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
    {mitVersprechen && <ol class="lvort__raster" data-einmal>
      {VERSPRECHEN.map((v, i) => {
        const gross = i === 0;
        return (
          <li
            class:list={["lvort__karte", { "lvort__karte--gross": gross }]}
            data-versprechen={v.id}
            style={`--i:${i};--start:${i * 120 + 150}ms`}
          >
            <div class="lvort__kopf">
              <span class="lvort__nr" aria-hidden="true">
                <SkizzenKreis art="plakette" groesse={56} durchmesser={44} seed={31 + i * 5} />
                <span class="lvort__ziffer">{i + 1}</span>
              </span>
              <span class="lvort__symbol" aria-hidden="true"><Icon name={v.icon} size={gross ? 30 : 26} class="icon" /></span>
            </div>
            <svg class="lvort__linie" viewBox="0 0 120 9" preserveAspectRatio="none" fill="none" stroke-linecap="round" aria-hidden="true" focusable="false" set:html={goldlinie(301 + i * 7)} />
            <div class="lvort__text">
              <h3>{v.title}</h3>
              {gross ? (
                <>
                  <p class="lvort__lang">{v.long}</p>
                  <p class="lvort__kurz">{v.short}</p>
                </>
              ) : (
                <p>{v.short}</p>
              )}
            </div>
          </li>
        );
      })}
    </ol>}
    {mitVersprechen && cta && (
      <div class="lvort__cta nur-desktop">
        {cta.extern
          ? <a class="btn" href={cta.href} target="_blank" rel="noopener" data-termin>{cta.label}</a>
          : <a class="btn" href={cta.href}>{cta.label}</a>}
      </div>
    )}
  </div>
</section>

<style>
  /* ---------- Kasten „Das bringt Ihnen …“ (nur Pauschal-Checks, Talk 2872) – Optik wie bisher ---------- */
  .lvort__eigen {
    max-width: 1180px; margin: 8px auto 40px;
    padding: 32px 28px;
    border-radius: var(--radius-card, 16px);
    background: rgba(195, 165, 111, 0.08);
    border: 1px solid rgba(195, 165, 111, 0.35);
  }
  .lvort__kicker {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--gold-500) !important;
  }
  .lvort__eigenliste { list-style: none; margin: 0; padding: 0; display: grid; }
  .lvort__eigenpunkt { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 18px; padding-block: 22px; }
  .lvort__eigenpunkt:first-child { padding-top: 4px; }
  .lvort__eigenpunkt:last-child { padding-bottom: 0; }
  .lvort__eigenpunkt + .lvort__eigenpunkt { border-top: 1px solid rgba(195, 165, 111, 0.22); }
  .lvort__eigenicon {
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--gold-500); color: var(--anthrazit-900);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .lvort__eigenpunkt h3 {
    margin: 0 0 8px;
    font-size: 22px; line-height: 1.3; font-weight: 700; letter-spacing: 0; text-transform: none;
    color: var(--weiss); hyphens: manual; overflow-wrap: break-word;
  }
  .lvort__eigenpunkt p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--anthrazit-200); }
  @media (min-width: 1024px) {
    .lvort__eigen { padding: 34px 36px 36px; margin-bottom: 48px; }
    .lvort__eigenliste { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 0; }
    .lvort__eigenpunkt, .lvort__eigenpunkt:first-child, .lvort__eigenpunkt:last-child { padding: 4px 28px 0; }
    .lvort__eigenpunkt:first-child { padding-left: 0; }
    .lvort__eigenpunkt:last-child { padding-right: 0; }
    .lvort__eigenpunkt + .lvort__eigenpunkt { border-top: 0; border-left: 1px solid rgba(195, 165, 111, 0.22); }
  }
  @media (max-width: 639px) {
    .lvort__eigen { padding: 24px 20px; margin-bottom: 28px; }
    .lvort__eigenpunkt { grid-template-columns: 40px minmax(0, 1fr); gap: 14px; padding-block: 18px; }
    .lvort__eigenicon { width: 40px; height: 40px; }
    .lvort__eigenpunkt h3 { font-size: 19px; }
  }

  /* ---------- Raster ---------- */
  .lvort__raster {
    list-style: none; margin: 8px auto 0; padding: 0;
    display: grid; grid-template-columns: minmax(0, 1fr);
    max-width: 1180px;
  }
  @media (min-width: 640px) {
    .lvort__raster { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .lvort__karte--gross { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .lvort__raster { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
    .lvort__karte--gross { grid-column: span 2; }
  }

  /* ---------- Karte (dunkle Kartenart, Audit 2.1) ---------- */
  .lvort__karte {
    position: relative; min-width: 0;
    display: flex; flex-direction: column;
    padding: 18px 0 20px;
    border-top: 1px solid rgba(195, 165, 111, 0.22);
  }
  .lvort__karte:first-child { border-top: 0; }
  @media (min-width: 640px) {
    .lvort__karte {
      padding: 26px 26px 28px;
      border: 1px solid rgba(195, 165, 111, 0.26);
      border-radius: var(--radius-card, 16px);
      background: linear-gradient(160deg, rgba(195, 165, 111, 0.09), rgba(255, 255, 255, 0.02) 60%);
    }
    .lvort__karte:first-child { border-top: 1px solid rgba(195, 165, 111, 0.26); }
    /* Hauptkarte Festpreis: kräftigerer Goldrahmen und warmer Schimmer */
    .lvort__karte--gross {
      border-color: rgba(195, 165, 111, 0.55);
      background:
        radial-gradient(120% 140% at 100% 0%, rgba(195, 165, 111, 0.2), rgba(195, 165, 111, 0) 55%),
        linear-gradient(160deg, rgba(195, 165, 111, 0.12), rgba(255, 255, 255, 0.02) 70%);
    }
  }

  .lvort__kopf { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .lvort__nr { position: relative; flex: none; width: 56px; height: 56px; display: grid; place-items: center; }
  .lvort__nr :global(.skreis) { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Ziffer wie die Schritt-Nummern im Ablauf: dunkel auf goldener Plakette, ohne führende Null */
  .lvort__ziffer {
    position: relative;
    font-family: var(--font-heading); font-weight: 700; font-size: 20px; line-height: 1;
    color: var(--anthrazit-900); font-variant-numeric: tabular-nums;
  }
  .lvort__symbol { color: var(--gold-500); opacity: 0.8; display: inline-flex; }
  .lvort__karte--gross .lvort__symbol { opacity: 0.9; }

  /* handgezeichnete Goldlinie (zeichnet sich einmal, wie die Plakette) */
  .lvort__linie { display: block; width: 100%; height: 9px; margin: 18px 0 16px; overflow: visible; }
  .lvort__linie :global(.skreis__s) { stroke: rgba(195, 165, 111, 0.6); stroke-width: 1.6; }

  .lvort__text { min-width: 0; }
  .lvort__text h3 {
    margin: 0 0 8px;
    font-size: 18px; line-height: 1.3; font-weight: 700; letter-spacing: 0; text-transform: none;
    color: var(--weiss); hyphens: manual; overflow-wrap: break-word;
  }
  .lvort__text p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--anthrazit-200); }
  @media (min-width: 1024px) {
    .lvort__text h3 { font-size: 19px; }
    .lvort__text p { font-size: 16px; }
  }
  .lvort__karte--gross h3 { font-size: 24px; color: var(--gold-300, var(--gold-500)); }
  .lvort__karte--gross p { font-size: 16px; line-height: 1.65; max-width: 62ch; }
  .lvort__kurz { display: none; }

  .lvort__cta { display: flex; justify-content: center; margin-top: 44px; }

  /* ---------- Handy: kompakte Liste ---------- */
  @media (max-width: 639px) {
    .lvort__karte { display: grid; grid-template-columns: 48px minmax(0, 1fr); column-gap: 14px; align-items: start; }
    .lvort__kopf { grid-row: 1 / span 2; }
    .lvort__nr { width: 48px; height: 48px; }
    .lvort__ziffer { font-size: 17px; }
    .lvort__symbol, .lvort__linie { display: none; }
    .lvort__text { padding-top: 3px; }
    .lvort__text h3 { margin-bottom: 4px; }
    .lvort__karte--gross h3 { font-size: 19px; }
    .lvort__karte--gross p { font-size: 15px; line-height: 1.65; }
    .lvort__lang { display: none; }
    .lvort__kurz { display: block; }
  }

  /* ---------- Einmal beim ersten Sichtbarwerden (scripts/einmal-animieren.ts) ----------
     Karten blenden gestaffelt ein, Plakette und Goldlinie zeichnen sich von Hand, dann Ziffer + Text.
     Ohne JS / reduzierte Bewegung: fertiges Bild. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .lvort__karte { animation: lvort-hoch 0.6s var(--ease) both; animation-delay: var(--start); }
    :global(html.js) .lvort__linie { --start: calc(var(--i) * 120ms + 550ms); }
    :global(html.js) .lvort__ziffer { animation: lvort-ein 0.3s var(--ease) both; animation-delay: calc(var(--i) * 120ms + 500ms); }
    :global(html.js) .lvort__symbol { animation: lvort-ein 0.5s var(--ease) both; animation-delay: calc(var(--i) * 120ms + 600ms); }
  }
  @keyframes lvort-hoch { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes lvort-ein { from { opacity: 0; } }
</style>
