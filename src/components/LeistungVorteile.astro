---
// Jamil 19.10.2026 (Talk 2538/2539/2541): Auf den Leistungsseiten standen die Vorteile doppelt
// (weiße Leiste unter dem Hero + Karten „Ihre Vorteile“). Jetzt EIN Abschnitt im dunklen Design:
// links groß das, was diese Leistung besonders macht (eigene Vorteile aus dem Frontmatter),
// rechts die 7 Versprechen (gleiche Quelle wie Startseite/Über uns: src/data/versprechen.ts)
// als nummerierte Linie mit goldenen Ziffern. Eigene Darstellung – NICHT die Siegel der Startseite.
// Jamil 20.10.2026 (Talk 2702/2704/2711): Projektfoto entfällt komplett (auch am PC). Damit keine
// leere Fläche entsteht, gibt es keine zwei Spalten mehr: oben „Das Besondere bei …“ als breites,
// zentriertes Band (1 Vorteil: Symbol + Titel + Text nebeneinander; 2–3 Vorteile nebeneinander im Band),
// darunter die 7 Versprechen als ausgewogenes Raster (Desktop + Tablet 2 Spalten: 1–4 | 5–7),
// darunter mittig der vorhandene Button (nur Desktop, nicht bei Pauschal-Checks, 5.7).
// Handy: alles untereinander wie bisher. Keine neuen Texte – nur bestehende CTA-Beschriftungen.
// Bewegung: nur kreisförmig (Jamil Msg 2518/2523) – die goldenen Plaketten zeichnen sich EINMAL,
// danach erscheinen Ziffer/Titel/Text (nur Deckkraft). Bei „Bewegung reduzieren“ steht sofort alles.
// Jamil 20.10.2026 (Talk 2691/2692/2694): Ziffern im selben Skizzen-Stil wie die Ablauf-Zeichnung
// und die Siegel – handgezeichnete, gefüllte goldene Plakette (SkizzenKreis, rough.js beim Build),
// Zahlen ohne führende Null („1, 2, 3 …“ statt „01, 02 …“).
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import SkizzenKreis from "./SkizzenKreis.astro";
import { vorteileFuerSeite, type Vorteil } from "../data/versprechen";

interface Props {
  eyebrow?: string;
  pre: string;
  accent?: string;
  /** Überschrift über den eigenen Vorteilen, z. B. „Das Besondere an Ihrer Badsanierung“ */
  eigeneTitel: string;
  /** Eigene Vorteile der Leistung (warum-Liste); Doppelungen mit den Versprechen fallen weg. */
  vorteile: Vorteil[];
  /** Bestehender Button der Seite („Preis berechnen“ / „… buchen“), nur Desktop. */
  cta?: { href: string; label: string; extern?: boolean };
}
const { eyebrow = "Ihre Vorteile", pre, accent = "", eigeneTitel, vorteile, cta } = Astro.props;
const { eigene, zusagen } = vorteileFuerSeite(vorteile);
// Raster der Versprechen ab Tablet: zwei Spalten, spaltenweise gefüllt (1–4 links, 5–7 rechts)
const zeilen = Math.ceil(zusagen.length / 2);
---

<section class="section section--dark lvort" aria-label="Ihre Vorteile">
  <div class="container">
    <SectionHead center eyebrow={eyebrow} pre={pre} accent={accent} />
    <div class="lvort__inhalt">
      {eigene.length > 0 && (
        <div class:list={["lvort__eigen", eigene.length === 1 ? "lvort__eigen--eins" : "lvort__eigen--mehr", `lvort__eigen--n${eigene.length}`]} style={`--n:${eigene.length}`}>
          <p class="lvort__kicker">{eigeneTitel}</p>
          <ul class="lvort__eigenliste">
            {eigene.map((v) => (
              <li class="lvort__eigenpunkt">
                <span class="lvort__eigenicon"><Icon name={v.icon} size={24} class="icon" /></span>
                <div>
                  <h3>{v.title}</h3>
                  <p>{v.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class="lvort__zusagen" data-einmal>
        <p class="lvort__kicker">Unsere {zusagen.length} Versprechen</p>
        <ol class="lvort__liste" style={`--zeilen:${zeilen}`}>
          {zusagen.map((z, i) => (
            <li class:list={["lvort__punkt", { "lvort__punkt--spaltenende": i === zeilen - 1 }]} data-versprechen={z.id} style={`--i:${i};--start:${i * 140}ms`}>
              <span class="lvort__nr" aria-hidden="true">
                <SkizzenKreis art="plakette" groesse={56} durchmesser={44} seed={31 + i * 5} />
                <span class="lvort__ziffer">{i + 1}</span>
              </span>
              <div class="lvort__text">
                <h3>{z.title}</h3>
                <p>{z.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      {cta && (
        <div class="lvort__cta nur-desktop">
          {cta.extern
            ? <a class="btn" href={cta.href} target="_blank" rel="noopener" data-termin>{cta.label}</a>
            : <a class="btn" href={cta.href}>{cta.label}</a>}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Ein Strang statt zwei Spalten (Jamil 20.10., Talk 2711): Band oben, Versprechen-Raster, Button */
  .lvort__inhalt { display: grid; gap: 56px; max-width: 1120px; margin-inline: auto; min-width: 0; }
  .lvort__zusagen, .lvort__eigen { min-width: 0; }
  .lvort__cta { display: flex; justify-content: center; margin-top: -8px; }

  .lvort__kicker {
    margin: 0 0 20px; max-width: none;
    font-family: var(--font-heading);
    font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--gold-500) !important;
  }

  /* Band oben: das Besondere an dieser Leistung – breit, zentriert, goldener Rahmen */
  .lvort__eigen {
    padding: 32px 28px;
    border-radius: var(--radius-card, 16px);
    background: rgba(195, 165, 111, 0.08);
    border: 1px solid rgba(195, 165, 111, 0.35);
  }
  .lvort__eigenliste { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .lvort__eigenpunkt { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 18px; padding-block: 22px; min-width: 0; }
  .lvort__eigenpunkt:first-child { padding-top: 4px; }
  .lvort__eigenpunkt:last-child { padding-bottom: 0; }
  .lvort__eigenpunkt + .lvort__eigenpunkt { border-top: 1px solid rgba(195, 165, 111, 0.22); }
  .lvort__eigenicon {
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--gold-500); color: var(--anthrazit-900);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .lvort__eigenpunkt h3 {
    margin: 0 0 8px;
    font-size: 22px; line-height: 1.3; font-weight: 700; letter-spacing: 0; text-transform: none;
    color: var(--weiss);
  }
  .lvort__eigenpunkt p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--anthrazit-200); }

  /* Band ab Tablet: 1 Vorteil = Symbol + Titel + Text nebeneinander, mittig;
     2–3 Vorteile = nebeneinander im Band, feine goldene Trennlinien senkrecht */
  @media (min-width: 768px) {
    .lvort__kicker { text-align: center; }
    .lvort__eigen { padding: 36px 40px 40px; }
    .lvort__eigen--eins .lvort__eigenliste { max-width: 760px; margin-inline: auto; }
    .lvort__eigen--eins .lvort__eigenpunkt { grid-template-columns: 56px minmax(0, 1fr); gap: 24px; align-items: start; padding: 0; }
    .lvort__eigen--eins .lvort__eigenicon { width: 56px; height: 56px; }
  }
  /* nebeneinander: 2 Vorteile ab Tablet, 3 Vorteile erst ab Desktop (am Tablet sonst zu schmal) */
  @media (min-width: 768px) {
    .lvort__eigen--n2 .lvort__eigenliste { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lvort__eigen--n2 .lvort__eigenpunkt { grid-template-columns: minmax(0, 1fr); gap: 16px; align-content: start; padding: 0 28px; }
    .lvort__eigen--n2 .lvort__eigenpunkt:first-child { padding-left: 0; }
    .lvort__eigen--n2 .lvort__eigenpunkt:last-child { padding-right: 0; }
    .lvort__eigen--n2 .lvort__eigenpunkt + .lvort__eigenpunkt { border-top: 0; border-left: 1px solid rgba(195, 165, 111, 0.22); }
    .lvort__eigen--n2 .lvort__eigenpunkt h3 { font-size: 20px; }
  }
  @media (min-width: 1024px) {
    .lvort__eigen { padding: 40px 56px 44px; }
    .lvort__eigen--mehr .lvort__eigenliste { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
    .lvort__eigen--mehr .lvort__eigenpunkt { grid-template-columns: minmax(0, 1fr); gap: 16px; align-content: start; padding: 0 40px; }
    .lvort__eigen--mehr .lvort__eigenpunkt:first-child { padding-left: 0; }
    .lvort__eigen--mehr .lvort__eigenpunkt:last-child { padding-right: 0; }
    .lvort__eigen--mehr .lvort__eigenpunkt + .lvort__eigenpunkt { border-top: 0; border-left: 1px solid rgba(195, 165, 111, 0.22); }
    .lvort__eigen--mehr .lvort__eigenpunkt h3 { font-size: 20px; }
  }

  /* Die 7 Versprechen: Handy eine Linie, ab Tablet zwei Spalten (1–4 | 5–7) */
  .lvort__liste { list-style: none; margin: 0; padding: 0; display: grid; }
  @media (min-width: 768px) {
    .lvort__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(var(--zeilen), auto);
      grid-auto-flow: column;
      column-gap: 48px;
      max-width: 960px; margin-inline: auto;
    }
    .lvort__punkt--spaltenende { padding-bottom: 0; }
    .lvort__punkt--spaltenende::before { display: none; }
  }
  @media (min-width: 1024px) { .lvort__liste { column-gap: 80px; } }
  .lvort__punkt { position: relative; display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 20px; padding-bottom: 26px; min-width: 0; }
  .lvort__punkt:last-child { padding-bottom: 0; }
  /* feine goldene Verbindungslinie zwischen den Plaketten – gestrichelt wie die Wege im Ablauf */
  .lvort__punkt:not(:last-child)::before {
    content: ""; position: absolute; left: 27px; top: 58px; bottom: 2px;
    border-left: 2px dashed rgba(195, 165, 111, 0.4);
  }
  .lvort__nr { position: relative; width: 56px; height: 56px; display: grid; place-items: center; }
  .lvort__nr :global(.skreis) { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Ziffer wie die Schritt-Nummern im Ablauf: dunkel auf goldener Plakette, ohne führende Null */
  .lvort__ziffer {
    position: relative;
    font-family: var(--font-heading); font-weight: 700; font-size: 19px; line-height: 1;
    color: var(--anthrazit-900);
    font-variant-numeric: tabular-nums;
  }
  .lvort__text { padding-top: 6px; min-width: 0; }
  .lvort__text h3 {
    margin: 0 0 4px;
    font-size: 18px; line-height: 1.35; font-weight: 700; letter-spacing: 0; text-transform: none;
    color: var(--weiss);
  }
  .lvort__text p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--anthrazit-200); }

  /* Einmal beim ersten Sichtbarwerden (scripts/einmal-animieren.ts): Plakette zeichnet sich
     von Hand (SkizzenKreis), dann erscheinen Ziffer und Text. Ohne JS / reduzierte Bewegung: fertiges Bild. */
  :global(html.js) .lvort__ziffer { animation: lvort-ein 0.3s var(--ease) both; animation-delay: calc(var(--i) * 140ms + 350ms); }
  :global(html.js) .lvort__text { animation: lvort-ein 0.5s var(--ease) both; animation-delay: calc(var(--i) * 140ms + 250ms); }
  @keyframes lvort-ein { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .lvort__ziffer, .lvort__text { animation: none !important; opacity: 1; }
  }

  @media (max-width: 639px) {
    .lvort__inhalt { gap: 40px; }
    .lvort__eigen { padding: 24px 20px; }
    .lvort__eigenpunkt { grid-template-columns: 40px minmax(0, 1fr); gap: 14px; padding-block: 18px; }
    .lvort__eigenicon { width: 40px; height: 40px; }
    .lvort__eigenpunkt h3 { font-size: 19px; }
    .lvort__punkt { grid-template-columns: 48px minmax(0, 1fr); gap: 14px; padding-bottom: 22px; }
    .lvort__nr { width: 48px; height: 48px; }
    .lvort__punkt:not(:last-child)::before { left: 23px; top: 50px; }
    .lvort__ziffer { font-size: 17px; }
    .lvort__text { padding-top: 3px; }
  }
</style>
