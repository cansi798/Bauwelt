---
// Projekt-Rechner 3.2 – gemeinsame Komponente für /rechner/ und die Startseite.
// Enpal-Funnel-Mechanik: Ergebnis VOR Kontaktfrage. Immer „schnelle Schätzung"
// (Fläche per Slider + Ausstattungsniveau) – die Modus-Wahl „Genaue Angaben“ ist
// auf Kundenwunsch 11.10.2026 entfallen.
// WhatsApp/E-Mail bekommen einen klar formatierten Anfragetext (Fachbegriffe).
//
// variant="seite": bisheriger 3-Schritte-Funnel (Leistung → Umfang → Ergebnis).
// variant="start" (Kundenwunsch 11.10.2026): Leistungskarten (Icon, Titel, Nutzen,
//   „Mehr erfahren") SIND die Leistungsauswahl, daneben/darunter direkt der Rechner.
//   Badsanierung ist vorausgewählt und serverseitig vorgerendert (kein Layout-Sprung).
// Pauschal-Leistungen (Immobilien-Sanierungscheck, 595 € inkl. MwSt.): keine Rechenschritte, sondern
//   ein Festpreis-Panel mit Leistungsinhalt und Buchen/Anfragen. Preis + Inhalt kommen
//   aus der Content-Datei (pauschalpreis/umfang) – eine einzige Quelle.
// Ohne JavaScript: Hinweis + Direktkontaktwege (html.js-Gate); auf der Startseite
// bleiben die Karten mit ihren „Mehr erfahren"-Links sichtbar.
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";
import { GEWERKE, PAUSCHAL, MWST_HINWEIS } from "../data/rechner";
import { SITE, EMAILS, TERMIN, u, waLink } from "../consts";

interface Props {
  variant?: "seite" | "start";
  /** Vorauswahl einer Leistung (Leistungsseiten, Kundenwunsch 14.10.2026) */
  gewerk?: string;
}
const { variant = "seite", gewerk } = Astro.props;
const start = variant === "start";
const H = start ? "h3" : "h2";     // Schritt-Überschriften
const HSub = start ? "h4" : "h3";  // Zwischenüberschriften
const erstes = GEWERKE[0];
const euro = (n: number) => n.toLocaleString("de-DE");

// Pauschal-Leistungen mit Preis + Inhalt aus der jeweiligen Leistungs-Content-Datei
const PAUSCHAL_DATA = await Promise.all(
  PAUSCHAL.map(async (p) => {
    const e = await getEntry("leistungen", p.slug);
    if (!e?.data.pauschalpreis) throw new Error(`Pauschalpreis fehlt in content/leistungen/${p.slug}.md`);
    return { ...p, preis: e.data.pauschalpreis, enthalten: e.data.umfang, hinweis: e.data.pauschalHinweis };
  })
);
/** Alle Leistungskarten in Menü-Reihenfolge: erst die Rechner-Gewerke, dann Pauschal. */
const KARTEN: { slug: string; label: string; icon: string; nutzen: string; preis?: number }[] = [
  ...GEWERKE,
  ...PAUSCHAL_DATA,
];
// Weiche Trennstellen für lange Wörter in den schmalen Handy-Karten
// (Chrome trennt Deutsch sonst nicht zuverlässig → „Modernisierun|g").
// Weiche Trennstellen für lange Kartentitel (Handy: sonst Umbruch mitten im Wort ohne Bindestrich)
const weich = (t: string) =>
  t.replace("Bodenlegerarbeiten", "Boden\u00ADleger\u00ADarbeiten").replace("Modernisierung", "Moderni\u00ADsierung")
   .replace("Badsanierung", "Bad\u00ADsanierung").replace("Innenausbau", "Innen\u00ADausbau")
   .replace("Trockenbau", "Trocken\u00ADbau").replace("Sanierungscheck", "Sanierungs\u00ADcheck");

---

<!-- Ohne JS: ehrlicher Hinweis + Kontaktwege -->
<div class="rechner__nojs">
  <p>
    Der Online-Rechner benötigt JavaScript. Sie erreichen uns aber jederzeit direkt –
    wir nennen Ihnen gern am Telefon eine erste Einschätzung:
  </p>
  <div class="rechner__nojs-actions">
    <a class="btn" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
    <a class="btn btn--dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn btn--ghost" href={`mailto:${EMAILS.service}?subject=Projektanfrage`}>E-Mail schreiben</a>
  </div>
</div>

<!-- Einleitung: Kundenwunsch 13.10.2026 (22) – Einleitungstext, „Keine Kontaktdaten nötig“ und
     Ehrlichkeits-Hinweis zu EINEM Absatz im Stil des Einleitungstexts zusammengefasst. -->
<p class:list={["lead", "rintro", { "rintro--start": start }]}>
  {start
    ? "Wählen Sie Ihre Leistung und sehen Sie sofort, womit Sie rechnen können – unverbindlich und ohne Kontaktdaten."
    : "In einer Minute zur ersten Preisspanne – unverbindlich und ohne Kontaktdaten."}
  {" "}Unsere Preise liegen sehr nah am tatsächlichen Preis: keine Lockangebote, sondern realistische Werte ({MWST_HINWEIS.replace("Bruttopreise", "Bruttopreise")}).
</p>

<div
  class:list={["rechner__app", start ? "rechner__app--start" : "card"]}
  data-variant={variant}
  data-vorwahl={gewerk}
>
  {start ? (
    /* Leistungskarten = Leistungsauswahl (Toggle-Buttons) + Link zur Leistungsseite */
    <div class="rkarten" role="group" aria-label="Leistung für die Kalkulation wählen">
      {KARTEN.map((g, i) => (
        <div class:list={["rkarte", { selected: i === 0 }]}>
          <button
            type="button"
            class="rkarte__wahl"
            id={`rTab-${g.slug}`}
            data-gewerk={g.slug}
            aria-pressed={i === 0 ? "true" : "false"}
            aria-controls="rPanel"
          >
            <span class="rkarte__icon"><Icon name={g.icon} size={22} class="icon" /></span>
            <span class="rkarte__titel">{weich(g.label)}</span>
            <span class="rkarte__nutzen">
              {g.nutzen}
              {/* Kundenwunsch 13.10.2026 (23): Pauschalpreis nicht direkt auf der Karte zeigen (erst nach Klick) */}
            </span>
            <span class="rkarte__status" aria-hidden="true">
              <span class="rkarte__status-an"><Icon name="check" size={14} class="icon" /> Ausgewählt</span>
              <span class="rkarte__status-aus"><Icon name={g.preis ? "euro" : "calc"} size={14} class="icon" /> {g.preis ? "Festpreis ansehen" : "Preis berechnen"}</span>
            </span>
          </button>
          <a class="rkarte__mehr" href={u(`leistungen/${g.slug}/`)}>
            Mehr erfahren<span class="visually-hidden"> über {g.label}</span> <Icon name="arrow" size={16} class="icon" />
          </a>
        </div>
      ))}
    </div>
  ) : (
    <div class="rechner__progress" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1" aria-label="Schritt 1 von 3">
      <span class="rechner__bar" style="width: 33%"></span>
    </div>
  )}

  <div
    class:list={["rechner__panel", { card: start }]}
    id="rPanel"
    {...(start ? { role: "region", "aria-label": "Projekt-Kalkulation" } : {})}
  >
    {!start && (
      /* Schritt 1: Gewerk (nur Rechner-Seite – auf der Startseite übernehmen das die Karten) */
      <section class="rstep" data-step="1">
        <h2 class="rstep__title">Worum geht es?</h2>
        <div class="rechner__tiles">
          {KARTEN.map((g) => (
            <button class="rtile" type="button" data-gewerk={g.slug}>
              <Icon name={g.icon} size={30} class="icon" />
              <span>{g.label}</span>
            </button>
          ))}
        </div>
      </section>
    )}

    <!-- Schritt 2: Umfang – Fläche (Slider) + Ausstattungsniveau -->
    <section class="rstep" data-step="2" hidden={!start}>
      {start && <p class="rpanel__gewerk" id="rGewerkLabel">{erstes.label} berechnen</p>}
      <H class="rstep__title" id="rFrage">{start ? erstes.frage : "Wie groß ist Ihr Projekt?"}</H>

      <div class="rechner__range" id="rRange">
        <input
          type="range" id="rMenge" aria-labelledby="rFrage"
          min={start ? erstes.min : 3} max={start ? erstes.max : 30}
          step={start ? erstes.step : 1} value={start ? erstes.default : 8}
        />
        <output class="rechner__mengeout" id="rMengeOut" for="rMenge">{start ? `${erstes.default} ${erstes.unit}` : "8 m²"}</output>
      </div>

      <div
        class:list={["rechner__tiers", { "rechner__tiers--4": start && erstes.tiers.length === 4 }]}
        id="rTiers" role="radiogroup" aria-label="Ausstattungsniveau"
      >
        {start && erstes.tiers.map((t, i) => (
          <button type="button" class:list={["rtier", { selected: i === 0 }]} role="radio" aria-checked={i === 0 ? "true" : "false"} data-tier={t.id}>
            <strong>{t.label}</strong>{t.untertitel && <em class="rtier__sub">{t.untertitel}</em>}<small>{t.hint}</small>
          </button>
        ))}
      </div>
      {/* Kundenwunsch 13.10.2026 (21): kein Brutto-Hinweis mehr über „Preisspanne anzeigen“ (auf der Ergebnisseite bleibt er, PAngV) */}

      <div class="rnav">
        {!start && <button class="btn btn--ghost rnav__zurueck" type="button" id="rZurueck2">Zurück</button>}
        <button class="btn rechner__next" type="button" id="rWeiter">Preisspanne anzeigen</button>
      </div>
    </section>

    <!-- Schritt 3: Ergebnis – Preis + sauber gruppierte Auswahl + Kontaktwege -->
    <section class="rstep" data-step="3" hidden>
      <H class="rstep__title" id="rErgebnisTitel">Ihre erste Preisspanne</H>
      <p class="rechner__result" id="rErgebnis" role="status">–</p>
      <p class="rbrutto" id="rBrutto">{MWST_HINWEIS}</p>

      <div class="rwahl" id="rWahl" aria-label="Ihre Auswahl"></div>

      <button class="btn btn--ghost btn--sm" type="button" id="rAendern">
        Angaben ändern
      </button>
      <p class="small rechner__disclaimer">
        Unverbindliche Ersteinschätzung, inkl. Material und Arbeit – {MWST_HINWEIS.replace("Bruttopreise", "Bruttopreis")}
        Ihren <strong>Festpreis</strong> nennen wir Ihnen nach einem kostenlosen Vor-Ort-Termin.
      </p>
      <div class="rechner__contact">
        {start ? (
          <a class="btn btn--lg" href={TERMIN.href} target="_blank" rel="noopener" data-termin>
            <Icon name="calendar" size={20} class="icon" /> Kostenlosen Termin buchen
          </a>
        ) : (
          <a class="btn btn--lg" href="#termin">
            <Icon name="calendar" size={20} class="icon" /> Kostenlosen Termin buchen
          </a>
        )}
        <a class="btn btn--dark btn--lg" id="rWhatsapp" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} class="icon" /> Anfrage per WhatsApp senden
        </a>
        <a class="btn btn--ghost btn--lg" id="rMail" href={`mailto:${EMAILS.service}`}>
          <Icon name="mail" size={20} class="icon" /> Anfrage per E-Mail senden
        </a>
      </div>
    </section>

    {PAUSCHAL_DATA.map((p) => (
      /* Pauschal-Leistung: Festpreis statt Berechnung */
      <section class="rstep rpausch" data-step={`p-${p.slug}`} hidden>
        <p class="rpanel__gewerk">{p.label}</p>
        <H class="rstep__title">Ihr Festpreis</H>
        <p class="rechner__result">{euro(p.preis)} € <span class="rpausch__art">pauschal</span></p>
        <p class="rbrutto">{MWST_HINWEIS.replace("Bruttopreise", "Bruttopreis")}</p>
        <div class="rwahl">
          <div class="rwahl__gruppe">
            <HSub class="rwahl__titel">Das ist enthalten</HSub>
            <ul>{p.enthalten.map((e) => <li>{e}</li>)}</ul>
          </div>
        </div>
        <p class="small rechner__disclaimer">
          Keine Berechnung nötig: Der {p.label} kostet immer {euro(p.preis)} €.
          {p.hinweis && <strong class="rpausch__hinweis">{p.hinweis}</strong>}
          <a href={u(`leistungen/${p.slug}/`)}>Mehr zum {p.label}</a>
        </p>
        <div class="rechner__contact">
          <a class="btn btn--lg" href={TERMIN.href} target="_blank" rel="noopener" data-termin>
            <Icon name="calendar" size={20} class="icon" /> {p.label.replace("Immobilien-", "")} buchen
          </a>
          <a
            class="btn btn--dark btn--lg"
            href={waLink(`Hallo Bauwelt Handwerk! 👋\n\nIch interessiere mich für den ${p.label} (Pauschalpreis ${euro(p.preis)} €).\n\nBitte melden Sie sich bei mir für einen Termin. Vielen Dank! 🙏`)}
            target="_blank" rel="noopener"
          >
            <Icon name="whatsapp" size={20} class="icon" /> Anfrage per WhatsApp senden
          </a>
          <a
            class="btn btn--ghost btn--lg"
            href={`mailto:${EMAILS.service}?subject=${encodeURIComponent(`Anfrage: ${p.label}`)}&body=${encodeURIComponent(`Guten Tag,\n\nich interessiere mich für den ${p.label} (Pauschalpreis ${euro(p.preis)} €).\n\nAdresse der Immobilie:\nWunschtermin:\nName:\nTelefonnummer:\n`)}`}
          >
            <Icon name="mail" size={20} class="icon" /> Anfrage per E-Mail senden
          </a>
        </div>
        {!start && (
          <button class="btn btn--ghost btn--sm rpausch__zurueck" type="button" data-zurueck>Andere Leistung wählen</button>
        )}
      </section>
    ))}
  </div>
</div>

<style>
  html:not(.js) .rechner__app:not(.rechner__app--start),
  html:not(.js) .rechner__app--start .rechner__panel { display: none; }
  html.js .rechner__nojs { display: none; }

  /* Einleitungsabsatz über dem Rechner (ein Block, gleicher Stil wie der Lead-Text) */
  .rintro { max-width: 680px; margin: -8px auto 28px; text-align: center; }
  .rintro--start { margin-bottom: 32px; }
  .rbrutto { margin: -8px 0 14px; font-size: 13.5px; font-weight: 700; color: var(--anthrazit-700); }
  .rbrutto--klein { margin: -8px 0 16px; font-size: 12.5px; font-weight: 600; color: var(--anthrazit-600); }

  .rechner__nojs { text-align: center; display: grid; gap: 16px; justify-items: center; }
  .rechner__nojs-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .rechner__app--start ~ .rechner__nojs, .rechner__nojs + .rechner__app--start { margin-top: 24px; }

  .rechner__app {
    position: relative;
    padding: 28px 20px;
    /* Schrittwechsel: Anfang landet UNTER dem fixierten Header – alles sofort im Blick */
    scroll-margin-top: calc(var(--header-h) + 12px);
  }
  @media (min-width: 768px) { .rechner__app { padding: 40px; } }
  /* hidden-Attribut muss auch gegen display:grid/flex der Klassen gewinnen */
  .rechner__app [hidden] { display: none !important; }

  .rechner__progress {
    height: 6px; border-radius: var(--radius-pill);
    background: var(--anthrazit-100);
    overflow: hidden;
    margin-bottom: 28px;
  }
  .rechner__bar { display: block; height: 100%; background: var(--gold-500); transition: width 300ms ease; }

  .rstep__title { font-size: clamp(20px, 3vw, 26px); }

  .rechner__tiles { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  .rtile {
    display: grid; justify-items: center; gap: 10px;
    padding: 22px 12px;
    background: var(--weiss);
    border: 2px solid var(--linie);
    border-radius: var(--radius-lg);
    font-family: var(--font-heading); font-weight: 600; font-size: 14px;
    color: var(--anthrazit-800);
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }
  .rtile :global(.icon) { color: var(--gold-700); width: 30px; height: 30px; }
  .rtile:hover { border-color: var(--gold-500); transform: translateY(-2px); }
  .rtile.selected { border-color: var(--gold-500); background: var(--gold-100); }
  .rtile:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .rpausch__art { font-size: 0.5em; font-weight: 700; color: var(--anthrazit-600); }
  .rpausch__zurueck { margin-top: 18px; }
  .rpausch__hinweis { display: block; margin-top: 8px; color: var(--anthrazit-800); }
  .rpausch .rwahl { grid-template-columns: 1fr; }

  /* ---------- Startseite: Leistungskarten + Rechner-Panel ---------- */
  .rechner__app--start {
    padding: 0;
    display: grid; gap: 16px;
    grid-template-columns: minmax(0, 1fr);
    max-width: 1080px; margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .rechner__app--start { grid-template-columns: minmax(300px, 360px) minmax(0, 1fr); gap: 24px; align-items: start; }
  }
  .rkarten { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* ungerade Anzahl (5 Leistungen): letzte Karte über die volle Breite */
  .rkarte:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .rkarten { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    /* Kalkulation bleibt beim Durchsehen der Karten im Blick */
    .rechner__app--start .rechner__panel { position: sticky; top: calc(var(--header-h) + 16px); }
  }

  .rkarte {
    position: relative;
    display: grid; grid-template-rows: 1fr auto;
    background: var(--weiss);
    border: 2px solid var(--linie);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
  .rkarte:hover { border-color: var(--gold-500); box-shadow: var(--shadow); }
  /* Gewählt: goldener Rahmen + goldene Kante links (Hintergrund bleibt weiß –
     die Sektion selbst ist schon sandfarben) */
  .rkarte.selected {
    border-color: var(--gold-500);
    box-shadow: inset 5px 0 0 var(--gold-500), var(--shadow);
  }
  .rkarte__wahl {
    display: grid; align-content: start; gap: 6px;
    grid-template-columns: auto minmax(0, 1fr);
    padding: 14px 14px 4px;
    background: none; border: 0; border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    text-align: left; color: inherit; cursor: pointer;
  }
  .rkarte__icon {
    grid-row: span 1;
    width: 36px; height: 36px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 10px;
    background: var(--gold-500);
    color: var(--anthrazit-900);
  }
  .rkarte__titel {
    align-self: center;
    font-family: var(--font-heading); font-weight: 700; font-size: 14px; line-height: 1.25;
    color: var(--anthrazit-800);
    hyphens: auto; overflow-wrap: break-word;
  }
  .rkarte__nutzen, .rkarte__status { grid-column: 1 / -1; }
  .rkarte__preis {
    display: block; margin-top: 4px;
    font-family: var(--font-heading); font-size: 13px; color: var(--gold-700);
  }
  .rkarte__nutzen { font-size: 13px; line-height: 1.4; color: var(--anthrazit-700); overflow-wrap: break-word; hyphens: auto; }
  .rkarte__status {
    display: inline-flex; align-items: center;
    font-size: 12px; font-weight: 700; color: var(--anthrazit-600);
  }
  .rkarte__status > span { display: inline-flex; align-items: center; gap: 5px; }
  .rkarte__status-an { display: none !important; color: var(--gold-700); }
  .rkarte.selected .rkarte__status-an { display: inline-flex !important; }
  .rkarte.selected .rkarte__status-aus { display: none !important; }
  .rkarte__mehr {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 14px 12px;
    font-weight: 700; font-size: 13.5px;
    color: var(--gold-700);
    justify-self: start;
  }
  .rkarte__mehr:hover { text-decoration: underline; }
  @media (min-width: 1024px) {
    .rkarte__wahl { grid-template-columns: auto minmax(0, 1fr); column-gap: 12px; padding: 16px 16px 4px; }
    .rkarte__icon { width: 40px; height: 40px; }
    .rkarte__titel { font-size: 15px; }
    .rkarte__nutzen { font-size: 13.5px; }
    .rkarte__status { display: none; }
    /* Desktop: Pfeil zur Kalkulation rechts an der gewählten Karte */
    .rkarte.selected::after {
      content: ""; position: absolute; top: 50%; right: -13px;
      width: 20px; height: 20px; margin-top: -10px;
      background: var(--weiss);
      border-top: 2px solid var(--gold-500); border-right: 2px solid var(--gold-500);
      transform: rotate(45deg);
    }
  }
  .rechner__panel.card { padding: 24px 18px; scroll-margin-top: calc(var(--header-h) + 12px); }
  @media (min-width: 768px) { .rechner__panel.card { padding: 32px 36px; } }
  .rpanel__gewerk {
    margin: 0 0 4px;
    font-family: var(--font-heading); font-weight: 700; font-size: 12.5px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--gold-700);
  }
  .rechner__app--start .rstep__title { margin-top: 0; }


  .rechner__range { display: grid; gap: 8px; margin-block: 18px 20px; }
  .rechner__range input[type="range"] { width: 100%; accent-color: var(--gold-600); height: 32px; }
  .rechner__mengeout {
    font-family: var(--font-heading); font-weight: 800; font-size: 28px;
    text-align: center;
  }


  .rechner__tiers { display: grid; gap: 10px; margin-bottom: 20px; }
  @media (min-width: 768px) { .rechner__tiers { grid-template-columns: repeat(3, 1fr); } }
  .rechner__tiers :global(.rtier) {
    display: grid; gap: 4px; align-content: start;
    padding: 14px;
    border: 2px solid var(--linie);
    border-radius: var(--radius-md);
    background: var(--weiss);
    text-align: left;
    font-size: 14px;
    transition: border-color var(--transition), background var(--transition);
  }
  .rechner__tiers :global(.rtier strong) { font-family: var(--font-heading); }
  .rechner__tiers :global(.rtier__sub) { font-style: normal; font-size: 12.5px; font-weight: 700; color: var(--gold-700); }
  @media (min-width: 768px) { .rechner__tiers--4 { grid-template-columns: repeat(2, 1fr); } }
  .rechner__tiers :global(.rtier small) { color: var(--anthrazit-600); }
  .rechner__tiers :global(.rtier.selected) { border-color: var(--gold-500); background: var(--gold-100); }


  /* Mobile Navigation: Zurück + Weiter zusammen. Kundenwunsch 13.10.2026 (19):
     nicht mehr angepinnt/mitlaufend und ohne weißen Rahmen – steht fest unter der Auswahl. */
  .rnav { display: grid; grid-template-columns: auto 1fr; gap: 10px; }
  .rechner__app--start .rnav { grid-template-columns: 1fr; }
  .rechner__next { width: 100%; }
  @media (max-width: 767px) {
    .rnav { margin-top: 18px; }
  }
  @media (min-width: 768px) { .rnav__zurueck { display: none; } }

  /* Ergebnis */
  .rechner__result {
    font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(26px, 5vw, 40px);
    color: var(--anthrazit-800);
    margin-block: 8px 16px;
  }
  .rechner__disclaimer { max-width: 560px; margin-top: 16px; }

  /* Ihre Auswahl: sauber gruppiert statt Chip-Wolke */
  .rwahl { display: grid; gap: 14px; margin-bottom: 18px; }
  @media (min-width: 640px) { .rwahl { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); align-items: start; } }
  .rwahl :global(.rwahl__gruppe) {
    background: var(--gold-100);
    border: 1px solid var(--gold-500);
    border-radius: var(--radius-md);
    padding: 14px 16px;
  }
  .rwahl :global(.rwahl__titel) {
    margin: 0 0 8px;
    font-family: var(--font-heading); text-transform: uppercase;
    font-size: 12px; letter-spacing: 0.08em; font-weight: 700;
    color: var(--gold-700);
  }
  .rwahl :global(.rwahl__gruppe ul) {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 5px;
  }
  .rwahl :global(.rwahl__gruppe li) {
    display: flex; align-items: baseline; gap: 8px;
    font-size: 14px; font-weight: 600;
  }
  .rwahl :global(.rwahl__gruppe li::before) {
    content: "✓";
    color: var(--gold-700);
    font-weight: 800;
    flex: none;
  }
  .rwahl :global(.rwahl__gruppe li.info::before) { content: "•"; }

  .rechner__contact { display: grid; gap: 12px; margin-top: 28px; }
  .rechner__contact .btn { width: 100%; }
  /* Handy: Kontakt-Buttons kompakter (Kundenwunsch 11.10.2026) – einzeilig,
     aber weiterhin ≥ 44 px Touch-Höhe. Desktop bleibt btn--lg. */
  @media (max-width: 768px) {
    .rechner__contact { gap: 10px; margin-top: 22px; }
    .rechner__contact .btn {
      min-height: 48px;
      padding: 11px 18px;
      font-size: 15px;
      gap: 8px;
      line-height: 1.2;
    }
    .rechner__contact .btn :global(.icon) { width: 18px; height: 18px; }
  }
  /* Sehr schmale Handys (≈ 360 px): noch etwas kleiner, damit nichts umbricht */
  @media (max-width: 400px) {
    .rechner__contact .btn { font-size: 14px; padding-inline: 10px; gap: 6px; }
  }
</style>

<script>
  // Preise + Logik kommen direkt aus data/rechner.ts (eine einzige Quelle, gebündelt von Vite).
  import { GEWERKE, berechne, preisText, tierById, MWST_HINWEIS, type Gewerk } from "../data/rechner";

  const app = document.querySelector<HTMLElement>(".rechner__app");
  if (app) {
    const START = app.dataset.variant === "start";
    const steps = Array.from(app.querySelectorAll<HTMLElement>(".rstep"));
    const panel = document.getElementById("rPanel")!;
    const bar = app.querySelector<HTMLElement>(".rechner__bar");
    const progress = app.querySelector<HTMLElement>(".rechner__progress");
    const range = document.getElementById("rMenge") as HTMLInputElement;
    const mengeOut = document.getElementById("rMengeOut")!;
    const frageEl = document.getElementById("rFrage")!;
    const gewerkLabel = document.getElementById("rGewerkLabel");
    const tiersEl = document.getElementById("rTiers")!;
    const rangeWrap = document.getElementById("rRange")!;
    const weiterBtn = document.getElementById("rWeiter")!;
    const ergebnisEl = document.getElementById("rErgebnis")!;
    const waBtn = document.getElementById("rWhatsapp") as HTMLAnchorElement;
    const mailBtn = document.getElementById("rMail") as HTMLAnchorElement;
    const gruppeTag = START ? "h4" : "h3";

    const state = {
      step: START ? 2 : 1,
      gewerk: null as Gewerk | null,
      menge: 0,
      tier: "",
    };
    const euro = (n: number) => n.toLocaleString("de-DE");
    const EMOJI: Record<string, string> = {
      badsanierung: "🛁", "sanierung-modernisierung": "🏠", "fliesen-boden": "🔲", innenausbau: "🧱",
    };

    type Scroll = "immer" | "bedarf" | "nie";
    function scrollZu(mode: Scroll) {
      if (mode === "nie") return;
      if (!START) {
        app!.scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }
      // Startseite: nur scrollen, wenn der Panel-Anfang nicht gut sichtbar ist.
      const top = panel.getBoundingClientRect().top;
      const headerH = document.getElementById("siteHeader")?.offsetHeight ?? 80;
      const zuHoch = top < headerH;
      const zuTief = top > window.innerHeight * (mode === "immer" ? 0.45 : 0.7);
      if (zuHoch || zuTief) panel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    /** step: 1–3 = Rechner-Schritte, "p-<slug>" = Festpreis-Panel einer Pauschal-Leistung. */
    function show(step: number | string, scroll: Scroll = "immer") {
      const nr = typeof step === "number" ? step : 3; // Festpreis-Panel = Endpunkt
      state.step = nr;
      steps.forEach((s) => (s.hidden = s.dataset.step !== String(step)));
      if (bar && progress) {
        bar.style.width = `${(nr / 3) * 100}%`;
        progress.setAttribute("aria-valuenow", String(nr));
        progress.setAttribute("aria-label", `Schritt ${nr} von 3`);
      }
      app!.toggleAttribute("data-started", nr > 1);
      scrollZu(scroll);
    }

    /** Karte/Kachel als gewählt markieren (Rechner- und Pauschal-Leistungen). */
    function markiere(slug: string) {
      app!.querySelectorAll<HTMLElement>("[data-gewerk]").forEach((t) => {
        const an = t.dataset.gewerk === slug;
        t.classList.toggle("selected", an);
        if (START) {
          t.setAttribute("aria-pressed", String(an));
          t.closest(".rkarte")?.classList.toggle("selected", an);
        }
      });
    }

    /** Pauschal-Leistung: direkt das Festpreis-Panel zeigen (keine Rechenschritte). */
    function selectPauschal(slug: string, scroll: Scroll = "immer") {
      state.gewerk = null;
      markiere(slug);
      show(`p-${slug}`, scroll);
    }

    function selectGewerk(g: Gewerk, scroll: Scroll = "immer") {
      state.gewerk = g;
      state.tier = g.tiers.some((t) => t.id === state.tier) ? state.tier : g.tiers[0].id;
      markiere(g.slug);
      if (gewerkLabel) gewerkLabel.textContent = `${g.label} berechnen`;
      frageEl.textContent = g.frage;
      range.min = String(g.min);
      range.max = String(g.max);
      range.step = String(g.step);
      range.value = String(g.default);
      renderTiers(g);
      updateMenge();
      updateRange();
      show(2, scroll);
    }

    function renderTiers(g: Gewerk) {
      tiersEl.innerHTML = "";
      for (const t of g.tiers) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "rtier" + (t.id === state.tier ? " selected" : "");
        btn.setAttribute("role", "radio");
        btn.setAttribute("aria-checked", String(t.id === state.tier));
        btn.dataset.tier = t.id;
        btn.innerHTML =
          `<strong>${t.label}</strong>` +
          (t.untertitel ? `<em class="rtier__sub">${t.untertitel}</em>` : "") +
          `<small>${t.hint}</small>`;
        btn.addEventListener("click", () => {
          state.tier = t.id;
          tiersEl.querySelectorAll(".rtier").forEach((el) => {
            el.classList.toggle("selected", el === btn);
            el.setAttribute("aria-checked", String(el === btn));
          });
          updateRange();
        });
        tiersEl.append(btn);
      }
      tiersEl.classList.toggle("rechner__tiers--4", g.tiers.length === 4);
    }

    /** Festpreis-Option (z. B. Barrierefreie Dusche): kein Flächen-Slider. */
    function updateRange() {
      const g = state.gewerk;
      const fest = Boolean(g && tierById(g, state.tier).festBis);
      rangeWrap.hidden = fest;
      weiterBtn.textContent = fest ? "Preis anzeigen" : "Preisspanne anzeigen";
    }

    function updateMenge() {
      state.menge = Number(range.value);
      mengeOut.textContent = `${state.menge} ${state.gewerk?.unit ?? ""}`;
    }

    function showResult() {
      const g = state.gewerk!;
      const t = tierById(g, state.tier);
      const erg = berechne(g, state.menge, t.id);
      const preis = preisText(erg);
      ergebnisEl.textContent = preis;
      document.getElementById("rErgebnisTitel")!.textContent =
        erg.art === "spanne" ? "Ihre erste Preisspanne" : "Ihre erste Preiseinschätzung";

      const fest = Boolean(t.festBis);
      const arbeiten = t.bausteine ?? g.bausteine;
      const masse = `${state.menge} ${g.unit}`;
      const niveau = t.untertitel ? `${t.label} (${t.untertitel})` : t.label;

      // Auswahl sauber gruppiert darstellen
      const wahl = document.getElementById("rWahl")!;
      const gruppe = (titel: string, punkte: string[], klasse = "") =>
        `<div class="rwahl__gruppe"><${gruppeTag} class="rwahl__titel">${titel}</${gruppeTag}><ul>` +
        punkte.map((p) => `<li class="${klasse}">${p}</li>`).join("") +
        `</ul></div>`;
      const projekt = fest ? [g.label, niveau] : [g.label, masse, `Niveau ${niveau}`];
      let html = gruppe("Ihr Projekt", projekt, "info");
      html += t.enthalten
        ? gruppe("Das ist enthalten", t.enthalten)
        : gruppe("Enthaltene Arbeiten", arbeiten.map((m) => m.label));
      wahl.innerHTML = html;

      // Anfrage-Texte: klar formatiert, mit Absätzen und Emojis;
      // Arbeiten in FACHSPRACHE, damit das Team sofort fachlich lesen kann.
      const emoji = EMOJI[g.slug] ?? "🔨";
      const arbeitenListe = arbeiten.map((m) => `• ${m.fach}`).join("\n");
      const ausstattung = t.enthalten ? `\n\n✅ Ausstattung:\n${t.enthalten.map((e) => `• ${e}`).join("\n")}` : "";
      const preisZeile = `${preis} (${MWST_HINWEIS.replace("Bruttopreise", "brutto")})`;
      const waText =
        `Hallo Bauwelt Handwerk! 👋\n\n` +
        `Ich habe gerade mein Projekt auf Ihrer Website berechnet:\n\n` +
        `${emoji} Projekt: ${g.label}\n` +
        (fest ? "" : `📐 Größe: ${masse}\n`) +
        `⭐ Niveau: ${niveau}` +
        ausstattung +
        `\n\n🔨 Gewünschte Arbeiten:\n${arbeitenListe}` +
        `\n\n💶 Ersteinschätzung: ${preisZeile}\n\n` +
        `Bitte melden Sie sich bei mir für ein verbindliches Angebot. Vielen Dank! 🙏`;
      waBtn.href = `https://wa.me/${waBtn.href.split("wa.me/")[1].split("?")[0]}?text=${encodeURIComponent(waText)}`;
      waBtn.dataset.text = waText;

      const subject = fest ? `Projektanfrage: ${g.label} – ${t.label}` : `Projektanfrage: ${g.label} (${masse})`;
      const body =
        `Guten Tag,\n\n` +
        `ich habe im Online-Rechner folgendes Projekt berechnet:\n\n` +
        `Projekt:  ${g.label}\n` +
        (fest ? "" : `Größe:    ${masse}\n`) +
        `Niveau:   ${niveau}` +
        ausstattung.replace("✅ ", "") +
        `\n\nGewünschte Arbeiten:\n${arbeitenListe}` +
        `\n\nErsteinschätzung: ${preisZeile}\n\n` +
        `Bitte rufen Sie mich für ein verbindliches Angebot zurück.\n\n` +
        `Name:\nTelefonnummer:\nAdresse (für den Vor-Ort-Termin):\n`;
      mailBtn.href = `${mailBtn.href.split("?")[0]}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      show(3);
    }

    // Events
    const istPauschal = (slug: string) => steps.some((s) => s.dataset.step === `p-${slug}`);
    app.querySelectorAll<HTMLButtonElement>("button[data-gewerk]").forEach((tile) =>
      tile.addEventListener("click", () => {
        const slug = tile.dataset.gewerk ?? "";
        const g = GEWERKE.find((x) => x.slug === slug);
        if (g) selectGewerk(g, START ? "bedarf" : "immer");
        else if (istPauschal(slug)) selectPauschal(slug, START ? "bedarf" : "immer");
      })
    );
    app.querySelectorAll<HTMLButtonElement>("[data-zurueck]").forEach((b) =>
      b.addEventListener("click", () => show(1))
    );
    range.addEventListener("input", updateMenge);
    document.getElementById("rWeiter")!.addEventListener("click", showResult);
    document.getElementById("rZurueck2")?.addEventListener("click", () => show((state.step - 1) as 1 | 2));
    // Vom Ergebnis zurück zu Fläche & Niveau (Werte bleiben erhalten)
    document.getElementById("rAendern")!.addEventListener("click", () => show(2));

    if (START) {
      // Startseite: erste Leistung ist vorausgewählt (Markup bereits serverseitig gerendert).
      selectGewerk(GEWERKE[0], "nie");
    } else {
      // Vorauswahl per ?gewerk=<slug> (z. B. von den Leistungsseiten)
      const pre = new URLSearchParams(location.search).get("gewerk") ?? app.dataset.vorwahl ?? null;
      const preG = pre ? GEWERKE.find((g) => g.slug === pre) : null;
      if (preG) selectGewerk(preG);
      else if (pre && istPauschal(pre)) selectPauschal(pre);
    }
  }
</script>
