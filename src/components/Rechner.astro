</style>

<script>
  // Preise + Logik kommen direkt aus data/rechner.ts (eine einzige Quelle, gebündelt von Vite).
  import { GEWERKE, berechne, preisText, tierById, kalkArtLabel, MWST_HINWEIS, type Gewerk, type KalkArt } from "../data/rechner";

  const app = document.querySelector<HTMLElement>(".rechner__app");
  if (app) {
    const START = app.dataset.variant === "start";
    const steps = Array.from(app.querySelectorAll<HTMLElement>(".rstep"));
    const panel = document.getElementById("rPanel")!;
    const bar = app.querySelector<HTMLElement>(".rechner__bar");
    const progress = app.querySelector<HTMLElement>(".rechner__progress");
    const range = document.getElementById("rMenge") as HTMLInputElement;
    const mengeOut = document.getElementById("rMengeOut")!;
    const frageEl = document.getElementById("rFrage")!;
    const gewerkLabel = document.getElementById("rGewerkLabel");
    const tiersEl = document.getElementById("rTiers")!;
    const rangeWrap = document.getElementById("rRange")!;
    const weiterBtn = document.getElementById("rWeiter")!;
    const ergebnisEl = document.getElementById("rErgebnis")!;
    const waBtn = document.getElementById("rWhatsapp") as HTMLAnchorElement;
    const mailBtn = document.getElementById("rMail") as HTMLAnchorElement;
    const gruppeTag = START ? "h4" : "h3";
    const mengeFrage = document.getElementById("rMengeFrage")!;
    const kalkEl = document.getElementById("rKalk")!;
    const kalkRadios = Array.from(kalkEl.querySelectorAll<HTMLInputElement>('input[name="rKalkArt"]'));
    const extrasEl = document.getElementById("rExtras")!;
    const extrasListe = document.getElementById("rExtrasListe")!;
    const liveEl = document.getElementById("rLive"); // entfernt (48) – bleibt optional

    const state = {
      step: START ? 2 : 1,
      gewerk: null as Gewerk | null,
      menge: 0,
      tier: "",
      art: "schnell" as KalkArt,   // Kalkulationsart (nur Gewerke mit Extras)
      teil: 1,                     // Audit 1.5: Schritt „Umfang“ bei Badsanierung in 2 Teile (1 = Art + Größe, 2 = Rechenart + Extras)
      pauschal: false,
      extras: [] as string[],      // gewählte Extra-ids
    };
    const euro = (n: number) => n.toLocaleString("de-DE");
    const EMOJI: Record<string, string> = {
      badsanierung: "🛁", "sanierung-modernisierung": "🏠", "fliesen-boden": "🔲", innenausbau: "🧱",
    };

    type Scroll = "immer" | "bedarf" | "nie";
    function scrollZu(mode: Scroll) {
      if (mode === "nie") return;
      if (!START) {
        app!.scrollIntoView({ behavior: "smooth", block: "start" });
        return;
      }
      // Startseite: nur scrollen, wenn der Panel-Anfang nicht gut sichtbar ist.
      const top = panel.getBoundingClientRect().top;
      const headerH = document.getElementById("siteHeader")?.offsetHeight ?? 80;
      const zuHoch = top < headerH;
      const zuTief = top > window.innerHeight * (mode === "immer" ? 0.45 : 0.7);
      if (zuHoch || zuTief) panel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    /** step: 1–3 = Rechner-Schritte, "p-<slug>" = Festpreis-Panel einer Pauschal-Leistung. */
    function show(step: number | string, scroll: Scroll = "immer") {
      const nr = typeof step === "number" ? step : 3; // Festpreis-Panel = Endpunkt
      state.step = nr;
      state.pauschal = typeof step !== "number";
      steps.forEach((s) => (s.hidden = s.dataset.step !== String(step)));
      updateSchritt();
      app!.toggleAttribute("data-started", nr > 1);
      scrollZu(scroll);
    }

    /** Audit 1.5: Badsanierung (Gewerk mit Extras, ohne Festpreis-Option) bekommt zwei Teil-Schritte. */
    function geteilt() {
      const g = state.gewerk;
      return Boolean(g?.extras) && !tierById(g!, state.tier).festBis;
    }
    /** Schritt-Anzeige „Schritt 2 von 3 – Umfang“ + Balken. */
    function updateSchritt() {
      const label = document.getElementById("rSchritt");
      if (state.pauschal) {
        if (label) label.textContent = "";
        if (bar) bar.style.width = "100%";
        return;
      }
      const namen = [...(START ? [] : ["Leistung"]), "Umfang", ...(geteilt() ? ["Rechenart"] : []), "Ergebnis"];
      const akt = state.step === 1 ? "Leistung" : state.step === 3 ? "Ergebnis" : state.teil === 2 && geteilt() ? "Rechenart" : "Umfang";
      const i = Math.max(0, namen.indexOf(akt));
      if (label) label.textContent = `Schritt ${i + 1} von ${namen.length} – ${akt}`;
      if (bar && progress) {
        bar.style.width = `${((i + 1) / namen.length) * 100}%`;
        progress.setAttribute("aria-valuemax", String(namen.length));
        progress.setAttribute("aria-valuenow", String(i + 1));
        progress.setAttribute("aria-label", `Schritt ${i + 1} von ${namen.length}`);
      }
    }

    /** Karte/Kachel als gewählt markieren (Rechner- und Pauschal-Leistungen). */
    function markiere(slug: string) {
      app!.querySelectorAll<HTMLElement>("[data-gewerk]").forEach((t) => {
        const an = t.dataset.gewerk === slug;
        t.classList.toggle("selected", an);
        if (START) {
          t.setAttribute("aria-pressed", String(an));
          t.closest(".rkarte")?.classList.toggle("selected", an);
        }
      });
    }

    /** Pauschal-Leistung: direkt das Festpreis-Panel zeigen (keine Rechenschritte). */
    function selectPauschal(slug: string, scroll: Scroll = "immer") {
      state.teil = 1;
      state.gewerk = null;
      markiere(slug);
      show(`p-${slug}`, scroll);
    }

    function selectGewerk(g: Gewerk, scroll: Scroll = "immer") {
      state.gewerk = g;
      state.teil = 1;
      state.tier = g.tiers.some((t) => t.id === state.tier) ? state.tier : g.tiers[0].id;
      markiere(g.slug);
      if (gewerkLabel) gewerkLabel.textContent = `${g.label} berechnen`;
      // Gewerke mit wahlFrage (Badsanierung): erst Option, dann Menge – Slider bekommt eigene Frage
      frageEl.textContent = g.wahlFrage ?? g.frage;
      mengeFrage.textContent = g.wahlFrage ? g.frage : "";
      mengeFrage.hidden = !g.wahlFrage;
      range.setAttribute("aria-labelledby", g.wahlFrage ? "rMengeFrage" : "rFrage");
      tiersEl.setAttribute("aria-label", g.wahlFrage ?? "Ausstattungsniveau");
      if (g.wahlFrage) rangeWrap.before(tiersEl);
      else tiersEl.before(rangeWrap);
      range.min = String(g.min);
      range.max = String(g.max);
      range.step = String(g.step);
      range.value = String(g.default);
      renderTiers(g);
      renderExtras(g);
      updateMenge();
      updateRange();
      show(2, scroll);
    }

    function renderTiers(g: Gewerk) {
      tiersEl.innerHTML = "";
      for (const t of g.tiers) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "rtier" + (t.id === state.tier ? " selected" : "");
        btn.setAttribute("role", "radio");
        btn.setAttribute("aria-checked", String(t.id === state.tier));
        btn.dataset.tier = t.id;
        btn.innerHTML =
          `<strong>${t.label}</strong>` +
          (t.untertitel ? `<em class="rtier__sub">${t.untertitel}</em>` : "") +
          `<small>${t.hint}</small>`;
        btn.addEventListener("click", () => {
          state.tier = t.id;
          tiersEl.querySelectorAll(".rtier").forEach((el) => {
            el.classList.toggle("selected", el === btn);
            el.setAttribute("aria-checked", String(el === btn));
          });
          updateRange();
        });
        tiersEl.append(btn);
      }
      tiersEl.classList.toggle("rechner__tiers--2", g.tiers.length === 2);
    }

    /** Extras der detaillierten Kalkulation als echte Checkboxen – NUR Bezeichnung, kein Preis. */
    function renderExtras(g: Gewerk) {
      extrasListe.innerHTML = "";
      for (const x of g.extras ?? []) {
        const label = document.createElement("label");
        label.className = "rextra";
        const cb = document.createElement("input");
        cb.type = "checkbox";
        cb.value = x.id;
        cb.checked = state.extras.includes(x.id);
        const text = document.createElement("span");
        text.textContent = x.label;
        label.append(cb, text);
        extrasListe.append(label);
      }
    }

    /** Kalkulationsart/Extras nur bei Gewerken mit Extras und ohne Festpreis-Option. */
    function updateKalk() {
      const g = state.gewerk;
      const sichtbar = geteilt() && state.teil === 2;
      kalkEl.hidden = !sichtbar;
      if (!sichtbar) return;
      kalkRadios.forEach((r) => (r.checked = r.value === state.art));
      extrasEl.hidden = state.art !== "detail";
      updateLive();
    }

    /** Live-Preis der detaillierten Kalkulation (ändert sich beim An-/Abhaken und mit der Badgröße). */
    function updateLive() {
      const g = state.gewerk;
      if (!g?.extras) return;
      if (liveEl) liveEl.textContent = preisText(berechne(g, state.menge, state.tier, { art: "detail", extras: state.extras }));
    }

    /** Festpreis-Option (z. B. Barrierefreie Dusche): kein Flächen-Slider. */
    function updateRange() {
      const g = state.gewerk;
      const fest = Boolean(g && tierById(g, state.tier).festBis);
      const teil2 = geteilt() && state.teil === 2;
      rangeWrap.hidden = fest || teil2;
      tiersEl.hidden = teil2;
      if (g) frageEl.textContent = teil2 ? "Wie möchten Sie rechnen?" : (g.wahlFrage ?? g.frage);
      const kalkFrage = document.getElementById("rKalkFrage");
      if (kalkFrage) kalkFrage.hidden = teil2; // Frage steht dann als Schritt-Überschrift
      const zurueckTeil = document.getElementById("rZurueckTeil");
      if (zurueckTeil) zurueckTeil.hidden = !teil2;
      weiterBtn.textContent = geteilt() && state.teil === 1 ? "Weiter" : fest ? "Preis anzeigen" : "Preisspanne anzeigen";
      updateKalk();
      updateSchritt();
    }

    function updateMenge() {
      state.menge = Number(range.value);
      const min = Number(range.min), max = Number(range.max);
      range.style.setProperty("--fill", `${((state.menge - min) / (max - min || 1)) * 100}%`);
      mengeOut.textContent = `${state.menge} ${state.gewerk?.unit ?? ""}`;
      updateLive();
    }

    function showResult() {
      const g = state.gewerk!;
      const t = tierById(g, state.tier);
      const fest = Boolean(t.festBis);
      // Kundenwunsch 14.10.2026 (47): Badsanierung mit Kalkulationsart (+ Extras bei „detailliert“)
      const kalk = Boolean(g.extras) && !fest;
      const detail = kalk && state.art === "detail";
      const extras = detail ? g.extras!.filter((x) => state.extras.includes(x.id)) : [];
      const artLabel = kalkArtLabel(state.art);
      const erg = berechne(g, state.menge, t.id, kalk ? { art: state.art, extras: state.extras } : {});
      const preis = preisText(erg);
      ergebnisEl.textContent = preis;
      document.getElementById("rErgebnisTitel")!.textContent =
        erg.art === "spanne" ? "Ihre erste Preisspanne" : "Ihre erste Preiseinschätzung";

      const arbeiten = t.bausteine ?? g.bausteine;
      const masse = `${state.menge} ${g.unit}`;
      const niveau = t.untertitel ? `${t.label} (${t.untertitel})` : t.label;

      // Auswahl sauber gruppiert darstellen
      const wahl = document.getElementById("rWahl")!;
      const gruppe = (titel: string, punkte: string[], klasse = "") =>
        `<div class="rwahl__gruppe"><${gruppeTag} class="rwahl__titel">${titel}</${gruppeTag}><ul>` +
        punkte.map((p) => `<li class="${klasse}">${p}</li>`).join("") +
        `</ul></div>`;
      const extrasZeile = extras.length ? `Extras: ${extras.map((x) => x.label).join(", ")}` : "Ohne Extras";
      const projekt = fest
        ? [g.label, niveau]
        : kalk
          ? [g.label, masse, artLabel, ...(detail ? [extrasZeile] : [])]
          : [g.label, masse, `Niveau: ${niveau}`];
      let html = gruppe("Ihr Projekt", projekt, "info");
      html += t.enthalten
        ? gruppe("Das ist enthalten", [...t.enthalten, ...extras.map((x) => x.label)])
        : gruppe("Enthaltene Arbeiten", arbeiten.map((m) => m.label));
      wahl.innerHTML = html;

      // Anfrage-Texte: klar formatiert, mit Absätzen und Emojis;
      // Arbeiten in FACHSPRACHE, damit das Team sofort fachlich lesen kann.
      const emoji = EMOJI[g.slug] ?? "🔨";
      const arbeitenListe = arbeiten.map((m) => `• ${m.fach}`).join("\n");
      const ausstattung = t.enthalten ? `\n\n✅ Ausstattung:\n${t.enthalten.map((e) => `• ${e}`).join("\n")}` : "";
      const preisZeile = `${preis} (${MWST_HINWEIS.replace("Bruttopreise", "brutto")})`;
      // Badsanierung: Kalkulationsart + Extras (Fachbegriffe) statt „Niveau“
      const extrasText = extras.length ? `\n${extras.map((x) => `• ${x.fach}`).join("\n")}` : " keine";
      const waWahl = kalk
        ? `🧮 Kalkulation: ${artLabel}` + (detail ? `\n✨ Extras:${extrasText}` : "")
        : `⭐ ${g.extras ? "Auswahl" : "Niveau"}: ${niveau}`;
      const mailWahl = kalk
        ? `Kalkulation: ${artLabel}` + (detail ? `\nExtras:${extrasText}` : "")
        : `${g.extras ? "Auswahl:  " : "Niveau:   "}${niveau}`;
      const waText =
        `Hallo Bauwelt Handwerk! 👋\n\n` +
        `Ich habe gerade mein Projekt auf Ihrer Website berechnet:\n\n` +
        `${emoji} Projekt: ${g.label}\n` +
        (fest ? "" : `📐 Größe: ${masse}\n`) +
        waWahl +
        ausstattung +
        `\n\n🔨 Gewünschte Arbeiten:\n${arbeitenListe}` +
        `\n\n💶 Preisspanne: ${preisZeile}\n\n` +
        `Bitte melden Sie sich bei mir für ein verbindliches Angebot. Vielen Dank! 🙏`;
      waBtn.href = `https://wa.me/${waBtn.href.split("wa.me/")[1].split("?")[0]}?text=${encodeURIComponent(waText)}`;
      waBtn.dataset.text = waText;

      const subject = fest
        ? `Projektanfrage: ${g.label} – ${t.label}`
        : `Projektanfrage: ${g.label} (${masse}${kalk ? `, ${artLabel}` : ""})`;
      const body =
        `Guten Tag,\n\n` +
        `ich habe im Online-Rechner folgendes Projekt berechnet:\n\n` +
        `Projekt:  ${g.label}\n` +
        (fest ? "" : `Größe:    ${masse}\n`) +
        mailWahl +
        ausstattung.replace("✅ ", "") +
        `\n\nGewünschte Arbeiten:\n${arbeitenListe}` +
        `\n\nPreisspanne: ${preisZeile}\n\n` +
        `Bitte rufen Sie mich für ein verbindliches Angebot zurück.\n\n` +
        `Name:\nTelefonnummer:\nAdresse (für den Vor-Ort-Termin):\n`;
      mailBtn.href = `${mailBtn.href.split("?")[0]}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      // Rückruf-Formular (Audit 6.3): Berechnung als Zusammenfassung mitschicken
      const rrf = app.querySelector<HTMLFormElement>("form[data-rueckruf]");
      if (rrf) rrf.dataset.zusammenfassung =
        `Projekt: ${g.label}\n` + (fest ? "" : `Größe: ${masse}\n`) + mailWahl + ausstattung.replace("✅ ", "") +
        `\nGewünschte Arbeiten:\n${arbeitenListe}\nPreisspanne: ${preisZeile}`;
      show(3);
    }

    // Events
    const istPauschal = (slug: string) => steps.some((s) => s.dataset.step === `p-${slug}`);
    app.querySelectorAll<HTMLButtonElement>("button[data-gewerk]").forEach((tile) =>
      tile.addEventListener("click", () => {
        const slug = tile.dataset.gewerk ?? "";
        const g = GEWERKE.find((x) => x.slug === slug);
        if (g) selectGewerk(g, START ? "bedarf" : "immer");
        else if (istPauschal(slug)) selectPauschal(slug, START ? "bedarf" : "immer");
      })
    );
    app.querySelectorAll<HTMLButtonElement>("[data-zurueck]").forEach((b) =>
      b.addEventListener("click", () => show(1))
    );
    range.addEventListener("input", updateMenge);
    // Kalkulationsart wechseln (echte Radios) und Extras an-/abhaken → Preis live
    kalkRadios.forEach((r) =>
      r.addEventListener("change", () => {
        if (!r.checked) return;
        state.art = r.value as KalkArt;
        updateKalk();
      })
    );
    extrasListe.addEventListener("change", () => {
      state.extras = Array.from(extrasListe.querySelectorAll<HTMLInputElement>("input:checked")).map((c) => c.value);
      updateLive();
    });
    // Audit 1.5: bei Badsanierung erst Teil 1 (Art + Größe) → „Weiter“ → Teil 2 (Rechenart + Extras)
    document.getElementById("rWeiter")!.addEventListener("click", () => {
      if (geteilt() && state.teil === 1) {
        state.teil = 2;
        updateRange();
        scrollZu("bedarf");
      } else showResult();
    });
    const zurueck = () => {
      if (state.step === 2 && state.teil === 2) {
        state.teil = 1;
        updateRange();
        scrollZu("bedarf");
      } else show((state.step - 1) as 1 | 2);
    };
    document.getElementById("rZurueck2")?.addEventListener("click", zurueck);
    document.getElementById("rZurueckTeil")?.addEventListener("click", zurueck);
    // Vom Ergebnis zurück zu Fläche & Niveau (Werte bleiben erhalten)
    document.getElementById("rAendern")!.addEventListener("click", () => show(2));

    if (START) {
      // Startseite: erste Leistung ist vorausgewählt (Markup bereits serverseitig gerendert).
      selectGewerk(GEWERKE[0], "nie");
    } else {
      // Vorauswahl per ?gewerk=<slug> (z. B. von den Leistungsseiten)
      // Kundenwunsch 14.10.2026 (28): eingebetteter Rechner (data-vorwahl) wählt still vor –
      // die Leistungsseite bleibt oben; nur ein ?gewerk=-Link scrollt zum Rechner.
      const urlPre = new URLSearchParams(location.search).get("gewerk");
      const pre = urlPre ?? app.dataset.vorwahl ?? null;
      const scroll: Scroll = urlPre ? "immer" : "nie";
      const preG = pre ? GEWERKE.find((g) => g.slug === pre) : null;
      if (preG) selectGewerk(preG, scroll);
      else if (pre && istPauschal(pre)) selectPauschal(pre, scroll);
    }
  }
</script>
