---
// Projekt-Rechner 3.2 – gemeinsame Komponente für /rechner/ und die Startseite.
// Enpal-Funnel-Mechanik: Ergebnis VOR Kontaktfrage. Immer „schnelle Schätzung"
// (Fläche per Slider + Ausstattungsniveau) – die Modus-Wahl „Genaue Angaben“ ist
// auf Kundenwunsch 11.10.2026 entfallen.
// WhatsApp/E-Mail bekommen einen klar formatierten Anfragetext (Fachbegriffe).
//
// variant="seite": bisheriger 3-Schritte-Funnel (Leistung → Umfang → Ergebnis).
// variant="start" (Kundenwunsch 11.10.2026): Leistungskarten (Icon, Titel, Nutzen,
//   „Mehr erfahren") SIND die Leistungsauswahl, daneben/darunter direkt der Rechner.
//   Badsanierung ist vorausgewählt und serverseitig vorgerendert (kein Layout-Sprung).
// Pauschal-Leistungen (Immobilien-Sanierungscheck, 595 € inkl. MwSt.): keine Rechenschritte, sondern
//   ein Festpreis-Panel mit Leistungsinhalt und Buchen/Anfragen. Preis + Inhalt kommen
//   aus der Content-Datei (pauschalpreis/umfang) – eine einzige Quelle.
// Ohne JavaScript: Hinweis + Direktkontaktwege (html.js-Gate); auf der Startseite
// bleiben die Karten mit ihren „Mehr erfahren"-Links sichtbar.
// Kundenwunsch 14.10.2026 (47): Badsanierung nur noch „Badsanierung“ / „Barrierefreie Dusche“.
//   Badsanierung: Badgröße + Kalkulationsart „Schnelle“ (Spanne nach m²) oder „Detaillierte
//   Kalkulation“ (echte Checkboxen für Extras, Preis live – Einzelpreise der Extras bleiben
//   unsichtbar). Optionswahl steht dort VOR der Badgröße (Gewerk.wahlFrage).
import { getEntry } from "astro:content";
import Icon from "./Icon.astro";
import { GEWERKE, PAUSCHAL, MWST_HINWEIS, KALK_ARTEN, berechne, preisText } from "../data/rechner";
import { SITE, EMAILS, TERMIN, u, waLink, leistungBySlug } from "../consts";
import RueckrufFormular from "./RueckrufFormular.astro";

interface Props {
  variant?: "seite" | "start";
  /** Vorauswahl einer Leistung (Leistungsseiten, Kundenwunsch 14.10.2026) */
  gewerk?: string;
  /** Eigener Einleitungstext (Leistungsseiten, Kundenwunsch 14.10.2026 (35)); MwSt-Hinweis bleibt. */
  intro?: string;
}
const { variant = "seite", gewerk, intro } = Astro.props;
const start = variant === "start";
const H = start ? "h3" : "h2";     // Schritt-Überschriften
const HSub = start ? "h4" : "h3";  // Zwischenüberschriften
const erstes = GEWERKE[0];
const euro = (n: number) => n.toLocaleString("de-DE");
// Startseite (Badsanierung vorgerendert): Optionswahl vor der Badgröße, wenn das Gewerk es so will.
const wahlZuerst = start && Boolean(erstes.wahlFrage);
const teile = wahlZuerst ? ["tiers", "range"] : ["range", "tiers"];
const mitKalk = start && Boolean(erstes.extras);

// Pauschal-Leistungen mit Preis + Inhalt aus der jeweiligen Leistungs-Content-Datei
const PAUSCHAL_DATA = await Promise.all(
  PAUSCHAL.map(async (p) => {
    const e = await getEntry("leistungen", p.slug);
    if (!e?.data.pauschalpreis) throw new Error(`Pauschalpreis fehlt in content/leistungen/${p.slug}.md`);
    return { ...p, preis: e.data.pauschalpreis, enthalten: e.data.umfang, hinweis: e.data.pauschalHinweis };
  })
);
/** Alle Leistungskarten in Menü-Reihenfolge: erst die Rechner-Gewerke, dann Pauschal.
 *  Kundenwunsch 16.10.2026 (73): Karte zeigt wie das Menü fett die Überschrift, darunter die
 *  Unterschrift (beides aus LEISTUNGEN in consts.ts). */
const KARTEN = [...GEWERKE, ...PAUSCHAL_DATA].map((g) => {
  const l = leistungBySlug(g.slug);
  if (!l) throw new Error(`Leistung ${g.slug} fehlt in LEISTUNGEN (consts.ts)`);
  // Kundenwunsch 19.10.2026 (Audit 1.3): fett der Leistungsname, darunter klein der Slogan
  return { ...g, titel: l.unterschrift, unterschrift: l.ueberschrift, preis: "preis" in g ? g.preis : undefined };
});
// Weiche Trennstellen für lange Wörter in den schmalen Handy-Karten
// (Chrome trennt Deutsch sonst nicht zuverlässig → „Modernisierun|g").
// Weiche Trennstellen für lange Kartentitel (Handy: sonst Umbruch mitten im Wort ohne Bindestrich)
const weich = (t: string) =>
  t.replace("Bodenlegerarbeiten", "Boden\u00ADleger\u00ADarbeiten").replace("Modernisierung", "Moderni\u00ADsierung")
   .replace("Badsanierung", "Bad\u00ADsanierung").replace("Innenausbau", "Innen\u00ADausbau")
   .replace("Trockenbau", "Trocken\u00ADbau").replace("Sanierungscheck", "Sanierungs\u00ADcheck")
   .replace("Komplettsanierung", "Komplett\u00ADsanierung").replace("Immobilienkauf", "Immobilien\u00ADkauf")
   .replace("selbstbestimmt", "selbst\u00ADbestimmt").replace("Oberflächen", "Ober\u00ADflächen").replace("Badezimmer", "Bade\u00ADzimmer");

---

<!-- Ohne JS: ehrlicher Hinweis + Kontaktwege -->
<div class="rechner__nojs">
  <p>
    Der Online-Rechner benötigt JavaScript. Sie erreichen uns aber jederzeit direkt –
    wir nennen Ihnen gern am Telefon eine erste Einschätzung:
  </p>
  <div class="rechner__nojs-actions">
    <a class="btn" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
    <a class="btn btn--dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn btn--ghost" href={`mailto:${EMAILS.service}?subject=Projektanfrage`}>E-Mail schreiben</a>
  </div>
</div>

<!-- Einleitung: Kundenwunsch 13.10.2026 (22) – Einleitungstext, „Keine Kontaktdaten nötig“ und
     Ehrlichkeits-Hinweis zu EINEM Absatz im Stil des Einleitungstexts zusammengefasst. -->
<p class:list={["lead", "rintro", { "rintro--start": start }]}>
  {intro ? <>{intro} ({MWST_HINWEIS})</> : <>{start
    ? "Wählen Sie Ihre Leistung und sehen Sie sofort, womit Sie rechnen können – unverbindlich und ohne Kontaktdaten."
    : "In einer Minute zur ersten Preisspanne – unverbindlich und ohne Kontaktdaten."}
  {" "}Unsere Preise liegen sehr nah am tatsächlichen Preis: keine Lockangebote, sondern realistische Werte ({MWST_HINWEIS.replace("Bruttopreise", "Bruttopreise")}).</>}
</p>

<div
  class:list={["rechner__app", start ? "rechner__app--start" : "card"]}
  data-variant={variant}
  data-vorwahl={gewerk}
>
  {start ? (
    /* Leistungskarten = Leistungsauswahl (Toggle-Buttons) + Link zur Leistungsseite */
    <div class="rkarten" role="group" aria-label="Leistung für die Kalkulation wählen">
      {KARTEN.map((g, i) => (
        <div class:list={["rkarte", { selected: i === 0 }]}>
          <button
            type="button"
            class="rkarte__wahl"
            id={`rTab-${g.slug}`}
            data-gewerk={g.slug}
            aria-pressed={i === 0 ? "true" : "false"}
            aria-controls="rPanel"
          >
            <span class="rkarte__icon"><Icon name={g.icon} size={22} class="icon" /></span>
            <span class="rkarte__titel">{weich(g.titel)}</span>
            <span class="rkarte__nutzen">
              {weich(g.unterschrift)}
              {/* Kundenwunsch 13.10.2026 (23): Pauschalpreis nicht direkt auf der Karte zeigen (erst nach Klick) */}
            </span>
            <span class="rkarte__status" aria-hidden="true">
              <span class="rkarte__status-an"><Icon name="check" size={14} class="icon" /> Ausgewählt</span>
              <span class="rkarte__status-aus"><Icon name={g.preis ? "euro" : "calc"} size={14} class="icon" /> {g.preis ? "Pauschalpreis ansehen" : "Preis berechnen"}</span>
            </span>
          </button>
          <a class="rkarte__mehr" href={u(`leistungen/${g.slug}/`)}>
            Mehr erfahren<span class="visually-hidden"> über {g.label}</span> <Icon name="arrow" size={16} class="icon" />
          </a>
        </div>
      ))}
    </div>
  ) : (
    <>
    <p class="rschritt" id="rSchritt" aria-live="polite">Schritt 1 von 3 – Leistung</p>
    <div class="rechner__progress" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1" aria-label="Schritt 1 von 3">
      <span class="rechner__bar" style="width: 33%"></span>
    </div>
    </>
  )}

  <div
    class:list={["rechner__panel", { card: start }]}
    id="rPanel"
    {...(start ? { role: "region", "aria-label": "Projekt-Kalkulation" } : {})}
  >
    {/* Kundenwunsch 19.10.2026 (Audit 1.5): sichtbare Schritt-Anzeige */}
    {start && <p class="rschritt" id="rSchritt" aria-live="polite"></p>}
    {!start && (
      /* Schritt 1: Gewerk (nur Rechner-Seite – auf der Startseite übernehmen das die Karten) */
      <section class="rstep" data-step="1">
        <h2 class="rstep__title">Worum geht es?</h2>
        <div class="rechner__tiles">
          {KARTEN.map((g) => (
            <button class="rtile" type="button" data-gewerk={g.slug}>
              <Icon name={g.icon} size={30} class="icon" />
              <span class="rtile__text"><strong>{weich(g.titel)}</strong><small>{weich(g.unterschrift)}</small></span>
            </button>
          ))}
        </div>
      </section>
    )}

    <!-- Schritt 2: Umfang – Fläche (Slider) + Ausstattungsniveau
         (Badsanierung: Option → Badgröße → Kalkulationsart → ggf. Extras) -->
    <section class="rstep" data-step="2" hidden={!start}>
      {start && <p class="rpanel__gewerk" id="rGewerkLabel">{erstes.label} berechnen</p>}
      <H class="rstep__title" id="rFrage">{start ? (erstes.wahlFrage ?? erstes.frage) : "Wie groß ist Ihr Projekt?"}</H>

      {teile.map((teil) => teil === "range" ? (
        <div class="rechner__range" id="rRange">
          <p class="rfrage" id="rMengeFrage" hidden={!wahlZuerst}>{wahlZuerst ? erstes.frage : ""}</p>
          <input
            type="range" id="rMenge" aria-labelledby={wahlZuerst ? "rMengeFrage" : "rFrage"}
            min={start ? erstes.min : 3} max={start ? erstes.max : 30}
            step={start ? erstes.step : 1} value={start ? erstes.default : 8}
          />
          <output class="rechner__mengeout" id="rMengeOut" for="rMenge">{start ? `${erstes.default} ${erstes.unit}` : "8 m²"}</output>
        </div>
      ) : (
        <div
          class:list={["rechner__tiers", { "rechner__tiers--2": start && erstes.tiers.length === 2 }]}
          id="rTiers" role="radiogroup" aria-label={wahlZuerst ? erstes.wahlFrage : "Ausstattungsniveau"}
        >
          {start && erstes.tiers.map((t, i) => (
            <button type="button" class:list={["rtier", { selected: i === 0 }]} role="radio" aria-checked={i === 0 ? "true" : "false"} data-tier={t.id}>
              <strong>{t.label}</strong>{t.untertitel && <em class="rtier__sub">{t.untertitel}</em>}<small>{t.hint}</small>
            </button>
          ))}
        </div>
      ))}

      {/* Kundenwunsch 14.10.2026 (47): Kalkulationsart + Extras (nur Gewerke mit `extras`, z. B. Badsanierung).
          Echte Radio-/Checkbox-Elemente (Tastatur, Screenreader); Extra-Preise werden NIE angezeigt. */}
      <div class="rkalk" id="rKalk" hidden={!mitKalk}>
        <p class="rfrage" id="rKalkFrage">Wie möchten Sie rechnen?</p>
        <div class="rkalk__arten" role="radiogroup" aria-labelledby="rKalkFrage">
          {KALK_ARTEN.map((k, i) => (
            <label class="rart">
              <input type="radio" name="rKalkArt" value={k.id} checked={i === 0} />
              <span class="rart__text"><strong>{k.label}</strong><small>{k.hint}</small></span>
            </label>
          ))}
        </div>
        <fieldset class="rextras" id="rExtras" hidden>
          <legend class="rfrage">Ihre Extras <span class="rextras__opt">(optional)</span></legend>
          <div class="rextras__liste" id="rExtrasListe">
            {mitKalk && erstes.extras!.map((x) => (
              <label class="rextra"><input type="checkbox" value={x.id} /><span>{x.label}</span></label>
            ))}
          </div>
          {/* Kundenwunsch 14.10.2026 (48): kein Live-Preis – der Preis erscheint erst nach „Preisspanne anzeigen“ */}
        </fieldset>
      </div>
      {/* Kundenwunsch 13.10.2026 (21): kein Brutto-Hinweis mehr über „Preisspanne anzeigen“ (auf der Ergebnisseite bleibt er, PAngV) */}

      <div class="rnav">
        {!start && <button class="btn btn--ghost rnav__zurueck" type="button" id="rZurueck2">Zurück</button>}
        {start && <button class="btn btn--ghost rnav__zurueck" type="button" id="rZurueckTeil" hidden>Zurück</button>}
        <button class="btn rechner__next" type="button" id="rWeiter">Preisspanne anzeigen</button>
      </div>
    </section>

    <!-- Schritt 3: Ergebnis – Preis + sauber gruppierte Auswahl + Kontaktwege -->
    <section class="rstep" data-step="3" hidden>
      <H class="rstep__title" id="rErgebnisTitel">Ihre erste Preisspanne</H>
      <p class="rechner__result" id="rErgebnis" role="status">–</p>
      <p class="rbrutto" id="rBrutto">{MWST_HINWEIS}</p>

      <div class="rwahl" id="rWahl" aria-label="Ihre Auswahl"></div>

      <button class="btn btn--ghost btn--sm" type="button" id="rAendern">
        Angaben ändern
      </button>
      <p class="small rechner__disclaimer">
        Unverbindliche Preisspanne, inkl. Material und Arbeit – {MWST_HINWEIS.replace("Bruttopreise", "Bruttopreis")}
        Ihren <strong>Festpreis</strong> nennen wir Ihnen nach einem kostenlosen Vor-Ort-Termin.
      </p>
      {/* Kundenwunsch 19.10.2026 (Audit 6.3): Rückruf-Formular direkt unter der Preisspanne */}
      <RueckrufFormular
        id={`rRueckruf-${variant}`}
        rechner
        titel="Rückruf zu Ihrer Preisspanne"
        text="Name und Telefonnummer genügen – wir rufen Sie innerhalb von 12 Stunden zurück und besprechen Ihr Projekt."
        betreff="Rückruf zur Preisspanne"
      />
      <div class="rechner__contact">
        {start ? (
          <a class="btn btn--lg" href={TERMIN.href} target="_blank" rel="noopener" data-termin>
            <Icon name="calendar" size={20} class="icon" /> {TERMIN.label}
          </a>
        ) : (
          <a class="btn btn--lg" href="#termin">
            <Icon name="calendar" size={20} class="icon" /> {TERMIN.label}
          </a>
        )}
        <a class="btn btn--dark btn--lg" id="rWhatsapp" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} class="icon" /> Anfrage per WhatsApp senden
        </a>
        <a class="btn btn--ghost btn--lg" id="rMail" href={`mailto:${EMAILS.service}`}>
          <Icon name="mail" size={20} class="icon" /> Anfrage per E-Mail senden
        </a>
      </div>
    </section>

    {PAUSCHAL_DATA.map((p) => (
      /* Pauschal-Leistung: Festpreis statt Berechnung */
      <section class="rstep rpausch" data-step={`p-${p.slug}`} hidden>
        <p class="rpanel__gewerk">{p.label}</p>
        <H class="rstep__title">Ihr Pauschalpreis</H>
        <p class="rechner__result">{euro(p.preis)} € <span class="rpausch__art">pauschal</span></p>
        <p class="rbrutto">{MWST_HINWEIS.replace("Bruttopreise", "Bruttopreis")}</p>
        <div class="rwahl">
          <div class="rwahl__gruppe">
            <HSub class="rwahl__titel">Das ist enthalten</HSub>
            <ul>{p.enthalten.map((e) => <li>{e}</li>)}</ul>
          </div>
        </div>
        <p class="small rechner__disclaimer">
          Keine Berechnung nötig: Der {p.label} kostet immer {euro(p.preis)} €.
          {p.hinweis && <strong class="rpausch__hinweis">{p.hinweis}</strong>}
          <a href={u(`leistungen/${p.slug}/`)}>Mehr zum {p.label}</a>
        </p>
        <div class="rechner__contact">
          <a class="btn btn--lg" href={TERMIN.href} target="_blank" rel="noopener" data-termin>
            <Icon name="calendar" size={20} class="icon" /> {p.cta ?? `${p.label.replace("Immobilien-", "")} buchen`}
          </a>
          <a
            class="btn btn--dark btn--lg"
            href={waLink(`Hallo Bauwelt Handwerk! 👋\n\nIch interessiere mich für den ${p.label} (Pauschalpreis ${euro(p.preis)} €).\n\nBitte melden Sie sich bei mir für einen Termin. Vielen Dank! 🙏`)}
            target="_blank" rel="noopener"
          >
            <Icon name="whatsapp" size={20} class="icon" /> Anfrage per WhatsApp senden
          </a>
          <a
            class="btn btn--ghost btn--lg"
            href={`mailto:${EMAILS.service}?subject=${encodeURIComponent(`Anfrage: ${p.label}`)}&body=${encodeURIComponent(`Guten Tag,\n\nich interessiere mich für den ${p.label} (Pauschalpreis ${euro(p.preis)} €).\n\nAdresse der Immobilie:\nWunschtermin:\nName:\nTelefonnummer:\n`)}`}
          >
            <Icon name="mail" size={20} class="icon" /> Anfrage per E-Mail senden
          </a>
        </div>
        {!start && (
          <button class="btn btn--ghost btn--sm rpausch__zurueck" type="button" data-zurueck>Andere Leistung wählen</button>
        )}
      </section>
    ))}
  </div>
</div>

<style>
  html:not(.js) .rechner__app:not(.rechner__app--start),
  html:not(.js) .rechner__app--start .rechner__panel { display: none; }
  html.js .rechner__nojs { display: none; }

  /* Einleitungsabsatz über dem Rechner (ein Block, gleicher Stil wie der Lead-Text) */
  .rintro { max-width: 680px; margin: -8px auto 28px; text-align: center; }
  .rintro--start { margin-bottom: 32px; }
  .rbrutto { margin: -8px 0 14px; font-size: 13.5px; font-weight: 700; color: var(--anthrazit-700); }
  .rbrutto--klein { margin: -8px 0 16px; font-size: 12.5px; font-weight: 600; color: var(--anthrazit-600); }

  .rechner__nojs { text-align: center; display: grid; gap: 16px; justify-items: center; }
  .rechner__nojs-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .rechner__app--start ~ .rechner__nojs, .rechner__nojs + .rechner__app--start { margin-top: 24px; }

  .rechner__app {
    position: relative;
    padding: 28px 20px;
    /* Schrittwechsel: Anfang landet UNTER dem fixierten Header – alles sofort im Blick */
    scroll-margin-top: calc(var(--header-h) + 12px);
  }
  @media (min-width: 768px) { .rechner__app { padding: 40px; } }
  /* hidden-Attribut muss auch gegen display:grid/flex der Klassen gewinnen */
  .rechner__app [hidden] { display: none !important; }

  .rechner__progress {
    height: 6px; border-radius: var(--radius-pill);
    background: var(--anthrazit-100);
    overflow: hidden;
    margin-bottom: 28px;
  }
  .rechner__bar { display: block; height: 100%; background: var(--gold-500); transition: width var(--dur-base) var(--ease); }

  .rstep__title { font-size: clamp(20px, 3vw, 26px); }
  /* Schritt-Anzeige über dem Balken (Audit 1.5) */
  .rschritt { margin: 0 0 8px; font-size: 14px; font-weight: 700; color: var(--gold-700); letter-spacing: 0.02em; }
  .rschritt:empty { display: none; }

  .rechner__tiles { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  .rtile {
    display: grid; justify-items: center; gap: 10px;
    padding: 22px 12px;
    background: var(--weiss);
    border: 2px solid var(--linie);
    border-radius: var(--radius-lg);
    font-family: var(--font-heading); font-weight: 600; font-size: 14px;
    color: var(--anthrazit-800);
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }
  .rtile :global(.icon) { color: var(--gold-700); width: 30px; height: 30px; }
  .rtile__text { display: grid; gap: 4px; text-align: center; line-height: 1.3; }
  .rtile__text small { font-family: var(--font-body); font-weight: 600; font-size: 13px; color: var(--anthrazit-600); }
  .rtile:hover { border-color: var(--gold-500); transform: translateY(-2px); }
  .rtile.selected { border-color: var(--gold-500); background: var(--gold-100); }
  .rtile:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .rpausch__art { font-size: 0.5em; font-weight: 700; color: var(--anthrazit-600); }
  .rpausch__zurueck { margin-top: 18px; }
  .rpausch__hinweis { display: block; margin-top: 8px; color: var(--anthrazit-800); }
  .rpausch .rwahl { grid-template-columns: 1fr; }

  /* ---------- Startseite: Leistungskarten + Rechner-Panel ---------- */
  .rechner__app--start {
    padding: 0;
    display: grid; gap: 16px;
    grid-template-columns: minmax(0, 1fr);
    max-width: 1080px; margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .rechner__app--start { grid-template-columns: minmax(300px, 360px) minmax(0, 1fr); gap: 24px; align-items: start; }
  }
  .rkarten { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* ungerade Anzahl: letzte Karte über die volle Breite (seit 16.10.2026 (73) sind es 6 Leistungen) */
  .rkarte:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .rkarten { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    /* Kalkulation bleibt beim Durchsehen der Karten im Blick */
    .rechner__app--start .rechner__panel { position: sticky; top: calc(var(--header-h) + 16px); }
  }

  .rkarte {
    position: relative;
    display: grid; grid-template-rows: 1fr auto;
    background: var(--weiss);
    border: 2px solid var(--linie);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
