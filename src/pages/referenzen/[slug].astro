---
// Referenz-Detailseite: großes Bild, Eckdaten, Beschreibung, weitere Projekte.
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHead from "../../components/SectionHead.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import Img from "../../components/Img.astro";
import { u } from "../../consts";

export async function getStaticPaths() {
  const referenzen = await getCollection("referenzen");
  return referenzen.map((r) => ({ params: { slug: r.id }, props: { r } }));
}

const { r } = Astro.props;
const { Content } = await render(r);

const weitere = (await getCollection("referenzen"))
  .filter((x) => x.id !== r.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={`${r.data.title} – Referenz aus ${r.data.place} | Bauwelt Handwerk`}
  description={`Referenzprojekt ${r.data.title} in ${r.data.place}${r.data.leistung ? ` – ${r.data.leistung}` : ""}${r.data.dauer ? `, umgesetzt in ${r.data.dauer}` : ""}.`}
>
  <section class="section rdetail">
    <div class="container">
      <div class="eyebrow">Referenz</div>
      <h1>{r.data.title}</h1>

      <div class="rdetail__grid">
        <div class="rdetail__media reveal">
          <Img src={r.data.file ?? `${r.id}.webp`} alt={r.data.title} w={960} h={720} eager />
        </div>
        <aside class="card rdetail__facts">
          <h2>Eckdaten</h2>
          <dl>
            <dt><Icon name="pin" size={16} class="icon" /> Ort</dt>
            <dd>{r.data.place}</dd>
            {r.data.dauer && (<><dt><Icon name="clock" size={16} class="icon" /> Dauer</dt><dd>{r.data.dauer}</dd></>)}
            {r.data.leistung && (<><dt><Icon name="tools" size={16} class="icon" /> Leistung</dt><dd>{r.data.leistung}</dd></>)}
          </dl>
          {r.data.quote && <blockquote class="rdetail__quote">„{r.data.quote}"</blockquote>}
          <a class="btn" href={u("rechner/")}>Ähnliches Projekt berechnen</a>
        </aside>
      </div>

      <div class="rdetail__prose">
        <Content />
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHead eyebrow="Weitere Projekte" pre="Mehr davon " accent="sehen" />
      <div class="grid cols-3">
        {weitere.map((w) => (
          <a class="card refcard reveal" href={u(`referenzen/${w.id}/`)}>
            <Img src={w.data.file ?? `${w.id}.webp`} alt={w.data.title} w={520} h={390} />
            <div class="refcard__body">
              <h3>{w.data.title}</h3>
              <p class="small"><Icon name="pin" size={14} class="icon" /> {w.data.place}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand pre="Ihr Projekt könnte das nächste " accent="sein" />
</BaseLayout>

<style>
  .rdetail h1 { margin-bottom: 24px; }
  .rdetail__grid { display: grid; gap: 24px; margin-bottom: 32px; }
  @media (min-width: 1024px) { .rdetail__grid { grid-template-columns: 1.6fr 1fr; align-items: start; } }

  .rdetail__facts { display: grid; gap: 16px; align-content: start; }
  .rdetail__facts h2 { font-size: 18px; margin: 0; }
  .rdetail__facts dl { margin: 0; display: grid; gap: 10px; }
  .rdetail__facts dt {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--anthrazit-600);
  }
  .rdetail__facts dt :global(.icon) { color: var(--gold-700); }
  .rdetail__facts dd { margin: 0 0 6px; font-weight: 600; }
  .rdetail__quote { margin: 0; font-style: italic; color: var(--anthrazit-700); }
  .rdetail__prose { max-width: var(--text-width); }

  .refcard { padding: 12px; display: grid; }
  .refcard__body { padding: 14px 10px 6px; }
  .refcard__body h3 { margin: 0 0 4px; font-size: 17px; text-transform: none; letter-spacing: 0; }
  .refcard__body p { margin: 0; display: inline-flex; align-items: center; gap: 6px; }
  .refcard__body :global(.icon) { color: var(--gold-700); }
</style>
