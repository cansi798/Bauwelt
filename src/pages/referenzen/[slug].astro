---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { u } from "../../consts";
import Icon from "../../components/Icon.astro";
import SectionHead from "../../components/SectionHead.astro";
import Placeholder from "../../components/Placeholder.astro";
import CtaBand from "../../components/CtaBand.astro";
import PageHero from "../../components/PageHero.astro";

export async function getStaticPaths() {
  const referenzen = await getCollection("referenzen");
  return referenzen.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"referenzen">; }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const facts = [
  data.leistung && { icon: "reno", label: "Leistung", value: data.leistung },
  { icon: "pin", label: "Ort", value: data.place },
  data.dauer && { icon: "clock", label: "Dauer", value: data.dauer },
].filter(Boolean) as { icon: string; label: string; value: string }[];
---
<BaseLayout title={`${data.title} – Referenz – Bauwelt Handwerk`} active="Referenzen"
  description={`${data.leistung ?? "Projekt"} in ${data.place} – ${data.title}.`}>
  <PageHero
    eyebrow="Referenz"
    title={data.title}
    crumbs={[{ label: "Start", href: u("") }, { label: "Referenzen", href: u("referenzen/") }, { label: data.title }]}
    prompt={data.prompt}
    img={data.file}
  />

  <section class="section">
    <div class="container">
      <div class="grid cols-3" style="margin-bottom:48px">
        {facts.map((f) => (
          <div class="card" style="display:flex;gap:14px;align-items:flex-start">
            <span style="color:var(--gold-700)"><Icon name={f.icon} /></span>
            <div>
              <div class="small" style="text-transform:uppercase;letter-spacing:.04em">{f.label}</div>
              <div style="font-family:var(--font-heading);font-weight:700">{f.value}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="prose" style="margin-bottom:48px"><Content /></div>

      <SectionHead pre="Vorher / " accent="Nachher" />
      <div class="grid cols-2">
        <figure>
          <div class="tile" style="aspect-ratio:4/3">
            <Placeholder prompt={`Vorher-Zustand: ${data.prompt}`} showKi={true} />
          </div>
          <figcaption class="small" style="margin-top:8px">Vorher</figcaption>
        </figure>
        <figure>
          <div class="tile" style="aspect-ratio:4/3">
            <Placeholder prompt={`Nachher-Ergebnis: ${data.prompt}`} img={data.file} imgClass="tile__img" showKi={true} />
          </div>
          <figcaption class="small" style="margin-top:8px">Nachher</figcaption>
        </figure>
      </div>

      <p style="margin-top:32px"><a class="textlink" href={u("referenzen/")}>Alle Referenzen <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <CtaBand title="Ein ähnliches Projekt geplant?" />
</BaseLayout>
