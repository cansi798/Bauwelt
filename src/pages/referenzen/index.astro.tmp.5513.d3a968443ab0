---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { u } from "../../consts";
import SectionHead from "../../components/SectionHead.astro";
import Gallery from "../../components/Gallery.astro";
import CtaBand from "../../components/CtaBand.astro";
import PageHero from "../../components/PageHero.astro";

const referenzen = (await getCollection("referenzen"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((r) => ({ ...r.data, slug: r.slug }));
---
<BaseLayout title="Referenzen – Bauwelt Handwerk" active="Referenzen"
  description="Ausgewählte Projekte von Bauwelt Handwerk: Badsanierungen, Modernisierungen und Dacharbeiten in Hamburg und Umgebung.">
  <PageHero
    eyebrow="Referenzen"
    title="Ergebnisse, die man sieht"
    lead="Eine Auswahl unserer Projekte in Hamburg und Umgebung. Klicken Sie ein Projekt an, um mehr zu erfahren."
    crumbs={[{ label: "Start", href: u("") }, { label: "Referenzen" }]}
    prompt="Collage schöner sanierter Bäder und Wohnräume, warmes Licht, echtes Handwerk"
  />
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Galerie" pre="Unsere " accent="Projekte" />
      <Gallery projects={referenzen} />
    </div>
  </section>
  <CtaBand />
</BaseLayout>
