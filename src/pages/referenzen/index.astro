---
// Referenzen-Übersicht: Galerie mit Gewerk-Filter.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
import CtaBand from "../../components/CtaBand.astro";

const referenzen = (await getCollection("referenzen")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Referenzen – Projekte aus Norderstedt & Hamburg | Bauwelt Handwerk"
  description="Sanierte Bäder, modernisierte Wohnungen, neue Dächer: echte Bauwelt-Projekte aus Norderstedt, Hamburg und Umgebung – mit Ort, Dauer und Leistungsumfang."
>
  <PageHero
    eyebrow="Referenzen"
    pre="Ergebnisse, die man "
    accent="sieht"
    lead="Jedes Projekt hier wurde von uns geplant, koordiniert und übergeben. Schauen Sie sich um – so arbeiten wir."
    bild="hero-referenzen.webp"
    alt="Modern saniertes Bad mit Glasdusche und Holz-Waschtisch"
  />

  <section class="section">
    <div class="container">
      <Gallery projects={referenzen} />
    </div>
  </section>

  <CtaBand pre="Ihr Projekt könnte das nächste " accent="sein" />
</BaseLayout>
