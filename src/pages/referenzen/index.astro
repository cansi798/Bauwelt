---
// Referenzen-Übersicht: Galerie nach Leistungen (Daten: src/data/galerie.ts).
// Die Projekt-Detailseiten unter /referenzen/<slug>/ bleiben erreichbar.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
import CtaBand from "../../components/CtaBand.astro";
---

<BaseLayout
  title="Referenzen aus Norderstedt & Hamburg | Bauwelt Handwerk"
  description="Sanierte Bäder, modernisierte Küchen und Wohnungen, Fliesenarbeiten und Innenausbau: echte Bauwelt-Projekte aus Norderstedt, Hamburg und Umgebung – sortiert nach Leistung."
>
  <PageHero
    eyebrow="Referenzen"
    pre="Ergebnisse, die man "
    accent="sieht"
    lead="Jedes Projekt hier wurde von uns geplant, koordiniert und übergeben. Schauen Sie sich um – so arbeiten wir."
    bild="hero-referenzen.webp"
    alt="Modern saniertes Bad mit Glasdusche und Holz-Waschtisch"
  />

  <section class="section">
    <div class="container">
      <Gallery />
    </div>
  </section>

  <CtaBand pre="Ihr Projekt könnte das nächste " accent="sein" />
</BaseLayout>
