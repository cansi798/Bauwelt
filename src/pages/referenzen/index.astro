---
// Referenzen-Übersicht: Galerie nach Leistungen (Daten: src/data/galerie.ts).
// Finale Struktur nach Kundenwunsch 14.10.2026 (36): Hero → Filter → je Kategorie Einleitung,
// Projektkarten (Foto + Projektname + ggf. Projektdaten) und Link zur Leistung → Abschluss mit CTAs.
// Die Projekt-Detailseiten unter /referenzen/<slug>/ bleiben erreichbar.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
import SectionHead from "../../components/SectionHead.astro";
import { CTA, TERMIN } from "../../consts";
---

<BaseLayout
  title="Referenzen: Bäder & Sanierungen aus Norderstedt | Bauwelt"
  description="Echte Projekte aus Norderstedt, Hamburg und Umkreis: sanierte Bäder, modernisierte Küchen, Fliesen- und Innenausbau – sortiert nach Leistung."
>
  <PageHero
    eyebrow="Referenzen"
    pre="Ergebnisse, die man "
    accent="sieht."
    lead="Jedes Projekt wurde von uns geplant, koordiniert und umgesetzt. Entdecken Sie eine Auswahl abgeschlossener Projekte aus den Bereichen Badsanierung, Komplettsanierung & Modernisierung, Fliesen- & Bodenlegerarbeiten sowie Innenausbau & Trockenbau."
    bild="galerie-bad-03.webp" /* Audit 7.2 (19.10.2026): echtes Projektfoto statt KI-Bild */
    alt="Großzügiges Bad mit dunklen Großformatfliesen und LED-Spiegel – echtes Bauwelt-Projekt in Hamburg"
  />

  <section class="section">
    <div class="container">
      <Gallery />
    </div>
  </section>

  <!-- Abschlussbereich (Kundenwunsch 14.10.2026 (36)) -->
  <section class="section section--sand rabschluss">
    <div class="container rabschluss__inner">
      <SectionHead center eyebrow="Ihr Projekt" pre="Gefällt Ihnen, was Sie " accent="sehen?" text="Jedes dieser Projekte begann mit einer Idee. Lassen Sie uns gemeinsam über Ihr Vorhaben sprechen." />
      <div class="rabschluss__actions">
        <a class="btn btn--lg" href={CTA.href}>{CTA.label}</a>
        <a class="btn btn--lg btn--ghost" href={TERMIN.href} target="_blank" rel="noopener" data-termin>{TERMIN.label}</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .rabschluss__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 16px; }
  @media (max-width: 767px) {
    .rabschluss__actions { display: grid; }
    .rabschluss__actions .btn { width: 100%; white-space: normal; text-align: center; }
  }
</style>
