---
// Referenzen-Übersicht: Galerie nach Leistungen (Daten: src/data/galerie.ts).
// Finale Struktur nach Kundenwunsch 14.10.2026 (36): Hero → Filter → je Kategorie Einleitung,
// Projektkarten (Foto + Projektname + ggf. Projektdaten) und Link zur Leistung (Abschluss mit CTAs seit 27.10.2026 entfernt).
// Die Projekt-Detailseiten unter /referenzen/<slug>/ bleiben erreichbar.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Gallery from "../../components/Gallery.astro";
---

<BaseLayout
  title="Referenzen aus Norderstedt & Hamburg | Bauwelt Handwerk"
  description="Projektbeispiele aus Norderstedt, Hamburg und Umkreis: Bäder, Küchen, Fliesen- und Innenausbau – sortiert nach Leistung."
>
  <PageHero
    eyebrow="Referenzen"
    pre="Ergebnisse, die man "
    accent="sieht."
    lead="Lassen Sie sich inspirieren: Entdecken Sie eine Auswahl an Projektbeispielen aus den Bereichen Badsanierung, Komplettsanierung & Modernisierung, Fliesen- & Bodenlegerarbeiten sowie Innenausbau & Trockenbau."
    bild="galerie-bad-03.webp" /* Audit 7.2 (19.10.2026): echtes Projektfoto statt KI-Bild */
    alt="Großzügiges Bad mit dunklen Großformatfliesen und LED-Spiegel"
  />

  <section class="section section--sand">
    <div class="container">
      <Gallery />
    </div>
  </section>

  {/* Abschlussbereich „Gefällt Ihnen, was Sie sehen?“ entfernt (Jamil 27.10.2026, Talk 3490). Termin/Preis bleiben über Kopfzeile, Sticky-Leiste und Footer erreichbar. */}

</BaseLayout>
