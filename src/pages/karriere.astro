---
// Karriere – Kundenwunsch 14.10.2026 (38): finale Struktur von Jamil, Texte wörtlich:
// 1 Hero → 2 Was Sie bei uns erwartet (dunkel) → 3 Bonusmodell → 4 Was Sie verdienen können
// → 5 Unsere Kultur → 6 Offene Stellen (aus src/content/stellen, `offen: true`) bzw.
// „Derzeit suchen wir keine Verstärkung.“ + Initiativbewerbung → 7 Bewerbung ohne Hürden.
// Ansprache durchgehend "Sie".
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Icon from "../components/Icon.astro";
import Img from "../components/Img.astro";
import RoughSzene from "../components/RoughSzene.astro";
import { EMAILS, SITE, waLink } from "../consts";

/** Kundenwunsch 14.10.2026 (38), Abschnitt 4: Jamil: „Die genauen Zahlen natürlich erst
 *  festlegen.“ → Abschnitt ist fertig gebaut, aber ausgeblendet, bis Bauwelt die Gehälter
 *  freigibt. Zum Einblenden auf `true` setzen (Beträge ggf. unten in VERGUETUNG anpassen). */
const VERGUETUNG_FREIGEGEBEN = false;

const ERWARTET = [
  { icon: "euro", title: "Leistung wird belohnt", text: "Neben einem fairen Grundgehalt können Sie durch erfolgreich abgeschlossene Projekte zusätzliche Prämien erhalten." },
  { icon: "arrow", title: "Mehr verdienen statt nur mehr arbeiten", text: "Wer Verantwortung übernimmt, sauber arbeitet und gute Ergebnisse liefert, soll auch finanziell davon profitieren." },
  { icon: "reno", title: "Regionale Baustellen", text: "Unsere Projekte liegen in Hamburg und Umgebung. Abends zu Hause statt auf Montage." },
  { icon: "hand", title: "Direkter Draht zur Geschäftsführung", text: "Kurze Wege, schnelle Entscheidungen und ein Team, in dem jede Meinung zählt." },
];

const VERGUETUNG = [
  { title: "Fliesenleger / Handwerker (m/w/d)", betrag: "3.500 € – 5.000 € brutto möglich", text: "Je nach Erfahrung, Verantwortung und Projektbeteiligung." },
  { title: "Helfer / Bauhelfer (m/w/d)", betrag: "z. B. 2.800 € – 3.500 € brutto möglich" },
  { title: "Vorarbeiter / Bauleiter (m/w/d)", betrag: "Individuelle Vergütung + Projektbeteiligung" },
];

const stellen = (await getCollection("stellen"))
  .filter((s) => s.data.offen)
  .sort((a, b) => a.data.order - b.data.order);
const hatStellen = stellen.length > 0;

// Sand/Weiß abwechselnd – auch wenn Abschnitt 4 ausgeblendet ist
const folge = ["bonus", ...(VERGUETUNG_FREIGEGEBEN ? ["verguetung"] : []), "kultur", "stellen", "bewerbung"];
const bg = (name: string) => ["section", { "section--sand": folge.indexOf(name) % 2 === 1 }];

const mailBewerbung = (betreff: string) => `mailto:${EMAILS.bewerbung}?subject=${encodeURIComponent(betreff)}`;
---

<BaseLayout
  sticky={[
    { label: "Jetzt bewerben", href: "#bewerben" },
    { label: "WhatsApp", href: waLink("Hallo Bauwelt Handwerk, ich interessiere mich für eine Stelle bei Ihnen. Bitte melden Sie sich bei mir."), extern: true },
  ] /* Audit 1.7 */}
  footerNurNav
  title="Karriere – Jobs in Norderstedt | Bauwelt Handwerk" /* S2 (Jamil 20.10., Talk 2787): ≤ 60 Zeichen, Ende „… Handwerk“ */
  description="Jobs im Handwerk in Norderstedt: faires Grundgehalt plus Projektprämien, Baustellen in Norderstedt, Hamburg und Umkreis. Bewerbung per WhatsApp oder E-Mail."
>
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Karriere"
    pre="Gute Handwerker verdienen "
    accent="mehr."
    lead="Wir suchen Menschen, die sauberes Handwerk, klare Prozesse und Verantwortung schätzen."
  >
    {/* Jamil 20.10.2026 (Talk 2787, Gesamt-Audit T3/W1): statt Stockfoto team.webp vier gezeichnete
        Gesichter im Skizzen-Stil der Seite (Szene „team“ in src/data/szenen.ts) – symbolisch für die
        Mitarbeitenden, keine echten Personen, keine Namen. Kein Foto → kein KI-/Stock-Hinweis nötig. */}
    <figure class="karriere__team" slot="medien">
      <RoughSzene
        szene="team"
        label="Gezeichnete Illustration im Comic-Stil: vier Handwerker-Gesichter in Arbeitskleidung – mit Bart, mit Haarknoten, mit Bauhelm und Brille, mit Mütze. Symbolbild, keine echten Personen."
      />
      <figcaption>Illustration – symbolisch für unser Team</figcaption>
    </figure>
    <p>
      Bei Bauwelt Handwerk zählt nicht nur, wie lange jemand arbeitet, sondern welche Qualität geliefert
      wird. Deshalb schaffen wir ein Umfeld, in dem Leistung gesehen, geschätzt und belohnt wird.
    </p>
  </PageHero>

  <!-- 2. Was Sie bei uns erwartet -->
  <section class="section section--dark">
    <div class="container">
      <SectionHead center eyebrow="Warum Bauwelt" pre="Handwerk, wie es auch für Mitarbeiter sein " accent="sollte." />
      <ul class="warum">
        {ERWARTET.map((w, i) => (
          <li class="warum__item reveal">
            <span class:list={["warum__icon", { "karriere__trend": w.icon === "arrow" }]}><Icon name={w.icon} size={24} class="icon" /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Unser Bonusmodell -->
  <section class:list={bg("bonus")}>
    <div class="container karriere__bonus">
      <SectionHead center eyebrow="Leistung soll sich lohnen" pre="Faire Bezahlung. Prämien für gute " accent="Projekte." /> {/* Audit 4.8: positiv statt abwertend */}
      <div class="karriere__prosa">
        <p class="lead">Wir bezahlen fair – und belohnen gute Projekte zusätzlich.</p>
        <p>Deshalb kombinieren wir ein faires Grundgehalt mit leistungsabhängigen Projektprämien.</p>
        <p>Wer Projekte in hoher Qualität und innerhalb der vereinbarten Zeit abschließt, profitiert direkt vom gemeinsamen Erfolg.</p>
      </div>
    </div>
  </section>

  <!-- 4. Was Sie verdienen können (ausgeblendet bis zur Freigabe der Zahlen, s. o.) -->
  {VERGUETUNG_FREIGEGEBEN && (
    <section class:list={bg("verguetung")}>
      <div class="container">
        <SectionHead center eyebrow="Transparente Vergütung" pre="Was Sie bei uns verdienen " accent="können." />
        <ul class="verdienst">
          {VERGUETUNG.map((v) => (
            <li class="card verdienst__karte reveal">
              <span class="verdienst__icon"><Icon name="euro" size={24} class="icon" /></span>
              <h3>{v.title}</h3>
              <p class="verdienst__betrag">{v.betrag}</p>
              {v.text && <p class="verdienst__text">{v.text}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 5. Unsere Kultur -->
  <section class:list={bg("kultur")}>
    <div class="container karriere__kultur">
      <div>
        <SectionHead eyebrow="Unsere Überzeugung" pre="Gute Arbeit beginnt beim " accent="Team." />
        <div class="karriere__prosa karriere__prosa--links">
          <p class="lead">
            Wir sind überzeugt, dass hochwertige Arbeit nur dort entstehen kann, wo Menschen respektvoll
            miteinander umgehen.
          </p>
          <p>
            Verlässlichkeit, Ehrlichkeit und Verantwortung gelten bei uns nicht nur gegenüber Kunden, sondern
            auch innerhalb des Teams.
          </p>
        </div>
      </div>
      <div class="karriere__kultur-bild reveal">
        <Img src="hero-karriere.webp" alt="Handwerker beim Trockenbau" w={720} h={540} />
      </div>
    </div>
  </section>

  <!-- 6. Offene Stellen: offene Stellen aus src/content/stellen (offen: true), sonst Hinweis -->
  <section class:list={bg("stellen")} id="stellen">
    <div class="container">
      {hatStellen
        ? <SectionHead eyebrow="Offene Stellen" pre="Aktuell suchen " accent="wir …" />
        : <SectionHead eyebrow="Bewerben" pre="Initiativ bewerben – wir suchen immer gute " accent="Leute." /> /* Audit 6.8 (19.10.2026) */}
      <div class:list={["grid", "stellen__grid", { "stellen__grid--leer": !hatStellen }]}>
        {stellen.map((s) => (
          <article class="card stelle reveal">
            <header class="stelle__head">
              <h3>{s.data.title}</h3>
              <p class="small">{s.data.art} · {s.data.ort}</p>
            </header>
            {s.data.aufgaben.length > 0 && (
              <div>
                <h4>Aufgaben</h4>
                <ul>{s.data.aufgaben.map((a) => <li>{a}</li>)}</ul>
              </div>
            )}
            {s.data.profil.length > 0 && (
              <div>
                <h4>Profil</h4>
                <ul>{s.data.profil.map((p) => <li>{p}</li>)}</ul>
              </div>
            )}
            <a class="btn" href={mailBewerbung(`Bewerbung: ${s.data.title}`)}>
              <Icon name="mail" size={18} class="icon" /> Jetzt bewerben
            </a>
          </article>
        ))}
        <article class="card stelle stelle--initiativ reveal">
          <header class="stelle__head">
            <h3>Initiativbewerbung</h3>
          </header>
          <p class="stelle__text">
            Gute Handwerker finden bei uns immer einen Platz.
          </p>
          <p class="stelle__text">
            Erzählen Sie uns kurz, wer Sie sind und was Sie können. Den Rest besprechen wir persönlich.
          </p>
          {/* Audit 6.8: WhatsApp als Hauptweg, E-Mail daneben */}
          <div class="stelle__wege">
            <a class="btn" href={waLink("Hallo Bauwelt Handwerk, ich möchte mich initiativ bewerben. Kurz zu mir: ")} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={18} class="icon" /> Per WhatsApp bewerben
            </a>
            <a class="btn btn--ghost" href={mailBewerbung("Initiativbewerbung")}>
              <Icon name="mail" size={18} class="icon" /> Per E-Mail
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 7. Bewerbung ohne Hürden (Buttons wie Partner-Seite; nicht in der Sticky-Leiste ⇒ auch mobil) -->
  <section class:list={bg("bewerbung")} id="bewerben">
    <div class="container text-center karriere__cta">
      <SectionHead center eyebrow="So einfach geht's" pre="Bewerbung ohne " accent="Hürden." />
      <div class="karriere__prosa">
        <p class="lead">Kein Bewerbungsportal. Kein Anschreiben-Roman. Keine komplizierten Formulare.</p>
        <p>Eine kurze Nachricht oder Ihr Lebenslauf genügt.</p>
        <p>Wir melden uns innerhalb von 24 Stunden zurück.</p>
      </div>
      <div class="karriere__buttons">
        <a class="btn btn--lg" href={mailBewerbung("Bewerbung")}>
          <Icon name="mail" size={20} class="icon" /> Bewerbung per E-Mail senden
        </a>
        <a class="btn btn--dark btn--lg" href={waLink("Hallo Bauwelt Handwerk, ich interessiere mich für eine Stelle bei Ihnen. Bitte melden Sie sich bei mir.")} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} class="icon" /> Per WhatsApp schreiben
        </a>
        <a class="btn btn--ghost btn--lg" href={`tel:${SITE.phoneTel}`}>
          <Icon name="phone" size={20} class="icon" /> {SITE.phoneDisplay} anrufen
        </a>
      </div>
      <p class="small">{EMAILS.bewerbung}</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Karriere-Startbild als Zeichnung (T3): Sand-Fläche wie ein Bildrahmen, Zeichnung darin */
  .karriere__team { margin: 0; padding: 18px 12px 10px; border-radius: var(--radius-lg); background: var(--gold-100); }
  .karriere__team :global(.rszene) { margin: 0; }
  .karriere__team :global(.rszene__bild) { max-width: none; }
  .karriere__team figcaption { margin-top: 6px; text-align: center; font-size: 13px; color: var(--anthrazit-600); }

  /* Pfeil-Icon schräg nach oben = „mehr verdienen“ */
  .karriere__trend :global(.icon) { transform: rotate(-45deg); }

  .karriere__prosa { max-width: var(--text-width); margin-inline: auto; display: grid; gap: 14px; }
  .karriere__prosa p { margin: 0; }
  .karriere__bonus .karriere__prosa { text-align: center; }
  .karriere__prosa--links { margin-inline: 0; }

  .karriere__kultur { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 1024px) { .karriere__kultur { grid-template-columns: 1.1fr 1fr; gap: 64px; } }

  .verdienst { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 900px) { .verdienst { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .verdienst__karte { display: grid; gap: 10px; align-content: start; border-top: 4px solid var(--gold-500); }
  .verdienst__karte h3 { margin: 0; font-size: 17px; text-transform: none; letter-spacing: 0; }
  .verdienst__betrag { margin: 0; font-family: var(--font-heading); font-weight: 800; font-size: 22px; line-height: 1.3; color: var(--gold-700); }
  .verdienst__text { margin: 0; font-size: 15px; color: var(--anthrazit-700); }
  .verdienst__icon {
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--gold-100); color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
  }

  .stellen__grid { grid-template-columns: 1fr; }
  @media (min-width: 768px) { .stellen__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .stellen__grid { grid-template-columns: repeat(3, 1fr); } }
  .stellen__grid--leer { max-width: 560px; }
  @media (min-width: 768px) { .stellen__grid--leer { grid-template-columns: 1fr; } }
  /* Flex-Spalte + margin-top:auto ⇒ „Jetzt bewerben" sitzt in allen Karten bündig unten */
  .stelle { display: flex; flex-direction: column; gap: 16px; }
  .stelle .btn { margin-top: auto; align-self: flex-start; }
  .stelle--initiativ { border: 2px dashed var(--gold-500); background: var(--gold-100); }
  .section--sand .stelle--initiativ { background: var(--weiss); }
  .stelle__text { margin: 0; font-size: 15px; color: var(--anthrazit-700); }
  .stelle__wege { display: flex; flex-wrap: wrap; gap: 10px; }
  .stelle__head h3 { margin: 0 0 4px; font-size: 19px; }
  .stelle__head p { margin: 0; }
  .stelle h4 {
    font-family: var(--font-heading); font-size: 13px; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--gold-700); margin: 0 0 8px;
  }
  .stelle ul { margin: 0; padding-left: 20px; display: grid; gap: 4px; font-size: 15px; }

  .karriere__cta { display: grid; justify-items: center; gap: 8px; }
  .karriere__cta .karriere__prosa { margin-bottom: 24px; }
  .karriere__buttons { display: grid; gap: 12px; width: min(100%, 440px); }
  .karriere__buttons .btn { width: 100%; }
  @media (max-width: 767px) {
    .karriere__buttons .btn { white-space: normal; text-align: center; }
  }
</style>
