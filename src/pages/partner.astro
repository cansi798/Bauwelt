---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, u, waLink } from "../consts";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import Steps from "../components/Steps.astro";
import PageHero from "../components/PageHero.astro";

const vorteile = [
  { icon: "euro", title: "Festpreise zum Kalkulieren", text: "Klare Netto-Festpreise, mit denen Sie sicher kalkulieren – ohne Nachträge im Nachhinein." },
  { icon: "user", title: "Deutschsprachige Ansprechpartner", text: "Feste Kontakte, klare Kommunikation, verlässliche Abstimmung auf Augenhöhe." },
  { icon: "hand", title: "Alles aus einer Hand", text: "Vom Bad bis zur Komplettsanierung koordinieren wir alle Gewerke – Sie haben einen Partner." },
  { icon: "calendar", title: "Feste Prozesse & Termine", text: "Zugesagte Termine, saubere Baustellen, dokumentierte Abnahme. Verlässlich planbar." },
  { icon: "shield", title: "Geprüfte Qualität", text: "Abnahme durch den Meister vor Übergabe – Ihr Ruf beim Endkunden bleibt gewahrt." },
  { icon: "reno", title: "Kapazität für Volumen", text: "Ob einzelnes Objekt oder mehrere Einheiten – wir skalieren mit Ihrem Bedarf." },
];
const zielgruppen = [
  { icon: "wall", title: "Hausverwaltungen", text: "Zuverlässige Sanierung von Wohneinheiten, planbar und dokumentiert." },
  { icon: "reno", title: "Bauträger & Investoren", text: "Serielle Bäder und Modernisierungen zum kalkulierbaren Festpreis." },
  { icon: "pin", title: "Makler", text: "Objekte vor dem Verkauf aufwerten – schnell und sauber." },
  { icon: "tools", title: "Handwerksbetriebe", text: "Kapazitäten und Gewerke ergänzen, wenn es bei Ihnen eng wird." },
];
const ablauf = [
  { title: "Anfrage", text: "Sie schildern uns Objekt, Umfang und Zeitrahmen." },
  { title: "Abstimmung", text: "Wir klären Details und Schnittstellen mit Ihrem Team." },
  { title: "Festpreis", text: "Sie erhalten eine klare Kalkulationsgrundlage." },
  { title: "Umsetzung", text: "Wir liefern termingerecht und sauber dokumentiert." },
];
---
<BaseLayout title="Für Partner – Kooperation mit Bauwelt Handwerk" active="Für Partner"
  description="B2B-Kooperation mit Bauwelt Handwerk: Netto-Festpreise zum Kalkulieren, deutschsprachige Ansprechpartner, alles aus einer Hand – für Hausverwaltungen, Bauträger, Makler und Handwerksbetriebe in Hamburg und Umgebung.">
  <PageHero
    eyebrow="Für Geschäftskunden"
    title="Ein verlässlicher Partner am Bau"
    lead="Sie planen mit festen Zahlen? Wir liefern Netto-Festpreise, deutschsprachige Ansprechpartner und alle Gewerke aus einer Hand – damit Ihre Kalkulation aufgeht."
    crumbs={[{ label: "Start", href: u("") }, { label: "Für Partner" }]}
    prompt="Zwei Handwerker besprechen einen Bauplan auf der Baustelle, professionelle Kooperation, echt"
    img="hero-partner.webp"
  />

  <section class="section">
    <div class="container">
      <SectionHead center eyebrow="Ihre Vorteile" pre="Was Partner an uns " accent="schätzen" />
      <div class="grid cols-3">
        {vorteile.map((v) => (
          <div class="card reveal"><div class="card__icon"><Icon name={v.icon} /></div><h3>{v.title}</h3><p>{v.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHead eyebrow="Für wen" pre="Mit wem wir " accent="zusammenarbeiten" />
      <div class="grid cols-2">
        {zielgruppen.map((z) => (
          <div class="card reveal" style="display:flex;gap:16px;align-items:flex-start">
            <span style="color:var(--gold-700)"><Icon name={z.icon} /></span>
            <div><h3 style="font-size:20px">{z.title}</h3><p>{z.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead center eyebrow="Ablauf" pre="So läuft die " accent="Kooperation" />
      <Steps steps={ablauf} />
    </div>
  </section>

  <!-- B2B-Kontakt -->
  <section class="section section--dark" id="kontakt">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <SectionHead eyebrow="Kooperationsanfrage" pre="Lassen Sie uns " accent="kalkulieren" />
          <p style="color:var(--anthrazit-400)">Schildern Sie uns Ihr Vorhaben – wir melden uns mit einer Einschätzung und Festpreis-Grundlage, in der Regel innerhalb von zwei Werktagen.</p>
          <ul>
            <li><Icon name="user" /><div><div class="label">Ansprechpartner</div><div class="value">{SITE.contactName} – {SITE.contactRole}</div></div></li>
            <li><Icon name="phone" /><div><div class="label">Telefon</div><a class="value" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a></div></li>
            <li><Icon name="whatsapp" /><div><div class="label">WhatsApp</div><a class="value" href={waLink("Hallo, wir möchten eine Kooperation anfragen.")} target="_blank" rel="noopener">Direkt schreiben</a></div></li>
            <li><Icon name="mail" /><div><div class="label">E-Mail</div><a class="value" href={`mailto:${SITE.emails.partner}?subject=${encodeURIComponent("Kooperationsanfrage")}`}>{SITE.emails.partner}</a></div></li>
          </ul>
        </div>
        <div class="form-card">
          <h3>Kooperationsanfrage senden</h3>
          <form id="contactForm" novalidate data-to={SITE.emails.partner} data-subject="Kooperationsanfrage über die Website">
            <div class="field"><label for="cfirma">Unternehmen <span class="req">*</span></label><input type="text" id="cfirma" name="firma" required autocomplete="organization" /></div>
            <div class="field"><label for="cname">Ansprechpartner <span class="req">*</span></label><input type="text" id="cname" name="name" required autocomplete="name" /></div>
            <div class="field"><label for="cphone">Telefon <span class="req">*</span></label><input type="tel" id="cphone" name="phone" required autocomplete="tel" /></div>
            <div class="field"><label for="cmail">E-Mail</label><input type="email" id="cmail" name="email" autocomplete="email" /></div>
            <div class="field"><label for="cmsg">Ihr Vorhaben</label><textarea id="cmsg" name="message" placeholder="Objekt, Umfang, Zeitrahmen, Anzahl Einheiten …"></textarea></div>
            <label class="check"><input type="checkbox" required /><span>Ich habe die <a href={u("datenschutz/")}>Datenschutzerklärung</a> gelesen und stimme der Verarbeitung zu. <span class="req">*</span></span></label>
            <button type="submit" class="btn btn--primary btn--block" style="margin-top:20px">Anfrage absenden</button>
            <div class="form-success" id="formSuccess"><strong>Fast geschafft:</strong> Ihr E-Mail-Programm öffnet sich mit Ihrer Anfrage. Bitte noch absenden – wir melden uns innerhalb von zwei Werktagen.</div>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Übergangslösung ohne Backend: E-Mail mit vorausgefüllter Anfrage öffnen.
  const LABELS: Record<string, string> = {
    firma: "Unternehmen", name: "Ansprechpartner", phone: "Telefon",
    email: "E-Mail", message: "Vorhaben",
  };
  const cf = document.getElementById("contactForm") as HTMLFormElement | null;
  if (cf) {
    cf.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!cf.checkValidity()) { cf.reportValidity(); return; }
      const data = new FormData(cf);
      const lines: string[] = [];
      data.forEach((value, key) => {
        const v = String(value).trim();
        if (v) lines.push(`${LABELS[key] ?? key}: ${v}`);
      });
      const to = cf.dataset.to || "";
      const subject = cf.dataset.subject || "Kooperationsanfrage";
      window.location.href =
        `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
      document.getElementById("formSuccess")!.classList.add("show");
      document.getElementById("formSuccess")!.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  }
</script>
