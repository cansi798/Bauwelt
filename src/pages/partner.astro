---
// Partner (B2B) – Kundenwunsch 14.10.2026 (39): finale Struktur von Jamil, Texte wörtlich:
// 1 Hero (2 Buttons) → 2 Mit wem wir arbeiten → 3 Warum Partner mit uns arbeiten (dunkel)
// → Für Hausverwaltungen (Jamils Ergänzung „B2B-Mehrwert“) → 4 Bestehende Kooperationen
// → 5 Ablauf der Zusammenarbeit → 6 Ansprechpartner (Burim Ahmedi) → 7 Partner-CTA.
// Eigener Kontakt-CTA (partner@) – bewusst NICHT der Rechner.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import Steps from "../components/Steps.astro";
import WarumAnders from "../components/WarumAnders.astro";
import Kooperationen from "../components/Kooperationen.astro";
import Icon from "../components/Icon.astro";
import { EMAILS, SITE, waLink } from "../consts";

const mailPartner = `mailto:${EMAILS.partner}?subject=${encodeURIComponent("Anfrage Zusammenarbeit")}`;

const ZIELGRUPPEN = [
  { icon: "reno", title: "Hausverwaltungen", text: "Ein Rahmen, viele Objekte. Feste Ansprechpartner, planbare Budgets und dokumentierte Ausführung." },
  { icon: "euro", title: "Makler & Investoren", text: "Sanierungsmaßnahmen mit Festpreis und klaren Fertigstellungsterminen für eine sichere Kalkulation." },
  { icon: "doc", title: "Architekten & Planer", text: "Saubere Ausführung, kurze Kommunikationswege und zuverlässige Umsetzung Ihrer Planung." },
  { icon: "hammer", title: "Fachbetriebe", text: "Langfristige Zusammenarbeit auf Augenhöhe. Faire Bezahlung und verlässliche Projektabläufe." },
];

const WARUM = [
  { icon: "doc", title: "Dokumentierte Abläufe", text: "Klare Kommunikation und nachvollziehbare Projektstände." },
  { icon: "clock", title: "Schnelle Reaktionszeiten", text: "Antwort innerhalb von 12 Stunden." },
  { icon: "user", title: "Feste Ansprechpartner", text: "Keine wechselnden Kontakte oder lange Abstimmungsketten." },
  { icon: "tools", title: "Koordination aus einer Hand", text: "Ein Ansprechpartner für die komplette Umsetzung." },
];

/** Jamils Ergänzung (B2B-Mehrwert) – wörtlich. */
const HAUSVERWALTUNGEN = [
  "Rahmen\u00ADvereinbarungen möglich", // weiche Trennstelle: sonst läuft das Wort mobil über die Kachel
  "Priorisierte Bearbeitung",
  "Dokumentierte Ausführung",
  "Feste Ansprechpartner",
];

const ABLAUF = [
  { title: "Anfrage senden", text: "Beschreiben Sie kurz Ihr Anliegen." },
  { title: "Abstimmung", text: "Wir besprechen Umfang, Anforderungen und Abläufe." },
  { title: "Umsetzung", text: "Festpreis, feste Ansprechpartner und saubere Dokumentation." },
  { title: "Langfristige Zusammenarbeit", text: "Klare Prozesse für wiederkehrende Projekte." },
];
---

<BaseLayout
  footerNurNav
  title="Partner – Zusammenarbeit mit Bauwelt Handwerk"
  description="Zusammenarbeit für Hausverwaltungen, Makler, Architekten und Fachbetriebe – Sanierung und Ausbau mit Festpreis, Dokumentation und festen Ansprechpartnern."
>
  <!-- 1. Hero -->
  <PageHero
    eyebrow="Partner"
    pre="Zusammenarbeit, auf die man bauen "
    accent="kann."
    lead="Sie betreuen Immobilien, vermitteln Projekte oder planen Umbauten?"
    bild="hero-partner.webp"
    alt="Zwei Profis mit Tablet an der Trockenbauwand"
  >
    <p>
      Wir sind der ausführende Partner, der Zusagen einhält, sauber dokumentiert und Termine verlässlich
      umsetzt – beim ersten Projekt und beim zwanzigsten.
    </p>
    <!-- Partner-Buttons stehen nicht in der Sticky-Leiste ⇒ auch mobil sichtbar (untereinander) -->
    <div class="partner__hero-actions">
      <a class="btn btn--lg" href={mailPartner}>Zusammenarbeit anfragen</a>
      <a class="btn btn--lg btn--ghost" href="#partner-kontakt">Erstes Gespräch vereinbaren</a>
    </div>
  </PageHero>

  <!-- 2. Mit wem wir arbeiten -->
  <section class="section section--sand">
    <div class="container">
      <SectionHead eyebrow="Für wen" pre="Mit wem wir " accent="arbeiten." />
      <div class="grid cols-2">
        {ZIELGRUPPEN.map((z) => (
          <div class="card pcard reveal">
            <span class="pcard__icon"><Icon name={z.icon} size={26} class="icon" /></span>
            <h3>{z.title}</h3>
            <p>{z.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Warum Partner mit uns arbeiten -->
  <section class="section section--dark">
    <div class="container">
      <SectionHead center eyebrow="Warum Bauwelt" pre="Verlässlich. Planbar. " accent="Persönlich." />
      <ul class="warum">
        {WARUM.map((w, i) => (
          <li class="warum__item reveal">
            <span class="warum__nr" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="warum__icon"><Icon name={w.icon} size={24} class="icon" /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Jamils Ergänzung: B2B-Mehrwert für Hausverwaltungen -->
  <section class="section">
    <div class="container">
      <SectionHead center pre="Für " accent="Hausverwaltungen" />
      <ul class="kacheln partner__kacheln">
        {HAUSVERWALTUNGEN.map((h) => (
          <li class="kachel reveal">
            <span class="kachel__icon"><Icon name="check" size={26} class="icon" /></span>
            <span class="kachel__titel">{h}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Bestehende Kooperationen (nur Namen – Logos erst nach rechtlicher Freigabe) -->
  <Kooperationen
    sand
    eyebrow="Kooperationen"
    pre="Vertrauen durch erfolgreiche "
    accent="Zusammenarbeit."
    text="Unsere Erfahrung stellen wir nicht nur Privatkunden direkt zur Verfügung. Auch Kunden und Projekte renommierter Anbieter zählen regelmäßig auf unsere Leistungen."
  />

  <!-- 5. So läuft eine Zusammenarbeit ab -->
  <section class="section">
    <div class="container">
      <SectionHead center eyebrow="Ablauf" pre="Einfach. Direkt. " accent="Verbindlich." />
      <Steps steps={ABLAUF} />
    </div>
  </section>

  <!-- 6. Ansprechpartner für Partner -->
  <WarumAnders eyebrow="Ihr Kontakt" pre="Sprechen wir über Ihr " accent="Projekt." zitat={false} id="ansprechpartner">
    <p>
      Sie suchen einen zuverlässigen Ausführungspartner für Sanierungen, Modernisierungen oder laufende
      Projekte?
    </p>
    <p>Wir freuen uns auf das Gespräch.</p>
  </WarumAnders>

  <!-- 7. Partner-CTA -->
  <section class="section" id="partner-kontakt">
    <div class="container text-center partner__cta">
      <SectionHead
        center
        eyebrow="Kontakt für Partner"
        pre="Lassen Sie uns "
        accent="sprechen."
        text="Schreiben Sie uns kurz, worum es geht. Wir melden uns innerhalb von 12 Stunden mit einem Terminvorschlag zurück."
      />
      <div class="partner__buttons">
        <a class="btn btn--lg" href={mailPartner}>
          <Icon name="mail" size={20} class="icon" /> E-Mail schreiben
        </a>
        <a class="btn btn--dark btn--lg" href={waLink("Hallo Bauwelt Handwerk, ich interessiere mich für eine Zusammenarbeit. Bitte melden Sie sich bei mir.")} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} class="icon" /> Per WhatsApp schreiben
        </a>
        <a class="btn btn--ghost btn--lg" href={`tel:${SITE.phoneTel}`}>
          <Icon name="phone" size={20} class="icon" /> {SITE.phoneDisplay} anrufen
        </a>
      </div>
      <p class="small">{EMAILS.partner}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .partner__hero-actions { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 8px; width: 100%; }
  @media (max-width: 767px) {
    .partner__hero-actions { display: grid; width: 100%; }
    .partner__hero-actions .btn { width: 100%; white-space: normal; text-align: center; }
  }

  .pcard { display: grid; gap: 10px; align-content: start; }
  .pcard h3 { margin: 0; font-size: 18px; }
  .pcard p { margin: 0; font-size: 15px; color: var(--anthrazit-700); }
  .pcard__icon {
    width: 52px; height: 52px;
    border-radius: var(--radius-md);
    background: var(--gold-100);
    color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
  }

  /* 2 × 2 – „Rahmenvereinbarungen“ ist für vier Spalten zu lang */
  @media (min-width: 768px) { .partner__kacheln { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 760px; } }
  .partner__kacheln :global(.kachel__icon) { background: var(--gold-500); color: var(--anthrazit-900); }

  .partner__cta { display: grid; justify-items: center; gap: 8px; }
  .partner__buttons { display: grid; gap: 12px; width: min(100%, 440px); }
  .partner__buttons .btn { width: 100%; }
  @media (max-width: 767px) {
    .partner__buttons .btn { white-space: normal; text-align: center; }
  }
</style>
