---
// 404 – kurz, freundlich, zurück zum Wesentlichen.
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { CTA, u } from "../consts";
---

<BaseLayout title="Seite nicht gefunden – Bauwelt Handwerk" description="Die aufgerufene Seite existiert nicht mehr. Zur Startseite der Bauwelt Handwerk GmbH oder direkt das eigene Projekt online berechnen." noindex>
  <section class="section nf">
    <div class="container nf__inner">
      <div class="eyebrow">Fehler 404</div>
      <h1>Diese Wand gibt es <span class="accent">nicht</span></h1>
      <p class="lead">Die gesuchte Seite wurde verschoben oder existiert nicht mehr – vielleicht haben wir sie gerade herausgerissen.</p>
      <div class="nf__actions">
        <a class="btn" href={u("")}><Icon name="arrow-left" size={18} class="icon" /> Zur Startseite</a>
        <a class="btn btn--ghost" href={CTA.href}>{CTA.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { min-height: 50vh; display: grid; align-items: center; }
  .nf__inner { display: grid; gap: 16px; justify-items: start; }
  .nf__inner h1, .nf__inner p { margin: 0; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
