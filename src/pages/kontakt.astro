---
// Kontakt: Ansprechpartner + Direktkontakt, Terminbuchung, Anfahrt (Textadresse,
// bewusst kein Karten-Embed – DSGVO).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import ContactSection from "../components/ContactSection.astro";
import BookingEmbed from "../components/BookingEmbed.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../consts";

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${SITE.legal}, ${SITE.street}, ${SITE.zip} ${SITE.city}`
)}`;
---

<BaseLayout
  title="Kontakt – Bauwelt Handwerk in Norderstedt"
  description="Kontakt zur Bauwelt Handwerk GmbH: Telefon, WhatsApp, E-Mail oder Online-Terminbuchung. Schweriner Straße 16, 22844 Norderstedt – Antwort in 24 Stunden."
>
  <PageHero
    eyebrow="Kontakt"
    pre="Wir sind für Sie "
    accent="da"
    lead="Anrufen, schreiben oder direkt einen Termin buchen – Sie erreichen uns ohne Umwege und bekommen innerhalb von 24 Stunden eine Antwort."
    bild="hero-kontakt.webp"
    alt="Handschlag zwischen Handwerker und Kunde"
  />

  <ContactSection />

  <section class="section section--sand" id="termin">
    <div class="container">
      <SectionHead center eyebrow="Terminbuchung" pre="Termin online " accent="vereinbaren" />
      <div class="kontakt__booking">
        <BookingEmbed />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Anfahrt" pre="So finden Sie " accent="uns" />
      <div class="card kontakt__anfahrt">
        <p>
          <strong>{SITE.legal}</strong><br />
          {SITE.street}<br />
          {SITE.zip} {SITE.city}
        </p>
        <p class="small">{SITE.hours}</p>
        <a class="btn btn--ghost" href={mapsHref} target="_blank" rel="noopener">
          <Icon name="pin" size={18} class="icon" /> Route in Google Maps öffnen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .kontakt__booking { max-width: 820px; margin-inline: auto; }
  .kontakt__anfahrt { max-width: 480px; display: grid; gap: 8px; justify-items: start; }
  .kontakt__anfahrt p { margin: 0; }
</style>
