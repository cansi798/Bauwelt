---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, u } from "../consts";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import ContactSection from "../components/ContactSection.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Kontakt – Bauwelt Handwerk" active="Kontakt"
  description="So erreichen Sie Bauwelt Handwerk in Norderstedt: Telefon, E-Mail, Anfrageformular und Anfahrt.">
  <PageHero
    eyebrow="Kontakt"
    title="Lassen Sie uns sprechen"
    lead="Erzählen Sie uns kurz von Ihrem Vorhaben – wir melden uns in der Regel innerhalb von zwei Werktagen."
    crumbs={[{ label: "Start", href: u("") }, { label: "Kontakt" }]}
    prompt="Freundlicher Handwerker am Telefon im Büro von Bauwelt Handwerk, einladend"
  />

  <ContactSection />

  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Anfahrt" pre="So finden Sie " accent="uns" />
      <div class="tile" style="aspect-ratio:16/6;border-radius:8px;overflow:hidden">
        <div class="ph" role="img" aria-label="Kartenausschnitt Norderstedt">
          <span class="ph__label">
            <Icon name="pin" size={40} />
            {SITE.street}, {SITE.zip} {SITE.city}
          </span>
        </div>
      </div>
      <p class="small" style="margin-top:12px">Eine interaktive Karte binden wir auf Wunsch ein (lädt aus Datenschutzgründen erst nach Ihrer Zustimmung).</p>
    </div>
  </section>
</BaseLayout>
