---
// Kontakt – Kundenwunsch 14.10.2026 (40): finale Struktur von Jamil, Texte wörtlich:
// 1 Hero → 2 So erreichen Sie uns (4 Wege, Vor-Ort-Termin = Sprungziel #termin, öffnet das
// Buchungsfenster wie bisher die Termin-Karte) → 3 Was passiert nach Ihrer Anfrage? (gezeichneter
// Ablauf der Startseite) → 5 Einzugsgebiet (mit Adresse + Route statt Karten-Embed – DSGVO)
// → 6 Persönlicher Ansprechpartner (Burim Ahmedi). Direktkontakt steht zusätzlich im Footer-Kopf.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import RoughSzene from "../components/RoughSzene.astro";
import WarumAnders from "../components/WarumAnders.astro";
import ServiceArea from "../components/ServiceArea.astro";
import Vertrauensleiste from "../components/Vertrauensleiste.astro";
import RueckrufFormular from "../components/RueckrufFormular.astro";
import Icon from "../components/Icon.astro";
import { CTA, EMAILS, SITE, TERMIN, waLink } from "../consts";

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${SITE.legal}, ${SITE.street}, ${SITE.zip} ${SITE.city}`
)}`;

type Weg = { icon: string; title: string; text: string; label: string; href: string; extern?: boolean; termin?: boolean; id?: string };
const WEGE: Weg[] = [
  { icon: "whatsapp", title: "WhatsApp", text: "Für schnelle Fragen und unkomplizierte Abstimmungen.", label: "Per WhatsApp schreiben", href: waLink(), extern: true },
  { icon: "mail", title: "E-Mail", text: "Für Anfragen, Unterlagen oder ausführlichere Informationen.", label: "E-Mail schreiben", href: `mailto:${EMAILS.service}` },
  { icon: "phone", title: "Telefon", text: "Direkter Kontakt für alle Fragen rund um Ihr Projekt.", label: `${SITE.phoneDisplay} anrufen`, href: `tel:${SITE.phoneTel}` },
  { icon: "calendar", title: TERMIN.begriff, text: "Vereinbaren Sie direkt einen Termin bei Ihnen vor Ort.", label: TERMIN.kurz, href: TERMIN.href, extern: true, termin: true, id: "termin" },
];

---

<BaseLayout
  footerNurNav /* Audit 5.4 (19.10.2026): die 4 Kontaktwege stehen schon auf der Seite – kein doppelter Footer-Block */
  title="Kontakt – Bauwelt Handwerk in Norderstedt"
  description="Kontakt zur Bauwelt Handwerk GmbH – WhatsApp, E-Mail, Telefon oder direkt einen kostenlosen Vor-Ort-Termin buchen. Schweriner Straße 16, 22844 Norderstedt."
>
  <!-- 1. Hero – Buttons nur Desktop (mobil stehen Termin + Rechner in der festen Leiste) -->
  <PageHero
    eyebrow="Kontakt"
    pre="Sprechen wir über Ihr "
    accent="Projekt."
    lead="Ob erste Idee, konkrete Anfrage oder Rückfrage zu einem Angebot – wir freuen uns auf Ihre Nachricht."
    bild="hero-kontakt.webp"
    alt="Handschlag zwischen Handwerker und Kunde"
  >
    <p>
      Sie entscheiden selbst, wie Sie mit uns Kontakt aufnehmen möchten. Per WhatsApp, E-Mail, Telefon
      oder über einen direkten kostenlosen Vor-Ort-Termin.
    </p>
    {/* Kundenwunsch 15.10.2026 (63): Buttons im Kontakt-Hero entfernt */}
  </PageHero>
  <Vertrauensleiste /> {/* Audit 6.2 */}

  <!-- 2. So erreichen Sie uns -->
  <section class="section section--sand" id="kontaktwege">
    <div class="container">
      <SectionHead center eyebrow="Kontaktmöglichkeiten" pre="Wählen Sie den Weg, der für Sie am besten " accent="passt." />
      <ul class="wege">
        {WEGE.map((w) => (
          <li class="card weg reveal" id={w.id}>
            <span class:list={["weg__icon", { "weg__icon--wa": w.icon === "whatsapp" }]}><Icon name={w.icon} size={26} class="icon" /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
            {w.termin ? (
              <a class="btn" href={w.href} target="_blank" rel="noopener" data-termin>{w.label}</a>
            ) : w.extern ? (
              <a class="btn btn--ghost" href={w.href} target="_blank" rel="noopener">{w.label}</a>
            ) : (
              <a class="btn btn--ghost" href={w.href}>{w.label}</a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2b. Rückruf-Formular (Kundenwunsch 19.10.2026, Audit 6.3) -->
  <section class="section" id="rueckruf">
    <div class="container kontakt__rueckruf">
      <RueckrufFormular id="kRueckruf" betreff="Rückruf-Anfrage über die Kontaktseite" />
    </div>
  </section>

  <!-- 3. Was passiert nach Ihrer Anfrage? – Ablauf-Animation der Startseite -->
  <section class="section" id="ablauf">
    <div class="container">
      <SectionHead center eyebrow="So geht es weiter" pre="Planbar. Transparent. " accent="Verlässlich." /> {/* Audit 7.7 */}
      {/* Kundenwunsch 19.10.2026 (Audit 1.8): eigener Ablauf „Was nach Ihrer Anfrage passiert“ */}
      <RoughSzene
        szene="wegKontakt"
        label="Gezeichneter Ablauf in vier Stationen: 1. Anfrage senden – per WhatsApp, E-Mail, Telefon oder Rückruf. 2. Persönliche Antwort – innerhalb von 12 Stunden (werktags). 3. Termin vor Ort – kostenlos und unverbindlich. 4. Klares Angebot – innerhalb von 24 Stunden nach dem Termin."
      />
    </div>
  </section>

  <!-- 5. Einzugsgebiet (statt Karten-Embed: Adresse + Route in Google Maps, DSGVO) -->
  <section class="section section--sand" id="einzugsgebiet">
    <div class="container">
      <SectionHead center eyebrow="Wo wir tätig sind" pre="Für Hamburg und " accent="Umgebung." /* Audit 4.10: wie Karte und Startseite */ text="Wir betreuen Privatkunden, Hausverwaltungen, Investoren und Unternehmen in:" />
      {/* Kundenwunsch 17.10.2026 (78): statt Gebiets-Kacheln das laufende Orts-Band wie auf der Startseite */}
      <ServiceArea eingebettet />
      <div class="card kontakt__anfahrt">
        <p>
          <strong>{SITE.legal}</strong><br />
          {SITE.street}<br />
          {SITE.zip} {SITE.city}
        </p>
        <p class="small">{SITE.hours}</p>
        <a class="btn btn--ghost" href={mapsHref} target="_blank" rel="noopener">
          <Icon name="pin" size={18} class="icon" /> Route in Google Maps öffnen
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Persönlicher Ansprechpartner -->
  <WarumAnders
    eyebrow="Ihr Ansprechpartner"
    pre="Sie haben Fragen? Ich helfe gerne "
    accent="weiter."
    zitat={false}
    weiss
    id="ansprechpartner"
  >
    <p>
      Ob erste Idee, konkrete Planung oder Rückfrage zu einem laufenden Projekt – wir nehmen uns Zeit für
      Ihr Anliegen und beraten Sie persönlich.
    </p>
  </WarumAnders>
</BaseLayout>

<style>
  .kontakt__rueckruf { max-width: 720px; }
  .kontakt__hero-actions { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 8px; width: 100%; }

  .wege { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  @media (min-width: 640px) { .wege { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .wege { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .weg { display: flex; flex-direction: column; gap: 12px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .weg h3 { margin: 0; font-size: 18px; }
  .weg p { margin: 0; font-size: 15px; color: var(--anthrazit-700); }
  .weg .btn { margin-top: auto; width: 100%; padding: var(--btn-s-pad); font-size: var(--btn-s-fs); white-space: normal; text-align: center; } /* Größe S (Audit 2.7) */
  .weg__icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: var(--gold-100); color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
  }
  /* Kundenwunsch 15.10.2026 (67): WhatsApp-Symbol in denselben Farben wie die anderen (kein Grün mehr) */

  .gebiet { max-width: 980px; }
  @media (min-width: 1024px) { .gebiet { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 768px) and (max-width: 1023px) { .gebiet { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .kontakt__anfahrt { max-width: 480px; margin: 32px auto 0; display: grid; gap: 8px; justify-items: center; text-align: center; }
  .kontakt__anfahrt p { margin: 0; }
</style>
