---
// Projekt-Rechner 2.1 (Enpal-Funnel-Mechanik): 3 Schritte, Ergebnis VOR Kontaktfrage.
// Schritt 2 hat zwei Modi: „Schnelle Schätzung" (Slider, fertige Skizze) und
// „Genaue Angaben" (Länge × Breite mit Live-Bemaßung + Modul-Wahl). Jedes Modul
// ist eine EBENE der Bauzeichnung – zusammen ergeben sie die fertige Skizze,
// abgewählte Ebenen fehlen in der Zeichnung. Mobil: Eingabe → Skizze direkt
// darunter als Live-Feedback → Details; Desktop: Eingaben links, Skizze rechts.
// Ohne JavaScript: Hinweis + Direktkontaktwege (noscript-Prinzip via html.js-Gate).
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import Icon from "../components/Icon.astro";
import BookingEmbed from "../components/BookingEmbed.astro";
import { GEWERKE } from "../data/rechner";
import { SITE, EMAILS } from "../consts";

// Nur die Daten, die der Client braucht (keine Funktionen).
const CLIENT_DATA = GEWERKE.map((g) => ({
  slug: g.slug, label: g.label, frage: g.frage, unit: g.unit,
  min: g.min, max: g.max, step: g.step, default: g.default,
  grund: g.grund, proEinheit: g.proEinheit, tiers: g.tiers, spanne: g.spanne,
  skizze: g.skizze, bausteine: g.bausteine, extras: g.extras, icon: g.icon,
}));
---

<BaseLayout
  title="Projekt berechnen – in 1 Minute zur Preisspanne | Bauwelt Handwerk"
  description="Berechnen Sie Ihr Sanierungs- oder Ausbauprojekt online – schnell schätzen oder mit genauen Maßen und Modulen. Sofort eine Preisspanne sehen, ohne Kontaktdaten."
>
  <section class="section rechner">
    <div class="container rechner__wrap">
      <SectionHead
        center
        as="h1"
        eyebrow="Projekt-Rechner"
        pre="Was kostet Ihr "
        accent="Projekt?"
        text="In einer Minute zur ersten Preisspanne – unverbindlich und ohne Angabe von Kontaktdaten."
      />

      <!-- Ohne JS: ehrlicher Hinweis + Kontaktwege -->
      <div class="rechner__nojs">
        <p>
          Der Online-Rechner benötigt JavaScript. Sie erreichen uns aber jederzeit direkt –
          wir nennen Ihnen gern am Telefon eine erste Einschätzung:
        </p>
        <div class="rechner__nojs-actions">
          <a class="btn" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
          <a class="btn btn--dark" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn btn--ghost" href={`mailto:${EMAILS.service}?subject=Projektanfrage`}>E-Mail schreiben</a>
        </div>
      </div>

      <div class="rechner__app card" data-gewerke={JSON.stringify(CLIENT_DATA)}>
        <div class="rechner__progress" role="progressbar" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1" aria-label="Schritt 1 von 3">
          <span class="rechner__bar" style="width: 33%"></span>
        </div>

        <!-- Schritt 1: Gewerk -->
        <section class="rstep" data-step="1">
          <h2 class="rstep__title">Worum geht es?</h2>
          <div class="rechner__tiles">
            {GEWERKE.map((g) => (
              <button class="rtile" type="button" data-gewerk={g.slug}>
                <Icon name={g.icon} size={30} class="icon" />
                <span>{g.label}</span>
              </button>
            ))}
          </div>

          <!-- KI-Variante (Beta): Gemma läuft per WebLLM komplett im Browser.
               Modelldaten (~1,4 GB) werden erst nach Klick von externem Server geladen. -->
          <div class="rki">
            <button class="btn btn--ghost" type="button" id="rKiToggle">
              ✨ Oder mit KI beschreiben (Beta)
            </button>
            <div class="rki__panel" id="rKiPanel" hidden>
              <p class="small">
                Beschreiben Sie Ihr Projekt in einem Satz – die KI (Gemma&nbsp;2) rechnet
                direkt in Ihrem Browser, Ihre Eingabe verlässt Ihr Gerät nicht. Beim ersten
                Start werden einmalig ca. 1,4&nbsp;GB Modelldaten von einem externen Server
                (mlc.ai/Hugging&nbsp;Face) geladen; dafür braucht es einen aktuellen Browser
                mit WebGPU und stabiles WLAN.
              </p>
              <textarea id="rKiText" rows="2"
                placeholder="z. B. Unser Bad ist 3 × 2 Meter, wir möchten neue Fliesen und eine bodengleiche Dusche."></textarea>
              <button class="btn" type="button" id="rKiStart">KI-Vorschlag erstellen</button>
              <p class="small rki__status" id="rKiStatus" role="status"></p>
            </div>
          </div>
        </section>

        <!-- Schritt 2: Umfang – schnell (Slider) oder genau (Maße + Module) -->
        <section class="rstep" data-step="2" hidden>
          <h2 class="rstep__title" id="rFrage">Wie groß ist Ihr Projekt?</h2>

          <div class="rmodus" role="radiogroup" aria-label="Wie genau möchten Sie rechnen?">
            <button type="button" class="rmodus__btn selected" data-modus="schnell" role="radio" aria-checked="true">
              <strong>Schnelle Schätzung</strong>
              <small>Ergebnis in 1 Minute</small>
            </button>
            <button type="button" class="rmodus__btn" data-modus="genau" role="radio" aria-checked="false">
              <strong>Genaue Angaben</strong>
              <small>Maße eingeben, Module wählen</small>
            </button>
          </div>

          <div class="rstep2grid">
            <!-- A: Größe zuerst … -->
            <div class="rs2 rs2--groesse">
              <div class="rechner__range" id="rRangeWrap">
                <input type="range" id="rMenge" min="3" max="30" step="1" value="8" aria-labelledby="rFrage" />
                <output class="rechner__mengeout" id="rMengeOut" for="rMenge">8 m²</output>
              </div>
              <div class="rmasse" id="rMasse" hidden>
                <label class="rmasse__feld">
                  <span>Länge</span>
                  <input type="number" id="rLaenge" min="0.5" max="50" step="0.1" inputmode="decimal" /> <span>m</span>
                </label>
                <span class="rmasse__mal" aria-hidden="true">×</span>
                <label class="rmasse__feld">
                  <span>Breite</span>
                  <input type="number" id="rBreite" min="0.5" max="50" step="0.1" inputmode="decimal" /> <span>m</span>
                </label>
                <output class="rmasse__flaeche" id="rFlaeche">= 8 m²</output>
              </div>
            </div>

            <!-- S: … Skizze als direktes Feedback (mobil direkt unter der Größe) -->
            <div class="rs2 rs2--skizze" id="rSkizzeSlot2">
              <figure class="rskizze rskizze--grob" id="rSkizzeWrap">
                <svg id="rSkizze" viewBox="0 0 340 270" role="img" aria-label="Bauzeichnung Ihres Projekts" data-skizze="raum">
                  <!-- Grundfläche: immer sichtbar, bewusst „wackelige" Handskizzen-Linie -->
                  <path class="sk sk-draw" style="--d: 0ms"
                    d="M50 44 C 130 40, 230 46, 306 44 C 310 100, 304 170, 306 226 C 216 230, 126 224, 50 228 C 46 168, 52 104, 50 44 Z" />

                  <!-- BAD: 5 Ebenen = 5 Module -->
                  <g class="sk-g" data-g="bad">
                    <g class="sk-l" data-l="0"><!-- Demontage: freigeräumte Innenkontur -->
                      <path class="sk sk-draw sk-fein" style="--d: 100ms" d="M60 54 C 132 51, 228 56, 296 54 C 299 102, 295 166, 296 218 C 214 221, 130 216, 60 218 C 57 164, 61 104, 60 54 Z" />
                    </g>
                    <g class="sk-l" data-l="1"><!-- Rohinstallation: Leitungswege + Anschlüsse -->
                      <path class="sk sk-draw sk-fein sk-leitung" style="--d: 150ms" d="M66 60 L 290 60 M66 60 L 66 212 M180 60 L 180 96" />
                      <circle class="sk sk-fein" cx="100" cy="60" r="4" /><circle class="sk sk-fein" cx="252" cy="60" r="4" /><circle class="sk sk-fein" cx="66" cy="186" r="4" />
                    </g>
                    <g class="sk-l" data-l="2"><!-- Abdichtung: Randstriche Nasszone -->
                      <path class="sk sk-draw sk-fein" style="--d: 200ms" d="M222 52 l6 10 M238 52 l6 10 M254 52 l6 10 M270 52 l6 10 M286 52 l6 10 M298 70 l-10 6 M298 88 l-10 6 M298 106 l-10 6" />
                    </g>
                    <g class="sk-l" data-l="3"><!-- Fliesen: Bodenraster -->
                      <path class="sk sk-draw sk-fein sk-raster" style="--d: 250ms" d="M110 130 L 290 130 M110 160 L 290 160 M140 118 L 140 172 M180 118 L 180 172 M220 118 L 220 172 M260 118 L 260 172" />
                    </g>
                    <g class="sk-l" data-l="4"><!-- Ausstattung: Wanne, Dusche, WC, Waschtisch, Tür -->
                      <rect class="sk sk-draw" style="--d: 150ms" x="62" y="66" width="92" height="42" rx="16" />
                      <rect class="sk sk-draw" style="--d: 280ms" x="228" y="120" width="64" height="58" rx="4" />
                      <path class="sk sk-draw sk-fein" style="--d: 400ms" d="M238 130 l44 38 M282 130 l-44 38" />
                      <ellipse class="sk sk-draw" style="--d: 520ms" cx="86" cy="190" rx="19" ry="14" />
                      <rect class="sk sk-draw sk-fein" style="--d: 520ms" x="67" y="201" width="38" height="11" rx="4" />
                      <rect class="sk sk-draw" style="--d: 640ms" x="224" y="188" width="68" height="28" rx="6" />
                      <ellipse class="sk sk-draw sk-fein" style="--d: 720ms" cx="258" cy="202" rx="15" ry="7" />
                      <path class="sk sk-draw sk-fein" style="--d: 800ms" d="M150 228 A 42 42 0 0 1 192 186" />
                    </g>
                  </g>

                  <!-- RAUM: 5 Ebenen -->
                  <g class="sk-g" data-g="raum">
                    <g class="sk-l" data-l="0">
                      <path class="sk sk-draw sk-fein" style="--d: 100ms" d="M60 54 C 132 51, 228 56, 296 54 C 299 102, 295 166, 296 218 C 214 221, 130 216, 60 218 C 57 164, 61 104, 60 54 Z" />
                    </g>
                    <g class="sk-l" data-l="1">
                      <path class="sk sk-draw sk-fein sk-leitung" style="--d: 150ms" d="M66 60 L 290 60 M66 60 L 66 212 M290 60 L 290 130" />
                      <circle class="sk sk-fein" cx="140" cy="60" r="4" /><circle class="sk sk-fein" cx="290" cy="104" r="4" /><circle class="sk sk-fein" cx="66" cy="160" r="4" />
                    </g>
                    <g class="sk-l" data-l="2">
                      <path class="sk sk-draw sk-fein" style="--d: 200ms" d="M56 70 l10 -6 M56 92 l10 -6 M56 114 l10 -6 M56 136 l10 -6 M56 158 l10 -6 M56 180 l10 -6 M70 224 l6 -10 M96 224 l6 -10 M122 224 l6 -10" />
                    </g>
                    <g class="sk-l" data-l="3">
                      <path class="sk sk-draw sk-fein sk-raster" style="--d: 250ms" d="M84 214 L 130 170 M116 216 L 176 160 M152 218 L 224 152 M192 218 L 262 154 M234 218 L 292 164" />
                    </g>
                    <g class="sk-l" data-l="4">
                      <path class="sk sk-draw sk-fein" style="--d: 300ms" d="M140 228 A 46 46 0 0 1 186 182" />
                      <path class="sk sk-draw" style="--d: 380ms" d="M118 44 l54 0 M126 40 l0 8 M164 40 l0 8" />
                      <g class="sk-symbol"><use id="rSkizzeIcon" href="#icon-reno" width="36" height="36" x="160" y="78" /></g>
                    </g>
                  </g>

                  <!-- DACH: 5 Ebenen -->
                  <g class="sk-g" data-g="dach">
                    <g class="sk-l" data-l="0">
                      <path class="sk sk-draw sk-fein" style="--d: 100ms" d="M60 54 C 132 51, 228 56, 296 54 C 299 102, 295 166, 296 218 C 214 221, 130 216, 60 218 C 57 164, 61 104, 60 54 Z" />
                    </g>
                    <g class="sk-l" data-l="1">
                      <path class="sk sk-draw sk-fein" style="--d: 150ms" d="M92 50 L 92 222 M148 48 L 148 224 M204 50 L 204 222 M260 48 L 260 224" />
                    </g>
                    <g class="sk-l" data-l="2">
                      <path class="sk sk-draw sk-fein sk-raster" style="--d: 200ms" d="M64 90 L 110 50 M64 140 L 160 52 M66 192 L 216 54 M96 218 L 268 56 M150 220 L 294 84 M206 222 L 294 138 M258 224 L 296 190" />
                    </g>
                    <g class="sk-l" data-l="3">
                      <path class="sk sk-draw" style="--d: 250ms" d="M50 136 C 140 132, 230 138, 306 135" />
                      <path class="sk sk-draw sk-fein" style="--d: 350ms" d="M74 96 q8 -6 16 0 q8 6 16 0 q8 -6 16 0 M188 96 q8 -6 16 0 q8 6 16 0 q8 -6 16 0 M74 180 q8 -6 16 0 q8 6 16 0 q8 -6 16 0 M188 180 q8 -6 16 0 q8 6 16 0 q8 -6 16 0" />
                    </g>
                    <g class="sk-l" data-l="4">
                      <path class="sk sk-draw" style="--d: 300ms" d="M46 40 L 310 40 M46 232 L 310 232" />
                      <path class="sk sk-draw sk-fein" style="--d: 400ms" d="M310 40 l0 16 q0 8 -8 8 M46 232 l0 -16" />
                    </g>
                  </g>

                  <!-- Bemaßung (nur im Genau-Modus sichtbar) -->
                  <g class="sk-mass">
                    <path class="sk sk-fein" d="M50 26 L306 26 M50 20 l0 12 M306 20 l0 12" />
                    <text id="skLaenge" x="178" y="18" text-anchor="middle">4,0 m</text>
                    <path class="sk sk-fein" d="M28 44 L28 228 M22 44 l12 0 M22 228 l12 0" />
                    <text id="skBreite" x="14" y="140" text-anchor="middle" transform="rotate(-90 14 140)">2,0 m</text>
                  </g>

                  <!-- Fläche (immer sichtbar) -->
                  <text id="skFlaeche" class="sk-f" x="178" y="250" text-anchor="middle">8 m²</text>
                  <text class="sk-flabel" x="178" y="263" text-anchor="middle">Fläche</text>
                </svg>
                <figcaption class="small" id="rSkizzeText">Ihre Bauzeichnung entsteht aus den gewählten Modulen</figcaption>
              </figure>
            </div>

            <!-- B: … dann Niveau, Module, Live-Preis, Weiter -->
            <div class="rs2 rs2--details">
              <div class="rechner__tiers" id="rTiers" role="radiogroup" aria-label="Ausstattungsniveau"></div>
              <div class="rmodule" id="rModuleWrap" hidden>
                <h3 class="rmodule__title">Was soll gemacht werden?</h3>
                <div class="rmodule__grid" id="rModule"></div>
              </div>
              <div class="rmodule" id="rExtrasWrap" hidden>
                <h3 class="rmodule__title">Extras <span class="rmodule__opt">(optional)</span></h3>
                <div class="rextras__grid" id="rExtras"></div>
              </div>
              <p class="rlivepreis" id="rLivePreis" hidden role="status"></p>
              <div class="rnav">
                <button class="btn btn--ghost rnav__zurueck" type="button" id="rZurueck2">Zurück</button>
                <button class="btn rechner__next" type="button" id="rWeiter">Preisspanne anzeigen</button>
              </div>
            </div>
          </div>
        </section>

        <!-- Schritt 3: Ergebnis + Bauzeichnung + Kontaktwege -->
        <section class="rstep" data-step="3" hidden>
          <div class="rechner__ergebnisgrid">
            <div class="rechner__ergebnistext">
              <h2 class="rstep__title">Ihre erste Preisspanne</h2>
              <p class="rechner__result" id="rErgebnis" role="status">–</p>
              <ul class="rechner__chips" id="rChips" aria-label="Ihre Auswahl"></ul>
              <p class="small rechner__disclaimer">
                Unverbindliche Ersteinschätzung auf Basis von Erfahrungswerten, inkl. Material und Arbeit.
                Ihren <strong>Festpreis</strong> nennen wir Ihnen nach einem kostenlosen Vor-Ort-Termin.
              </p>
            </div>
            <div class="rechner__ergebnisrechts">
              <div id="rSkizzeSlot3"></div>
              <button class="btn btn--ghost rskizze__download" type="button" id="rSkizzeDownload">
                <Icon name="download" size={18} class="icon" /> Zeichnung herunterladen (PNG)
              </button>
              <p class="small rskizze__tipp">
                Tipp: Zeichnung herunterladen und einfach an Ihre WhatsApp- oder
                E-Mail-Anfrage anhängen – dann sehen wir sofort, worum es geht.
              </p>
            </div>
          </div>
          <div class="rechner__contact">
            <a class="btn btn--lg" href="#termin">
              <Icon name="calendar" size={20} class="icon" /> Kostenlosen Termin buchen
            </a>
            <a class="btn btn--dark btn--lg" id="rWhatsapp" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={20} class="icon" /> Ergebnis per WhatsApp senden
            </a>
            <a class="btn btn--ghost btn--lg" id="rMail" href={`mailto:${EMAILS.service}`}>
              <Icon name="mail" size={20} class="icon" /> Rückruf per E-Mail anfragen
            </a>
          </div>
        </section>

        <button class="rechner__back" type="button" id="rZurueck" hidden>
          <Icon name="arrow-left" size={18} class="icon" /> Zurück
        </button>
      </div>

      <div class="rechner__booking" id="termin">
        <BookingEmbed />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rechner__wrap { max-width: 980px; }
  html:not(.js) .rechner__app { display: none; }
  html.js .rechner__nojs { display: none; }
  .rechner__nojs { text-align: center; display: grid; gap: 16px; justify-items: center; }
  .rechner__nojs-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  .rechner__app { position: relative; padding: 28px 20px; }
  @media (min-width: 768px) { .rechner__app { padding: 40px; } }

  .rechner__progress {
    height: 6px; border-radius: var(--radius-pill);
    background: var(--anthrazit-100);
    overflow: hidden;
    margin-bottom: 28px;
  }
  .rechner__bar { display: block; height: 100%; background: var(--gold-500); transition: width 300ms ease; }

  .rstep__title { font-size: clamp(20px, 3vw, 26px); }

  .rechner__tiles { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 768px) { .rechner__tiles { grid-template-columns: repeat(3, 1fr); } }
  .rtile {
    display: grid; justify-items: center; gap: 10px;
    padding: 22px 12px;
    background: var(--weiss);
    border: 2px solid var(--linie);
    border-radius: var(--radius-lg);
    font-family: var(--font-heading); font-weight: 600; font-size: 14px;
    color: var(--anthrazit-800);
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }
  .rtile :global(.icon) { color: var(--gold-700); width: 30px; height: 30px; }
  .rtile:hover { border-color: var(--gold-500); transform: translateY(-2px); }
  .rtile.selected { border-color: var(--gold-500); background: var(--gold-100); }

  /* Modus-Umschalter */
  .rmodus { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; margin-block: 18px 22px; }
  .rmodus__btn {
    display: grid; gap: 2px; text-align: left;
    padding: 12px 16px;
    background: var(--weiss);
    border: 2px solid var(--linie);
    border-radius: var(--radius-md);
    transition: border-color var(--transition), background var(--transition);
  }
  .rmodus__btn strong { font-family: var(--font-heading); font-size: 14.5px; }
  .rmodus__btn small { color: var(--anthrazit-600); font-size: 12.5px; }
  .rmodus__btn.selected { border-color: var(--gold-500); background: var(--gold-100); }

  /* Mobil: Größe → Skizze → Details (logische Lesefolge).
     Desktop: Eingaben links (Größe oben, Details darunter), Skizze rechts daneben. */
  .rstep2grid { display: grid; gap: 22px; }
  /* hidden-Attribut muss auch gegen display:grid/flex der Klassen gewinnen */
  .rechner__app [hidden] { display: none !important; }
  @media (min-width: 768px) {
    .rstep2grid {
      grid-template-columns: 1.15fr 1fr;
      grid-template-areas: "groesse skizze" "details skizze";
      gap: 18px 32px;
      align-items: start;
    }
    .rs2--groesse { grid-area: groesse; }
    .rs2--skizze  { grid-area: skizze; }
    .rs2--details { grid-area: details; }
  }

  .rechner__range { display: grid; gap: 8px; }
  .rechner__range input[type="range"] { width: 100%; accent-color: var(--gold-600); height: 32px; }
  .rechner__mengeout {
    font-family: var(--font-heading); font-weight: 800; font-size: 28px;
    text-align: center;
  }

  /* Länge × Breite (Genau-Modus) */
  .rmasse { display: flex; flex-wrap: wrap; align-items: end; gap: 10px 14px; }
  .rmasse__feld { display: grid; gap: 4px; font-size: 13px; font-weight: 600; color: var(--anthrazit-700); }
  .rmasse__feld input {
    width: 96px;
    padding: 10px 12px;
    border: 2px solid var(--linie);
    border-radius: var(--radius-md);
    font-family: var(--font-heading); font-weight: 700; font-size: 17px;
    color: var(--anthrazit-800);
  }
  .rmasse__feld input:focus { outline: none; border-color: var(--gold-500); }
  .rmasse__mal { font-family: var(--font-heading); font-weight: 800; font-size: 20px; padding-bottom: 10px; }
  .rmasse__flaeche {
    font-family: var(--font-heading); font-weight: 800; font-size: 22px;
    padding-bottom: 6px; margin-left: auto;
  }

  .rechner__tiers { display: grid; gap: 10px; margin-bottom: 20px; }
  @media (min-width: 768px) { .rechner__tiers { grid-template-columns: repeat(3, 1fr); } }
  .rechner__tiers :global(.rtier) {
    display: grid; gap: 4px;
    padding: 14px;
    border: 2px solid var(--linie);
    border-radius: var(--radius-md);
    background: var(--weiss);
    text-align: left;
    font-size: 14px;
    transition: border-color var(--transition), background var(--transition);
  }
  .rechner__tiers :global(.rtier strong) { font-family: var(--font-heading); }
  .rechner__tiers :global(.rtier small) { color: var(--anthrazit-600); }
  .rechner__tiers :global(.rtier.selected) { border-color: var(--gold-500); background: var(--gold-100); }

  /* Modul-/Extras-Wahl (Genau-Modus) – laienfreundlich: Titel + Erklärzeile */
  .rmodule__title { font-size: 16px; margin: 0 0 10px; }
  .rmodule__opt { font-weight: 400; color: var(--anthrazit-600); font-size: 13px; }
  .rmodule__grid, .rextras__grid { display: grid; gap: 8px; margin-bottom: 18px; }
  @media (min-width: 560px) { .rmodule__grid, .rextras__grid { grid-template-columns: 1fr 1fr; } }
  .rmodule :global(.rmodul) {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 14px;
    border: 2px solid var(--linie);
    border-radius: var(--radius-md);
    background: var(--weiss);
    text-align: left;
    transition: border-color var(--transition), background var(--transition), opacity var(--transition);
  }
  .rmodule :global(.rmodul .rmodul__text) { display: grid; gap: 1px; }
  .rmodule :global(.rmodul strong) { font-size: 14px; }
  .rmodule :global(.rmodul small) { font-size: 12px; color: var(--anthrazit-600); font-weight: 400; }
  .rmodule :global(.rmodul .rmodul__check) {
    width: 22px; height: 22px; flex: none; margin-top: 2px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 2px solid var(--anthrazit-400);
    border-radius: 6px;
    color: transparent;
    transition: all var(--transition);
  }
  .rmodule :global(.rmodul[aria-pressed="true"]) { border-color: var(--gold-500); background: var(--gold-100); }
  .rmodule :global(.rmodul[aria-pressed="true"] .rmodul__check) {
    background: var(--gold-500); border-color: var(--gold-600); color: var(--anthrazit-900);
  }
  .rmodule :global(.rmodul[aria-pressed="false"]) { opacity: 0.7; }
  .rmodule :global(.rmodul .rmodul__preis) { margin-left: auto; font-weight: 700; font-size: 13px; color: var(--gold-700); white-space: nowrap; padding-top: 2px; }

  /* Mobile Navigation: Zurück + Weiter zusammen, unten angepinnt */
  .rnav { display: grid; grid-template-columns: auto 1fr; gap: 10px; }
  @media (max-width: 767px) {
    .rnav {
      position: sticky; bottom: 10px; z-index: 5;
      background: var(--weiss);
      padding: 10px;
      margin-inline: -10px;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }
  }
  @media (min-width: 768px) { .rnav__zurueck { display: none; } }

  /* KI-Panel (Beta) */
  .rki { margin-top: 22px; display: grid; gap: 12px; justify-items: center; }
  .rki__panel { display: grid; gap: 10px; width: 100%; max-width: 560px; }
  .rki__panel textarea {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid var(--linie);
    border-radius: var(--radius-md);
    font: inherit; font-size: 15px;
    resize: vertical;
  }
  .rki__panel textarea:focus { outline: none; border-color: var(--gold-500); }
  .rki__status { margin: 0; color: var(--anthrazit-600); min-height: 1.2em; }

  .rlivepreis {
    margin: 0 0 16px;
    font-family: var(--font-heading); font-weight: 800; font-size: 19px;
    color: var(--anthrazit-800);
  }
  .rlivepreis :global(small) { display: block; font-weight: 400; font-size: 12.5px; color: var(--anthrazit-600); }

  .rechner__next { width: 100%; }

  /* --- Bauzeichnung --- */
  .rskizze {
    margin: 0;
    display: grid; gap: 10px; justify-items: center;
    background: var(--gold-100);
    border: 1px solid var(--linie);
    border-radius: var(--radius-lg);
    padding: 16px 14px;
  }
  .rskizze svg { width: 100%; max-width: 360px; height: auto; }
  .rskizze .sk {
    fill: none;
    stroke: var(--anthrazit-800);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rskizze .sk-fein { stroke-width: 1.6; stroke: var(--anthrazit-600); }
  .rskizze .sk-leitung { stroke-dasharray: 6 5; }
  .rskizze .sk-raster { stroke: var(--gold-700); opacity: 0.75; }
  .rskizze .sk-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: sk-zeichnen 800ms ease forwards;
    animation-delay: var(--d, 0ms);
  }
  .rskizze .sk-leitung.sk-draw { animation-name: sk-zeichnen-dash; }
  @keyframes sk-zeichnen { to { stroke-dashoffset: 0; } }
  /* Leitungen behalten nach dem Zeichnen ihre Strichelung */
  @keyframes sk-zeichnen-dash { 0% { stroke-dasharray: 1; stroke-dashoffset: 1; } 99% { stroke-dasharray: 1; stroke-dashoffset: 0; } 100% { stroke-dasharray: 0.02 0.016; stroke-dashoffset: 0; } }
  .rskizze .sk-g { display: none; }
  .rskizze svg[data-skizze="bad"]  .sk-g[data-g="bad"]  { display: block; }
  .rskizze svg[data-skizze="raum"] .sk-g[data-g="raum"] { display: block; }
  .rskizze svg[data-skizze="dach"] .sk-g[data-g="dach"] { display: block; }
  /* Modul-Ebenen: nur gewählte werden gezeichnet */
  .rskizze .sk-l { display: none; }
  .rskizze .sk-l.an { display: block; }
  .rskizze .sk-symbol { color: var(--gold-700); }
  .rskizze text { font-family: var(--font-heading); font-weight: 700; font-size: 13px; fill: var(--anthrazit-800); }
  .rskizze .sk-f { font-size: 20px; }
  .rskizze .sk-flabel { font-size: 10px; font-weight: 400; fill: var(--anthrazit-600); letter-spacing: 0.08em; text-transform: uppercase; }
  .rskizze--grob .sk-mass { display: none; }
  .rskizze figcaption { color: var(--anthrazit-600); text-align: center; }

  .rechner__result {
    font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(26px, 5vw, 40px);
    color: var(--anthrazit-800);
    margin-block: 8px 4px;
  }
  .rechner__disclaimer { max-width: 560px; }

  .rechner__ergebnisgrid { display: grid; gap: 24px; }
  @media (max-width: 767px) { .rechner__ergebnisrechts { order: -1; } }
  @media (min-width: 768px) {
    .rechner__ergebnisgrid { grid-template-columns: 1.15fr 1fr; align-items: start; }
  }
  .rechner__ergebnisrechts { display: grid; gap: 14px; }
  .rskizze__download { justify-self: center; }
  .rskizze__tipp { margin: 0; text-align: center; color: var(--anthrazit-600); max-width: 320px; justify-self: center; }

  .rechner__chips {
    list-style: none; margin: 10px 0 12px; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .rechner__chips :global(li) {
    font-size: 13.5px; font-weight: 600;
    color: var(--anthrazit-800);
    background: var(--gold-100);
    border: 1px solid var(--gold-500);
    border-radius: var(--radius-pill);
    padding: 5px 14px;
  }

  .rechner__contact { display: grid; gap: 12px; margin-top: 28px; }
  .rechner__contact .btn { width: 100%; }

  .rechner__back {
    position: absolute; top: 24px; left: 20px;
    display: inline-flex; align-items: center; gap: 6px;
    border: 0; background: none;
    color: var(--anthrazit-600); font-size: 14px;
    padding: 6px 10px; border-radius: var(--radius-pill);
  }
  .rechner__back:hover { background: var(--anthrazit-100); }
  html.js .rechner__app[data-started] .rechner__progress { margin-top: 24px; }

  .rechner__booking { margin-top: 40px; }
</style>

<script>
  type Tier = { id: string; label: string; hint: string };
  type Modul = { id: string; label: string; fach: string; hint: string; anteil: number };
  type Extra = { id: string; label: string; preis: number };
  type Gewerk = {
    slug: string; label: string; frage: string; unit: string; icon: string;
    min: number; max: number; step: number; default: number;
    grund: number; proEinheit: Record<string, number>; tiers: Tier[]; spanne: number;
    skizze: "bad" | "raum" | "dach"; bausteine: Modul[]; extras: Extra[];
  };

  const app = document.querySelector<HTMLElement>(".rechner__app");
  if (app) {
    const GEWERKE: Gewerk[] = JSON.parse(app.dataset.gewerke || "[]");
    const steps = Array.from(app.querySelectorAll<HTMLElement>(".rstep"));
    const bar = app.querySelector<HTMLElement>(".rechner__bar")!;
    const progress = app.querySelector<HTMLElement>(".rechner__progress")!;
    const back = document.getElementById("rZurueck")!;
    const range = document.getElementById("rMenge") as HTMLInputElement;
    const mengeOut = document.getElementById("rMengeOut")!;
    const frageEl = document.getElementById("rFrage")!;
    const tiersEl = document.getElementById("rTiers")!;
    const ergebnisEl = document.getElementById("rErgebnis")!;
    const waBtn = document.getElementById("rWhatsapp") as HTMLAnchorElement;
    const mailBtn = document.getElementById("rMail") as HTMLAnchorElement;
    const rangeWrap = document.getElementById("rRangeWrap")!;
    const masseWrap = document.getElementById("rMasse")!;
    const laengeIn = document.getElementById("rLaenge") as HTMLInputElement;
    const breiteIn = document.getElementById("rBreite") as HTMLInputElement;
    const flaecheOut = document.getElementById("rFlaeche")!;
    const moduleWrap = document.getElementById("rModuleWrap")!;
    const moduleEl = document.getElementById("rModule")!;
    const livePreis = document.getElementById("rLivePreis")!;
    const skizzeWrap = document.getElementById("rSkizzeWrap")!;
    const skizzeSvg = document.getElementById("rSkizze")!;
    const skizzeText = document.getElementById("rSkizzeText")!;
    const skizzeIcon = document.getElementById("rSkizzeIcon")!;
    const skLaenge = document.getElementById("skLaenge")!;
    const skBreite = document.getElementById("skBreite")!;
    const skFlaeche = document.getElementById("skFlaeche")!;
    const slot2 = document.getElementById("rSkizzeSlot2")!;
    const slot3 = document.getElementById("rSkizzeSlot3")!;

    // Handskizzen-Pfade auf Länge 1 normieren (für die Zeichnen-Animation)
    skizzeSvg.querySelectorAll(".sk-draw").forEach((p) => p.setAttribute("pathLength", "1"));

    const state = {
      step: 1,
      gewerk: null as Gewerk | null,
      menge: 0,
      tier: "",
      modus: "schnell" as "schnell" | "genau",
      laenge: 0,
      breite: 0,
      module: new Set<string>(),
      extras: new Set<string>(),
    };
    const euro = (n: number) => n.toLocaleString("de-DE");
    const m1 = (n: number) => n.toLocaleString("de-DE", { maximumFractionDigits: 1 });

    function show(step: number) {
      state.step = step;
      steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
      bar.style.width = `${(step / 3) * 100}%`;
      progress.setAttribute("aria-valuenow", String(step));
      progress.setAttribute("aria-label", `Schritt ${step} von 3`);
      back.hidden = step === 1;
      app.toggleAttribute("data-started", step > 1);
      if (step === 2 && skizzeWrap.parentElement !== slot2) slot2.append(skizzeWrap);
      app.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    /** Zeichnungs-Ebenen an die Modul-Auswahl koppeln (schnell = alles gezeichnet). */
    function updateEbenen() {
      const g = state.gewerk;
      if (!g) return;
      const layers = skizzeSvg.querySelectorAll<SVGGElement>(`.sk-g[data-g="${g.skizze}"] .sk-l`);
      layers.forEach((l, i) => {
        const an = state.modus !== "genau" || state.module.has(g.bausteine[i]?.id);
        l.classList.toggle("an", an);
      });
    }

    function selectGewerk(g: Gewerk) {
      state.gewerk = g;
      state.tier = g.tiers.some((t) => t.id === state.tier) ? state.tier : g.tiers[0].id;
      state.module = new Set(g.bausteine.map((b) => b.id));
      app.querySelectorAll(".rtile").forEach((t) =>
        t.classList.toggle("selected", (t as HTMLElement).dataset.gewerk === g.slug)
      );
      frageEl.textContent = g.frage;
      range.min = String(g.min);
      range.max = String(g.max);
      range.step = String(g.step);
      range.value = String(g.default);
      state.menge = g.default;
      const b = Math.round(Math.sqrt(g.default / 1.6) * 10) / 10;
      state.breite = b;
      state.laenge = Math.round((g.default / b) * 10) / 10;
      laengeIn.value = String(state.laenge);
      breiteIn.value = String(state.breite);
      skizzeSvg.dataset.skizze = g.skizze;
      skizzeIcon.setAttribute("href", `#icon-${g.icon}`);
      renderTiers(g);
      renderModule(g);
      updateEbenen();
      updateMenge();
      updateMasse();
      updateLive();
      show(2);
    }

    function renderTiers(g: Gewerk) {
      tiersEl.innerHTML = "";
      for (const t of g.tiers) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "rtier" + (t.id === state.tier ? " selected" : "");
        btn.setAttribute("role", "radio");
        btn.setAttribute("aria-checked", String(t.id === state.tier));
        btn.innerHTML = `<strong>${t.label}</strong><small>${t.hint}</small>`;
        btn.addEventListener("click", () => {
          state.tier = t.id;
          tiersEl.querySelectorAll(".rtier").forEach((el) => {
            el.classList.toggle("selected", el === btn);
            el.setAttribute("aria-checked", String(el === btn));
          });
          updateLive();
        });
        tiersEl.append(btn);
      }
    }

    function renderModule(g: Gewerk) {
      moduleEl.innerHTML = "";
      for (const m of g.bausteine) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "rmodul";
        btn.dataset.modul = m.id;
        btn.setAttribute("aria-pressed", "true");
        btn.innerHTML =
          `<span class="rmodul__check">✓</span>` +
          `<span class="rmodul__text"><strong>${m.label}</strong><small>${m.hint}</small></span>`;
        btn.addEventListener("click", () => toggleModul(m.id, btn));
        moduleEl.append(btn);
      }
      // Extras (optional, mit Aufpreis)
      const extrasEl = document.getElementById("rExtras")!;
      extrasEl.innerHTML = "";
      state.extras = new Set();
      for (const x of g.extras) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "rmodul";
        btn.dataset.extra = x.id;
        btn.setAttribute("aria-pressed", "false");
        btn.innerHTML =
          `<span class="rmodul__check">✓</span>` +
          `<span class="rmodul__text"><strong>${x.label}</strong></span>` +
          `<span class="rmodul__preis">+ ${euro(x.preis)} €</span>`;
        btn.addEventListener("click", () => {
          const an = !state.extras.has(x.id);
          state.extras[an ? "add" : "delete"](x.id);
          btn.setAttribute("aria-pressed", String(an));
          updateLive();
        });
        extrasEl.append(btn);
      }
    }

    function toggleModul(id: string, btn: HTMLElement) {
      if (state.module.has(id)) {
        if (state.module.size === 1) return; // mindestens ein Modul bleibt
        state.module.delete(id);
      } else {
        state.module.add(id);
      }
      btn.setAttribute("aria-pressed", String(state.module.has(id)));
      updateEbenen();
      updateLive();
    }

    function setModus(m: "schnell" | "genau") {
      state.modus = m;
      app.querySelectorAll<HTMLElement>(".rmodus__btn").forEach((b) => {
        const an = b.dataset.modus === m;
        b.classList.toggle("selected", an);
        b.setAttribute("aria-checked", String(an));
      });
      const genau = m === "genau";
      rangeWrap.hidden = genau;
      masseWrap.hidden = !genau;
      moduleWrap.hidden = !genau;
      document.getElementById("rExtrasWrap")!.hidden = !genau;
      livePreis.hidden = !genau;
      skizzeWrap.classList.toggle("rskizze--grob", !genau);
      skizzeText.textContent = genau
        ? "Ihre Module und Maße zeichnen die Bauzeichnung"
        : "Grobe Skizze – Maße und Module im Genau-Modus";
      if (genau) updateMasse();
      updateEbenen();
      updateLive();
    }

    function updateMenge() {
      state.menge = Number(range.value);
      mengeOut.textContent = `${state.menge} ${state.gewerk?.unit ?? ""}`;
      if (state.modus !== "genau") skFlaeche.textContent = `${state.menge} m²`;
      updateLive();
    }

    function updateMasse() {
      const l = Math.min(50, Math.max(0.5, Number(laengeIn.value) || 0.5));
      const b = Math.min(50, Math.max(0.5, Number(breiteIn.value) || 0.5));
      state.laenge = l;
      state.breite = b;
      const f = Math.round(l * b * 10) / 10;
      flaecheOut.textContent = `= ${m1(f)} m²`;
      skLaenge.textContent = `${m1(l)} m`;
      skBreite.textContent = `${m1(b)} m`;
      if (state.modus === "genau") skFlaeche.textContent = `${m1(f)} m²`;
      updateLive();
    }

    function flaeche(): number {
      return state.modus === "genau"
        ? Math.round(state.laenge * state.breite * 10) / 10
        : state.menge;
    }

    function modulFaktor(): number {
      if (state.modus !== "genau") return 1;
      return state.gewerk!.bausteine
        .filter((m) => state.module.has(m.id))
        .reduce((sum, m) => sum + m.anteil, 0);
    }

    function extraSumme(): number {
      if (state.modus !== "genau") return 0;
      return state.gewerk!.extras
        .filter((x) => state.extras.has(x.id))
        .reduce((sum, x) => sum + x.preis, 0);
    }

    function spanne() {
      const g = state.gewerk!;
      const proE = g.proEinheit[state.tier] ?? Object.values(g.proEinheit)[0];
      const basis = (g.grund + flaeche() * proE) * modulFaktor() + extraSumme();
      const r = (n: number) => Math.round(n / 500) * 500;
      return { von: r(basis * (1 - g.spanne)), bis: r(basis * (1 + g.spanne)) };
    }

    function updateLive() {
      if (!state.gewerk || state.modus !== "genau") return;
      const { von, bis } = spanne();
      const extraTxt = state.extras.size ? ` · ${state.extras.size} Extra${state.extras.size > 1 ? "s" : ""}` : "";
      livePreis.innerHTML =
        `Aktuell ca. ${euro(von)} € – ${euro(bis)} €` +
        `<small>${state.module.size} von ${state.gewerk.bausteine.length} Arbeitsschritten${extraTxt}</small>`;
    }

    function showResult() {
      const g = state.gewerk!;
      const { von, bis } = spanne();
      const tierLabel = g.tiers.find((t) => t.id === state.tier)?.label ?? "";
      const genau = state.modus === "genau";
      const f = flaeche();
      ergebnisEl.textContent = `ca. ${euro(von)} € – ${euro(bis)} €`;

      const gewaehlt = g.bausteine.filter((m) => !genau || state.module.has(m.id));
      const extrasGewaehlt = genau ? g.extras.filter((x) => state.extras.has(x.id)) : [];
      const chipsEl = document.getElementById("rChips")!;
      chipsEl.innerHTML = "";
      const chips = [
        g.label,
        genau ? `${m1(state.laenge)} × ${m1(state.breite)} m (${m1(f)} m²)` : `${state.menge} ${g.unit}`,
        tierLabel,
        ...(genau ? gewaehlt.map((m) => m.label) : []),
        ...extrasGewaehlt.map((x) => `+ ${x.label}`),
      ];
      for (const text of chips) {
        const li = document.createElement("li");
        li.textContent = text;
        chipsEl.append(li);
      }

      slot3.append(skizzeWrap);
      skizzeText.textContent = genau
        ? "Ihre Bauzeichnung mit den gewählten Modulen und Maßen"
        : "Grobe Skizze Ihres Projekts";

      // Anfrage-Text in FACHSPRACHE – damit das Team sofort fachlich lesen kann.
      const masse = genau ? `${m1(state.laenge)} × ${m1(state.breite)} m` : `${state.menge} ${g.unit}`;
      const module = genau ? `, Leistungen: ${gewaehlt.map((m) => m.fach).join(", ")}` : "";
      const extras = extrasGewaehlt.length ? `, Extras: ${extrasGewaehlt.map((x) => x.label).join(", ")}` : "";
      const beschreibung =
        `${g.label}, ${masse}, Niveau „${tierLabel}"${module}${extras}, ` +
        `Ersteinschätzung ca. ${euro(von)}–${euro(bis)} €`;
      const waText =
        `Hallo Bauwelt Handwerk, ich habe gerade mein Projekt berechnet: ${beschreibung}. ` +
        `Bitte melden Sie sich bei mir für ein verbindliches Angebot. Vielen Dank!`;
      waBtn.href = `https://wa.me/${waBtn.href.split("wa.me/")[1].split("?")[0]}?text=${encodeURIComponent(waText)}`;
      waBtn.dataset.text = waText; // für die Teilen-Variante mit Bild-Anhang

      const subject = `Projektanfrage: ${g.label}`;
      const body =
        `Guten Tag,\n\nich habe im Online-Rechner folgendes Projekt berechnet:\n` +
        `${beschreibung}.\n\nBitte rufen Sie mich für ein verbindliches Angebot zurück.\n\n` +
        `Name:\nTelefonnummer:\nAdresse (für den Vor-Ort-Termin):\n`;
      mailBtn.href = `${mailBtn.href.split("?")[0]}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      show(3);
    }

    /** Bauzeichnung als PNG-Blob: SVG klonen, Zustand einfrieren, über Canvas rendern. */
    function erzeugePng(): Promise<Blob> {
      const svg = skizzeSvg.cloneNode(true) as SVGSVGElement;
      const art = skizzeSvg.dataset.skizze;
      svg.querySelectorAll(".sk-g").forEach((gr) => {
        if ((gr as SVGElement).dataset.g !== art) gr.remove();
      });
      svg.querySelectorAll(".sk-l:not(.an)").forEach((l) => l.remove());
      if (state.modus !== "genau") svg.querySelector(".sk-mass")?.remove();
      const use = svg.querySelector("use");
      if (use) {
        const symbol = document.querySelector(use.getAttribute("href") || "");
        if (symbol) {
          const g = document.createElementNS("http://www.w3.org/2000/svg", "g");
          g.setAttribute("transform", "translate(160 78) scale(1.5)");
          g.setAttribute("fill", "none");
          g.setAttribute("stroke", "#8C7345");
          g.setAttribute("stroke-width", "2");
          g.setAttribute("stroke-linecap", "round");
          g.setAttribute("stroke-linejoin", "round");
          g.innerHTML = symbol.innerHTML;
          use.replaceWith(g);
        } else {
          use.remove();
        }
      }
      const css = getComputedStyle(document.documentElement);
      const farbe = (v: string, fb: string) => (css.getPropertyValue(v) || fb).trim() || fb;
      const stil = document.createElementNS("http://www.w3.org/2000/svg", "style");
      stil.textContent = `
        .sk { fill: none; stroke: ${farbe("--anthrazit-800", "#2D2C2E")}; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
        .sk-fein { stroke-width: 1.6; stroke: ${farbe("--anthrazit-600", "#5A585C")}; }
        .sk-leitung { stroke-dasharray: 6 5; }
        .sk-raster { stroke: ${farbe("--gold-700", "#8C7345")}; opacity: 0.75; }
        text { font-family: Verdana, sans-serif; font-weight: 700; font-size: 13px; fill: ${farbe("--anthrazit-800", "#2D2C2E")}; }
        .sk-f { font-size: 20px; }
        .sk-flabel { font-size: 10px; font-weight: 400; fill: ${farbe("--anthrazit-600", "#5A585C")}; letter-spacing: 0.08em; }
      `;
      svg.prepend(stil);
      svg.setAttribute("xmlns", "http://www.w3.org/2000/svg");

      const daten = new Blob([new XMLSerializer().serializeToString(svg)], { type: "image/svg+xml" });
      const url = URL.createObjectURL(daten);
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error("SVG-Render fehlgeschlagen")); };
        img.onload = () => {
          const c = document.createElement("canvas");
          c.width = 1020; c.height = 810;
          const ctx = c.getContext("2d")!;
          ctx.fillStyle = "#FFFFFF";
          ctx.fillRect(0, 0, c.width, c.height);
          ctx.drawImage(img, 0, 0, c.width, c.height);
          ctx.fillStyle = farbe("--anthrazit-600", "#5A585C");
          ctx.font = "24px Verdana, sans-serif";
          ctx.textAlign = "center";
          const g = state.gewerk!;
          const masse = state.modus === "genau"
            ? `${m1(state.laenge)} × ${m1(state.breite)} m (${m1(flaeche())} m²)`
            : `${state.menge} ${g.unit}`;
          ctx.fillText(`Projekt-Zeichnung: ${g.label}, ${masse} – bauwelt-handwerk.de`, c.width / 2, c.height - 20);
          URL.revokeObjectURL(url);
          c.toBlob((blob) => (blob ? resolve(blob) : reject(new Error("PNG fehlgeschlagen"))), "image/png");
        };
        img.src = url;
      });
    }

    async function skizzeHerunterladen() {
      const blob = await erzeugePng();
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `Bauwelt-Zeichnung_${state.gewerk!.slug}.png`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    }

    /** WhatsApp: Chat öffnet IMMER direkt bei unserer Nummer mit dem Anfrage-Text.
     *  Die Zeichnung wird gleichzeitig automatisch gespeichert – mehr erlaubt
     *  WhatsApp technisch nicht (wa.me kann keine Datei anhängen). Ein Hinweis
     *  erklärt das Anhängen per Büroklammer. */
    function whatsappMitZeichnung() {
      // Kein preventDefault: der Link öffnet den Chat mit Text an unsere Nummer.
      skizzeHerunterladen().catch(() => {});
      const tipp = document.querySelector(".rskizze__tipp");
      if (tipp) tipp.textContent =
        "Die Zeichnung wurde gerade gespeichert (Downloads/Galerie) – hängen Sie sie im Chat über die Büroklammer an.";
    }

    // Events
    document.getElementById("rSkizzeDownload")!.addEventListener("click", skizzeHerunterladen);
    waBtn.addEventListener("click", whatsappMitZeichnung);
    document.getElementById("rZurueck2")!.addEventListener("click", () => show((state.step - 1) as 1 | 2));

    // --- KI-Variante (Beta): Gemma 2 über WebLLM, komplett im Browser ---
    const kiPanel = document.getElementById("rKiPanel")!;
    const kiStatus = document.getElementById("rKiStatus")!;
    const kiText = document.getElementById("rKiText") as HTMLTextAreaElement;
    document.getElementById("rKiToggle")!.addEventListener("click", () => {
      kiPanel.hidden = !kiPanel.hidden;
    });

    let kiEngine: any = null;
    async function kiVorschlag() {
      const beschreibung = kiText.value.trim();
      if (!beschreibung) { kiStatus.textContent = "Bitte beschreiben Sie kurz Ihr Projekt."; return; }
      const gpu = (navigator as any).gpu;
      const adapter = gpu ? await gpu.requestAdapter().catch(() => null) : null;
      if (!adapter) {
        kiStatus.textContent =
          "Ihr Gerät/Browser unterstützt die KI-Funktion nicht (WebGPU fehlt) – z. B. aktuelles Chrome " +
          "oder Edge am Computer nutzen. Oder einfach oben auswählen, das Ergebnis ist dasselbe.";
        return;
      }
      try {
        if (!kiEngine) {
          kiStatus.textContent = "KI-Modell wird geladen … (einmalig, je nach Verbindung einige Minuten)";
          // BASE_URL kann ohne End-Slash kommen („/Bauwelt") – normalisieren
          const basis = import.meta.env.BASE_URL.endsWith("/")
            ? import.meta.env.BASE_URL
            : import.meta.env.BASE_URL + "/";
          const mod = await import(/* @vite-ignore */ `${basis}assets/js/web-llm.mjs`);
          kiEngine = await mod.CreateMLCEngine("gemma-2-2b-it-q4f16_1-MLC", {
            initProgressCallback: (r: { text: string }) => { kiStatus.textContent = r.text; },
          });
        }
        kiStatus.textContent = "KI denkt nach …";
        const anleitung =
          `Du hilfst einem Handwerksbetrieb. Antworte NUR mit einem JSON-Objekt, kein anderer Text. ` +
          `Felder: gewerk (eines von: ${GEWERKE.map((g) => g.slug).join(", ")}), ` +
          `laenge (Zahl in Metern oder null), breite (Zahl oder null), ` +
          `niveau (basis|komfort|premium), module (Liste passender IDs), extras (Liste passender IDs). ` +
          `Verfügbare Module/Extras je Gewerk: ` +
          GEWERKE.map((g) => `${g.slug}: Module[${g.bausteine.map((m) => m.id).join(",")}] Extras[${g.extras.map((x) => x.id).join(",")}]`).join("; ");
        const antwort = await kiEngine.chat.completions.create({
          messages: [
            { role: "system", content: anleitung },
            { role: "user", content: beschreibung },
          ],
          temperature: 0.2,
          max_tokens: 220,
        });
        const roh = antwort.choices?.[0]?.message?.content ?? "";
        const json = JSON.parse((roh.match(/\{[\s\S]*\}/) || ["{}"])[0]);
        const g = GEWERKE.find((x) => x.slug === json.gewerk);
        if (!g) throw new Error("Gewerk nicht erkannt");
        selectGewerk(g);
        setModus("genau");
        if (json.laenge > 0) { laengeIn.value = String(json.laenge); }
        if (json.breite > 0) { breiteIn.value = String(json.breite); }
        updateMasse();
        if (g.tiers.some((t) => t.id === json.niveau)) {
          state.tier = json.niveau;
          renderTiers(g);
        }
        if (Array.isArray(json.module) && json.module.length) {
          state.module = new Set(json.module.filter((id: string) => g.bausteine.some((m) => m.id === id)));
          if (state.module.size === 0) state.module = new Set(g.bausteine.map((m) => m.id));
          renderModule(g);
          moduleEl.querySelectorAll<HTMLElement>(".rmodul").forEach((el) =>
            el.setAttribute("aria-pressed", String(state.module.has(el.dataset.modul || "")))
          );
        }
        if (Array.isArray(json.extras)) {
          state.extras = new Set(json.extras.filter((id: string) => g.extras.some((x) => x.id === id)));
          document.querySelectorAll<HTMLElement>("#rExtras .rmodul").forEach((el) =>
            el.setAttribute("aria-pressed", String(state.extras.has(el.dataset.extra || "")))
          );
        }
        updateEbenen();
        updateLive();
        kiStatus.textContent = "Vorschlag übernommen – bitte prüfen und anpassen.";
      } catch (err) {
        const msg = (err as Error).message || "";
        kiStatus.textContent = /GPU|WebGPU/i.test(msg)
          ? "Ihr Gerät unterstützt die KI-Funktion nicht (WebGPU fehlt). Nutzen Sie einfach die Auswahl oben – das Ergebnis ist dasselbe."
          : "Die KI konnte gerade keinen Vorschlag erstellen. Nutzen Sie einfach die Auswahl oben.";
        kiEngine = null;
      }
    }
    document.getElementById("rKiStart")!.addEventListener("click", kiVorschlag);
    app.querySelectorAll<HTMLButtonElement>(".rtile").forEach((tile) =>
      tile.addEventListener("click", () => {
        const g = GEWERKE.find((x) => x.slug === tile.dataset.gewerk);
        if (g) selectGewerk(g);
      })
    );
    app.querySelectorAll<HTMLElement>(".rmodus__btn").forEach((b) =>
      b.addEventListener("click", () => setModus(b.dataset.modus as "schnell" | "genau"))
    );
    range.addEventListener("input", updateMenge);
    laengeIn.addEventListener("input", updateMasse);
    breiteIn.addEventListener("input", updateMasse);
    document.getElementById("rWeiter")!.addEventListener("click", showResult);
    back.addEventListener("click", () => show((state.step - 1) as 1 | 2));

    // Vorauswahl per ?gewerk=<slug> (aus den Gewerk-Karten der Startseite)
    const pre = new URLSearchParams(location.search).get("gewerk");
    const preG = pre ? GEWERKE.find((g) => g.slug === pre) : null;
    if (preG) selectGewerk(preG);
  }
</script>
