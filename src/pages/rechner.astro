---
// Projekt-Rechner-Seite: Funnel-Logik liegt in components/Rechner.astro
// (dieselbe Komponente läuft seit 11.10.2026 auch auf der Startseite).
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import BookingEmbed from "../components/BookingEmbed.astro";
import Rechner from "../components/Rechner.astro";
---

<BaseLayout
  title="Sanierungskosten berechnen – Norderstedt & Hamburg | Bauwelt"
  description="Preisspanne für Badsanierung, Sanierung, Fliesen oder Innenausbau in Norderstedt, Hamburg und Umkreis – in einer Minute, unverbindlich, ohne Kontaktdaten."
>
  <section class="section rechner">
    <div class="container rechner__wrap">
      <SectionHead
        center
        as="h1"
        eyebrow="Projekt-Rechner"
        pre="Was kostet Ihr "
        accent="Projekt?"
      />

      <Rechner variant="seite" />

      <div class="rechner__booking" id="termin">
        <BookingEmbed />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rechner__wrap { max-width: 860px; }
  .rechner__booking { margin-top: 40px; }
</style>
