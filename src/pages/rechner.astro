---
// Projekt-Rechner-Seite: Funnel-Logik liegt in components/Rechner.astro
// (dieselbe Komponente läuft seit 11.10.2026 auch auf der Startseite).
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import BookingEmbed from "../components/BookingEmbed.astro";
import Rechner from "../components/Rechner.astro";
import Faq from "../components/Faq.astro";
import { faqSchema } from "../lib/schema";

// SEO-/KI-Audit S7 (Go Jamil 19.10.2026): kurzer Erklärtext + 3 Fragen unter dem Rechner
const FRAGEN = [
  {
    q: "Wie genau ist die Preisspanne?",
    a: "Die Preisspanne ist eine erste Orientierung auf Basis unserer Erfahrung. Den genauen Preis kennen wir erst, wenn wir Ihre Räume gesehen haben: Zustand, Untergrund und Ihre Ausstattungswünsche machen den Unterschied – und können die Spanne nach oben oder unten verschieben.",
  },
  {
    q: "Ist das Ergebnis verbindlich?",
    a: "Nein. Die Preisspanne ist eine unverbindliche Orientierung. Den genauen Preis nennen wir Ihnen in einem schriftlichen Angebot nach dem kostenlosen Vor-Ort-Termin – darin steht genau, welche Leistungen enthalten sind.",
  },
  {
    q: "Muss ich meine Kontaktdaten angeben?",
    a: "Nein. Der Rechner läuft komplett in Ihrem Browser, Ihre Eingaben werden nicht gespeichert. Erst wenn Sie das Ergebnis selbst per WhatsApp, E-Mail oder Rückruf-Formular an uns schicken, erhalten wir Ihre Angaben.",
  },
];
---

<BaseLayout
  schema={faqSchema(FRAGEN) /* Audit S7 */}
  title="Sanierungskosten berechnen – Norderstedt | Bauwelt Handwerk"
  description="Erste Preisorientierung für Badsanierung, Sanierung, Fliesen oder Innenausbau in Norderstedt, Hamburg und Umkreis – in einer Minute, ohne Kontaktdaten."
>
  <section class="section rechner">
    <div class="container rechner__wrap">
      <SectionHead
        center
        as="h1"
        eyebrow="Projekt-Rechner"
        pre="Was kostet Ihr "
        accent="Projekt?"
      />

      <Rechner variant="seite" />

      <!-- SEO-/KI-Audit S7: So rechnet der Rechner -->
      <div class="rechner__info">
        <SectionHead center eyebrow="Gut zu wissen" pre="So rechnet der " accent="Rechner" />
        <div class="rechner__prosa">
          <p>
            Sie wählen Leistung, Größe und Ausstattung – der Rechner zeigt sofort eine Preisspanne. Alle Preise
            sind Bruttopreise inkl. 19 % MwSt. und enthalten Material und Arbeit.
          </p>
          <p>
            Bei der Badsanierung richtet sich die Preisspanne nach der Badgröße. Was sich ohne Besichtigung nicht
            kalkulieren lässt – etwa der Zustand des Untergrunds oder verdeckte Schäden –, klären wir beim
            kostenlosen Vor-Ort-Termin. Danach erhalten Sie Ihr schriftliches Angebot.
          </p>
        </div>
        <Faq items={FRAGEN} />
      </div>

      <div class="rechner__booking" id="termin">
        <BookingEmbed />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rechner__wrap { max-width: 860px; }
  .rechner__booking { margin-top: 40px; }
  .rechner__info { margin-top: 64px; }
  .rechner__prosa { max-width: 680px; margin: 0 auto 28px; }
  .rechner__prosa p { margin: 0 0 1em; }
</style>
