---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, u } from "../consts";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import Placeholder from "../components/Placeholder.astro";
import CtaBand from "../components/CtaBand.astro";
import PageHero from "../components/PageHero.astro";

const werte = [
  { icon: "shield", title: "Solide", text: "Klare Linien, saubere Verarbeitung. Wir bauen, damit es hält." },
  { icon: "hand", title: "Nahbar", text: "Ein deutschsprachiger Ansprechpartner, verständliche Sprache, ehrliche Beratung." },
  { icon: "check", title: "Verlässlich", text: "Feste Prozesse, zugesagte Termine, Festpreis. Sie wissen, woran Sie sind." },
];
const belege = [
  "Fester Ansprechpartner von der Planung bis zur Abnahme",
  "Abnahme jeder Baustelle durch den Meister",
  "Betriebshaftpflicht (Nachweis auf Anfrage)",
  "Alle Gewerke koordiniert aus einer Hand",
];
---
<BaseLayout title="Über uns – Bauwelt Handwerk" active="Über uns"
  description="Bauwelt Handwerk steht für handwerkliche Qualität am Bau in Hamburg und Umgebung: solide, verlässlich, nahbar.">
  <PageHero
    eyebrow="Über uns"
    title="Handwerk, das man sieht"
    lead="Bauwelt Handwerk steht für handwerkliche Qualität am Bau: verlässlich geplant, sauber ausgeführt, ehrlich beraten."
    crumbs={[{ label: "Start", href: u("") }, { label: "Über uns" }]}
    prompt="Handwerker-Team von Bauwelt Handwerk vor einem Projekt, freundlich, echte Arbeitskleidung, kein gestelltes Stockfoto"
    img="hero-ueber-uns.webp"
  />

  <section class="section">
    <div class="container">
      <SectionHead center eyebrow="Unsere Werte" pre="Wofür wir " accent="stehen" />
      <div class="grid cols-3">
        {werte.map((w) => (
          <div class="card reveal"><div class="card__icon"><Icon name={w.icon} /></div><h3>{w.title}</h3><p>{w.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="grid cols-2" style="gap:48px;align-items:center">
        <div class="tile" style="aspect-ratio:4/3;border-radius:8px;overflow:hidden">
          <Placeholder img="team.webp" imgClass="tile__img" showKi={true}
            prompt="Team von Bauwelt Handwerk in Anthrazit-Arbeitskleidung, freundlich, vor Baustelle oder Firmenfahrzeug, echt" />
        </div>
        <div>
          <SectionHead pre="Qualität &amp; " accent="Verlässlichkeit" />
          <ul class="checklist">
            {belege.map((b) => (<li><Icon name="check" size={22} />{b}</li>))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
