---
// Über uns – Kundenwunsch 14.10.2026 (37): finale Struktur von Jamil, Texte wörtlich:
// 1 Hero → 2 Geschäftsführer-Statement → 3 Unsere Werte (dunkel) → 4 Handwerk ohne
// Überraschungen → 5 Zahlen & Fakten (gezeichnete Siegel = Icons/Kreise) → 6 Partner & Auftraggeber.
// Abschnitt „Was für uns gutes Handwerk ausmacht“ entfällt (nicht mehr in der Struktur).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import UspSection from "../components/UspSection.astro";
import SiegelSlider from "../components/SiegelSlider.astro";
import WarumAnders from "../components/WarumAnders.astro";
import Kooperationen from "../components/Kooperationen.astro";
import Icon from "../components/Icon.astro";

const WERTE = [
  { icon: "clock", title: "Verbindlichkeit", text: "Wir halten Zusagen ein und reagieren schnell." },
  { icon: "eye", title: "Transparenz", text: "Sie wissen jederzeit, was als Nächstes passiert." },
  { icon: "hand", title: "Verantwortung", text: "Ein Ansprechpartner begleitet Ihr Projekt von Anfang bis Ende." /* (57) ohne „deutschsprachig“ */ },
];
// Kundenwunsch 19.10.2026 (Audit 7.1): Bagger-Bild ersetzt. Platz für ein KI-Bild eines FIKTIVEN
// Teams: Datei `team-fiktiv.webp` in public/assets/img/ ablegen (16:11, z. B. 1520 × 1080, WebP
// < 200 KB) → wird automatisch verwendet und trägt den Hinweis „KI-generiertes Bild“ (KI_BILDER).
// Solange die Datei fehlt, steht hier ein echtes Projektfoto.
import { existsSync } from "node:fs";
// Jamil 19.10.2026: Fakten statt Siegel – früher als Siegel „15+ Jahre“ / „Regional in Hamburg & Umgebung“
const FAKTEN = ["15+ Jahre Erfahrung im Handwerk" /* Audit K3 */, "Regional in Hamburg & Umgebung, Sitz Norderstedt" /* region.ts */];
const TEAM_BILD = "team-fiktiv.webp";
const teamDa = existsSync(`${process.cwd()}/public/assets/img/${TEAM_BILD}`); // Build läuft im Projektordner
const heroBild = teamDa
  ? { bild: TEAM_BILD, alt: "KI-generiertes Bild eines fiktiven Handwerker-Teams in einem fertig sanierten Innenraum" }
  : { bild: "galerie-bad-05.webp", alt: "Dachgeschossbad mit Glasdusche und Doppelwaschtisch – echtes Bauwelt-Projekt in Hamburg" };
---

<BaseLayout
  title="Über uns – Ihr Handwerksbetrieb aus Norderstedt | Bauwelt"
  description="Bauwelt Handwerk aus Norderstedt: über 15 Jahre Erfahrung im Handwerk, klare Abläufe, Festpreis-Zusage und ein fester Ansprechpartner für Hamburg und Umkreis."
>
  <!-- 1. Hero (Kundenwunsch 14.10.2026 (37), Text wörtlich) -->
  <PageHero
    eyebrow="Über uns"
    pre="Handwerk, wie es heute sein "
    accent="sollte."
    bild={heroBild.bild}
    alt={heroBild.alt}
    checks={FAKTEN}
  >
    <div class="ueber__intro">
      <p class="lead">
        Im Laufe der Jahre haben wir festgestellt: Was Kunden am Handwerk frustriert, ist selten die
        Arbeit selbst. Es sind fehlende Kommunikation, unklare Abläufe und lange Wartezeiten – niemand
        weiß, wer gerade zuständig ist und wann es weitergeht.
      </p>
      <p>
        Gleichzeitig haben wir erlebt, wie serviceorientierte Unternehmen ihre Kunden mit Transparenz,
        Verbindlichkeit und klaren Prozessen begeistern. Dort weiß jeder zu jeder Zeit, was als Nächstes passiert.
      </p>
      <p>Das hat bei uns ein Umdenken ausgelöst.</p>
      <p class="ueber__frage">Warum sollte modernes Handwerk nicht genauso funktionieren?</p>
      <p>
        Mit dieser Überzeugung haben wir unsere Abläufe neu gestaltet: Jedes Projekt folgt einem klaren
        Prozess mit festen Schritten, Sie haben einen festen Ansprechpartner und werden aktiv informiert,
        statt nachfragen zu müssen. So verbinden wir hochwertige Handwerksarbeit mit den Service-Standards
        moderner Dienstleistungsunternehmen.
      </p>
      <p>
        Denn gute Kommunikation ist für uns kein Extra, sondern die Grundlage jedes gelungenen Projekts.
      </p>
    </div>
  </PageHero>

  <!-- 2. Geschäftsführer-Statement -->
  <WarumAnders eyebrow="Ein persönliches Wort" pre="Warum wir anders " accent="arbeiten." id="statement">
    <p>
      Wir haben uns gefragt, warum die Zusammenarbeit mit einem Handwerksbetrieb nicht genauso einfach
      sein kann wie mit den besten Dienstleistungsunternehmen.
    </p>
    <p>
      Inspiriert von Unternehmen, die ihre Kunden mit Verbindlichkeit, Transparenz und erstklassigem
      Service begeistern, haben wir unsere Prozesse neu gestaltet.
    </p>
    <p>
      Denn wir sind überzeugt: Gutes Handwerk zeigt sich nicht nur im Ergebnis, sondern während des
      gesamten Projekts.
    </p>
  </WarumAnders>

  <!-- Kundenwunsch 15.10.2026 (59): Abschnitt „Unsere Überzeugung.“ (Werte) entfernt -->

  <!-- Kundenwunsch 15.10.2026 (66): „Handwerk ohne Überraschungen“ entfernt -->

  <!-- 5. Unsere Versprechen: dieselben 7 gezeichneten Siegel wie auf der Startseite (Jamil 19.10.2026,
       Talk 2538/2539/2541). „15+ Jahre“ und „Regional“ sind keine Versprechen → stehen jetzt im Hero. -->
  <SiegelSlider weiss pre="Darauf können Sie sich " accent="verlassen." />

  <!-- 6. Partner & Auftraggeber – nur Namen, keine Logos (Nutzung nicht freigegeben) -->
  <Kooperationen
    sand
    eyebrow="Vertrauen durch starke Partnerschaften"
    pre="Unsere Erfahrung kommt vielen Projekten "
    accent="zugute."
    text="Unsere Erfahrung bringen wir nicht nur in eigene Projekte ein. Kunden von Obi betreuen wir seit 2024 – bisher über 20 Aufträge. Seit 2026 kommen Aufträge über seniovo und Hornbach dazu, mit steigender Tendenz."
  />
</BaseLayout>

<style>
  .ueber__intro { display: grid; gap: 12px; }
  .ueber__intro p { margin: 0; }
  .ueber__frage { font-family: var(--font-heading); font-weight: 700; color: var(--anthrazit-900); }
</style>
