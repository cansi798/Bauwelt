---
// Über uns: Einstieg + Überzeugung (Texte Kunde 07.10.2026), Werte, Versprechen, Kontakt.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import UspSection from "../components/UspSection.astro";
import SiegelSlider from "../components/SiegelSlider.astro";
import ContactSection from "../components/ContactSection.astro";
import CtaBand from "../components/CtaBand.astro";
import Img from "../components/Img.astro";
---

<BaseLayout
  title="Über uns – Handwerk, wie es heute sein sollte | Bauwelt Handwerk"
  description="Bauwelt Handwerk aus Norderstedt verbindet hochwertige Handwerksarbeit mit klarer Kommunikation, transparenten Abläufen und festen Zusagen – seit über 15 Jahren."
>
  <!-- Texte laut Kundenfeedback 07.10.2026 (wörtlich übernommen) -->
  <PageHero
    eyebrow="Über uns"
    pre="Handwerk, wie es heute "
    accent="sein sollte"
    bild="hero-ueber-uns.webp"
    alt="Das Bauwelt-Team auf der Baustelle"
  >
    <div class="ueber__intro">
      <p class="lead">
        Im Laufe der Jahre haben wir festgestellt, dass es oft nicht die handwerkliche
        Arbeit ist, die Kunden frustriert, sondern fehlende Kommunikation, unklare Abläufe
        und lange Wartezeiten.
      </p>
      <p>
        Gleichzeitig haben wir erlebt, wie serviceorientierte Unternehmen in anderen
        Branchen ihre Kunden begeistern: mit Transparenz, Verbindlichkeit und klaren Prozessen.
      </p>
      <p>Das hat bei uns ein Umdenken ausgelöst.</p>
      <p class="ueber__frage">Warum sollte modernes Handwerk nicht genauso funktionieren?</p>
      <p>
        Mit dieser Überzeugung haben wir unsere Abläufe neu gestaltet und verbinden heute
        hochwertige Handwerksarbeit mit den Service-Standards moderner
        Dienstleistungsunternehmen. Selbstverständlich optimieren wir diese Abläufe ständig.
      </p>
    </div>
  </PageHero>

  <section class="section">
    <div class="container ueber__grid">
      <div>
        <SectionHead eyebrow="Unsere Überzeugung" pre="Was für uns gutes Handwerk " accent="ausmacht" />
        <p>
          Wir sind überzeugt, dass Kunden heute mehr erwarten dürfen als ein gutes
          handwerkliches Ergebnis.
        </p>
        <p>
          Ein Projekt sollte nachvollziehbar geplant, transparent kommuniziert und zuverlässig
          umgesetzt werden. Genau deshalb haben wir unsere Abläufe konsequent an den
          Bedürfnissen unserer Kunden ausgerichtet.
        </p>
        <p>
          Denn am Ende zählt nicht nur das fertige Badezimmer oder die abgeschlossene
          Sanierung, sondern auch die Art und Weise, wie man dorthin gelangt.
        </p>
      </div>
      <div class="ueber__media reveal">
        <Img src="team.webp" alt="Das Team bei der Arbeit im Rohbau" w={720} h={540} />
      </div>
    </div>
  </section>

  <UspSection />
  <SiegelSlider fakten={["15+ Jahre Erfahrung", "100 % deutschsprachiger Ansprechpartner", "Regional vor Ort"]} />
  <ContactSection />
  <CtaBand />
</BaseLayout>

<style>
  .ueber__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 1024px) { .ueber__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; } }
  .ueber__intro { display: grid; gap: 12px; }
  .ueber__intro p { margin: 0; }
  .ueber__frage { font-family: var(--font-heading); font-weight: 700; color: var(--anthrazit-900); }
</style>
