---
// Startseite – Reihenfolge laut Kundenfeedback 30.09.2026:
// 14.10.2026 (30): 1 Hero → Versprechen → 2 Leistungen-Rechner (11.10.2026: Leistungskarten + Projekt-Kalkulation
// kombiniert, ersetzt „Unsere Leistungen“) → 3 Ablauf → 4 Referenzen → 5 Kundenportal → 6 Angebot
// → 7 Versprechen → 8 Einzugsgebiet → 9 FAQ → 10 Kontakt.
// Entfallen: CTA-Band „So sollte Handwerk sein", Terminbuchungs-Sektion
// (Termin jetzt überall per Buchungsfenster), Schritt-Karten beim Ablauf.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import RoughSzene from "../components/RoughSzene.astro";
import PortalSection from "../components/PortalSection.astro";
import AngebotSection from "../components/AngebotSection.astro";
import RefSlider from "../components/RefSlider.astro";
import Rechner from "../components/Rechner.astro";
import SiegelSlider from "../components/SiegelSlider.astro";
import Vertrauensleiste from "../components/Vertrauensleiste.astro";
import Zahlenleiste from "../components/Zahlenleiste.astro";
import Faq from "../components/Faq.astro";
import ServiceArea from "../components/ServiceArea.astro";
import SectionHead from "../components/SectionHead.astro";
import { CTA, TERMIN } from "../consts";
import { FAQ_HOME } from "../data/home";
---

<BaseLayout
  title="Sanierung & Ausbau zum Festpreis – Bauwelt Handwerk Norderstedt"
  description="Badsanierung und Innenausbau in Hamburg & Umgebung – realistische Preise statt Lockangebote. Antwort innerhalb von 12 Stunden, Angebot innerhalb von 24 Stunden."
>
  <Hero />
  <div id="weiter"></div>
  <!-- Kundenwunsch 19.10.2026 (Audit 6.2): Vertrauensleiste direkt unter dem Hero -->
  <Zahlenleiste /> {/* Audit 6.6 */}
  <Vertrauensleiste />

  <!-- Kundenwunsch 14.10.2026 (30): „Worauf Sie sich verlassen können“ direkt nach dem Hero, danach der Rechner -->
  <SiegelSlider />

  <!-- Leistungen + Projekt-Kalkulation in einem (Kundenwunsch 11.10.2026) -->
  <section class="section" id="leistungen">
    <div class="container">
      <SectionHead
        center
        eyebrow="Unsere Leistungen"
        pre="Leistung wählen, Preis "
        accent="berechnen"
      />
      <Rechner variant="start" />
    </div>
  </section>

  <section class="section section--sand" id="ablauf">
    <div class="container">
      <SectionHead center eyebrow="So läuft Ihr Projekt" pre="Von der ersten Idee bis zum fertigen " accent="Ergebnis" />
      <!-- Kundenwunsch 16.10.2026 (74): Bild-Story wieder entfernt – zurück zur gezeichneten 4-Stationen-Animation -->
      <RoughSzene
        szene="weg"
        label="Gezeichneter Ablauf in vier Stationen: 1. Orientierung erhalten – Preis in wenigen Minuten. 2. Wünsche besprechen – kostenloser Vor-Ort-Termin. 3. Klarheit erhalten – Angebot innerhalb von 24 Stunden. 4. Zurücklehnen und genießen – wir koordinieren alles und setzen es für Sie um."
      />
      <div class="weg__actions nur-desktop">
        <a class="btn btn--lg" href={CTA.href}>{CTA.label}</a>
        <a class="btn btn--lg btn--ghost" href={TERMIN.href} target="_blank" rel="noopener" data-termin>{TERMIN.label}</a>
      </div>
    </div>
  </section>

  <RefSlider
    eyebrow="Referenzen"
    pre="Aus Ideen werden "
    accent="Ergebnisse"
    text="Jedes Projekt ist einzigartig. Unser Anspruch bleibt derselbe – hochwertige Handwerksarbeit, klare Kommunikation und ein Ergebnis, das begeistert."
  />

  <PortalSection />
  <AngebotSection />
  {/* Audit 5.2 (19.10.2026): Zitat „Warum wir anders arbeiten“ steht nur noch auf Über uns */}
  <ServiceArea />

  <!-- Weniger Abstand zum Einzugsgebiet darüber (Kundenfeedback 07.10.2026) -->
  <section class="section faq-home" id="fragen">
    <div class="container">
      <SectionHead center eyebrow="Häufige Fragen" pre="Gut zu " accent="wissen" />
      <Faq items={FAQ_HOME} withCta />
    </div>
  </section>

</BaseLayout>

<style>
  .faq-home { padding-top: 0; }
  .weg__actions {
    display: flex; flex-wrap: wrap; gap: 12px 16px;
    justify-content: center;
    margin-top: 12px;
  }
  @media (max-width: 767px) {
    /* Buttons untereinander, gleich breit, Text mittig (wie im Hero) */
    .weg__actions { display: grid; justify-items: stretch; }
    .weg__actions .btn { width: 100%; justify-content: center; text-align: center; white-space: normal; }
  }
</style>
