---
// Startseite – Dramaturgie nach Enpal-Vorbild (Spec §3):
// Hero → Zahlen → 6 Gewerke → Video → USP → Referenzen → CTA → Versprechen
// → Ablauf → FAQ → Termin → Kontakt.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustBand from "../components/TrustBand.astro";
import LeistungSection from "../components/LeistungSection.astro";
import VideoSection from "../components/VideoSection.astro";
import UspSection from "../components/UspSection.astro";
import RefSlider from "../components/RefSlider.astro";
import CtaBand from "../components/CtaBand.astro";
import SiegelSlider from "../components/SiegelSlider.astro";
import Steps from "../components/Steps.astro";
import Faq from "../components/Faq.astro";
import ContactSection from "../components/ContactSection.astro";
import ServiceArea from "../components/ServiceArea.astro";
import BookingEmbed from "../components/BookingEmbed.astro";
import SectionHead from "../components/SectionHead.astro";
import { LEISTUNG_SECTIONS, FAQ_HOME } from "../data/home";
---

<BaseLayout
  title="Sanierung & Ausbau zum Festpreis – Bauwelt Handwerk Norderstedt"
  description="Badsanierung, Komplettsanierung und Ausbau zum Festpreis – ein Ansprechpartner, alle Gewerke, verbindlicher Zeitplan. Jetzt Projekt online berechnen."
>
  <Hero />
  <TrustBand />

  {LEISTUNG_SECTIONS.map((l, i) => (
    <LeistungSection data={l} reverse={i % 2 === 1} sand={i % 2 === 1} />
  ))}

  <VideoSection />
  <UspSection />
  <RefSlider />
  <CtaBand />
  <SiegelSlider />

  <section class="section">
    <div class="container">
      <SectionHead center eyebrow="Ablauf" pre="In vier Schritten zum " accent="Ziel" />
      <Steps />
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <SectionHead center eyebrow="Häufige Fragen" pre="Gut zu " accent="wissen" />
      <Faq items={FAQ_HOME} withCta />
    </div>
  </section>

  <ServiceArea />

  <section class="section section--sand" id="termin">
    <div class="container">
      <SectionHead center eyebrow="Terminbuchung" pre="Termin online " accent="vereinbaren" />
      <div style="max-width: 820px; margin-inline: auto;">
        <BookingEmbed />
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
