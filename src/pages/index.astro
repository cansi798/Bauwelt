---
// Startseite – Dramaturgie nach Kundenfeedback 12.09.2026:
// Hero → Weg zum Badezimmer (6 Schritte) → Kundenportal → Transparentes
// Angebot → Referenzen → Gewerke-Karten → CTA-Band → FAQ
// → Siegel → Einzugsgebiet → Termin → Kontakt.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Steps from "../components/Steps.astro";
import VideoKachel from "../components/VideoKachel.astro";
import PortalSection from "../components/PortalSection.astro";
import AngebotSection from "../components/AngebotSection.astro";
import RefSlider from "../components/RefSlider.astro";
import GewerkeKarten from "../components/GewerkeKarten.astro";
import CtaBand from "../components/CtaBand.astro";
import SiegelSlider from "../components/SiegelSlider.astro";
import Faq from "../components/Faq.astro";
import ContactSection from "../components/ContactSection.astro";
import ServiceArea from "../components/ServiceArea.astro";
import BookingEmbed from "../components/BookingEmbed.astro";
import SectionHead from "../components/SectionHead.astro";
import { CTA } from "../consts";
import { FAQ_HOME, HERO } from "../data/home";
---

<BaseLayout
  title="Sanierung & Ausbau zum Festpreis – Bauwelt Handwerk Norderstedt"
  description="Badsanierung und Innenausbau in Hamburg & Umgebung – alles aus einer Hand. Angebot in 24 h, Kundenportal mit Live-Projektstatus. Jetzt Projekt berechnen."
>
  <Hero />
  <div id="weiter"></div>

  <!-- Bilder zuerst: Referenzen direkt nach dem Hero (visueller Einstieg statt Text) -->
  <RefSlider
    eyebrow="Referenzen"
    pre="Aus Ideen werden "
    accent="Ergebnisse"
    text="Jedes Projekt ist einzigartig. Unser Anspruch bleibt derselbe – hochwertige Handwerksarbeit, klare Kommunikation und ein Ergebnis, das begeistert."
  />

  <!-- Foto-Karten früh: erst überzeugen (Bilder), dann erklären (Text) -->
  <GewerkeKarten />

  <section class="section">
    <div class="container">
      <SectionHead center eyebrow="So läuft Ihr Projekt" pre="Ihr Weg zum neuen " accent="Badezimmer" />
      <VideoKachel name="weg" titel="Ihr Weg zum neuen Badezimmer – als Video erklärt" />
      <Steps />
      <div class="weg__actions">
        <a class="btn btn--lg" href={CTA.href}>{CTA.label}</a>
        <a class="btn btn--lg btn--ghost" href={HERO.cta2.href}>{HERO.cta2.label}</a>
      </div>
    </div>
  </section>

  <PortalSection />
  <AngebotSection />

  <CtaBand cta2Href="#termin" />

  <section class="section">
    <div class="container">
      <SectionHead center eyebrow="Häufige Fragen" pre="Gut zu " accent="wissen" />
      <Faq items={FAQ_HOME} withCta />
    </div>
  </section>

  <SiegelSlider />
  <ServiceArea />

  <section class="section section--sand" id="termin">
    <div class="container">
      <SectionHead center eyebrow="Terminbuchung" pre="Termin online " accent="vereinbaren" />
      <div style="max-width: 820px; margin-inline: auto;">
        <BookingEmbed />
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>

<style>
  .weg__actions {
    display: flex; flex-wrap: wrap; gap: 12px 16px;
    justify-content: center;
    margin-top: 36px;
  }
</style>
