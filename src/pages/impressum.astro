---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, u } from "../consts";
import Icon from "../components/Icon.astro";
---
<BaseLayout title="Impressum – Bauwelt Handwerk" description="Impressum der Bauwelt Handwerk GmbH, Norderstedt." noindex>
  <section class="section">
    <div class="container">
      <article class="legal">
        <p class="eyebrow">Rechtliches</p>
        <h1 class="rule">Impressum</h1>

        <h2>Angaben gemäß § 5 DDG</h2>
        <address>{SITE.legal}<br />{SITE.street}<br />{SITE.zip} {SITE.city}<br />Deutschland</address>

        <h2>Vertreten durch</h2>
        <p>Geschäftsführer: {SITE.managing}</p>

        <h2>Kontakt</h2>
        <p>
          Telefon: <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a><br />
          E-Mail: <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          Web: <a href="https://www.bauwelt-handwerk.de">www.bauwelt-handwerk.de</a>
        </p>

        <h2>Registereintrag</h2>
        <p>Handelsregister: HRB 27109 KI<br />Registergericht: Amtsgericht Kiel</p>

        <h2>Umsatzsteuer-Identifikationsnummer</h2>
        <p>USt-IdNr. gemäß § 27a Umsatzsteuergesetz: {SITE.vat}</p>

        {/* HINWEIS (nicht öffentlich sichtbar): Für Handwerksbetriebe sind i. d. R. weitere
            Angaben Pflicht – zuständige Handwerkskammer, Berufsbezeichnung, ggf.
            Berufshaftpflichtversicherung (Name, Sitz, Geltungsraum). Angaben beim Kunden
            abfragen (siehe Offene-Fragen-Kunde-Bauwelt.docx) und diesen Abschnitt ergänzen:
        <h2>Berufsrechtliche Angaben</h2>
        <p>Mitglied der Handwerkskammer …<br />Berufsbezeichnung: …<br />
        Berufshaftpflichtversicherung: …, Geltungsraum: Deutschland</p>
        */}

        <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
        <address>{SITE.managing}<br />{SITE.street}<br />{SITE.zip} {SITE.city}</address>

        <h2>Verbraucherstreitbeilegung</h2>
        <p>Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>

        <p style="margin-top:40px"><a class="textlink" href={u("")}><span style="display:inline-flex;transform:rotate(180deg)"><Icon name="arrow" size={18} /></span> Zurück zur Startseite</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
