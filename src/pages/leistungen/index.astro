---
// Leistungen-Übersicht: Kachel-Grid mit genau den Leistungen aus dem Menü
// (Kundenwunsch 10.10.2026: Übersicht an die bestehenden Leistungen anpassen).
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { u, NAV2 } from "../../consts";

const imMenue = (NAV2.find((n) => n.label === "Leistungen")?.children ?? [])
  .filter((c) => c.desc)
  .map((c) => c.href.replace(/\/$/, "").split("/").pop());
const leistungen = (await getCollection("leistungen"))
  .filter((l) => imMenue.includes(l.id))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Leistungen – alle Gewerke aus einer Hand | Bauwelt Handwerk"
  description="Badsanierung, Sanierung & Modernisierung, Fliesen- & Bodenlegerarbeiten, Innenausbau & Trockenbau – alle Gewerke aus einer Hand, zum Festpreis."
>
  <PageHero
    eyebrow="Leistungen"
    pre="Alle Gewerke aus einer "
    accent="Hand"
    lead="Vom einzelnen Raum bis zur Kernsanierung – wir übernehmen Planung, Ausführung und Koordination. Sie haben einen Ansprechpartner und einen Festpreis."
    bild="hero-leistungen.webp"
    alt="Hochwertig saniertes Bad mit freistehender Wanne"
  />

  <section class="section">
    <div class="container">
      <div class="grid cols-2">
        {leistungen.map((l) => (
          <a class="card lcard reveal" href={u(`leistungen/${l.id}/`)}>
            <span class="lcard__icon"><Icon name={l.data.icon} size={28} class="icon" /></span>
            <h2>{l.data.title.replace(" zum Festpreis", "")}</h2>
            <p>{l.data.teaser}</p>
            <span class="lcard__more">Mehr erfahren <Icon name="arrow" size={18} class="icon" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .lcard { display: grid; gap: 12px; align-content: start; }
  .lcard h2 { font-size: 19px; margin: 0; }
  .lcard p { margin: 0; font-size: 15px; color: var(--anthrazit-700); }
  .lcard__icon {
    width: 56px; height: 56px;
    border-radius: var(--radius-md);
    background: var(--gold-100);
    color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .lcard__more {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--gold-700); font-weight: 600; margin-top: 4px;
  }
</style>
