---
// Leistungsseite – EINE Vorlage für alle Leistungen (Kundenwunsch 11.10.2026):
// Hero mit H1 (ohne Häkchen-Zeile) → Intro (ca. 8 Zeilen aus Kundensicht) → „Warum
// <Leistung> mit Bauwelt Handwerk?“ → Leistungsumfang (Icon-Karten) → Ablauf (gezeichnete
// Ablauf-Animation der Startseite) → Referenzen → FAQ. Kontakt-Kopf kommt aus dem Footer.
// Kundenwunsch 11.10.2026 (7): „Unser Versprechen“ und „Nächster Schritt“ entfallen.
// Hintergründe wechseln automatisch (weiß/sand), auch wenn ein Abschnitt fehlt.
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import RoughSzene from "../../components/RoughSzene.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/Icon.astro";
import Img from "../../components/Img.astro";
import SectionHead from "../../components/SectionHead.astro";
import { u } from "../../consts";
import { gewerkBySlug } from "../../data/rechner";

export async function getStaticPaths() {
  const leistungen = await getCollection("leistungen");
  return leistungen.map((l) => ({ params: { slug: l.id }, props: { l } }));
}

const { l } = Astro.props;
const { Content } = await render(l);

const kurzTitel = l.data.title.replace(" zum Festpreis", "");
// Überlange Wörter in der H1 (z. B. „Bodenlegerarbeiten") mit weichen Trennstellen,
// sonst läuft die Überschrift auf dem Handy über den Rand.
const h1Titel = kurzTitel
  .replace("Bodenlegerarbeiten", "Boden\u00ADleger\u00ADarbeiten")
  .replace("Sanierungscheck", "Sanierungs\u00ADcheck");
const pauschal = l.data.pauschalpreis;
const rechnerSlug = l.data.rechnerSlug ?? l.id;
const hatRechner = Boolean(gewerkBySlug(rechnerSlug));
const ctaHref = hatRechner ? u(`rechner/?gewerk=${rechnerSlug}`) : u("rechner/");
const euro = (n: number) => n.toLocaleString("de-DE");

// Leistungsumfang als Icon-Karten: passendes Icon je Punkt über Stichworte
// (Reihenfolge = Priorität), sonst Häkchen.
const UMFANG_ICONS: [RegExp, string][] = [
  [/besichtigung/i, "eye"],
  [/kosten/i, "euro"],
  [/gespräch/i, "chat"],
  [/einschätzung|zustand/i, "doc"],
  [/demontage|rückbau|entsorg/i, "hammer"],
  [/sanitär|heizung/i, "tap"],
  [/energetisch|elektro|beleuchtung/i, "bolt"],
  [/barriere/i, "user"],
  [/fliese|großformat/i, "tiles"],
  [/dusche|möbel|accessoire/i, "bath"],
  [/untergrund|schleif|spachtel/i, "tools"],
  [/vinyl|laminat/i, "tiles"],
  [/fugen|silikon/i, "check"],
  [/komplettsanierung|wohnung|haus/i, "reno"],
  [/grundriss|trockenbau|decke|vorwand|vorwände|wand/i, "wall"],
  [/koordination|gewerk/i, "user"],
  [/termin|preis/i, "calendar"],
  [/tür|zarge/i, "reno"],
];
const umfangIcon = (t: string) => UMFANG_ICONS.find(([re]) => re.test(t))?.[1] ?? "check";

// 2 passende Referenzen (Kategorie-Zuordnung je Gewerk)
const catMap: Record<string, "bad" | "sanierung" | "aussen"> = {
  badsanierung: "bad",
  "fliesen-boden": "bad",
  "sanierung-modernisierung": "sanierung",
  innenausbau: "sanierung",
  "maler-boeden": "sanierung",
  "sanitaer-heizung-elektro": "sanierung",
  "dach-fassade": "aussen",
};
const alleRefs = (await getCollection("referenzen")).sort((a, b) => a.data.order - b.data.order);
const refs = alleRefs.filter((r) => r.data.cat === catMap[l.id]).slice(0, 2);

// Abschnitte in fester Reihenfolge; jeder zweite bekommt den Sand-Hintergrund.
const sektionen = [
  "intro",
  l.data.warum.length > 0 && "warum",
  "umfang",
  "ablauf",
  refs.length > 0 && "refs",
  l.data.faq.length > 0 && "faq",
].filter(Boolean) as string[];
const bg = (k: string) => ["section", { "section--sand": sektionen.indexOf(k) % 2 === 0 }];

const description =
  l.data.beschreibung ??
  // Ziel ~140–160 Zeichen: langer Zusatz, wenn er passt, sonst kurzer, sonst nur Teaser.
  ([
    `${l.data.teaser} Jetzt online berechnen – Festpreis nach kostenlosem Vor-Ort-Termin in Norderstedt & Hamburg.`,
    `${l.data.teaser} Jetzt online berechnen – Festpreis nach Vor-Ort-Termin.`,
    l.data.teaser,
  ].find((d) => d.length <= 160) ?? l.data.teaser);
---

<BaseLayout title={`${l.data.title} – Norderstedt & Hamburg`} description={description}>
  <PageHero
    eyebrow={l.data.badge ? `${kurzTitel} · ${l.data.badge}` : kurzTitel}
    pre={`${h1Titel} zum `}
    accent={l.data.h1Akzent}
    lead={l.data.lead}
    bild={l.data.bild ?? `hero-${l.id}.webp`}
    alt={kurzTitel}
    ctaHref={pauschal ? u("kontakt/#termin") : ctaHref}
    ctaLabel={pauschal ? `${kurzTitel.replace("Immobilien-", "")} buchen` : `${kurzTitel} berechnen`}
    ctaNote={pauschal ? `Pauschalpreis ${euro(pauschal)} €` : undefined}
    ohneTermin={Boolean(pauschal)}
  />

  <!-- 1. Intro: worum es geht – aus Kundensicht -->
  <section class:list={bg("intro")}>
    <div class="container ldetail__intro">
      <SectionHead eyebrow={kurzTitel} pre={l.data.introTitel ?? `${kurzTitel} mit Bauwelt Handwerk`} />
      <div class="ldetail__prose"><Content /></div>
    </div>
  </section>

  <!-- 2. Warum mit Bauwelt Handwerk? -->
  {l.data.warum.length > 0 && (
    <section class:list={bg("warum")}>
      <div class="container">
        <SectionHead center eyebrow="Ihre Vorteile" pre={`Warum ${kurzTitel} mit `} accent="Bauwelt Handwerk?" />
        <ul class="warum">
          {l.data.warum.map((w) => (
            <li class="card warum__item reveal">
              <span class="warum__icon"><Icon name={w.icon} size={24} class="icon" /></span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 3. Leistungsumfang -->
  <section class:list={bg("umfang")}>
    <div class="container">
      <SectionHead eyebrow="Leistungsumfang" pre="Was alles drin " accent="ist" />
      <ul class="umfang">
        {l.data.umfang.map((t, i) => (
          <li class="umfang__item reveal">
            <span class="umfang__icon"><Icon name={umfangIcon(t)} size={26} class="icon" /></span>
            <span class="umfang__nr" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <p>{t}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Ablauf: dieselbe gezeichnete Animation wie auf der Startseite -->
  <section class:list={bg("ablauf")}>
    <div class="container">
      <SectionHead center eyebrow="Ablauf" pre="So läuft es " accent="ab" />
      <RoughSzene
        szene="weg"
        label="Gezeichneter Ablauf in vier Stationen: 1. Orientierung erhalten – Preis in wenigen Minuten. 2. Wünsche besprechen – persönlicher Termin. 3. Klarheit erhalten – Angebot in 24 Stunden. 4. Zurücklehnen und genießen – wir koordinieren alles und setzen es für Sie um."
      />
    </div>
  </section>

  {refs.length > 0 && (
    <section class:list={bg("refs")}>
      <div class="container">
        <SectionHead eyebrow="Referenzen" pre="Das haben wir schon " accent="gebaut" />
        <div class="grid cols-2">
          {refs.map((r) => (
            <a class="card refmini reveal" href={u(`referenzen/${r.id}/`)}>
              <Img src={r.data.file ?? `${r.id}.webp`} alt={r.data.title} w={560} h={380} />
              <div class="refmini__body">
                <h3>{r.data.title}</h3>
                <p class="small"><Icon name="pin" size={14} class="icon" /> {r.data.place}{r.data.dauer && ` · ${r.data.dauer}`}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {l.data.faq.length > 0 && (
    <section class:list={bg("faq")}>
      <div class="container">
        <SectionHead center eyebrow="Häufige Fragen" pre={`${kurzTitel}: Gut zu `} accent="wissen" />
        <Faq items={l.data.faq} />
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .ldetail__intro { max-width: 860px; }
  .ldetail__prose { max-width: var(--text-width); font-size: 17px; line-height: 1.7; }
  .ldetail__prose :global(p) { margin-bottom: 1em; }
  .ldetail__prose :global(p:last-child) { margin-bottom: 0; }

  .warum { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 640px) { .warum { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .warum { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .warum__item { display: grid; gap: 10px; align-content: start; padding: 24px; }
  .warum__icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: var(--gold-500);
    color: var(--anthrazit-900);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .warum__item h3 { margin: 4px 0 0; font-size: 17px; text-transform: none; letter-spacing: 0; line-height: 1.3; }
  .warum__item p { margin: 0; font-size: 15px; color: var(--anthrazit-700); }

  .refmini { padding: 12px; display: grid; }
  .refmini__body { padding: 14px 10px 6px; }
  .refmini__body h3 { margin: 0 0 4px; font-size: 17px; text-transform: none; letter-spacing: 0; }
  .refmini__body p { margin: 0; display: inline-flex; align-items: center; gap: 6px; }
  .refmini__body :global(.icon) { color: var(--gold-700); }
  /* Leistungsumfang: Icon-Karten (Kundenwunsch 11.10.2026 (7)) */
  .umfang { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 640px) { .umfang { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
  @media (min-width: 1024px) { .umfang { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  .umfang__item {
    position: relative;
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 16px;
    padding: 20px 22px;
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-left: 4px solid var(--gold-500);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .umfang__item:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .umfang__icon {
    width: 56px; height: 56px;
    border-radius: 14px;
    background: var(--gold-100);
    border: 1px solid var(--gold-500);
    color: var(--gold-700);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .umfang__nr {
    position: absolute; top: 10px; right: 14px;
    font-family: var(--font-heading); font-weight: 800; font-size: 13px; letter-spacing: 0.06em;
    color: var(--gold-500);
  }
  .umfang__item p {
    margin: 0; padding-right: 18px;
    font-family: var(--font-heading); font-weight: 600; font-size: 16px; line-height: 1.35;
    color: var(--anthrazit-800);
  }
</style>
