---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { u } from "../../consts";
import Icon from "../../components/Icon.astro";
import SectionHead from "../../components/SectionHead.astro";
import Steps from "../../components/Steps.astro";
import Faq from "../../components/Faq.astro";
import Gallery from "../../components/Gallery.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";

export async function getStaticPaths() {
  const leistungen = await getCollection("leistungen");
  return leistungen.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"leistungen">; }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

// Passende Referenzen (nach Gewerk) für die Bilder-Sektion
const slugToCat: Record<string, string> = {
  "badsanierung": "bad",
  "sanierung-modernisierung": "sanierung",
  "dach-fassade": "aussen",
};
const cat = slugToCat[entry.slug];
const refs = cat
  ? (await getCollection("referenzen"))
      .filter((r) => r.data.cat === cat)
      .sort((a, b) => a.data.order - b.data.order)
      .slice(0, 3)
      .map((r) => ({ ...r.data, slug: r.slug }))
  : [];
---
<BaseLayout title={`${data.title} – Bauwelt Handwerk`} active="Leistungen" description={data.teaser}>
  <PageHero
    eyebrow="Leistung"
    title={data.title}
    lead={data.lead}
    crumbs={[{ label: "Start", href: u("") }, { label: "Leistungen", href: u("leistungen/") }, { label: data.title }]}
    prompt={data.heroPrompt}
  />

  <section class="section">
    <div class="container">
      <div class="grid cols-2" style="gap:48px;align-items:start">
        <div>
          <SectionHead pre="Leistungs" accent="umfang" />
          <ul class="checklist">
            {data.umfang.map((item) => (
              <li><Icon name="check" size={22} />{item}</li>
            ))}
          </ul>
        </div>
        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {data.ablauf.length > 0 && (
    <section class="section section--sand">
      <div class="container">
        <SectionHead center eyebrow="Ablauf" pre="So " accent="läuft es" />
        <Steps steps={data.ablauf} />
      </div>
    </section>
  )}

  {refs.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead eyebrow="Referenzen" pre="Beispiele aus der " accent="Praxis" />
        <Gallery projects={refs} withFilter={false} />
      </div>
    </section>
  )}

  {data.faq.length > 0 && (
    <section class="section section--sand">
      <div class="container">
        <SectionHead center eyebrow="Häufige Fragen" pre="Gut zu " accent="wissen" />
        <Faq items={data.faq} />
      </div>
    </section>
  )}

  <CtaBand title={`${data.title} anfragen`} />
</BaseLayout>
