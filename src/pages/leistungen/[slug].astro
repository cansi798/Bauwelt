---
// Leistungsseite – EINE Vorlage für alle Leistungen (Kundenwunsch 11.10.2026):
// Hero mit H1 (ohne Häkchen-Zeile) → Intro (ca. 8 Zeilen aus Kundensicht) → „Warum
// <Leistung> mit Bauwelt Handwerk?“ → Ablauf (gezeichnete Ablauf-Animation der
// Startseite) → Referenzen → FAQ. Kontakt-Kopf kommt aus dem Footer.
// Kundenwunsch 12.10.2026 (16): Abschnitt „Was alles drin ist“ entfällt; Referenzen
// zeigen echte Fotos (refBilder im Frontmatter), wo vorhanden.
// Kundenwunsch 11.10.2026 (7): „Unser Versprechen“ und „Nächster Schritt“ entfallen.
// Kundenwunsch 14.10.2026 (29): Jede Leistungsseite ist eine eigenständige „Landingpage“,
// die man Kunden direkt schicken kann: Vollbild-Hero (LeistungHero) → Rechner → Intro mit
// Foto → „Warum mit uns?“ (dunkel) → Referenzen-Karussell → Ablauf mit CTAs → Versprechen
// (Siegel der Startseite) → FAQ mit Termin-Button. Gleiches Schema für alle Leistungen.
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeistungHero from "../../components/LeistungHero.astro";
import RoughSzene from "../../components/RoughSzene.astro";
import Faq from "../../components/Faq.astro";
import Icon from "../../components/Icon.astro";
import Img from "../../components/Img.astro";
import SectionHead from "../../components/SectionHead.astro";
import Rechner from "../../components/Rechner.astro";
import LeistungVorteile from "../../components/LeistungVorteile.astro";
import Vertrauensleiste from "../../components/Vertrauensleiste.astro";
import { CTA, SITE, TERMIN, u, leistungBySlug, kurzName } from "../../consts";
import { gewerkBySlug } from "../../data/rechner";
import { GALERIE } from "../../data/galerie";
import { breadcrumbSchema, faqSchema, serviceSchema } from "../../lib/schema";

export async function getStaticPaths() {
  // Leistungen mit eigener Seitendatei (eigeneSeite, z. B. Sicher wohnen) nicht doppelt erzeugen
  const leistungen = await getCollection("leistungen", (l) => !l.data.eigeneSeite);
  return leistungen.map((l) => ({ params: { slug: l.id }, props: { l } }));
}

const { l } = Astro.props;
const { Content } = await render(l);

// Kundenwunsch 16.10.2026 (73): Namen aus LEISTUNGEN (consts.ts).
// Kundenwunsch 19.10.2026 (Audit 1.3): H1 = Leistungsname (unterschrift, letztes Wort gold),
// darunter klein der Slogan (ueberschrift); Pfad/Brotkrumen + Seitentitel = Leistungsname.
const leistung = leistungBySlug(l.id);
if (!leistung) throw new Error(`Leistung ${l.id} fehlt in LEISTUNGEN (consts.ts)`);
const kurzTitel = kurzName(leistung);
// Überlange Wörter in sichtbaren Überschriften (H1 + H2) mit weichen Trennstellen, sonst läuft die
// Überschrift auf dem Handy über den Rand und die Seite lässt sich seitlich verschieben
// (z. B. „Was gehört zu Fliesen- & Bodenlegerarbeiten?“ bei 360 px). Nicht für Titel/Meta verwenden.
const weich = (t: string) => t
  .replace("Bodenlegerarbeiten", "Boden\u00ADleger\u00ADarbeiten")
  .replace("Komplettsanierung", "Komplett\u00ADsanierung")
  .replace("Modernisierung", "Moderni\u00ADsierung")
  .replace("Sanierungscheck", "Sanierungs\u00ADcheck");
const h1Titel = weich(leistung.unterschrift);
const pauschal = l.data.pauschalpreis;
const rechnerSlug = l.data.rechnerSlug ?? l.id;
const hatRechner = Boolean(gewerkBySlug(rechnerSlug));
const euro = (n: number) => n.toLocaleString("de-DE");

// Referenzen: NUR echte Fotos aus refBilder (KI-Referenzbilder entfernt, 12.10.2026 (17)).
// Kundenwunsch 14.10.2026 (27): ALLE Fotos der zugehörigen Galerie-Gruppe als Karussell
// (Fallback: refBilder aus der Leistungsdatei)
const galerieGruppe = GALERIE.find((g) => g.id === l.data.refAnker);
const refBilder = galerieGruppe?.bilder?.length ? galerieGruppe.bilder : (l.data.refBilder ?? []);

const heroBild = l.data.bild ?? `hero-${l.id}.webp`; /* Hero-Bilder bleiben wie sie sind (Kunde 12.10.2026) */
// Foto neben dem Intro: erstes Referenzfoto, das nicht schon im Hero steht.
const introBild = refBilder.find((b) => b.file !== heroBild);
const buchen = pauschal
  ? { href: u("kontakt/#termin"), label: `${kurzTitel.replace("Immobilien-", "")} buchen`, extern: false }
  : { href: TERMIN.href, label: TERMIN.label, extern: true };
// Überschriften aus dem Frontmatter: letztes Wort wird gold (wie überall auf der Seite)
const teile = (t: string) => {
  const i = t.lastIndexOf(" ");
  return i < 0 ? { pre: "", accent: t } : { pre: t.slice(0, i + 1), accent: t.slice(i + 1) };
};
const h1 = teile(h1Titel);
const mitIntro = !l.data.ohneIntro;
// Hintergrund-Wechsel: ohne Intro folgt die Kachel-Sektion direkt auf den (sandfarbenen) Rechner → weiß
const kachelnSand = mitIntro || !hatRechner;
const bilderKopf = teile(l.data.bilderTitel ?? "Das haben wir schon gebaut");
const ablaufKopf = l.data.ablaufTitel ? teile(l.data.ablaufTitel) : null;
// Kundenwunsch 14.10.2026 (54): Vorteile nicht mehr als Plaketten im Hero.
// Jamil 19.10.2026 (Talk 2538/2539/2541): Die frühere Leiste mit 4 Kernvorteilen unter dem Hero
// und die Karten „Ihre Vorteile“ zeigten dieselben Vorteile doppelt. Jetzt EIN Abschnitt
// (LeistungVorteile): eigene Vorteile der Leistung + die 7 Versprechen – jeder Vorteil genau einmal.

// SEO-/KI-Audit S4 (19.10.2026): Titel mit Leistung + Norderstedt (lokaler Fokus), max. ca. 60 Zeichen
const seoTitel = [
  `${kurzTitel} in Norderstedt & Hamburg | Bauwelt Handwerk`,
  `${kurzTitel} in Norderstedt & Hamburg | Bauwelt`,
  `${kurzTitel} in Norderstedt | Bauwelt`,
].find((t) => t.length <= 60) ?? `${kurzTitel} | Bauwelt`;
const description =
  l.data.beschreibung ??
  // Ziel ~140–160 Zeichen: langer Zusatz, wenn er passt, sonst kurzer, sonst nur Teaser.
  ([
    `${l.data.teaser} In Norderstedt, Hamburg und Umkreis – Festpreis nach Vor-Ort-Termin.`,
    `${l.data.teaser} In Norderstedt, Hamburg und Umkreis.`,
    l.data.teaser,
  ].find((d) => d.length <= 160) ?? l.data.teaser);
---

<BaseLayout
  schema={[
    ...serviceSchema({ name: leistung.unterschrift, beschreibung: l.data.teaser, url: new URL(u(`leistungen/${l.id}/`), Astro.site).href, preis: pauschal, gebiet: "Hamburg und Umgebung" }),
    ...breadcrumbSchema([
      { name: "Startseite", url: new URL(u(""), Astro.site).href },
      { name: leistung.unterschrift, url: new URL(u(`leistungen/${l.id}/`), Astro.site).href },
    ]),
    ...faqSchema(l.data.faq),
  ] /* SEO-/KI-Audit S3 */}
  title={seoTitel /* SEO-/KI-Audit S4: Leistung + Norderstedt, max. ca. 60 Zeichen */}
  description={description}
  sticky={pauschal ? [
    { label: buchen.label, href: buchen.href },
    { label: "Anrufen", href: `tel:${SITE.phoneTel}`, ariaLabel: `${SITE.phoneDisplay} anrufen` },
  ] : undefined /* Audit 1.7: Pauschal-Checks ohne Rechner */}
>
  <LeistungHero
    eyebrow={leistung.unterschrift}
    pre={h1.pre}
    accent={h1.accent}
    slogan={leistung.ueberschrift}
    claim={l.data.claim}
    lead={l.data.lead}
    bild={heroBild}
    ctaHref={hatRechner ? "#rechner" : buchen.href}
    ctaLabel={hatRechner ? CTA.label : buchen.label}
    mitTermin={!pauschal}
    chips={[] /* (54): Plaketten entfallen, Vorteile stehen in LeistungVorteile */}
  />
  <Vertrauensleiste />

  {/* Kundenwunsch 14.10.2026 (26): Rechner direkt auf der Leistungsseite (statt Button „… berechnen“) */}
  {hatRechner && (
    <section class="section section--sand" id="rechner">
      <div class="container">
        <SectionHead center eyebrow={`${kurzTitel} berechnen`} pre="Was kostet Ihr " accent="Projekt?" />
        <Rechner variant="seite" gewerk={rechnerSlug} intro={l.data.rechnerText} />
      </div>
    </section>
  )}

  <!-- 1. Intro: worum es geht – aus Kundensicht, mit echtem Foto daneben.
       Kundenwunsch 16.10.2026 (77): per ohneIntro abschaltbar (Badsanierung: „entfernen“) -->
  {mitIntro && (
  <section class="section">
    <div class:list={["container", "lintro", { "lintro--bild": introBild }]}>
      <div class="lintro__text">
        <SectionHead eyebrow={kurzTitel} pre={weich(l.data.introTitel ?? `${kurzTitel} mit Bauwelt Handwerk`)} />
        <div class="ldetail__prose"><Content /></div>
        {/* Audit 5.7: bei Pauschal-Checks kein dritter gleicher Buchen-Button */}
        <div class:list={["lintro__actions", "nur-desktop", { "lintro__actions--aus": pauschal }]}>
          {buchen.extern
            ? <a class="btn" href={buchen.href} target="_blank" rel="noopener" data-termin>{buchen.label}</a>
            : <a class="btn" href={buchen.href}>{buchen.label}</a>}
        </div>
      </div>
      {introBild && (
        <figure class="lintro__bild reveal">
          <Img src={introBild.file} alt={introBild.alt} w={4} h={5} />
          {/* Kundenwunsch 14.10.2026 (52): Festpreis-Schild auf dem Foto entfernt */}
        </figure>
      )}
    </div>
  </section>
  )}

  <!-- Leistungsumfang als Kacheln (Kundenwunsch 14.10.2026 (35)) -->
  {l.data.kacheln.length > 0 && (
    <section class:list={["section", { "section--sand": kachelnSand }]}>
      <div class="container">
        <SectionHead center eyebrow="Leistungsumfang" {...teile(weich(l.data.umfangTitel ?? `Das gehört zu ${kurzTitel}`))} text={l.data.umfangText} />
        {/* Kundenwunsch 14.10.2026 (53): Kacheln zentriert umbrechen (7 Kacheln → 4 + 3), keine einzelne Restkachel */}
        <ul class:list={["kacheln", "kacheln--zentriert", { "kacheln--vier": l.data.kacheln.length === 7 || l.data.kacheln.length === 8 }]}>
          {l.data.kacheln.map((k) => (
            <li class="kachel reveal">
              <span class="kachel__icon"><Icon name={k.icon} size={26} class="icon" /></span>
              <span class="kachel__titel">{k.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 2. Warum mit Bauwelt Handwerk? – EIN dunkler Vorteils-Abschnitt (Jamil 19.10.2026) -->
  <LeistungVorteile
    pre={`Warum ${weich(kurzTitel)} mit `}
    accent="Bauwelt Handwerk?"
    eigeneTitel={pauschal ? `Das bringt Ihnen der ${kurzTitel}` : `Das Besondere bei ${kurzTitel}`}
    vorteile={l.data.warum}
  />

  {refBilder.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="lrefs__head">
          <SectionHead eyebrow="Projektbilder" pre={bilderKopf.pre} accent={bilderKopf.accent} text={l.data.bilderText} />
          {refBilder.length > 1 && (
            <div class="slider__nav">
              <button class="slider__btn" type="button" data-dir="-1" aria-label="Zurück">
                <Icon name="arrow-left" size={20} class="icon" />
              </button>
              <button class="slider__btn" type="button" data-dir="1" aria-label="Weiter">
                <Icon name="arrow" size={20} class="icon" />
              </button>
            </div>
          )}
        </div>
        <div class="slider">
          <div class="slider__track" data-slider>
            {refBilder.map((b) => (
              <a class="card refmini" href={u(`referenzen/${l.data.refAnker ? `#${l.data.refAnker}` : ""}`)}>
                <Img src={b.file} alt={b.alt} w={4} h={5} />
                {/* Kundenwunsch 14.10.2026 (35): Projektname unter dem Foto */}
                {b.titel && <span class="refmini__titel">{b.titel}</span>}
              </a>
            ))}
          </div>
        </div>
        <div class="lmitte">
          <a class="btn btn--ghost" href={u(`referenzen/${l.data.refAnker ? `#${l.data.refAnker}` : ""}`)}>Alle Referenzen ansehen</a>
        </div>
      </div>
    </section>
  )}

  <!-- Ablauf: dieselbe gezeichnete Animation wie auf der Startseite, mit CTAs -->
  <section class="section section--sand">
    <div class="container">
      {ablaufKopf
        ? <SectionHead center eyebrow="Ablauf" pre={ablaufKopf.pre} accent={ablaufKopf.accent} />
        : <SectionHead center eyebrow="Ablauf" pre="So einfach kommen Sie zu Ihrem " accent={l.data.ablaufZiel ?? "Ergebnis"} />}
      {/* Kundenwunsch 19.10.2026 (Audit 1.8): Pauschal-Check (Sanierungscheck) mit eigenem Ablauf */}
      {pauschal ? (
        <RoughSzene
          szene="wegCheck"
          label="Gezeichneter Ablauf in vier Stationen: 1. Termin buchen – online oder kurz per WhatsApp. 2. Besichtigung – vor Ort, gern gemeinsam mit Ihnen. 3. Einschätzung – Sanierungsbedarf und Kosten. 4. Sicher entscheiden – bei einer Sanierung mit uns wird der Check angerechnet."
        />
      ) : (
        <RoughSzene
          szene="weg"
          label="Gezeichneter Ablauf in vier Stationen: 1. Orientierung erhalten – Preis in wenigen Minuten. 2. Wünsche besprechen – kostenloser Vor-Ort-Termin. 3. Klarheit erhalten – Angebot innerhalb von 24 Stunden. 4. Zurücklehnen und genießen – wir koordinieren alles und setzen es für Sie um."
        />
      )}
      <div class="lmitte lmitte--zwei nur-desktop">
        {hatRechner && <a class="btn btn--lg" href="#rechner">{CTA.label}</a>}
        {buchen.extern
          ? <a class:list={["btn", "btn--lg", { "btn--ghost": hatRechner }]} href={buchen.href} target="_blank" rel="noopener" data-termin>{buchen.label}</a>
          : <a class="btn btn--lg" href={buchen.href}>{buchen.label}</a>}
      </div>
    </div>
  </section>

  {l.data.faq.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead center eyebrow="Häufige Fragen" pre={`${weich(kurzTitel)}: Gut zu `} accent="wissen" />
        <Faq items={l.data.faq} withCta />
        {/* Audit 5.6: allgemeine Fragen (Festpreis, Vor-Ort-Termin, Ablauf) stehen einmal auf der Startseite */}
        <p class="lmitte lfaq__mehr"><a href={`${u("")}#fragen`}>Allgemeine Fragen zu Festpreis, Vor-Ort-Termin und Ablauf <Icon name="arrow" size={16} class="icon" /></a></p>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .lrefs__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 24px; margin-bottom: 24px; }
  .lrefs__head :global(.section-head) { margin-bottom: 0; }
  .refmini { width: min(84vw, 420px); } /* größer: Kundenwunsch 14.10.2026 (33) */

  .lmitte { display: flex; justify-content: center; margin-top: 8px; }
  .lfaq__mehr { margin-top: 20px; }
  .lfaq__mehr a { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; }
  .lmitte--zwei { flex-wrap: wrap; gap: 14px 16px; margin-top: 32px; }

  .lintro { display: grid; gap: 32px; align-items: center; }
  .lintro:not(.lintro--bild) { max-width: 860px; }
  .lintro__text { display: grid; gap: 0; justify-items: start; }
  .lintro__actions { margin-top: 28px; }
  .lintro__actions--aus { display: none !important; }
  .lintro__bild { position: relative; margin: 0; }
  .lintro__bild :global(img) { width: 100%; border-radius: var(--radius-lg, 20px); box-shadow: 0 24px 60px -24px rgba(31, 30, 32, 0.45); }
  .lintro__siegel {
    position: absolute; left: -16px; bottom: 28px;
    display: flex; align-items: center; gap: 10px;
    max-width: 280px;
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--weiss);
    box-shadow: 0 16px 40px -16px rgba(31, 30, 32, 0.35);
    font-size: 14px; line-height: 1.35; color: var(--anthrazit-700);
  }
  .lintro__siegel strong { color: var(--anthrazit-900); }
  .lintro__siegel :global(.icon) {
    flex: none; width: 34px; height: 34px; padding: 7px;
    border-radius: 50%; background: var(--gold-500); color: var(--anthrazit-900);
  }
  @media (min-width: 1024px) {
    .lintro--bild { grid-template-columns: 1.15fr 0.85fr; gap: 72px; }
  }
  @media (max-width: 1023px) {
    .lintro__bild { max-width: 460px; justify-self: center; width: 100%; }
    .lintro__siegel { left: 12px; right: 12px; bottom: 12px; max-width: none; }
  }
  .ldetail__prose { max-width: var(--text-width); font-size: 17px; line-height: 1.7; }
  .ldetail__prose :global(p) { margin-bottom: 1em; }
  .ldetail__prose :global(p:last-child) { margin-bottom: 0; }

  .refmini { padding: 12px; display: grid; gap: 10px; text-decoration: none; }
  .refmini__titel { font-family: var(--font-heading); font-weight: 700; font-size: 15px; line-height: 1.3; color: var(--anthrazit-900); padding: 0 4px 2px; }

  /* .warum- und .kachel-Stile liegen seit Kundenwunsch 14.10.2026 (37–40) in global.css (auch Über uns, Karriere, Partner, Kontakt) */
</style>

<script>
  // Karussell der Referenzfotos (wie Startseiten-Slider): Pfeile scrollen um eine Kartenbreite
  for (const slider of document.querySelectorAll<HTMLElement>(".slider")) {
    const track = slider.querySelector<HTMLElement>("[data-slider]");
    const nav = slider.closest("section")?.querySelectorAll<HTMLButtonElement>(".slider__btn");
    if (!track || !nav?.length) continue;
    const step = () => (track.firstElementChild as HTMLElement)?.offsetWidth + 20 || 300;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 4;
      nav.forEach((b) => { b.disabled = Number(b.dataset.dir) < 0 ? track.scrollLeft <= 4 : track.scrollLeft >= max; });
    };
    nav.forEach((b) => b.addEventListener("click", () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: "smooth" })));
    track.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
