---
// Kundenwunsch 17.10.2026 (82): „Zuhause-Check 60+“ heißt jetzt „Sicher wohnen. Heute und morgen.“
// (neue Adresse /leistungen/sicher-wohnen/). GitHub Pages kann nicht serverseitig umleiten –
// diese Mini-Seite hält bereits geteilte Links am Leben: sofortige Weiterleitung, noindex,
// canonical auf die neue Seite. Steht bewusst nicht in der Sitemap (nur Content-Einträge).
import { u } from "../../consts";
const ziel = u("leistungen/sicher-wohnen/");
const absolut = new URL(ziel, Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Weiterleitung – Sicher-wohnen-Check | Bauwelt Handwerk</title>
    <link rel="canonical" href={absolut} />
    <meta http-equiv="refresh" content={`0; url=${ziel}`} />
    <script is:inline define:vars={{ ziel }}>location.replace(ziel + location.hash);</script>
  </head>
  <body>
    <p>Diese Seite ist umgezogen: <a href={ziel}>Sicher-wohnen-Check</a></p>
  </body>
</html>
