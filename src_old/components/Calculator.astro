---
import { u } from "../consts";
---
<div class="grid cols-2" style="align-items:stretch">
  <form class="calc" id="calcForm" novalidate>
    <div class="field">
      <label for="calcSize">Größe des Bads: <span class="calc__slider-val" id="sizeOut">6 m²</span></label>
      <input type="range" id="calcSize" min="2" max="20" step="1" value="6" />
    </div>
    <div class="field">
      <span style="display:block;font-family:var(--font-heading);font-weight:600;font-size:14px;margin-bottom:8px">Ausstattung</span>
      <div class="chips" role="radiogroup" aria-label="Ausstattung">
        <label class="chip"><input type="radio" name="tier" value="standard" checked /><span>Standard</span></label>
        <label class="chip"><input type="radio" name="tier" value="komfort" /><span>Komfort</span></label>
        <label class="chip"><input type="radio" name="tier" value="premium" /><span>Premium</span></label>
      </div>
    </div>
    <div class="field">
      <span style="display:block;font-family:var(--font-heading);font-weight:600;font-size:14px;margin-bottom:8px">Zusätzlich gewünscht</span>
      <div class="chips">
        <label class="chip"><input type="checkbox" name="extra" value="1200" /><span>Bodengleiche Dusche</span></label>
        <label class="chip"><input type="checkbox" name="extra" value="900" /><span>Fußbodenheizung</span></label>
        <label class="chip"><input type="checkbox" name="extra" value="1500" /><span>Barrierefrei</span></label>
      </div>
    </div>
  </form>
  <div class="calc__result" aria-live="polite">
    <p class="small" style="color:var(--gold-300);text-transform:uppercase;letter-spacing:.08em;font-family:var(--font-heading);font-weight:600;margin:0 0 8px">Ihre Preisspanne</p>
    <div class="calc__price"><span class="cur">€</span> <span id="priceOut">18.000</span></div>
    <div class="calc__range" id="rangeOut">ca. 16.200 € – 19.800 € inkl. Material und Arbeit</div>
    <a class="btn btn--primary" href={u("kontakt/")} style="margin-top:24px">Festpreis-Angebot anfordern</a>
    <p class="small" style="color:var(--anthrazit-400);margin-top:16px">Unverbindliche Orientierung. Ihr verbindlicher Festpreis folgt nach einem kurzen Vor-Ort-Termin.</p>
  </div>
</div>
<div class="calc__hint">
  <strong>Hinweis:</strong> Die Preise dienen der ersten Orientierung. Jedes Bad wird vom Meister vor Ort aufgenommen, bevor wir Ihnen einen festen Preis nennen.
</div>

<script>
  // >>> PLATZHALTER-PREISE – bitte durch echte Werte ersetzen. <<< (Richtwerte in Euro)
  const PRICING = {
    grundpauschale: 4500,
    proQm: { standard: 2200, komfort: 3000, premium: 4200 } as Record<string, number>,
    spanne: 0.10,
  };
  const form = document.getElementById("calcForm");
  if (form) {
    const sizeInput = document.getElementById("calcSize") as HTMLInputElement;
    const sizeOut = document.getElementById("sizeOut")!;
    const priceOut = document.getElementById("priceOut")!;
    const rangeOut = document.getElementById("rangeOut")!;
    const euro = (n: number) => Math.round(n).toLocaleString("de-DE");
    const recalc = () => {
      const qm = parseInt(sizeInput.value, 10);
      const tier = (document.querySelector('input[name="tier"]:checked') as HTMLInputElement)?.value || "standard";
      const extras = Array.from(document.querySelectorAll('input[name="extra"]:checked'))
        .reduce((sum, el) => sum + Number((el as HTMLInputElement).value), 0);
      const base = PRICING.grundpauschale + qm * PRICING.proQm[tier] + extras;
      sizeOut.textContent = qm + " m²";
      priceOut.textContent = euro(base);
      rangeOut.textContent = `ca. ${euro(base * (1 - PRICING.spanne))} € – ${euro(base * (1 + PRICING.spanne))} € inkl. Material und Arbeit`;
    };
    form.addEventListener("input", recalc);
    recalc();
  }
</script>
