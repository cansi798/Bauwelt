---
import { SITE, u, waLink } from "../consts";
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
---
<section class="section section--dark" id="kontakt">
  <div class="container">
    <SectionHead eyebrow="Kontakt" pre="Lassen Sie uns " accent="sprechen" />
    <div class="contact-grid">
      <div class="contact-info">
        <div class="advisor-group">
          {SITE.contacts.map((c) => (
            <div class="advisor">
              <span class="advisor__photo">
                <span class="advisor__ph"><Icon name="user" size={30} /></span>
                <img src={u(`assets/img/${c.photo}`)} alt={`${c.name}, ${c.role}`} onerror="this.remove()" />
              </span>
              <div>
                <div class="value" style="font-family:var(--font-heading);font-weight:700">{c.name}</div>
                <div class="small" style="color:var(--anthrazit-400)">{c.role}</div>
              </div>
            </div>
          ))}
        </div>
        <p style="color:var(--anthrazit-400)">Erzählen Sie uns kurz von Ihrem Vorhaben. Wir melden uns in der Regel innerhalb von 24 Stunden.</p>
        <ul>
          <li><Icon name="user" /><div><div class="label">Ihre Ansprechpartner</div><div class="value">{SITE.contacts.map((c) => `${c.name} (${c.role})`).join(" · ")}</div></div></li>
          <li><Icon name="phone" /><div><div class="label">Telefon</div><a class="value" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a></div></li>
          <li><Icon name="whatsapp" /><div><div class="label">WhatsApp</div><a class="value" href={waLink()} target="_blank" rel="noopener">Direkt schreiben</a></div></li>
          <li><Icon name="mail" /><div><div class="label">E-Mail</div><a class="value" href={`mailto:${SITE.emails.service}`}>{SITE.emails.service}</a></div></li>
          <li><Icon name="pin" /><div><div class="label">Adresse</div><div class="value">{SITE.legal}<br />{SITE.street}<br />{SITE.zip} {SITE.city}</div></div></li>
          <li><Icon name="clock" /><div><div class="label">Erreichbarkeit</div><div class="value">{SITE.hours}</div></div></li>
        </ul>
      </div>
      <div class="form-card">
        <h3>Schnell Kontakt aufnehmen</h3>
        <p style="color:var(--anthrazit-400)">Schreiben Sie uns Ihr Anliegen – wir melden uns in der Regel innerhalb von 24 Stunden.</p>
        <div class="contact-actions">
          <a class="btn btn--primary btn--block" href={`mailto:${SITE.emails.service}?subject=${encodeURIComponent("Anfrage über die Website")}`}>
            <Icon name="mail" size={18} /> E-Mail schreiben
          </a>
          <a class="btn btn--secondary btn--block" href={`tel:${SITE.phoneTel}`}>
            <Icon name="phone" size={18} /> {SITE.phoneDisplay}
          </a>
          <a class="btn btn--secondary btn--block" href={waLink()} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} /> WhatsApp
          </a>
        </div>
        <p class="small" style="margin-top:16px;color:var(--anthrazit-400)">Oder direkt an <a href={`mailto:${SITE.emails.service}`}>{SITE.emails.service}</a></p>
      </div>
    </div>
  </div>
</section>
